                @* Centro de ayuda (07/08/2026): ayuda online, manuales, atajos F1-F9, novedades *@
                <AyudaMenu />

                @* Menú de usuario (07/08/2026): ficha, mis accesos, theme y cerrar sesión.
                   Reemplaza el texto "Usuario: X", el botón naranja de salir y el ícono
                   suelto de paleta — los tres pasaron a vivir adentro del desplegable. *@
                <UsuarioMenu ThemeGris="_themeGris" OnCambiarTheme="CambiarTheme" />
            </MudAppBar>

            <MudMainContent>
                <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4 mb-8">
                    @Body
