                                    @onclick="() => _informesReservasExpanded = !_informesReservasExpanded">
                                <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Small" Class="nav-item__icon" />
                                <span>Informes sobre Reservas</span>
                                <MudIcon Icon="@(_informesReservasExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                         Size="Size.Small" Class="nav-section__chevron" />
                            </button>
                            @if (_informesReservasExpanded)
                            {
                                <div class="nav-section__items nav-section__items--sub">
                                    <a href="/reservas-fecha-servicio"
                                       class="nav-item @(Nav.Uri.Contains("reservas-fecha-servicio") ? "nav-item--active" : "")"
                                       @onclick="ToggleDrawer">
                                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Reservas por fecha y servicio</span>
                                    </a>
                                    <a href="/reservas-banda-horaria"
                                       class="nav-item @(Nav.Uri.Contains("reservas-banda-horaria") ? "nav-item--active" : "")"
                                       @onclick="ToggleDrawer">
                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Reservas por fecha y banda horaria</span>
                                    </a>
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Bandas Horarios</span>
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="nav-divider"></div>

                }

                @if (Permisos.Tiene('T'))
                {
                @* ── TRÁFICO ── *@
