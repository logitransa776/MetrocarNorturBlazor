                                {
                                    var abierto = _informesModulosAbiertos.Contains(grupo.Modulo.Modulo);
                                    @* Cada submódulo redefine --nt-mod con SU color: acá es donde
                                       el usuario ve que el mismo naranja de la sección Tráfico
                                       reaparece en los informes de Tráfico y significa lo mismo. *@
                                    <div style="--nt-mod:@grupo.Modulo.Color">
                                    <button class="nav-section__title nav-section__title--sub @(abierto ? "nav-section__title--open" : "")"
                                            @onclick="() => AlternarModuloInformes(grupo.Modulo.Modulo)">
