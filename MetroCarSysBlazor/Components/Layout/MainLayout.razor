@code {
    private bool _drawerOpen = false;

    // Secciones principales — todas colapsadas al entrar (cualquier usuario)
    private bool _reservasExpanded = false;
    private bool _traficoExpanded = false;
    private bool _vehiculosExpanded = false;
    private bool _facturacionExpanded = false;
    private bool _tallerExpanded = false;
    private bool _combustibleExpanded = false;
    private bool _abmExpanded = false;
    private bool _utilitariosExpanded = false;

    // Submenús nivel 3 — Reservas
    private bool _plantillasExpanded = false;
    private bool _informesReservasExpanded = false;

    // Submenús nivel 3 — Tráfico
    private bool _francosExpanded = false;
    private bool _viaticosExpanded = false;
    private bool _contactosExpanded = false;
    private bool _adicionalesStockExpanded = false;
    private bool _libroNovedadesExpanded = false;

    // Submenús nivel 3 — Vehículos y Choferes
    private bool _apercibimientosExpanded = false;
    private bool _capacitacionesExpanded = false;

    // Submenús nivel 3 — Facturación
    private bool _factuCliExpanded = false;
    private bool _tarifaVentaExpanded = false;
    private bool _tarifaChofExpanded = false;
    private bool _adicionalesExpanded = false;
    private bool _liquidChofExpanded = false;

    // Submenús nivel 3 — Taller
    private bool _stockExpanded = false;
    private bool _chequeoExpanded = false;
    private bool _articulosExpanded = false;

    // Submenús nivel 3 — Combustible
    private bool _depositosExpanded = false;

    // Submenús nivel 3 — ABM del sistema
    private bool _parametrosExpanded = false;
    private bool _abmFacturacionExpanded = false;

    // Submenús nivel 3 — Utilitarios
    private bool _reparacionesExpanded = false;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    // ── Theme switcher (clases CSS en app.css; theme.js aplica y persiste) ──
    private bool _themeGris;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Sincroniza el ícono con el theme guardado en el navegador.
            var theme = await JS.InvokeAsync<string>("norturTheme.get");
            if (theme == "gris" && !_themeGris)
            {
                _themeGris = true;
                StateHasChanged();
            }
        }
    }

    private async Task CambiarTheme()
    {
        _themeGris = !_themeGris;
        await JS.InvokeVoidAsync("norturTheme.set", _themeGris ? "gris" : "clasico");
    }

    private void CerrarSesion()
    {
        AuthState.CerrarSesion();
        Nav.NavigateTo("/login", forceLoad: false);
    }
}
