                                    @onclick="() => _contactosExpanded = !_contactosExpanded">
                                <MudIcon Icon="@Icons.Material.Filled.Contacts" Size="Size.Small" Class="nav-item__icon" />
                                <span>Contactos y Proveedores</span>
                                <MudIcon Icon="@(_contactosExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                         Size="Size.Small" Class="nav-section__chevron" />
                            </button>
                            @if (_contactosExpanded)
                            {
                                <div class="nav-section__items nav-section__items--sub">
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.ContactPage" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Contactos</span>
                                    </span>
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Rubros de contactos</span>
                                    </span>
                                </div>
                            }
                            <span class="nav-item nav-item--disabled">
                                <MudIcon Icon="@Icons.Material.Filled.PeopleAlt" Size="Size.Small" Class="nav-item__icon" />
                                <span>Lista de pasajeros</span>
                            </span>
                            <span class="nav-item nav-item--disabled">
                                <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Small" Class="nav-item__icon" />
                                <span>Controles sobre los estados de las reservas</span>
                            </span>
                            @* Adicionales Stock — submenú nivel 3 *@
