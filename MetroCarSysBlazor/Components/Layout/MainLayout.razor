                    @if (_vehiculosExpanded)
                    {
                        <div class="nav-section__items">
                            <a href="/choferes"
                               class="nav-item @(Nav.Uri.Contains("choferes") ? "nav-item--active" : "")"
                               @onclick="ToggleDrawer">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="nav-item__icon" />
                                <span>Choferes</span>
                            </a>
                            @* Apercibimientos — submenú nivel 3 *@
                            <button class="nav-section__title nav-section__title--sub @(_apercibimientosExpanded ? "nav-section__title--open" : "")"
                                    @onclick="() => _apercibimientosExpanded = !_apercibimientosExpanded">
                                <MudIcon Icon="@Icons.Material.Filled.GppBad" Size="Size.Small" Class="nav-item__icon" />
                                <span>Apercibimientos</span>
                                <MudIcon Icon="@(_apercibimientosExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                         Size="Size.Small" Class="nav-section__chevron" />
                            </button>
                            @if (_apercibimientosExpanded)
                            {
                                <div class="nav-section__items nav-section__items--sub">
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Apercibimientos</span>
                                    </span>
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.List" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Motivos</span>
                                    </span>
                                </div>
                            }
                            @* Capacitaciones — submenú nivel 3 *@
                            <button class="nav-section__title nav-section__title--sub @(_capacitacionesExpanded ? "nav-section__title--open" : "")"
                                    @onclick="() => _capacitacionesExpanded = !_capacitacionesExpanded">
                                <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Small" Class="nav-item__icon" />
                                <span>Capacitaciones</span>
                                <MudIcon Icon="@(_capacitacionesExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                         Size="Size.Small" Class="nav-section__chevron" />
                            </button>
                            @if (_capacitacionesExpanded)
                            {
                                <div class="nav-section__items nav-section__items--sub">
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Consulta</span>
                                    </span>
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.LibraryAdd" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Armado de capacitaciones</span>
                                    </span>
                                </div>
                            }
                            <span class="nav-item nav-item--disabled">
                                <MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Small" Class="nav-item__icon" />
                                <span>Odómetros</span>
                            </span>
                            <span class="nav-item nav-item--disabled">
                                <MudIcon Icon="@Icons.Material.Filled.CarCrash" Size="Size.Small" Class="nav-item__icon" />
