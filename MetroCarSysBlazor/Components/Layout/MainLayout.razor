                                    @onclick="() => _adicionalesStockExpanded = !_adicionalesStockExpanded">
                                <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Small" Class="nav-item__icon" />
                                <span>Adicionales Stock</span>
                                <MudIcon Icon="@(_adicionalesStockExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                         Size="Size.Small" Class="nav-section__chevron" />
                            </button>
                            @if (_adicionalesStockExpanded)
                            {
                                <div class="nav-section__items nav-section__items--sub">
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Mantenimiento</span>
                                    </span>
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.Input" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Ingreso</span>
                                    </span>
                                </div>
                            }
                            @* Libro de Novedades — submenú nivel 3 *@
                            <button class="nav-section__title nav-section__title--sub @(_libroNovedadesExpanded ? "nav-section__title--open" : "")"
                                    @onclick="() => _libroNovedadesExpanded = !_libroNovedadesExpanded">
                                <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" Class="nav-item__icon" />
                                <span>Libro de Novedades</span>
                                <MudIcon Icon="@(_libroNovedadesExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                         Size="Size.Small" Class="nav-section__chevron" />
                            </button>
                            @if (_libroNovedadesExpanded)
                            {
                                <div class="nav-section__items nav-section__items--sub">
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.Book" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Libro de Novedades</span>
                                    </span>
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Envío de correos</span>
                                    </span>
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Correos Electrónicos Parámetros</span>
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="nav-divider"></div>

                }

                @if (Permisos.Tiene('V'))
                {
                @* ── VEHÍCULOS Y CHOFERES ── *@
