                                         Size="Size.Small" Class="nav-section__chevron" />
                            </button>
                            @if (_francosExpanded)
                            {
                                <div class="nav-section__items nav-section__items--sub">
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Ingreso de Francos</span>
                                    </span>
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.EditCalendar" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Mantenimiento de Francos</span>
                                    </span>
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.ManageSearch" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Auditoría Francos</span>
                                    </span>
                                </div>
                            }
                            @* Viáticos — submenú nivel 3 *@
                            <button class="nav-section__title nav-section__title--sub @(_viaticosExpanded ? "nav-section__title--open" : "")"
                                    @onclick="() => _viaticosExpanded = !_viaticosExpanded">
                                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" Class="nav-item__icon" />
                                <span>Viáticos</span>
                                <MudIcon Icon="@(_viaticosExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                         Size="Size.Small" Class="nav-section__chevron" />
                            </button>
                            @if (_viaticosExpanded)
                            {
                                <div class="nav-section__items nav-section__items--sub">
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Viáticos</span>
                                    </span>
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Motivo</span>
                                    </span>
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Forma Liquidación</span>
                                    </span>
                                </div>
                            }
                            <span class="nav-item nav-item--disabled">
                                <MudIcon Icon="@Icons.Material.Filled.ConfirmationNumber" Size="Size.Small" Class="nav-item__icon" />
                                <span>Voucher Recepción</span>
                            </span>
                            <span class="nav-item nav-item--disabled">
                                <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" Class="nav-item__icon" />
                                <span>Guardia</span>
                            </span>
                            @* Contactos y Proveedores — submenú nivel 3 *@
