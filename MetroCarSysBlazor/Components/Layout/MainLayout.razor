    /// <summary>Primer segmento del path ("/siniestros?x=1" → "siniestros").</summary>
    private string RutaActual()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        var corte = path.IndexOfAny(new[] { '/', '?', '#' });
        return corte >= 0 ? path[..corte] : path;
    }

    private string TituloPantallaActual()
    {
        var path = RutaActual();

        if (_pantallasPorRuta.TryGetValue(path, out var pantalla))
            return pantalla.Titulo;

        if (InformesCatalogo.TitulosPorRuta.TryGetValue(path, out var tituloInforme))
            return tituloInforme;

        return "Informes y Reportes · Sistema de gestión";
    }

    /// <summary>
    /// Color del filete de la barra: el del módulo de la pantalla abierta. Las pantallas
    /// sin módulo (login, ayuda, el hub de informes) caen en el neutro — no se les inventa
    /// un color de módulo que después le enseñaría al usuario algo falso.
    /// </summary>
    private string ColorModuloActual()
    {
        var path = RutaActual();

        if (_pantallasPorRuta.TryGetValue(path, out var pantalla))
            return InformesCatalogo.Color(pantalla.Modulo);

        return InformesCatalogo.Color(InformesCatalogo.ModuloDeRuta(path));
    }

    // ── Theme switcher (clases CSS en app.css; theme.js aplica y persiste) ──
    private bool _themeGris;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Registra este circuito como "sesión en uso". Si el usuario cierra el navegador,
            // el circuito se cae y SesionCircuitoTracker cierra la sesión tras la gracia.
            // Va acá (y no en el CircuitHandler) porque recién ahora el usuario está resuelto.
            await RegistrarCircuitoAsync();

            // Sincroniza el ícono con el theme guardado en el navegador.
            var theme = await JS.InvokeAsync<string>("norturTheme.get");
            if (theme == "gris" && !_themeGris)
            {
                _themeGris = true;
                StateHasChanged();
            }
        }
    }

    // ── Seguimiento de la sesión del circuito (cierre al cerrar el navegador) ──
    private async Task RegistrarCircuitoAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var usuario = state.User.Identity?.Name;
        var sid = state.User.FindFirst(NorturClaims.Sesion)?.Value;

        if (string.IsNullOrWhiteSpace(usuario) || !Guid.TryParse(sid, out var sessionId)) return;

        SesionCtx.SessionId = sessionId;
        SesionCtx.Usuario = usuario;
        SesionTracker.Conectar(sessionId, usuario, SesionCtx.CircuitId);
    }

    private async Task CambiarTheme()
    {
        _themeGris = !_themeGris;
        await JS.InvokeVoidAsync("norturTheme.set", _themeGris ? "gris" : "clasico");
    }
}
