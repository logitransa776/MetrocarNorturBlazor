@inherits LayoutComponentBase
@implements IDisposable
@inject NorturAuthStateProvider AuthState
@inject IPermissionService Permisos
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SesionCircuitoContexto SesionCtx
@inject SesionCircuitoTracker SesionTracker

<MudThemeProvider Theme="NorturTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>

        @* ── Overlay backdrop (cierra el drawer al clickear afuera) ── *@
        @if (_drawerOpen)
        {
            <div class="nav-backdrop" @onclick="ToggleDrawer"></div>
        }

        @* ── Drawer lateral — FUERA del MudLayout para posición fixed real ── *@
        <div class="nav-drawer @(_drawerOpen ? "nav-drawer--open" : "")">

            <div class="nav-drawer__header">
                <img src="images/logo.png" alt="NORTUR" style="height:20px; filter:brightness(0) invert(1);" />
                <span class="nav-drawer__subtitle">Informes y Reportes</span>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               Style="color:white; margin-left:auto;"
                               OnClick="ToggleDrawer" />
            </div>

            <nav class="nav-drawer__nav">

                @* Aviso: todas las secciones arrancan colapsadas — el usuario abre la que necesite. *@
                <div class="nav-hint">
                    <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Small" Class="nav-hint__icon" />
                    <span>Tocá una sección para abrirla</span>
                </div>

                @* Visibilidad por módulo del usuario (letra en usuario.acceso) —
                   mismo comportamiento que el SKIP FOR del menú FoxPro. *@

                @if (Permisos.Tiene('S'))
                {
                @* ── SISTEMA ── (Sistema → Accesos del FoxPro: ABM de Usuarios y Permisos)
                   --nt-mod = el color del módulo. Entra UNA vez acá y lo heredan el ícono,
                   el filete y el ítem activo (ver app.css § CÓDIGO DE COLOR POR MÓDULO). *@
                <div class="nav-section" style="--nt-mod:@InformesCatalogo.Color(ModuloInforme.Sistema)">
                    <button class="nav-section__title @(_sistemaExpanded ? "nav-section__title--open" : "")"
                            @onclick="() => _sistemaExpanded = !_sistemaExpanded">
                        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Small" Class="nav-section__icon" />
                        <span>Sistema</span>
                        <MudIcon Icon="@(_sistemaExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                 Size="Size.Small" Class="nav-section__chevron" />
                    </button>
                    @if (_sistemaExpanded)
                    {
                        <div class="nav-section__items">
                            <a href="/usuarios-abm"
                               class="nav-item @(Nav.Uri.Contains("usuarios-abm") ? "nav-item--active" : "")"
                               @onclick="ToggleDrawer">
                                <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Size="Size.Small" Class="nav-item__icon" />
                                <span>Usuarios y Permisos</span>
                            </a>
                            @* Parámetros Empresa + Generales. En el FoxPro cuelgan de «ABM del
                               sistema» (permiso 'A'); acá van bajo Sistema ('S') porque exponen
                               CUIT, tasa de IVA y la password del correo. Decisión 12/08/2026. *@
                            <a href="/parametros"
                               class="nav-item @(Nav.Uri.Contains("parametros") ? "nav-item--active" : "")"
                               @onclick="ToggleDrawer">
                                <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" Class="nav-item__icon" />
                                <span>Parámetros del sistema</span>
                            </a>
                        </div>
                    }
                </div>

                <div class="nav-divider"></div>

                }

                @if (Permisos.Tiene('R'))
                {
                @* ── RESERVAS ── *@
                <div class="nav-section" style="--nt-mod:@InformesCatalogo.Color(ModuloInforme.Reservas)">
                    <button class="nav-section__title @(_reservasExpanded ? "nav-section__title--open" : "")"
                            @onclick="() => _reservasExpanded = !_reservasExpanded">
                        <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Small" Class="nav-section__icon" />
                        <span>Reservas</span>
                        <MudIcon Icon="@(_reservasExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                 Size="Size.Small" Class="nav-section__chevron" />
                    </button>
                    @if (_reservasExpanded)
                    {
                        <div class="nav-section__items">
                            <a href="/reservas-especiales"
                               class="nav-item @(Nav.Uri.Contains("reservas-especiales") ? "nav-item--active" : "")"
                               @onclick="ToggleDrawer">
                                <MudIcon Icon="@Icons.Material.Filled.AddBox" Size="Size.Small" Class="nav-item__icon" />
                                <span>Reservas Especiales</span>
                            </a>
                            <a href="/reservas-por-plantillas"
                               class="nav-item @(Nav.Uri.Contains("reservas-por-plantillas") ? "nav-item--active" : "")"
                               @onclick="ToggleDrawer">
                                <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Class="nav-item__icon" />
                                <span>Reservas por Plantillas</span>
                            </a>
                            <span class="nav-item nav-item--disabled">
                                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Class="nav-item__icon" />
                                <span>Clientes</span>
                            </span>
                            <a href="/operadores"
                               class="nav-item @(Nav.Uri.Contains("operadores") ? "nav-item--active" : "")"
                               @onclick="ToggleDrawer">
                                <MudIcon Icon="@Icons.Material.Filled.SupportAgent" Size="Size.Small" Class="nav-item__icon" />
                                <span>Operadores</span>
                            </a>
                            <a href="/grupos"
                               class="nav-item @(Nav.Uri.Contains("grupos") ? "nav-item--active" : "")"
                               @onclick="ToggleDrawer">
                                <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Class="nav-item__icon" />
                                <span>Grupos</span>
                            </a>
                            <a href="/destinos"
                               class="nav-item @(Nav.Uri.Contains("destinos") ? "nav-item--active" : "")"
                               @onclick="ToggleDrawer">
                                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="nav-item__icon" />
                                <span>Destinos</span>
                            </a>
                            @* Plantillas — submenú nivel 3 *@
                            <button class="nav-section__title nav-section__title--sub @(_plantillasExpanded ? "nav-section__title--open" : "")"
                                    @onclick="() => _plantillasExpanded = !_plantillasExpanded">
                                <MudIcon Icon="@Icons.Material.Filled.Article" Size="Size.Small" Class="nav-item__icon" />
                                <span>Plantillas</span>
                                <MudIcon Icon="@(_plantillasExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                         Size="Size.Small" Class="nav-section__chevron" />
                            </button>
                            @if (_plantillasExpanded)
                            {
                                <div class="nav-section__items nav-section__items--sub">
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.NoteAdd" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Crear Plantillas</span>
                                    </span>
                                    <a href="/plantillas-mantenimiento"
                                       class="nav-item @(Nav.Uri.Contains("plantillas-mantenimiento") ? "nav-item--active" : "")"
                                       @onclick="ToggleDrawer">
                                        <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Mantenimiento Plantillas</span>
                                    </a>
                                </div>
                            }
                            <span class="nav-item nav-item--disabled">
                                <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Small" Class="nav-item__icon" />
                                <span>Importa Reservas desde Excel</span>
                            </span>
                        </div>
                    }
                </div>

                <div class="nav-divider"></div>

                }

                @if (Permisos.Tiene('T'))
                {
                @* ── TRÁFICO ── *@
                <div class="nav-section" style="--nt-mod:@InformesCatalogo.Color(ModuloInforme.Trafico)">
                    <button class="nav-section__title @(_traficoExpanded ? "nav-section__title--open" : "")"
                            @onclick="() => _traficoExpanded = !_traficoExpanded">
                        <MudIcon Icon="@Icons.Material.Filled.DirectionsBus" Size="Size.Small" Class="nav-section__icon" />
                        <span>Tráfico</span>
                        <MudIcon Icon="@(_traficoExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                 Size="Size.Small" Class="nav-section__chevron" />
                    </button>
                    @if (_traficoExpanded)
                    {
                        <div class="nav-section__items">
                            <a href="/planilla-trafico"
                               class="nav-item @(Nav.Uri.Contains("planilla-trafico") ? "nav-item--active" : "")"
                               @onclick="ToggleDrawer">
                                <MudIcon Icon="@Icons.Material.Filled.TableChart" Size="Size.Small" Class="nav-item__icon" />
                                <span>Operación de Tráfico</span>
                            </a>
                            <span class="nav-item nav-item--disabled">
                                <MudIcon Icon="@Icons.Material.Filled.Flight" Size="Size.Small" Class="nav-item__icon" />
                                <span>Web de Aeropuertos 2000</span>
                            </span>
                            <a href="/cabeceras-recorridos"
                               class="nav-item @(Nav.Uri.Contains("cabeceras-recorridos") ? "nav-item--active" : "")"
                               @onclick="ToggleDrawer">
                                <MudIcon Icon="@Icons.Material.Filled.AltRoute" Size="Size.Small" Class="nav-item__icon" />
                                <span>Cabeceras - Recorridos</span>
                            </a>
                            @* Francos — submenú nivel 3 *@
                            <button class="nav-section__title nav-section__title--sub @(_francosExpanded ? "nav-section__title--open" : "")"
                                    @onclick="() => _francosExpanded = !_francosExpanded">
                                <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Small" Class="nav-item__icon" />
                                <span>Francos</span>
                                <MudIcon Icon="@(_francosExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                         Size="Size.Small" Class="nav-section__chevron" />
                            </button>
                            @if (_francosExpanded)
                            {
                                <div class="nav-section__items nav-section__items--sub">
                                    <a href="/francos-ingreso"
                                       class="nav-item @(Nav.Uri.Contains("francos-ingreso") ? "nav-item--active" : "")"
                                       @onclick="ToggleDrawer">
                                        <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Ingreso de Francos</span>
                                    </a>
                                    <a href="/francos"
                                       class="nav-item @(Nav.Uri.EndsWith("/francos") ? "nav-item--active" : "")"
                                       @onclick="ToggleDrawer">
                                        <MudIcon Icon="@Icons.Material.Filled.EditCalendar" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Mantenimiento de Francos</span>
                                    </a>
                                </div>
                            }
                            @* Viáticos — submenú nivel 3 *@
                            <button class="nav-section__title nav-section__title--sub @(_viaticosExpanded ? "nav-section__title--open" : "")"
                                    @onclick="() => _viaticosExpanded = !_viaticosExpanded">
                                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" Class="nav-item__icon" />
                                <span>Viáticos</span>
                                <MudIcon Icon="@(_viaticosExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                         Size="Size.Small" Class="nav-section__chevron" />
                            </button>
                            @if (_viaticosExpanded)
                            {
                                <div class="nav-section__items nav-section__items--sub">
                                    <a href="/viaticos"
                                       class="nav-item @(Nav.Uri.EndsWith("/viaticos") ? "nav-item--active" : "")"
                                       @onclick="ToggleDrawer">
                                        <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Viáticos</span>
                                    </a>
                                    <a href="/viaticos-motivo"
                                       class="nav-item @(Nav.Uri.Contains("viaticos-motivo") ? "nav-item--active" : "")"
                                       @onclick="ToggleDrawer">
                                        <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Motivo</span>
                                    </a>
                                    <a href="/viaticos-forma-liquidacion"
                                       class="nav-item @(Nav.Uri.Contains("viaticos-forma-liquidacion") ? "nav-item--active" : "")"
                                       @onclick="ToggleDrawer">
                                        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Forma Liquidación</span>
                                    </a>
                                </div>
                            }
                            <a href="/voucher-recepcion"
                               class="nav-item @(Nav.Uri.Contains("voucher-recepcion") ? "nav-item--active" : "")"
                               @onclick="ToggleDrawer">
                                <MudIcon Icon="@Icons.Material.Filled.ConfirmationNumber" Size="Size.Small" Class="nav-item__icon" />
                                <span>Voucher Recepción</span>
                            </a>
                            <a href="/guardias"
                               class="nav-item @(Nav.Uri.Contains("guardias") ? "nav-item--active" : "")"
                               @onclick="ToggleDrawer">
                                <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" Class="nav-item__icon" />
                                <span>Guardia</span>
                            </a>
                            @* Contactos y Proveedores — submenú nivel 3 *@
                            <button class="nav-section__title nav-section__title--sub @(_contactosExpanded ? "nav-section__title--open" : "")"
                                    @onclick="() => _contactosExpanded = !_contactosExpanded">
                                <MudIcon Icon="@Icons.Material.Filled.Contacts" Size="Size.Small" Class="nav-item__icon" />
                                <span>Contactos y Proveedores</span>
                                <MudIcon Icon="@(_contactosExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                         Size="Size.Small" Class="nav-section__chevron" />
                            </button>
                            @if (_contactosExpanded)
                            {
                                <div class="nav-section__items nav-section__items--sub">
                                    <a href="/contactos"
                                       class="nav-item @(Nav.Uri.Contains("contactos") && !Nav.Uri.Contains("rubros-contacto") ? "nav-item--active" : "")"
                                       @onclick="ToggleDrawer">
                                        <MudIcon Icon="@Icons.Material.Filled.ContactPage" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Contactos</span>
                                    </a>
                                    <a href="/rubros-contacto"
                                       class="nav-item @(Nav.Uri.Contains("rubros-contacto") ? "nav-item--active" : "")"
                                       @onclick="ToggleDrawer">
                                        <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Rubros de contactos</span>
                                    </a>
                                </div>
                            }
                            <span class="nav-item nav-item--disabled">
                                <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Small" Class="nav-item__icon" />
                                <span>Controles sobre los estados de las reservas</span>
                            </span>
                            @* Adicionales Stock — submenú nivel 3 *@
                            <button class="nav-section__title nav-section__title--sub nav-section__title--soon @(_adicionalesStockExpanded ? "nav-section__title--open" : "")"
                                    @onclick="() => _adicionalesStockExpanded = !_adicionalesStockExpanded">
                                <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Small" Class="nav-item__icon" />
                                <span>Adicionales Stock</span>
                                <MudIcon Icon="@(_adicionalesStockExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                         Size="Size.Small" Class="nav-section__chevron" />
                            </button>
                            @if (_adicionalesStockExpanded)
                            {
                                <div class="nav-section__items nav-section__items--sub">
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Mantenimiento</span>
                                    </span>
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.Input" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Ingreso</span>
                                    </span>
                                </div>
                            }
                            @* Libro de Novedades — submenú nivel 3 *@
                            <button class="nav-section__title nav-section__title--sub @(_libroNovedadesExpanded ? "nav-section__title--open" : "")"
                                    @onclick="() => _libroNovedadesExpanded = !_libroNovedadesExpanded">
                                <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" Class="nav-item__icon" />
                                <span>Libro de Novedades</span>
                                <MudIcon Icon="@(_libroNovedadesExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                         Size="Size.Small" Class="nav-section__chevron" />
                            </button>
                            @if (_libroNovedadesExpanded)
                            {
                                @* El LIBRO en sí vive en el hub /informes (es una consulta con
                                   rango de fechas y Excel; regla del 18/08/2026: un informe tiene
                                   una sola entrada). Acá quedan los dos ítems operativos. *@
                                <div class="nav-section__items nav-section__items--sub">
                                    <a href="/envio-correos"
                                       class="nav-item @(Nav.Uri.Contains("envio-correos") ? "nav-item--active" : "")"
                                       @onclick="ToggleDrawer">
                                        <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Envío de correos</span>
                                    </a>
                                    <a href="/correos-destinatarios"
                                       class="nav-item @(Nav.Uri.Contains("correos-destinatarios") ? "nav-item--active" : "")"
                                       @onclick="ToggleDrawer">
                                        <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Correos Electrónicos Parámetros</span>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="nav-divider"></div>

                }

                @if (Permisos.Tiene('V'))
                {
                @* ── VEHÍCULOS Y CHOFERES ── (el hub lo llama "Flota": mismo módulo, letra V) *@
                <div class="nav-section" style="--nt-mod:@InformesCatalogo.Color(ModuloInforme.Flota)">
                    <button class="nav-section__title @(_vehiculosExpanded ? "nav-section__title--open" : "")"
                            @onclick="() => _vehiculosExpanded = !_vehiculosExpanded">
                        <MudIcon Icon="@Icons.Material.Filled.AirportShuttle" Size="Size.Small" Class="nav-section__icon" />
                        <span>Vehículos y Choferes</span>
                        <MudIcon Icon="@(_vehiculosExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                 Size="Size.Small" Class="nav-section__chevron" />
                    </button>
                    @if (_vehiculosExpanded)
                    {
                        <div class="nav-section__items">
                            <a href="/choferes"
                               class="nav-item @(Nav.Uri.Contains("choferes") ? "nav-item--active" : "")"
                               @onclick="ToggleDrawer">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="nav-item__icon" />
                                <span>Choferes</span>
                            </a>
                            @* Apercibimientos — submenú nivel 3 *@
                            <button class="nav-section__title nav-section__title--sub nav-section__title--soon @(_apercibimientosExpanded ? "nav-section__title--open" : "")"
                                    @onclick="() => _apercibimientosExpanded = !_apercibimientosExpanded">
                                <MudIcon Icon="@Icons.Material.Filled.GppBad" Size="Size.Small" Class="nav-item__icon" />
                                <span>Apercibimientos</span>
                                <MudIcon Icon="@(_apercibimientosExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                         Size="Size.Small" Class="nav-section__chevron" />
                            </button>
                            @if (_apercibimientosExpanded)
                            {
                                <div class="nav-section__items nav-section__items--sub">
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Apercibimientos</span>
                                    </span>
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.List" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Motivos</span>
                                    </span>
                                </div>
                            }
                            @* Capacitaciones — submenú nivel 3 *@
                            <button class="nav-section__title nav-section__title--sub nav-section__title--soon @(_capacitacionesExpanded ? "nav-section__title--open" : "")"
                                    @onclick="() => _capacitacionesExpanded = !_capacitacionesExpanded">
                                <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Small" Class="nav-item__icon" />
                                <span>Capacitaciones</span>
                                <MudIcon Icon="@(_capacitacionesExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                         Size="Size.Small" Class="nav-section__chevron" />
                            </button>
                            @if (_capacitacionesExpanded)
                            {
                                <div class="nav-section__items nav-section__items--sub">
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Consulta</span>
                                    </span>
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.LibraryAdd" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Armado de capacitaciones</span>
                                    </span>
                                </div>
                            }
                            <a href="/odometros"
                               class="nav-item @(Nav.Uri.Contains("odometros") ? "nav-item--active" : "")"
                               @onclick="ToggleDrawer">
                                <MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Small" Class="nav-item__icon" />
                                <span>Odómetros</span>
                            </a>
                            <a href="/siniestros"
                               class="nav-item @(Nav.Uri.Contains("siniestros") ? "nav-item--active" : "")"
                               @onclick="ToggleDrawer">
                                <MudIcon Icon="@Icons.Material.Filled.CarCrash" Size="Size.Small" Class="nav-item__icon" />
                                <span>Siniestros</span>
                            </a>
                            <a href="/vehiculos"
                               class="nav-item @(Nav.Uri.Contains("/vehiculos") ? "nav-item--active" : "")"
                               @onclick="ToggleDrawer">
                                <MudIcon Icon="@Icons.Material.Filled.DirectionsBus" Size="Size.Small" Class="nav-item__icon" />
                                <span>Vehículos - Flota</span>
                            </a>
                            <a href="/fleteros"
                               class="nav-item @(Nav.Uri.Contains("fleteros") ? "nav-item--active" : "")"
                               @onclick="ToggleDrawer">
                                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Small" Class="nav-item__icon" />
                                <span>Fleteros</span>
                            </a>
                            <a href="/tipos-vehiculo"
                               class="nav-item @(Nav.Uri.Contains("tipos-vehiculo") ? "nav-item--active" : "")"
                               @onclick="ToggleDrawer">
                                <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" Class="nav-item__icon" />
                                <span>Tipo de Vehículos</span>
                            </a>
                        </div>
                    }
                </div>

                <div class="nav-divider"></div>

                }

