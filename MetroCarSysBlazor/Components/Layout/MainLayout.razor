@inherits LayoutComponentBase
@inject NorturAuthStateProvider AuthState
@inject IPermissionService Permisos
@inject NavigationManager Nav
@inject IJSRuntime JS

<MudThemeProvider Theme="NorturTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>

        @* ── Overlay backdrop (cierra el drawer al clickear afuera) ── *@
        @if (_drawerOpen)
        {
            <div class="nav-backdrop" @onclick="ToggleDrawer"></div>
        }

        @* ── Drawer lateral — FUERA del MudLayout para posición fixed real ── *@
        <div class="nav-drawer @(_drawerOpen ? "nav-drawer--open" : "")">

            <div class="nav-drawer__header">
                <img src="images/logo.png" alt="NORTUR" style="height:20px; filter:brightness(0) invert(1);" />
                <span class="nav-drawer__subtitle">Informes y Reportes</span>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               Style="color:white; margin-left:auto;"
                               OnClick="ToggleDrawer" />
            </div>

            <nav class="nav-drawer__nav">

                @* Aviso: todas las secciones arrancan colapsadas — el usuario abre la que necesite. *@
                <div class="nav-hint">
                    <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Small" Class="nav-hint__icon" />
                    <span>Tocá una sección para abrirla</span>
                </div>

                @* Visibilidad por módulo del usuario (letra en usuario.acceso) —
                   mismo comportamiento que el SKIP FOR del menú FoxPro. *@

                @if (Permisos.Tiene('R'))
                {
                @* ── RESERVAS ── *@
                <div class="nav-section">
                    <button class="nav-section__title @(_reservasExpanded ? "nav-section__title--open" : "")"
                            @onclick="() => _reservasExpanded = !_reservasExpanded">
                        <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Small" Class="nav-section__icon" />
                        <span>Reservas</span>
                        <MudIcon Icon="@(_reservasExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                 Size="Size.Small" Class="nav-section__chevron" />
                    </button>
                    @if (_reservasExpanded)
                    {
                        <div class="nav-section__items">
                            <span class="nav-item nav-item--disabled">
                                <MudIcon Icon="@Icons.Material.Filled.AddBox" Size="Size.Small" Class="nav-item__icon" />
                                <span>Reservas Especiales</span>
                            </span>
                            <span class="nav-item nav-item--disabled">
                                <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Class="nav-item__icon" />
                                <span>Reservas por Plantillas</span>
                            </span>
                            <span class="nav-item nav-item--disabled">
                                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Class="nav-item__icon" />
                                <span>Clientes</span>
                            </span>
                            <span class="nav-item nav-item--disabled">
                                <MudIcon Icon="@Icons.Material.Filled.SupportAgent" Size="Size.Small" Class="nav-item__icon" />
                                <span>Operadores</span>
                            </span>
                            <span class="nav-item nav-item--disabled">
                                <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Class="nav-item__icon" />
                                <span>Grupos</span>
                            </span>
                            <span class="nav-item nav-item--disabled">
                                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="nav-item__icon" />
                                <span>Destinos</span>
                            </span>
                            @* Plantillas — submenú nivel 3 *@
                            <button class="nav-section__title nav-section__title--sub @(_plantillasExpanded ? "nav-section__title--open" : "")"
                                    @onclick="() => _plantillasExpanded = !_plantillasExpanded">
                                <MudIcon Icon="@Icons.Material.Filled.Article" Size="Size.Small" Class="nav-item__icon" />
                                <span>Plantillas</span>
                                <MudIcon Icon="@(_plantillasExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                         Size="Size.Small" Class="nav-section__chevron" />
                            </button>
                            @if (_plantillasExpanded)
                            {
                                <div class="nav-section__items nav-section__items--sub">
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.NoteAdd" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Crear Plantillas</span>
                                    </span>
                                    <span class="nav-item nav-item--disabled">
                                        <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" Class="nav-item__icon" />
                                        <span>Mantenimiento Plantillas</span>
                                    </span>
                                </div>
                            }
