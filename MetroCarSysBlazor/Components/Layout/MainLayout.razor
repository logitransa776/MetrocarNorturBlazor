                    <button class="nav-section__title @(_vehiculosExpanded ? "nav-section__title--open" : "")"
                            @onclick="() => _vehiculosExpanded = !_vehiculosExpanded">
                        <MudIcon Icon="@Icons.Material.Filled.AirportShuttle" Size="Size.Small" Class="nav-section__icon" />
                        <span>Vehículos y Choferes</span>
                        <MudIcon Icon="@(_vehiculosExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                 Size="Size.Small" Class="nav-section__chevron" />
