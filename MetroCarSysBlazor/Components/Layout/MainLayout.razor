@code {
    private bool _drawerOpen = false;

    // Secciones principales — todas colapsadas al entrar (cualquier usuario)
    private bool _reservasExpanded = false;
    private bool _traficoExpanded = false;
    private bool _vehiculosExpanded = false;
    private bool _facturacionExpanded = false;
    private bool _tallerExpanded = false;
    private bool _combustibleExpanded = false;
    private bool _abmExpanded = false;
    private bool _utilitariosExpanded = false;
    private bool _sistemaExpanded = true;   // Sistema va primero y arranca abierta (Usuarios y Permisos a la vista)
    private bool _informesExpanded = false; // Informes — sección transversal, al pie del drawer

    // Submódulos abiertos dentro de Informes (Reservas, Tráfico, Flota…) — se generan
    // desde InformesCatalogo, así que el estado no puede ser un bool por sección.
    private readonly HashSet<ModuloInforme> _informesModulosAbiertos = new();

    private void AlternarModuloInformes(ModuloInforme modulo)
    {
        if (!_informesModulosAbiertos.Remove(modulo))
            _informesModulosAbiertos.Add(modulo);
    }

    // Submenús nivel 3 — Reservas
    private bool _plantillasExpanded = false;

    // Submenús nivel 3 — Tráfico
    private bool _francosExpanded = false;
    private bool _viaticosExpanded = false;
    private bool _contactosExpanded = false;
    private bool _adicionalesStockExpanded = false;
    private bool _libroNovedadesExpanded = false;

    // Submenús nivel 3 — Vehículos y Choferes
    private bool _apercibimientosExpanded = false;
    private bool _capacitacionesExpanded = false;

    // Submenús nivel 3 — Facturación
    private bool _factuCliExpanded = false;
    private bool _tarifaVentaExpanded = false;
    private bool _tarifaChofExpanded = false;
    private bool _adicionalesExpanded = false;
    private bool _liquidChofExpanded = false;

    // Submenús nivel 3 — Taller
    private bool _stockExpanded = false;
    private bool _chequeoExpanded = false;
    private bool _articulosExpanded = false;

    // Submenús nivel 3 — Combustible
    private bool _depositosExpanded = false;

    // Submenús nivel 3 — ABM del sistema
    private bool _parametrosExpanded = false;
    private bool _abmFacturacionExpanded = false;

    // Submenús nivel 3 — Utilitarios
    private bool _reparacionesExpanded = false;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    // ── Título dinámico del AppBar: nombre de la pantalla actual ──
    // El layout NO se re-renderiza solo al navegar → suscripción a LocationChanged
    // (y desuscripción en Dispose para no fugar el circuito SignalR).
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;

        ActualizarReloj();
        _relojTimer = new System.Threading.Timer(
            _ => InvokeAsync(() => { ActualizarReloj(); StateHasChanged(); }),
            null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    // ── Reloj de cabecera — fecha corta (día abreviado) + hora 24hs sin segundos ──
    private static readonly string[] DiasAbrev = { "dom.", "lun.", "mar.", "mié.", "jue.", "vie.", "sáb." };
    private string _relojFecha = "";
    private string _relojHora = "";
    private System.Threading.Timer? _relojTimer;

    private void ActualizarReloj()
    {
        var ahora = DateTime.Now;
        _relojFecha = $"{DiasAbrev[(int)ahora.DayOfWeek]} {ahora:dd/MM/yyyy}";
        _relojHora = ahora.ToString("HH:mm");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        _relojTimer?.Dispose();
    }

    // Mapa ruta → nombre de pantalla (mismos textos que el drawer). En Home (o
    // ruta desconocida) se muestra el texto institucional de siempre.
    // Títulos de las pantallas OPERATIVAS (ABMs, catálogos, operación). Los títulos de
    // los INFORMES no se repiten acá: salen de InformesCatalogo.TitulosPorRuta, que es
    // la fuente única (mismo nombre en la barra, en el drawer y en el hub /informes).
    /// <summary>
    /// Las pantallas operativas (las que NO son informes): su título para la barra y el
    /// módulo al que pertenecen. El módulo alimenta el filete de color de la barra —
    /// por eso va acá y no en un segundo diccionario: una ruta, un solo lugar donde
    /// declararla. Los informes NO se repiten acá: los resuelve InformesCatalogo, que
    /// ya sabe el título y el módulo de cada uno.
    /// <c>null</c> en el módulo = pantalla transversal, sin color de módulo (el hub).
    /// </summary>
    private sealed record Pantalla(string Titulo, ModuloInforme? Modulo);

