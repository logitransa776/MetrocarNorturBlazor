@inject ReportService Reports
@inject AbmService Abm

@* ───────────────────────────────────────────────────────────────────────────────
   Carga de combustible — réplica de vehiculo_combustible_carga_sobre. Un solo dialog con
   4 modos: "ver" / "alta" / "modifica" / "baja".

   ⚠ ANDAMIAJE (07/07/2026): la ESCRITURA está construida (AbmService.*CargaCombustibleAsync)
   pero el botón Grabar está DESHABILITADO — vehiculo_sobre es la tabla VIVA del módulo (dueño
   FoxPro, sync viva). Se activa el día del corte con ConciliacionCombustibleAbmActivo=true.
   ─────────────────────────────────────────────────────────────────────────────── *@

<MudDialog Class="zoom-viaje-dialog cli-dialog nortur-ficha">
    <TitleContent>
        <div class="zoom-title-bar" style="width:100%; display:flex; align-items:center;">
            <MudIcon Icon="@_icono" Class="me-2" Style="color:#F99410;" />
            <span class="zoom-title-bar__text">@_titulo</span>
            <span class="zoom-title-bar__chip" style="margin-left:10px;">@_chip</span>
            @if (!string.IsNullOrEmpty(_encabezado))
            {
                <span class="zoom-title-bar__nro">@_encabezado</span>
            }
            <span style="flex:1;"></span>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                           Style="color:rgba(255,255,255,0.85); margin:-4px -6px -4px 0;"
                           title="Cerrar" OnClick="Cerrar" />
        </div>
    </TitleContent>

    <DialogContent>
        @if (_cargando)
        {
            <div class="d-flex justify-center align-center" style="min-height:200px;">
                <MudProgressCircular Indeterminate="true" Style="color:#003AA0;" />
            </div>
        }
        else if (_noExiste)
        {
            <MudAlert Severity="Severity.Warning" Class="my-2">La carga ya no existe.</MudAlert>
        }
        else
        {
            @if (SoloEscritura && !_abmActivo)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    <b>Vista previa del ABM.</b> La carga de combustible todavía se hace en FoxPro;
                    esta pantalla queda lista para activarse el día que la tabla pase a Buslink.
                </MudAlert>
            }
            @if (_model.Conciliada && !EsAlta)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                    Carga conciliada en el lote <b>@_model.NSobre</b> — modificarla o darla de baja afecta ese sobre.
                </MudAlert>
            }
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
            }

            @* ── Vehículo / estación ── *@
            <div class="zoom-box zoom-box--sec">
                <span class="zoom-box__label">Vehículo y estación</span>
                <div class="zoom-row pa-2">
                    <div class="zoom-field zoom-field--sm">
                        <div class="zoom-field__label">Interno</div>
                        @if (SoloEscritura)
                        {
                            <MudNumericField @bind-Value="_model.Interno" Min="0" HideSpinButtons="true"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                        }
                        else { <div class="zoom-field__value zoom-field__value--acento">@_model.InternoNT</div> }
                    </div>
                    <div class="zoom-field zoom-field--2">
                        <div class="zoom-field__label">Dominio</div>
                        @if (SoloEscritura)
                        {
                            <MudTextField @bind-Value="_model.Dominio" MaxLength="20" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Style="text-transform:uppercase;" />
                        }
                        else { <div class="zoom-field__value" title="@_model.Dominio">@V(_model.Dominio)</div> }
                    </div>
                    <div class="zoom-field zoom-field--3">
                        <div class="zoom-field__label">Estación</div>
                        @if (SoloEscritura)
                        {
                            <MudSelect T="int" @bind-Value="_model.EstacionId" Dense="true"
                                       Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var e in _estaciones)
                                {
                                    <MudSelectItem T="int" Value="@e.Id">@e.Nombre</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else { <div class="zoom-field__value" title="@_model.Estacion">@V(_model.Estacion)</div> }
                    </div>
                    <div class="zoom-field zoom-field--2">
                        <div class="zoom-field__label">Tipo combustible</div>
                        @if (SoloEscritura)
                        {
                            <MudSelect T="string" @bind-Value="_model.TipoCarga" Dense="true"
                                       Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var a in _articulos)
                                {
                                    <MudSelectItem T="string" Value="@a">@a</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else { <div class="zoom-field__value">@V(_model.TipoCarga)</div> }
                    </div>
                </div>
            </div>

            @* ── Carga ── *@
            <div class="zoom-box zoom-box--sec">
                <span class="zoom-box__label">Datos de la carga</span>
                <div class="zoom-row pa-2">
                    <div class="zoom-field zoom-field--2">
                        <div class="zoom-field__label">Fecha</div>
                        @if (SoloEscritura)
                        {
                            <MudDatePicker @bind-Date="_fecha" DateFormat="dd/MM/yyyy"
                                           PickerVariant="PickerVariant.Dialog" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        }
                        else { <div class="zoom-field__value">@_model.FCarga.ToString("dd/MM/yyyy")</div> }
                    </div>
                    <div class="zoom-field zoom-field--sm">
                        <div class="zoom-field__label">Hora</div>
                        @if (SoloEscritura)
                        {
                            <MudTextField @bind-Value="_model.Hora" MaxLength="5" Placeholder="HH:mm"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                        }
                        else { <div class="zoom-field__value">@V(_model.Hora)</div> }
                    </div>
                    <div class="zoom-field zoom-field--2">
                        <div class="zoom-field__label">Odómetro</div>
                        @if (SoloEscritura)
                        {
                            <MudNumericField @bind-Value="_model.Odometro" Min="0" HideSpinButtons="true"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                        }
                        else { <div class="zoom-field__value">@_model.Odometro.ToString("N0", _ar)</div> }
                    </div>
                    <div class="zoom-field zoom-field--sm">
                        <div class="zoom-field__label">Litros</div>
                        @if (SoloEscritura)
                        {
                            <MudNumericField @bind-Value="_model.Litros" Min="0" Format="0.00" HideSpinButtons="true"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                        }
                        else { <div class="zoom-field__value">@_model.Litros.ToString("N2", _ar)</div> }
                    </div>
                    <div class="zoom-field zoom-field--sm">
                        <div class="zoom-field__label">Lleno</div>
                        @if (SoloEscritura)
                        {
                            <MudCheckBox @bind-Value="_model.Lleno" Color="Color.Primary" Size="Size.Small" Dense="true" Label="Sí" />
                        }
                        else { <div class="zoom-field__value">@(_model.Lleno ? "LLENO" : "PARCIAL")</div> }
                    </div>
                </div>
                <div class="zoom-row pa-2">
                    <div class="zoom-field zoom-field--sm">
                        <div class="zoom-field__label">Importe</div>
                        @if (SoloEscritura)
                        {
                            <MudNumericField @bind-Value="_model.Importe" Min="0" Format="0.00" HideSpinButtons="true"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                        }
                        else { <div class="zoom-field__value">@(_model.Importe > 0 ? _model.Importe.ToString("C2", _ar) : "—")</div> }
                    </div>
                    <div class="zoom-field zoom-field--2">
                        <div class="zoom-field__label">Forma de pago</div>
                        @if (SoloEscritura)
                        {
                            <MudSelect T="string" @bind-Value="_model.FPago" Dense="true"
                                       Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var f in _formasPago)
                                {
                                    <MudSelectItem T="string" Value="@f">@f</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else { <div class="zoom-field__value">@V(_model.FPago)</div> }
                    </div>
                    <div class="zoom-field zoom-field--3">
                        <div class="zoom-field__label">Chofer</div>
                        @if (SoloEscritura)
                        {
                            <MudTextField @bind-Value="_model.Chofer" MaxLength="15" Placeholder="SIN CHOFER"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                        }
                        else { <div class="zoom-field__value" title="@_model.Chofer">@V(_model.Chofer)</div> }
                    </div>
                    <div class="zoom-field zoom-field--sm">
                        <div class="zoom-field__label">Lote</div>
                        <div class="zoom-field__value">@(_model.Conciliada ? _model.NSobre.ToString() : "—")</div>
                    </div>
                </div>
            </div>

            @if (!EsAlta && (!string.IsNullOrEmpty(_model.UCreate) || !string.IsNullOrEmpty(_model.UModify)))
            {
                <div class="zoom-box zoom-box--sec">
                    <span class="zoom-box__label">Auditoría</span>
                    <div class="zoom-row pa-2">
                        <div class="zoom-field zoom-field--2">
                            <div class="zoom-field__label">Creó</div>
                            <div class="zoom-field__value">@V(_model.UCreate) @(_model.FCreate is DateTime fc ? $"· {fc:dd/MM/yyyy HH:mm}" : "")</div>
                        </div>
                        <div class="zoom-field zoom-field--2">
                            <div class="zoom-field__label">Modificó</div>
                            <div class="zoom-field__value">@V(_model.UModify) @(_model.FModify is DateTime fm ? $"· {fm:dd/MM/yyyy HH:mm}" : "")</div>
                        </div>
                    </div>
                </div>
            }

            @* ── Botonera ── *@
            <div class="cli-footer">
                <div class="cli-footer__hint">
                    <MudIcon Icon="@(SoloEscritura && _abmActivo ? Icons.Material.Filled.Edit : Icons.Material.Filled.Lock)" Size="Size.Small" />
                    @(SoloEscritura && !_abmActivo
                        ? "Escritura preparada · pendiente de activar en Buslink"
                        : SoloEscritura ? "Edición habilitada" : "Vista de solo lectura")
                </div>
                <div class="cli-footer__btns">
                    @if (EsAlta)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Save" OnClick="Grabar" Disabled="!_abmActivo || _grabando">
                            @(_grabando ? "Grabando…" : "Agregar")
                        </MudButton>
                    }
                    else if (EsModifica)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Save" OnClick="Grabar" Disabled="!_abmActivo || _grabando">
                            @(_grabando ? "Grabando…" : "Modificar")
                        </MudButton>
                    }
                    else if (EsBaja)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Delete" OnClick="Grabar" Disabled="!_abmActivo || _grabando">
                            @(_grabando ? "Procesando…" : "Eliminar carga")
                        </MudButton>
                    }
                    <MudButton Variant="@(SoloLectura ? Variant.Filled : Variant.Text)"
                               Color="@(SoloLectura ? Color.Primary : Color.Default)" Size="Size.Small"
                               OnClick="Cerrar">@(SoloLectura ? "Cerrar" : "Cancelar")</MudButton>
                </div>
            </div>
        }
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Modo { get; set; } = "ver";
    [Parameter] public int Id { get; set; }

    private static bool _abmActivo => AbmFeatureFlags.ConciliacionCombustibleAbmActivo;

    private readonly System.Globalization.CultureInfo _ar =
        System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    private CargaCombustibleDetalleDto _model = new();
    private DateTime? _fecha = DateTime.Today;
    private List<EstacionCombustibleRow> _estaciones = new();
    private readonly List<string> _articulos = new() { "DIESEL 500", "EURO-DIESEL" };
    private readonly List<string> _formasPago = new()
    { "TARJETA PREPAGO", "CUENTA CORRIENTE", "EFECTIVO", "TARJETA DE CREDITO", "AUDITOR", "OTRA" };

    private bool _cargando = true, _grabando, _noExiste;
    private string? _error;

    private bool EsAlta => Modo == "alta";
    private bool EsModifica => Modo == "modifica";
    private bool EsBaja => Modo == "baja";
    private bool SoloLectura => Modo == "ver" || EsBaja;
    private bool SoloEscritura => EsAlta || EsModifica;

    private string _titulo => EsAlta ? "Alta de carga" : EsModifica ? "Modificar carga"
        : EsBaja ? "Eliminar carga" : "Datos de la carga";
    private string _chip => EsAlta ? "Nueva" : EsModifica ? "Edición" : EsBaja ? "Baja física" : "Solo lectura";
    private string _encabezado => EsAlta ? "" : $"{_model.Dominio} · {_model.FCarga:dd/MM/yyyy}";
    private string _icono => EsAlta ? Icons.Material.Filled.AddCircle
        : EsBaja ? Icons.Material.Filled.RemoveCircle : Icons.Material.Filled.LocalGasStation;

    protected override async Task OnInitializedAsync()
    {
        _estaciones = await Reports.GetEstacionesCombustibleAsync();

        if (EsAlta)
        {
            _model = new CargaCombustibleDetalleDto
            {
                FCarga = DateOnly.FromDateTime(DateTime.Today),
                Hora = DateTime.Now.ToString("HH:mm"),
                TipoCarga = _articulos[0],
                FPago = _formasPago[0],
                Lleno = true,
                IdRubro = 1,
            };
            _fecha = DateTime.Today;
            _cargando = false;
            return;
        }

        var d = await Reports.GetCargaCombustibleRowAsync(Id);
        if (d is null) { _noExiste = true; _cargando = false; return; }
        _model = d;
        _fecha = d.FCarga.ToDateTime(TimeOnly.MinValue);
        _cargando = false;
    }

    private async Task Grabar()
    {
        if (!_abmActivo)
        {
            _error = "La escritura de cargas todavía no está habilitada (sigue en FoxPro).";
            return;
        }
        _error = null; _grabando = true;

        if (EsBaja)
        {
            Finalizar(await Abm.BajaCargaCombustibleAsync(Id));
            return;
        }

        var estacionNombre = _estaciones.FirstOrDefault(e => e.Id == _model.EstacionId)?.Nombre ?? _model.Estacion;
        var input = new CargaCombustibleInput(
            _model.Interno, _model.Dominio, _model.IdRubro <= 0 ? 1 : _model.IdRubro, _model.EstacionId,
            estacionNombre, _model.TipoCarga, DateOnly.FromDateTime(_fecha ?? DateTime.Today), _model.Hora,
            _model.Chofer, _model.Odometro, _model.Litros, _model.Importe, _model.Lleno, _model.DosCarga,
            _model.FPago, CurrentUsuario());

        Finalizar(EsAlta
            ? await Abm.AltaCargaCombustibleAsync(input)
            : await Abm.ModificaCargaCombustibleAsync(Id, input));
    }

    private void Finalizar(AbmService.AbmResult r)
    {
        _grabando = false;
        if (r.Ok) MudDialog.Close(DialogResult.Ok(true));
        else { _error = r.Error; StateHasChanged(); }
    }

    private void Cerrar() => MudDialog.Close(DialogResult.Ok(false));

    private static string CurrentUsuario() => "BUSLINK";   // reemplazar por el usuario logueado al activar
    private static string V(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;
}
