@inject ReportService Reports
@inject AbmService Abm

@* ───────────────────────────────────────────────────────────────────────────────
   Fila de plantilla — réplica de reserva_plantilla_mantenimiento_abm.scx. 4 modos:
   "ver" | "alta" | "modifica" | "baja". Baja FÍSICA. ANDAMIAJE: Grabar apagado por
   AbmFeatureFlags.PlantillasAbmActivo (hoy false). Plano: RESERVA_PLANTILLAS.md.
   ─────────────────────────────────────────────────────────────────────────────── *@

<MudDialog Class="zoom-viaje-dialog cli-dialog nortur-ficha">
    <TitleContent>
        <div class="zoom-title-bar" style="width:100%; display:flex; align-items:center;">
            <MudIcon Icon="@_icono" Class="me-2" Style="color:#F99410;" />
            <span class="zoom-title-bar__text">@_titulo</span>
            <span class="zoom-title-bar__chip" style="margin-left:10px;">@_chip</span>
            <span style="flex:1;"></span>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                           Style="color:rgba(255,255,255,0.85); margin:-4px -6px -4px 0;"
                           title="Cerrar" OnClick="Cerrar" />
        </div>
    </TitleContent>

    <DialogContent>
        @if (_cargando)
        {
            <div class="d-flex justify-center align-center" style="min-height:160px;">
                <MudProgressCircular Indeterminate="true" Style="color:#003AA0;" />
            </div>
        }
        else if (_noExiste)
        {
            <MudAlert Severity="Severity.Warning" Class="my-2">La fila de plantilla ya no existe.</MudAlert>
        }
        else
        {
            @if (SoloEscritura && !_abmActivo)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    <b>Vista previa del ABM.</b> El mantenimiento de plantillas todavía se hace en FoxPro;
                    esta pantalla se activa el día que la tabla pase a Buslink.
                </MudAlert>
            }
            @if (EsBaja)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                    Baja <b>física</b>: la fila se elimina definitivamente (así lo hace el FoxPro).
                </MudAlert>
            }
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
            }

            <div class="zoom-box zoom-box--sec">
                <span class="zoom-box__label">Plantilla @_idReserva</span>
                <div class="zoom-row pa-2">
                    <div class="zoom-field zoom-field--sm">
                        <div class="zoom-field__label">Hora inicio</div>
                        @if (SoloEscritura) { <MudTextField @bind-Value="_horaIni" Placeholder="HH:mm" MaxLength="5" Variant="Variant.Outlined" Margin="Margin.Dense" /> }
                        else { <div class="zoom-field__value">@V(_horaIni)</div> }
                    </div>
                    <div class="zoom-field zoom-field--sm">
                        <div class="zoom-field__label">Hora fin</div>
                        @if (SoloEscritura) { <MudTextField @bind-Value="_horaFin" Placeholder="HH:mm" MaxLength="5" Variant="Variant.Outlined" Margin="Margin.Dense" /> }
                        else { <div class="zoom-field__value">@V(_horaFin)</div> }
                    </div>
                    <div class="zoom-field zoom-field--2">
                        <div class="zoom-field__label">Servicio</div>
                        @if (SoloEscritura)
                        {
                            <MudSelect T="string" @bind-Value="_idServicio" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var s in _servicios) { <MudSelectItem T="string" Value="@s.IdServici">@s.Nombre</MudSelectItem> }
                            </MudSelect>
                        }
                        else { <div class="zoom-field__value" title="@_servicioNombre">@V(_servicioNombre)</div> }
                    </div>
                    <div class="zoom-field zoom-field--sm">
                        <div class="zoom-field__label">T. Vehículo</div>
                        @if (SoloEscritura)
                        {
                            <MudSelect T="string" @bind-Value="_tipoVeh" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var v in _tiposVeh) { <MudSelectItem T="string" Value="@v.Id">@v.Nombre</MudSelectItem> }
                            </MudSelect>
                        }
                        else { <div class="zoom-field__value">@V(_tipoVeh)</div> }
                    </div>
                </div>
                <div class="zoom-row pa-2">
                    <div class="zoom-field zoom-field--3">
                        <div class="zoom-field__label">Desde</div>
                        @if (SoloEscritura) { <MudTextField @bind-Value="_desde" MaxLength="70" Variant="Variant.Outlined" Margin="Margin.Dense" Style="text-transform:uppercase;" /> }
                        else { <div class="zoom-field__value" title="@_desde">@V(_desde)</div> }
                    </div>
                    <div class="zoom-field zoom-field--3">
                        <div class="zoom-field__label">Hasta</div>
                        @if (SoloEscritura) { <MudTextField @bind-Value="_hasta" MaxLength="70" Variant="Variant.Outlined" Margin="Margin.Dense" Style="text-transform:uppercase;" /> }
                        else { <div class="zoom-field__value" title="@_hasta">@V(_hasta)</div> }
                    </div>
                    <div class="zoom-field zoom-field--2">
                        <div class="zoom-field__label">Empresa destino</div>
                        @if (SoloEscritura) { <MudTextField @bind-Value="_empresaDestino" MaxLength="50" Variant="Variant.Outlined" Margin="Margin.Dense" Style="text-transform:uppercase;" /> }
                        else { <div class="zoom-field__value" title="@_empresaDestino">@V(_empresaDestino)</div> }
                    </div>
                </div>
                <div class="zoom-row pa-2">
                    <div class="zoom-field zoom-field--sm">
                        <div class="zoom-field__label">Pax</div>
                        @if (SoloEscritura) { <MudNumericField @bind-Value="_pax" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" /> }
                        else { <div class="zoom-field__value">@_pax</div> }
                    </div>
                    <div class="zoom-field zoom-field--sm">
                        <div class="zoom-field__label">Km</div>
                        @if (SoloEscritura) { <MudNumericField @bind-Value="_km" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" /> }
                        else { <div class="zoom-field__value">@_km</div> }
                    </div>
                    <div class="zoom-field zoom-field--sm">
                        <div class="zoom-field__label">Horas</div>
                        @if (SoloEscritura) { <MudNumericField @bind-Value="_hs" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" /> }
                        else { <div class="zoom-field__value">@_hs</div> }
                    </div>
                    <div class="zoom-field zoom-field--sm">
                        <div class="zoom-field__label">Cabecera</div>
                        @if (SoloEscritura) { <MudTextField @bind-Value="_cabecera" MaxLength="15" Variant="Variant.Outlined" Margin="Margin.Dense" Style="font-family:monospace; text-transform:uppercase;" /> }
                        else { <div class="zoom-field__value" style="font-family:monospace;">@V(_cabecera)</div> }
                    </div>
                    <div class="zoom-field zoom-field--sm">
                        <div class="zoom-field__label">Provincia/Distrito</div>
                        @if (SoloEscritura) { <MudTextField @bind-Value="_provincia" MaxLength="20" Variant="Variant.Outlined" Margin="Margin.Dense" Style="text-transform:uppercase;" /> }
                        else { <div class="zoom-field__value">@V(_provincia)</div> }
                    </div>
                </div>
                <div class="zoom-row pa-2">
                    <div class="zoom-field zoom-field--2">
                        <div class="zoom-field__label">Recorrido celular</div>
                        @if (SoloEscritura) { <MudTextField @bind-Value="_recorrido" MaxLength="30" Variant="Variant.Outlined" Margin="Margin.Dense" Style="text-transform:uppercase;" /> }
                        else { <div class="zoom-field__value" title="@_recorrido">@V(_recorrido)</div> }
                    </div>
                    <div class="zoom-field zoom-field--2">
                        <div class="zoom-field__label">Guía</div>
                        @if (SoloEscritura) { <MudTextField @bind-Value="_guia" MaxLength="60" Variant="Variant.Outlined" Margin="Margin.Dense" Style="text-transform:uppercase;" /> }
                        else { <div class="zoom-field__value" title="@_guia">@V(_guia)</div> }
                    </div>
                    <div class="zoom-field zoom-field--3">
                        <div class="zoom-field__label">Comentario</div>
                        @if (SoloEscritura) { <MudTextField @bind-Value="_comentario" MaxLength="70" Variant="Variant.Outlined" Margin="Margin.Dense" /> }
                        else { <div class="zoom-field__value" title="@_comentario">@V(_comentario)</div> }
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_adicionales))
                {
                    <div class="zoom-row pa-2">
                        <div class="zoom-field zoom-field--3">
                            <div class="zoom-field__label">Adicionales</div>
                            <div class="zoom-field__value">@_adicionales</div>
                        </div>
                    </div>
                }
            </div>

            <div class="cli-footer">
                <div class="cli-footer__hint">
                    <MudIcon Icon="@(SoloEscritura && _abmActivo ? Icons.Material.Filled.Edit : Icons.Material.Filled.Lock)" Size="Size.Small" />
                    @(SoloEscritura && !_abmActivo ? "Escritura preparada · pendiente de activar en Buslink"
                        : SoloEscritura ? "Edición habilitada" : "Vista de solo lectura")
                </div>
                <div class="cli-footer__btns">
                    @if (EsAlta)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Save" OnClick="Grabar" Disabled="!_abmActivo || _grabando">
                            @(_grabando ? "Grabando…" : "Agregar")
                        </MudButton>
                    }
                    else if (EsModifica)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Save" OnClick="Grabar" Disabled="!_abmActivo || _grabando">
                            @(_grabando ? "Grabando…" : "Modificar")
                        </MudButton>
                    }
                    else if (EsBaja)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Delete" OnClick="Grabar" Disabled="!_abmActivo || _grabando">
                            @(_grabando ? "Procesando…" : "Eliminar")
                        </MudButton>
                    }
                    <MudButton Variant="@(SoloLectura ? Variant.Filled : Variant.Text)"
                               Color="@(SoloLectura ? Color.Primary : Color.Default)" Size="Size.Small"
                               OnClick="Cerrar">@(SoloLectura ? "Cerrar" : "Cancelar")</MudButton>
                </div>
            </div>
        }
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Modo { get; set; } = "ver";
    [Parameter] public int Id { get; set; }
    [Parameter] public string IdReserva { get; set; } = "";

    private static bool _abmActivo => AbmFeatureFlags.PlantillasAbmActivo;

    private List<ServicioDto> _servicios = new();
    private List<VehiculoTipoDto> _tiposVeh = new();

    private string _idReserva = "", _horaIni = "", _horaFin = "", _idServicio = "", _servicioNombre = "";
    private string _tipoVeh = "", _desde = "", _hasta = "", _empresaDestino = "", _cabecera = "";
    private string _provincia = "", _recorrido = "", _guia = "", _guiaDueno = "", _comentario = "", _adicionales = "", _cronograma = "";
    private int _pax, _km, _hs;
    private bool _cargando = true, _grabando, _noExiste;
    private string? _error;

    private bool EsAlta => Modo == "alta";
    private bool EsModifica => Modo == "modifica";
    private bool EsBaja => Modo == "baja";
    private bool SoloLectura => Modo == "ver" || EsBaja;
    private bool SoloEscritura => EsAlta || EsModifica;

    private string _titulo => EsAlta ? "Agregar fila" : EsModifica ? "Modificar fila" : EsBaja ? "Eliminar fila" : "Fila de plantilla";
    private string _chip => EsAlta ? "Nuevo" : EsModifica ? "Edición" : EsBaja ? "Baja física" : "Solo lectura";
    private string _icono => EsAlta ? Icons.Material.Filled.AddCircle : EsBaja ? Icons.Material.Filled.RemoveCircle : Icons.Material.Filled.Article;

    protected override async Task OnInitializedAsync()
    {
        _servicios = await Reports.GetServiciosAsync();
        _tiposVeh = await Reports.GetVehiculosTipoAsync();
        _idReserva = IdReserva;

        if (EsAlta) { _cargando = false; return; }

        var f = await Reports.GetPlantillaFilaRowAsync(Id);
        if (f is null) { _noExiste = true; _cargando = false; return; }
        _idReserva = f.IdReserva; _horaIni = f.HoraIni; _horaFin = f.HoraFin;
        _idServicio = f.IdServicio; _servicioNombre = f.Servicio; _tipoVeh = f.TipoVeh;
        _desde = f.Desde; _hasta = f.Hasta; _empresaDestino = f.EmpresaDestino; _cabecera = f.Cabecera;
        _provincia = f.Provincia; _recorrido = f.Recorrido; _guia = f.Guia; _guiaDueno = f.GuiaDueno;
        _comentario = f.Comentario; _adicionales = f.Adicionales; _cronograma = f.Cronograma;
        _pax = f.Pax; _km = f.Km; _hs = f.Hs;
        _cargando = false;
    }

    private async Task Grabar()
    {
        if (!_abmActivo)
        {
            _error = "La escritura de plantillas todavía no está habilitada (sigue en FoxPro).";
            return;
        }
        _error = null; _grabando = true;

        if (EsBaja)
        {
            Finalizar(await Abm.BajaPlantillaFilaAsync(Id));
            return;
        }

        var input = new PlantillaFilaInput(
            IdReserva: _idReserva, Cronograma: _cronograma, HoraIni: _horaIni, HoraFin: _horaFin,
            IdServicio: _idServicio, TipoVeh: _tipoVeh, Desde: _desde, Hasta: _hasta,
            Pax: _pax, Km: _km, Hs: _hs, Cabecera: _cabecera, EmpresaDestino: _empresaDestino,
            Recorrido: _recorrido, Provincia: _provincia, IataDesde: "", IataHasta: "", GpsCod: "",
            IdGuia: "", NombreGuia: _guia, GuiaDueno: _guiaDueno, Comentario: _comentario, DiaSiguiente: false);

        Finalizar(EsAlta ? await Abm.AltaPlantillaFilaAsync(input) : await Abm.ModificaPlantillaFilaAsync(Id, input));
    }

    private void Finalizar(AbmService.AbmResult r)
    {
        _grabando = false;
        if (r.Ok) MudDialog.Close(DialogResult.Ok(true));
        else { _error = r.Error; StateHasChanged(); }
    }

    private void Cerrar() => MudDialog.Close(DialogResult.Ok(false));
    private static string V(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;
}
