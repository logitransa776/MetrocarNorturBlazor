@inject ReportService Reports

@* Diálogo "Conductores" del menú Aplicar Filtros de Tráfico.
   Réplica fiel de trafico_filtro_chofer.scx (caption FoxPro: "Buscar reservas por Tipo de
   Estado"): rango de fecha de trabajo (Desde/Hasta + Hoy/Todo), checkbox "Solamente los
   conductores activos" (tildado por defecto) y combo de Conductor (código + nombre).
   Filtra viaje por Between(f_reserva, x1, x2) AND id_chofer = X.
   Devuelve TraficoFiltro(Choferes, desde, hasta, Texto: id_chofer) al aceptar.

   Nota: el form FoxPro tenía además un combo de Fletero como ALTERNATIVA al conductor; en
   Blazor el filtro por fletero ya vive en su propio diálogo (TraficoFiltroFleteroDialog),
   así que este diálogo se enfoca solo en el conductor (la razón del ítem "Conductores"). *@

<MudDialog>
    <DialogContent>
        <div style="min-width:380px;">
            <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color:#003AA0; font-weight:600;">
                Rango de Fecha de Trabajo
            </MudText>

            <div class="d-flex align-center" style="gap:8px;">
                <MudDatePicker @bind-Date="_desde" Label="Desde" DateFormat="dd/MM/yyyy" Editable="true"
                               Culture="@_ar" MinDate="_min" MaxDate="_max"
                               PickerVariant="PickerVariant.Dialog" Style="flex:1;" />
                <MudDatePicker @bind-Date="_hasta" Label="Hasta" DateFormat="dd/MM/yyyy" Editable="true"
                               Culture="@_ar" MinDate="_min" MaxDate="_max"
                               PickerVariant="PickerVariant.Dialog" Style="flex:1;" />
            </div>

            <div class="d-flex mt-1" style="gap:8px;">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="SetHoy">Hoy</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="SetTodo">Todo</MudButton>
            </div>

            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1" Style="color:#003AA0; font-weight:600;">
                Conductor
            </MudText>

            @* Checkbox "Solamente los conductores activos" — réplica de Check1 (tildado por
               defecto). Al cambiarlo se recarga el combo (con/sin el filtro f_delete). *@
            <MudCheckBox T="bool" Value="_soloActivos" ValueChanged="OnSoloActivosChanged"
                         Label="Solamente los conductores activos" Color="Color.Primary"
                         Size="Size.Small" Dense="true" />

            <MudSelect T="string" @bind-Value="_chofer" Label="Conductor" Variant="Variant.Outlined"
                       Dense="true" Class="mt-1" Disabled="_cargandoCombo"
                       AdornmentIcon="@Icons.Material.Filled.Badge" Adornment="Adornment.Start">
                @foreach (var c in _choferes)
                {
                    <MudSelectItem Value="@c.Codigo">@c.Codigo — @c.Nombre</MudSelectItem>
                }
            </MudSelect>

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_error</MudAlert>
            }
            else if (_dias > 31)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                    Rango de @_dias días: la consulta puede tardar y traer muchos servicios.
                </MudAlert>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.FilterAlt" OnClick="Aplicar">Aceptar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Día actualmente mostrado en la planilla; valor inicial de ambas fechas.</summary>
    [Parameter] public DateOnly DiaActual { get; set; }

    /// <summary>Si se abre en modo "editar filtro", trae el filtro vigente para precargar los campos.</summary>
    [Parameter] public TraficoFiltro? FiltroInicial { get; set; }

    private readonly System.Globalization.CultureInfo _ar =
        System.Globalization.CultureInfo.GetCultureInfo("es-AR");
    private readonly DateTime _min = ReportService.FechaMinValida.ToDateTime(TimeOnly.MinValue);
    private readonly DateTime _max = ReportService.FechaMaxValida.ToDateTime(TimeOnly.MinValue);

    private DateTime? _desde;
    private DateTime? _hasta;
    private string? _chofer;
    private bool _soloActivos = true;   // réplica de Check1.Value = .T. (tildado por defecto)
    private List<ChoferOpcion> _choferes = new();
    private bool _cargandoCombo;
    private string? _error;

    private int _dias =>
        _desde is not null && _hasta is not null && _hasta >= _desde
            ? (int)(_hasta.Value.Date - _desde.Value.Date).TotalDays + 1
            : 0;

    protected override async Task OnInitializedAsync()
    {
        if (FiltroInicial is { Tipo: TraficoFiltroTipo.Choferes } f)
        {
            // Modo editar: precargar rango + conductor vigente. Se preselecciona el chofer ANTES de
            // cargar el combo para que CargarChoferes() respete la selección si sigue presente.
            _desde = f.Desde.ToDateTime(TimeOnly.MinValue);
            _hasta = f.Hasta.ToDateTime(TimeOnly.MinValue);
            _chofer = f.Texto;
            await CargarChoferes();
            // Si el chofer editado no está entre los activos, abrir el combo completo para mostrarlo.
            if (_chofer is not null && _choferes.All(c => c.Codigo != _chofer))
            {
                _soloActivos = false;
                await CargarChoferes();
            }
            return;
        }
        var d = DiaActual.ToDateTime(TimeOnly.MinValue);
        _desde = d;
        _hasta = d;
        await CargarChoferes();
    }

    // Recarga el combo según el checkbox "solo activos" (réplica de Check1.Click). Mantiene
    // la selección si el chofer elegido sigue presente en la nueva lista.
    private async Task CargarChoferes()
    {
        _cargandoCombo = true;
        _choferes = await Reports.GetChoferesParaFiltroAsync(_soloActivos);
        if (_chofer is not null && _choferes.All(c => c.Codigo != _chofer))
            _chofer = null;
        _cargandoCombo = false;
    }

    private async Task OnSoloActivosChanged(bool value)
    {
        _soloActivos = value;
        await CargarChoferes();
    }

    // "Hoy": ambas fechas = hoy (un solo día). Réplica de Command1.Click.
    private void SetHoy()
    {
        var hoy = DateTime.Today;
        _desde = hoy;
        _hasta = hoy;
    }

    // "Todo": todo el rango usable de la réplica. Réplica de Command2.Click (01/01/1900–31/12/2099,
    // acá acotado al rango válido de la réplica para evitar fechas corruptas).
    private void SetTodo()
    {
        _desde = _min;
        _hasta = _max;
    }

    private void Aplicar()
    {
        // Validaciones del bAceptar.Click del FoxPro.
        if (_desde is null || _hasta is null) { _error = "Elegí ambas fechas."; return; }
        if (_hasta < _desde) { _error = "La fecha Hasta no puede ser anterior a Desde."; return; }
        if (string.IsNullOrWhiteSpace(_chofer)) { _error = "Elegí un conductor."; return; }

        var filtro = new TraficoFiltro(
            TraficoFiltroTipo.Choferes,
            DateOnly.FromDateTime(_desde.Value),
            DateOnly.FromDateTime(_hasta.Value),
            Texto: _chofer);

        MudDialog.Close(DialogResult.Ok(filtro));
    }

    private void Cancelar() => MudDialog.Cancel();
}
