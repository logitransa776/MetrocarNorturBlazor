<MudPaper Class="pa-0" Elevation="2" Style="@($"height:100%; border-radius:8px; overflow:hidden; border-left:4px solid {Color}; background: linear-gradient(135deg, #ffffff 60%, {Color}18 100%);")">
    <div style="padding:8px 14px; display:flex; align-items:baseline; gap:10px;">
        <span style="font-size:0.78rem; font-weight:800; color:#4A5568; letter-spacing:0.06em; text-transform:uppercase; white-space:nowrap;">@Label</span>
        <span style="@($"font-size:1.25rem; font-weight:900; color:{Color}; white-space:nowrap; letter-spacing:-0.01em;")">@Value</span>
        @if (!string.IsNullOrEmpty(Sub))
        {
            <span style="font-size:0.74rem; font-weight:600; color:#718096; white-space:nowrap;">@Sub</span>
        }
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string? Sub { get; set; }
    [Parameter] public string Color { get; set; } = NorturColors.Azul;
}
