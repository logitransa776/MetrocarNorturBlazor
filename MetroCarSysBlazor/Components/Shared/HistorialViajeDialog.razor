@inject ReportService Reports
@inject ExcelExportService Excel
@inject IJSRuntime JS
@implements IDisposable

@* ───────────────────────────────────────────────────────────────────────────────
   Réplica del form FoxPro `trafico_historial.scx` ("Historia del viaje" del menú
   contextual de Tráfico). Solo lectura.
     · Cabecera (recuadro gris): Creó / Eliminó / Modificó — usuario + fecha (de `viaje`).
     · Grilla: bitácora de `viaje_log` (9 columnas exactas del FoxPro).
     · "Zoon Motivo" (botón + doble-click): abre el comentario completo en grande
       (el FoxPro abría form_error con cursorViajeLog.comentario).
   Extras sobre el original: motivo coloreado, exportar a Excel, fecha+hora completa.
   ─────────────────────────────────────────────────────────────────────────────── *@

<MudDialog Class="zoom-viaje-dialog hist-dialog">
    <TitleContent>
        <div class="zoom-title-bar" style="width:100%; display:flex; align-items:center;">
            <MudIcon Icon="@Icons.Material.Filled.History" Class="me-2" Style="color:#F99410;" />
            <span class="zoom-title-bar__text">Historial del viaje</span>
            <span class="zoom-title-bar__nro">Reserva&nbsp;#@IdViaje</span>
            <span style="flex:1;"></span>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Style="color:rgba(255,255,255,0.85); margin:-4px -6px -4px 0;"
                           title="Cerrar"
                           OnClick="Cerrar" />
        </div>
    </TitleContent>

    <DialogContent>
        @if (_cargando)
        {
            <div class="d-flex justify-center align-center" style="min-height:220px;">
                <MudProgressCircular Indeterminate="true" Style="color:#003AA0;" />
            </div>
        }
        else if (_d is null)
        {
            <MudAlert Severity="Severity.Warning">No se encontró el historial del viaje.</MudAlert>
        }
        else
        {
            @* ── Cabecera de auditoría (recuadro gris del FoxPro) ── *@
            <div class="hist-cab">
                <div class="hist-cab__item">
                    <span class="hist-cab__label">Creador</span>
                    <span class="hist-cab__user">@Dato(_d.UsuarioCreo)</span>
                    <span class="hist-cab__fecha">@Fecha(_d.FechaCreo)</span>
                </div>
                <div class="hist-cab__item">
                    <span class="hist-cab__label">Elimino</span>
                    <span class="hist-cab__user">@Dato(_d.UsuarioElimino)</span>
                    <span class="hist-cab__fecha">@Fecha(_d.FechaElimino)</span>
                </div>
                <div class="hist-cab__item">
                    <span class="hist-cab__label">Ult. Modifico</span>
                    <span class="hist-cab__user">@Dato(_d.UsuarioModifico)</span>
                    <span class="hist-cab__fecha">@Fecha(_d.FechaModifico)</span>
                </div>
            </div>

            @* ── Grilla de movimientos (viaje_log) ── *@
            @if (_d.Movimientos.Count == 0)
            {
                <div class="hist-empty">Esta reserva no tiene movimientos registrados.</div>
            }
            else
            {
                <div class="hist-grid-wrap">
                    <table class="hist-grid">
                        <thead>
                            <tr>
                                <th>Hora</th>
                                <th>Usuario</th>
                                <th>Motivo</th>
                                <th>Chofer</th>
                                <th>Cronograma</th>
                                <th>Cron. Nuevo</th>
                                <th class="r">Int. Orig</th>
                                <th class="r">Int. Nuevo</th>
                                <th>Comentario</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < _d.Movimientos.Count; i++)
                            {
                                var idx = i;
                                var m = _d.Movimientos[idx];
                                <tr class="@(idx == _filaSel ? "hist-row--sel" : "")"
                                    @onclick="() => _filaSel = idx"
                                    @ondblclick="() => AbrirMotivo(m.Comentario)">
                                    <td>@FechaHora(m.Hora)</td>
                                    <td>@m.Usuario</td>
                                    <td><span class="hist-motivo" style="@MotivoStyle(m.Motivo)">@MotivoTexto(m.Motivo)</span></td>
                                    <td>@m.Chofer</td>
                                    <td>@m.Cronograma</td>
                                    <td>@m.CronogramaNuevo</td>
                                    <td class="r">@(m.InternoOrig?.ToString() ?? "")</td>
                                    <td class="r">@(m.InternoNuevo?.ToString() ?? "")</td>
                                    <td class="hist-coment" title="@m.Comentario">@m.Comentario</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </DialogContent>

    <DialogActions>
        @* Botón "Zoon Motivo" del FoxPro: abre el comentario de la fila seleccionada en grande. *@
        <MudButton StartIcon="@Icons.Material.Filled.Subject"
                   Variant="Variant.Outlined"
                   Disabled="@(_d is null || _d.Movimientos.Count == 0)"
                   OnClick="ZoonMotivoSeleccionado">Zoon Motivo</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.GridOn"
                   Variant="Variant.Outlined"
                   Disabled="@(_d is null || _d.Movimientos.Count == 0)"
                   OnClick="ExportarExcel">Exportar a Excel</MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Cerrar">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;

    [Parameter] public int IdViaje { get; set; }

    // Fecha de reserva de la fila que abrió el historial: permite que la cabecera haga SEEK
    // por ix_viaje_f_reserva en vez de scanear toda la tabla viaje (igual que el Zoom).
    [Parameter] public DateOnly? FReserva { get; set; }

    private HistorialViajeDto? _d;
    private bool _cargando = true;
    private int _filaSel = 0;   // fila seleccionada en la grilla (para "Zoon Motivo")
    private readonly System.Globalization.CultureInfo _ar =
        System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    protected override async Task OnInitializedAsync()
    {
        _d = await Reports.GetHistorialViajeAsync(IdViaje, FReserva);
        _cargando = false;
    }

    private void Cerrar() => MudDialog.Close();

    // ── Helpers de formato ──
    private string Dato(string s) => string.IsNullOrWhiteSpace(s) ? "" : s;
    private string Fecha(DateOnly? f) => f is null ? "" : f.Value.ToString("dd/MM/yyyy", _ar);
    // El FoxPro rotula "Hora" pero el dato es datetime → mostramos fecha + hora completas.
    private string FechaHora(DateTime? d) => d is null ? "" : d.Value.ToString("dd/MM/yyyy HH:mm", _ar);

    // ── "Zoon Motivo": abre el comentario completo en un sub-diálogo (réplica de form_error) ──
    private async Task ZoonMotivoSeleccionado()
    {
        if (_d is null || _filaSel < 0 || _filaSel >= _d.Movimientos.Count) return;
        await AbrirMotivo(_d.Movimientos[_filaSel].Comentario);
    }

    private async Task AbrirMotivo(string comentario)
    {
        var parametros = new DialogParameters<TextoZoomDialog>
        {
            { x => x.Titulo, "Zoon" },
            { x => x.Texto, comentario }
        };
        var opciones = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = false,
            CloseOnEscapeKey = true,
            BackdropClick = true
        };
        await DialogService.ShowAsync<TextoZoomDialog>("Zoon", parametros, opciones);
    }

    private async Task ExportarExcel()
    {
        if (_d is null || _d.Movimientos.Count == 0) return;
        var bytes = Excel.HistorialViaje(_d);
        var nombre = $"historial_reserva_{IdViaje}_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("descargarArchivo", nombre, streamRef);
    }

    // ── Color del motivo (valor agregado, no está en el FoxPro) ──
    // Tipifica el movimiento por su semántica en la línea de tiempo del viaje.
    private string MotivoTexto(string m) => string.IsNullOrWhiteSpace(m) ? "—" : m.Trim().ToUpperInvariant();

    private string MotivoStyle(string motivo)
    {
        var m = (motivo ?? "").Trim().ToUpperInvariant();
        // (fondo, texto) — pasteles claros, mismo criterio de tono que la banda de estado del Zoom.
        var (bg, fg) = m switch
        {
            "ALTA"                                   => ("#EAF7F3", "#1B7A63"),  // creación → verde
            "ASIGNO"                                 => ("#FFFBDD", "#8A7600"),  // asignación → amarillo
            "FINALIZO"                               => ("#F2F2F2", "#555555"),  // fin → gris
            "CHEQUEO"                                => ("#E8F6FF", "#0E6FA8"),  // chequeo → celeste
            "CANCELO" or "CANCELADO" or "ANULO"      => ("#FFF0F0", "#C02626"),  // cancelación → rojo
            _ when m.Contains("CBIO") || m.Contains("CAMBIO") || m.Contains("REASIGN")
                                                     => ("#FDF0FF", "#8A3CB0"),  // cambio/reasignación → violeta
            _ when m.Contains("LIBER")               => ("#FFF4E6", "#B5651D"),  // liberación → naranja
            _                                        => ("#EEF2F8", "#3A4A63"),  // otros → azul grisáceo
        };
        return $"background:{bg}; color:{fg};";
    }

    public void Dispose() { }
}
