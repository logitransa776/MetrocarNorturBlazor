@* Diálogo "Tipo de Reserva" del menú Aplicar Filtros de Tráfico.
   Réplica de trafico_filtro_tipo_reserva.scx (código TIPO_RESERVA): el usuario elige un rango
   Desde/Hasta (con atajos Hoy / Todo) + el origen de la reserva, y la grilla pasa a modo filtro
   server-side (arma_grid_viaje → Between(f_reserva, x1, x2) AND origen = 'T'/'P').

   origen NO es el servicio, es cómo se cargó la reserva:
     'T' = por Transportación (turismo / transfer puntual — botón Tur de la toolbar)
     'P' = por Plantilla      (servicio recurrente de empresa — botón Emp de la toolbar)
   El FoxPro era excluyente (optiongroup T o P). Acá se agrega "Ambos" (mejora pedida): cuando se
   elige Ambos, el filtro no agrega el AND origen y trae los dos.

   Devuelve un TraficoFiltro(TipoReserva, desde, hasta, Texto = "T"|"P"|null) al aceptar. *@

<MudDialog>
    <DialogContent>
        <div style="min-width:360px;">
            <MudText Typo="Typo.body2" Class="mb-3" Style="color:#5B6B82;">
                Mostrá los servicios por <b>tipo de reserva</b> (cómo se cargó) en un rango de fechas.
                Mientras el filtro esté activo, la navegación de día queda deshabilitada.
            </MudText>

            <div class="d-flex align-center" style="gap:12px;">
                <MudDatePicker @bind-Date="_desde" Label="Desde" DateFormat="dd/MM/yyyy"
                               Editable="true" Culture="@_ar"
                               MinDate="_min" MaxDate="_max"
                               PickerVariant="PickerVariant.Dialog" Style="flex:1;" />
                <MudDatePicker @bind-Date="_hasta" Label="Hasta" DateFormat="dd/MM/yyyy"
                               Editable="true" Culture="@_ar"
                               MinDate="_min" MaxDate="_max"
                               PickerVariant="PickerVariant.Dialog" Style="flex:1;" />
            </div>

            @* Atajos Hoy / Todo (réplica de los botones del form FoxPro) *@
            <div class="d-flex mt-2" style="gap:8px;">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="SetHoy">Hoy</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="SetTodo">Todo</MudButton>
            </div>

            <MudRadioGroup @bind-Value="_origen" Class="mt-4">
                <MudText Typo="Typo.subtitle2" Class="mb-1">Tipo de reserva</MudText>
                <MudRadio Value="@("")" Color="Color.Primary" Dense="true">
                    Ambos <span style="color:#8A98AC;">(transportación + plantilla)</span>
                </MudRadio>
                <MudRadio Value="@("T")" Color="Color.Primary" Dense="true">
                    por Transportación <span style="color:#8A98AC;">(turismo / transfers)</span>
                </MudRadio>
                <MudRadio Value="@("P")" Color="Color.Primary" Dense="true">
                    por Plantilla <span style="color:#8A98AC;">(servicio de empresa)</span>
                </MudRadio>
            </MudRadioGroup>

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_error</MudAlert>
            }
            else if (_dias > 31)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                    Rango de @_dias días: la consulta puede tardar y traer muchos servicios.
                </MudAlert>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.FilterAlt" OnClick="Aplicar">
            Aplicar filtro
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Día actualmente mostrado en la planilla; valor inicial de ambas fechas (botón Hoy implícito).</summary>
    [Parameter] public DateOnly DiaActual { get; set; }

    /// <summary>Si se abre en modo "editar filtro", trae el filtro vigente para precargar los campos.</summary>
    [Parameter] public TraficoFiltro? FiltroInicial { get; set; }

    private readonly System.Globalization.CultureInfo _ar =
        System.Globalization.CultureInfo.GetCultureInfo("es-AR");
    private readonly DateTime _min = ReportService.FechaMinValida.ToDateTime(TimeOnly.MinValue);
    private readonly DateTime _max = ReportService.FechaMaxValida.ToDateTime(TimeOnly.MinValue);

    private DateTime? _desde;
    private DateTime? _hasta;
    private string _origen = "";   // "" = Ambos (default), "T" = Transportación, "P" = Plantilla
    private string? _error;

    private int _dias =>
        _desde is not null && _hasta is not null && _hasta >= _desde
            ? (int)(_hasta.Value.Date - _desde.Value.Date).TotalDays + 1
            : 0;

    protected override void OnInitialized()
    {
        if (FiltroInicial is { Tipo: TraficoFiltroTipo.TipoReserva } f)
        {
            // Modo editar: precargar el rango y el origen vigentes (Texto null = Ambos).
            _desde = f.Desde.ToDateTime(TimeOnly.MinValue);
            _hasta = f.Hasta.ToDateTime(TimeOnly.MinValue);
            _origen = f.Texto ?? "";
            return;
        }
        // Default: Ambos + Hoy (día activo en ambas fechas).
        var d = DiaActual.ToDateTime(TimeOnly.MinValue);
        _desde = d;
        _hasta = d;
    }

    private void SetHoy()
    {
        var hoy = DateTime.Today;
        _desde = hoy;
        _hasta = hoy;
    }

    private void SetTodo()
    {
        // El FoxPro usaba 01/01/1900–31/12/2099; acá se acota al rango válido de la réplica.
        _desde = _min;
        _hasta = _max;
    }

    private void Aplicar()
    {
        if (_desde is null || _hasta is null)
        {
            _error = "Elegí ambas fechas.";
            return;
        }
        if (_hasta < _desde)
        {
            _error = "La fecha Hasta no puede ser anterior a Desde.";
            return;
        }

        var filtro = new TraficoFiltro(
            TraficoFiltroTipo.TipoReserva,
            DateOnly.FromDateTime(_desde.Value),
            DateOnly.FromDateTime(_hasta.Value),
            Texto: string.IsNullOrEmpty(_origen) ? null : _origen);   // null = Ambos

        MudDialog.Close(DialogResult.Ok(filtro));
    }

    private void Cancelar() => MudDialog.Cancel();
}
