@inject ReportService Reports
@inject AbmService Abm

@* ───────────────────────────────────────────────────────────────────────────────
   Artículo por rubro de consumo — réplica de estacion_rubro_articulo_abm.scx.
   Un solo dialog con 4 modos: "ver" / "alta" / "modifica" / "baja". Combo de rubro
   (estacion_rubro) + nombre. Para rubro 1 son los tipos de combustible de la carga.

   ⚠ ANDAMIAJE (07/07/2026): escritura construida (AbmService.*ArticuloRubroAsync) pero
   apagada por ArticulosRubroAbmActivo. 🐛 Baja FÍSICA (DELETE, sin f_delete); id no-identity.
   ─────────────────────────────────────────────────────────────────────────────── *@

<MudDialog Class="zoom-viaje-dialog cli-dialog nortur-ficha">
    <TitleContent>
        <div class="zoom-title-bar" style="width:100%; display:flex; align-items:center;">
            <MudIcon Icon="@_icono" Class="me-2" Style="color:#F99410;" />
            <span class="zoom-title-bar__text">@_titulo</span>
            <span class="zoom-title-bar__chip" style="margin-left:10px;">@_chip</span>
            <span style="flex:1;"></span>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                           Style="color:rgba(255,255,255,0.85); margin:-4px -6px -4px 0;"
                           title="Cerrar" OnClick="Cerrar" />
        </div>
    </TitleContent>

    <DialogContent>
        @if (_cargando)
        {
            <div class="d-flex justify-center align-center" style="min-height:150px;">
                <MudProgressCircular Indeterminate="true" Style="color:#003AA0;" />
            </div>
        }
        else if (_noExiste)
        {
            <MudAlert Severity="Severity.Warning" Class="my-2">El artículo ya no existe.</MudAlert>
        }
        else
        {
            @if (SoloEscritura && !_abmActivo)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    <b>Vista previa del ABM.</b> La edición de artículos todavía se hace en FoxPro;
                    esta pantalla queda lista para activarse el día que la tabla pase a Buslink.
                </MudAlert>
            }
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
            }

            <div class="zoom-box zoom-box--sec">
                <span class="zoom-box__label">Artículo por rubro de consumo</span>
                <div class="zoom-row pa-2">
                    @if (!EsAlta)
                    {
                        <div class="zoom-field zoom-field--sm">
                            <div class="zoom-field__label">Código</div>
                            <div class="zoom-field__value zoom-field__value--acento">@Id</div>
                        </div>
                    }
                    <div class="zoom-field zoom-field--2">
                        <div class="zoom-field__label">Rubro</div>
                        @if (SoloEscritura)
                        {
                            <MudSelect T="int" @bind-Value="_rubroId" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var r in _rubros)
                                {
                                    <MudSelectItem T="int" Value="@r.Id">@r.Rubro</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else { <div class="zoom-field__value">@_rubroNombre</div> }
                    </div>
                    <div class="zoom-field zoom-field--3">
                        <div class="zoom-field__label">Artículo</div>
                        @if (SoloEscritura)
                        {
                            <MudTextField @bind-Value="_nombre" MaxLength="30" Immediate="true"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Style="text-transform:uppercase;" />
                        }
                        else { <div class="zoom-field__value" title="@_nombre">@V(_nombre)</div> }
                    </div>
                </div>
            </div>

            @if (EsBaja)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                    Esta baja es <b>física</b> (DELETE) — no se puede deshacer.
                </MudAlert>
            }

            <div class="cli-footer">
                <div class="cli-footer__hint">
                    <MudIcon Icon="@(SoloEscritura && _abmActivo ? Icons.Material.Filled.Edit : Icons.Material.Filled.Lock)" Size="Size.Small" />
                    @(SoloEscritura && !_abmActivo
                        ? "Escritura preparada · pendiente de activar en Buslink"
                        : SoloEscritura ? "Edición habilitada" : "Vista de solo lectura")
                </div>
                <div class="cli-footer__btns">
                    @if (EsAlta)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Save" OnClick="Grabar" Disabled="!_abmActivo || _grabando">
                            @(_grabando ? "Grabando…" : "Agregar")
                        </MudButton>
                    }
                    else if (EsModifica)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Save" OnClick="Grabar" Disabled="!_abmActivo || _grabando">
                            @(_grabando ? "Grabando…" : "Modificar")
                        </MudButton>
                    }
                    else if (EsBaja)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Delete" OnClick="Grabar" Disabled="!_abmActivo || _grabando">
                            @(_grabando ? "Procesando…" : "Eliminar")
                        </MudButton>
                    }
                    <MudButton Variant="@(SoloLectura ? Variant.Filled : Variant.Text)"
                               Color="@(SoloLectura ? Color.Primary : Color.Default)" Size="Size.Small"
                               OnClick="Cerrar">@(SoloLectura ? "Cerrar" : "Cancelar")</MudButton>
                </div>
            </div>
        }
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Modo { get; set; } = "ver";
    [Parameter] public int Id { get; set; }

    private static bool _abmActivo => AbmFeatureFlags.ArticulosRubroAbmActivo;

    private List<RubroContactoRow> _rubros = new();
    private int _rubroId;
    private string _rubroNombre = "";
    private string _nombre = "";
    private bool _cargando = true, _grabando, _noExiste;
    private string? _error;

    private bool EsAlta => Modo == "alta";
    private bool EsModifica => Modo == "modifica";
    private bool EsBaja => Modo == "baja";
    private bool SoloLectura => Modo == "ver" || EsBaja;
    private bool SoloEscritura => EsAlta || EsModifica;

    private string _titulo => EsAlta ? "Alta de artículo" : EsModifica ? "Modificar artículo"
        : EsBaja ? "Eliminar artículo" : "Datos del artículo";
    private string _chip => EsAlta ? "Nuevo" : EsModifica ? "Edición" : EsBaja ? "Baja física" : "Solo lectura";
    private string _icono => EsAlta ? Icons.Material.Filled.AddCircle
        : EsBaja ? Icons.Material.Filled.RemoveCircle : Icons.Material.Filled.ListAlt;

    protected override async Task OnInitializedAsync()
    {
        _rubros = await Reports.GetRubrosContactoAsync();

        if (EsAlta)
        {
            // Default: rubro combustible (=1) si existe.
            _rubroId = _rubros.FirstOrDefault(r => r.Id == 1)?.Id ?? _rubros.FirstOrDefault()?.Id ?? 0;
            _cargando = false;
            return;
        }

        var d = await Reports.GetArticuloRubroRowAsync(Id);
        if (d is null) { _noExiste = true; _cargando = false; return; }
        _rubroId = d.RubroId;
        _rubroNombre = d.Rubro;
        _nombre = d.Nombre;
        _cargando = false;
    }

    private async Task Grabar()
    {
        if (!_abmActivo)
        {
            _error = "La escritura de artículos todavía no está habilitada (sigue en FoxPro).";
            return;
        }
        _error = null; _grabando = true;

        AbmService.AbmResult r;
        if (EsBaja)
            r = await Abm.BajaArticuloRubroAsync(Id);
        else if (EsModifica)
            r = await Abm.ModificaArticuloRubroAsync(Id, _rubroId, _nombre);
        else
            r = await Abm.AltaArticuloRubroAsync(_rubroId, _nombre);

        _grabando = false;
        if (r.Ok) MudDialog.Close(DialogResult.Ok(true));
        else { _error = r.Error; StateHasChanged(); }
    }

    private void Cerrar() => MudDialog.Close(DialogResult.Ok(false));
    private static string V(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;
}
