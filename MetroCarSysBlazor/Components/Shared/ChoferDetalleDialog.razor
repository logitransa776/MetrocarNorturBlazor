@inject ReportService Reports

<MudDialog Class="zoom-viaje-dialog nortur-ficha">
    <TitleContent>
        <div class="zoom-title-bar" style="width:100%; display:flex; align-items:center;">
            <MudIcon Icon="@Icons.Material.Filled.Badge" Class="me-2" Style="color:#F99410;" />
            <span class="zoom-title-bar__text">ABM de Conductores</span>
            <span class="zoom-title-bar__chip" style="margin-left:10px;">Solo lectura</span>
            @if (_d is not null)
            {
                <span class="zoom-title-bar__nro">@_d.Codigo</span>
            }
            <span style="flex:1;"></span>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Style="color:rgba(255,255,255,0.85); margin:-4px -6px -4px 0;"
                           title="Cerrar"
                           OnClick="Cerrar" />
        </div>
    </TitleContent>

    <DialogContent>
        @if (_cargando)
        {
            <div class="d-flex justify-center align-center" style="min-height:220px;">
                <MudProgressCircular Indeterminate="true" Style="color:#003AA0;" />
            </div>
        }
        else if (_d is null)
        {
            <MudAlert Severity="Severity.Warning">No se encontró el chofer.</MudAlert>
        }
        else
        {
            @* ── Encabezado: Código + Nombre + Fletero ── *@
            <div class="cli-head">
                <div class="zoom-field zoom-field--1">
                    <div class="zoom-field__label">Código</div>
                    <div class="zoom-field__value zoom-field__value--acento">@_d.Codigo</div>
                </div>
                <div class="zoom-field zoom-field--3">
                    <div class="zoom-field__label">Nombre completo</div>
                    <div class="zoom-field__value">@Str(_d.Nombre)</div>
                </div>
                <div class="zoom-field zoom-field--1">
                    <div class="zoom-field__label">Fletero</div>
                    <div class="zoom-field__value">@Str(_d.Fletero)</div>
                </div>
                @if (_d.FInhabilitacion is not null)
                {
                    <span class="cli-egresado">EGRESADO · @Fecha(_d.FInhabilitacion)</span>
                }
            </div>

            <MudTabs Elevation="0" Rounded="true" Class="cli-tabs nortur-tabs nortur-tabs--pill">

                @* ══════════ Datos Personales ══════════ *@
                <MudTabPanel Text="Datos Personales">
                    <div class="zoom-box zoom-box--sec">
                        <span class="zoom-box__label">Identificación</span>
                        <div class="zoom-row">
                            @F("Apellido", Str(_d.Apellido))
                            @F("1º Nombre", Str(_d.Nombre1))
                            @F("2º Nombre", Str(_d.Nombre2))
                            @F("Tipo Doc", Str(_d.Tdoc))
                            @F("Nro de Doc", Str(_d.Ndoc))
                            @F("N° C.U.I.L.", Str(_d.Ncuil))
                            @F("F. Nacimiento", Fecha(_d.FNac))
                            @F("Lugar de nacimiento", Str(_d.LugarNacimiento), ancho: 2)
                            @F("Estado Civil", Str(_d.EstadoCivil))
                            @F("Grupo Sanguíneo", Str(_d.GrupoSanguineo))
                            @F("RH", _d.RhDescripcion)
                        </div>
                    </div>

                    <div class="zoom-box zoom-box--sec">
                        <span class="zoom-box__label">Registros y vencimientos</span>
                        <div class="zoom-row">
                            @F("Nro de Registro", Str(_d.RegistroNro))
                            @FVto("Venc. Registro", _d.VtoRegistro)
                            @F("Nro Registro CNRT", Str(_d.RegistroNroCnrt))
                            @FVto("Venc. Reg CNRT", _d.VtoCnrt)
                            @FVto("Venc. Ingreso Aeo", _d.VtoAep)
                        </div>
                    </div>

                    <div class="zoom-box zoom-box--sec">
                        <span class="zoom-box__label">Familia y contacto</span>
                        <div class="zoom-row">
                            @F("Nombre del padre", Str(_d.Padre), ancho: 2)
                            @F("Nombre de la madre", Str(_d.Madre), ancho: 2)
                            @F("E-Mail", Str(_d.Email), ancho: 2)
                            @F("Nextel de la empresa", Str(_d.Nextel))
                            @F("Nextel Celular", Str(_d.NextelCel))
                            @F("Comentarios", Str(_d.Comentario), ancho: 4)
                        </div>
                    </div>
                </MudTabPanel>

                @* ══════════ Domicilios ══════════ *@
                <MudTabPanel Text="Domicilios">
                    <div class="zoom-box zoom-box--sec">
                        <span class="zoom-box__label">Domicilio que figura en el Documento Nacional</span>
                        <div class="zoom-row">
                            @F("Domicilio", Str(_d.Domicilio), ancho: 2)
                            @F("Nro", Str(_d.Nro))
                            @F("Piso", Str(_d.Piso))
                            @F("Depto", Str(_d.Depto))
                            @F("Entre", Str(_d.Entre1), ancho: 2)
                            @F("Y", Str(_d.Entre2), ancho: 2)
                            @F("C. Postal", Str(_d.CPostal))
                            @F("Localidad", Str(_d.Localidad), ancho: 2)
                            @F("Partido", Str(_d.Partido), ancho: 2)
                            @F("Provincia", Str(_d.Provincia))
                        </div>
                    </div>

                    <div class="zoom-box zoom-box--sec">
                        <span class="zoom-box__label">Domicilio donde vive actualmente</span>
                        <div class="zoom-row">
                            @F("Domicilio", Str(_d.RealDomicilio), ancho: 2)
                            @F("Nro", Str(_d.RealNro))
                            @F("Piso", Str(_d.RealPiso))
                            @F("Depto", Str(_d.RealDepto))
                            @F("Entre", Str(_d.RealEntre1), ancho: 2)
                            @F("Y", Str(_d.RealEntre2), ancho: 2)
                            @F("C. Postal", Str(_d.RealCPostal))
                            @F("Localidad", Str(_d.RealLocalidad), ancho: 2)
                            @F("Partido", Str(_d.RealPartido), ancho: 2)
                            @F("Provincia", Str(_d.RealProvincia))
                        </div>
                    </div>
                </MudTabPanel>

                @* ══════════ Teléfonos ══════════ *@
                <MudTabPanel Text="Teléfonos">
                    <div class="zoom-box zoom-box--sec">
                        <span class="zoom-box__label">Teléfonos principales</span>
                        <div class="zoom-row">
                            @F("Teléfono", Str(_d.Telefono))
                            @F("Celular", Str(_d.Celular))
                        </div>
                    </div>

                    <div class="zoom-box zoom-box--sec">
                        <span class="zoom-box__label">Teléfonos adicionales</span>
                        @if (_d.Telefonos.All(t => string.IsNullOrWhiteSpace(t.Telefono)
                                                && string.IsNullOrWhiteSpace(t.Linea)
                                                && string.IsNullOrWhiteSpace(t.Celular)))
                        {
                            <span class="cli-empty">Sin teléfonos adicionales cargados.</span>
                        }
                        else
                        {
                            <MudSimpleTable Dense="true" Hover="true" Striped="true" Class="cli-mails">
                                <thead>
                                    <tr>
                                        <th style="width:36px;">#</th>
                                        <th>Teléfono</th>
                                        <th>Línea</th>
                                        <th>Celular</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in _d.Telefonos)
                                    {
                                        <tr>
                                            <td>@t.Orden</td>
                                            <td>@Str(t.Telefono)</td>
                                            <td>@Str(t.Linea)</td>
                                            <td>@Str(t.Celular)</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }
                    </div>
                </MudTabPanel>

                @* ══════════ Condiciones Laborales ══════════ *@
                <MudTabPanel Text="Condiciones Laborales">
                    <div class="zoom-box zoom-box--sec">
                        <span class="zoom-box__label">Datos laborales</span>
                        <div class="zoom-row">
                            @F("F. Ingreso", Fecha(_d.FIngreso))
                            @F("Legajo", _d.Legajo > 0 ? _d.Legajo.ToString() : "—")
                            @F("Lista de liquidación", Str(_d.IdListaPrecio))
                            @F("Días de trabajo", string.IsNullOrEmpty(_d.DiasTrabajo) ? "—" : _d.DiasTrabajo, ancho: 2)
                            @F("Jornada", Jornada())
                            @F("Jornal (horas)", _d.Jornal > 0 ? _d.Jornal.ToString() : "—")
                        </div>
                    </div>

                    <div class="zoom-box zoom-box--sec">
                        <span class="zoom-box__label">Opciones</span>
                        <div class="cli-flags">
                            @Flag("Aplica jornal", _d.JornalAplica)
                            @Flag("Auditor", _d.Auditor)
                        </div>
                    </div>

                    <div class="zoom-box zoom-box--sec">
                        <span class="zoom-box__label">PIN de combustible</span>
                        <div class="zoom-row">
                            @F("YPF Pin", Str(_d.YpfPin))
                            @F("Esso Pin", Str(_d.EssoPin))
                        </div>
                    </div>
                </MudTabPanel>

                @* ══════════ Vehículos ══════════ *@
                <MudTabPanel Text="@($"Vehículos ({_d.Vehiculos.Count})")">
                    <div class="zoom-box zoom-box--sec">
                        <span class="zoom-box__label">Vehículos asignados</span>
                        @if (_d.Vehiculos.Count == 0)
                        {
                            <span class="cli-empty">Sin vehículos asignados.</span>
                        }
                        else
                        {
                            <MudSimpleTable Dense="true" Hover="true" Striped="true" Class="cli-mails">
                                <thead>
                                    <tr>
                                        <th>Código Vehículo</th>
                                        <th>Nro. Interno</th>
                                        <th>Dominio</th>
                                        <th>Modelo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var v in _d.Vehiculos)
                                    {
                                        <tr>
                                            <td>@Str(v.IdVehiculo)</td>
                                            <td>@(v.Interno > 0 ? v.Interno.ToString() : "—")</td>
                                            <td>@Str(v.Patente)</td>
                                            <td>@Str(v.Modelo)</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }
                    </div>
                </MudTabPanel>

            </MudTabs>

            @* ── Botonera réplica FoxPro (deshabilitada — solo lectura) ── *@
            <div class="cli-footer">
                <div class="cli-footer__hint">
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                    Vista de solo lectura — la edición se hace en Metrocar (FoxPro).
                </div>
                <div class="cli-footer__btns">
                    <MudButton Disabled="true" Variant="Variant.Outlined" Size="Size.Small">Agregar</MudButton>
                    <MudButton Disabled="true" Variant="Variant.Outlined" Size="Size.Small">Modificar</MudButton>
                    <MudButton Disabled="true" Variant="Variant.Outlined" Size="Size.Small">Eliminar</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               OnClick="Cerrar">Cerrar</MudButton>
                </div>
            </div>
        }
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string IdChofer { get; set; } = "";

    private ChoferDetalleDto? _d;
    private bool _cargando = true;
    private readonly System.Globalization.CultureInfo _ar =
        System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    protected override async Task OnInitializedAsync()
    {
        _d = await Reports.GetChoferDetalleAsync(IdChofer);
        _cargando = false;
    }

    private void Cerrar() => MudDialog.Close();

    private string Fecha(DateOnly? f) => f is null ? "—" : f.Value.ToString("dd/MM/yyyy", _ar);
    private string Str(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;

    private string Jornada()
    {
        if (_d?.HInicioJornal is null || _d.HFinJornal is null) return "—";
        return $"{_d.HInicioJornal.Value:HH:mm} a {_d.HFinJornal.Value:HH:mm}";
    }

    private RenderFragment F(string label, string valor, bool acento = false, int ancho = 1) => b =>
    {
        b.OpenElement(0, "div");
        b.AddAttribute(1, "class", $"zoom-field zoom-field--{ancho}");
        if (!string.IsNullOrEmpty(label))
        {
            b.OpenElement(2, "div"); b.AddAttribute(3, "class", "zoom-field__label");
            b.AddContent(4, label); b.CloseElement();
        }
        b.OpenElement(5, "div");
        b.AddAttribute(6, "class", acento ? "zoom-field__value zoom-field__value--acento" : "zoom-field__value");
        b.AddContent(7, string.IsNullOrWhiteSpace(valor) ? "—" : valor);
        b.CloseElement();
        b.CloseElement();
    };

    @* Campo de vencimiento con color según vencido / por vencer (30 días) *@
    private RenderFragment FVto(string label, DateOnly? f) => b =>
    {
        var clase = VtoClass(f);
        b.OpenElement(0, "div");
        b.AddAttribute(1, "class", "zoom-field zoom-field--1");
        b.OpenElement(2, "div"); b.AddAttribute(3, "class", "zoom-field__label");
        b.AddContent(4, label); b.CloseElement();
        b.OpenElement(5, "div");
        b.AddAttribute(6, "class", "zoom-field__value" + (clase is null ? "" : " " + clase));
        b.AddContent(7, Fecha(f));
        b.CloseElement();
        b.CloseElement();
    };

    private string? VtoClass(DateOnly? f)
    {
        if (f is null) return null;
        var hoy = DateOnly.FromDateTime(DateTime.Today);
        if (f < hoy) return "chof-vto--vencido";
        if (f <= hoy.AddDays(30)) return "chof-vto--proximo";
        return null;
    }

    private RenderFragment Flag(string label, bool on) => b =>
    {
        b.OpenElement(0, "div");
        b.AddAttribute(1, "class", on ? "cli-flag cli-flag--on" : "cli-flag");
        b.OpenComponent<MudIcon>(2);
        b.AddComponentParameter(3, "Icon", on ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank);
        b.AddComponentParameter(4, "Size", Size.Small);
        b.CloseComponent();
        b.OpenElement(5, "span"); b.AddContent(6, label); b.CloseElement();
        b.CloseElement();
    };
}
