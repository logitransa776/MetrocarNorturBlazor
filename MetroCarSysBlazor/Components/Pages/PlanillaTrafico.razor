                            <tr class="@TraficoFilaRow.EstadoCss(b.Estado) @(_busCtx?.Id == b.Id ? "tg-row--sel" : "")"
                                @oncontextmenu="@(e => AbrirMenuBus(e, b))" @oncontextmenu:preventDefault="true">
                                @* La celda Fletero es el DISPARADOR TÁCTIL del mismo menú (07/08/2026).
                                   En tablet/iPad no hay clic derecho: sin esto, el menú de la unidad era
                                   inalcanzable. Mismo patrón que el chip de Estado de la grilla de viajes
                                   (TraficoFilaRow.razor): clic izquierdo sobre el chip = clic derecho sobre
                                   la fila, menú en la posición del toque. El clic derecho del <tr> se
