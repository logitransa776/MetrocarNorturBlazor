@page "/planilla-trafico"
@inject ReportService Reports
@inject ExcelExportService Excel
@inject NorturAuthStateProvider AuthState
@inject IPermissionService Permisos
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject AbmService Abm
@inject ISnackbar Snackbar
@inject IConfiguration Config
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>BusLink</PageTitle>

@* Columna a pantalla completa: toolbar + KPIs fijos arriba, grilla flexible abajo.
   La ventana no scrollea (body.planilla-fixed); solo scrollea la grilla. *@
<div class="planilla-page">

@* ════════════ Barra superior: navegación de día + acciones ════════════ *@
<MudPaper Class="pa-3 mb-3 planilla-page__toolbar" Elevation="2" Style="border-radius:12px;">
    <div class="d-flex align-center flex-wrap" style="gap:12px;">

        @* Navegación de día (<<  fecha  >>) *@
        <div class="d-flex align-center" style="gap:6px;">
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                           Variant="Variant.Filled" Color="Color.Primary"
                           title="Día anterior" OnClick="DiaAnterior"
                           Disabled="@(_cargando || _filtroActivo is not null)" />
            <MudDatePicker Date="_fecha" DateFormat="dddd dd/MM/yyyy"
                           Editable="true" Style="min-width:210px;"
                           MinDate="_min" MaxDate="_max"
                           Disabled="@(_filtroActivo is not null)"
                           Culture="@_ar" PickerVariant="PickerVariant.Dialog"
                           DateChanged="OnFechaChanged" />
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                           Variant="Variant.Filled" Color="Color.Primary"
                           title="Día siguiente" OnClick="DiaSiguiente"
                           Disabled="@(_cargando || _filtroActivo is not null)" />
            <MudButton Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Today"
                       OnClick="IrHoy" Disabled="@(_cargando || _filtroActivo is not null)">Hoy</MudButton>
        </div>

        <MudDivider Vertical="true" FlexItem="true" />

        @* Unidades (réplica de los combos cronogramaCbio/cronograma + botones S/C y Cxl del FoxPro) *@
        <div class="d-flex align-center" style="gap:6px;">
            @* Combos Empresa / Interno — MudAutocomplete (19/08/2026).
               Antes eran <select> nativos. Se cambiaron por dos motivos que el <select> no
               podía dar: (1) el scroll de su lista lo dibuja el sistema operativo y saltaba
               sin remedio; (2) su búsqueda por teclado es por PREFIJO, así que con una empresa
               elegida había que tipear "NT0021" entero — ahora se escribe "21" y aparece.
               La cascada empresa → internos y el reseteo del interno no cambian. *@
            <MudAutocomplete T="string"
                             Value="@_selUPr"
                             ValueChanged="@(v => OnUPrChanged(v ?? ""))"
                             SearchFunc="@BuscarEmpresas"
                             Disabled="@_verCancelados"
                             Placeholder="Todas/Empresas"
                             Class="@($"filtro-ac {(string.IsNullOrEmpty(_selUPr) ? "" : "filtro-ac--activo")}")"
                             PopoverClass="filtro-ac-popover"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                             Clearable="true" ResetValueOnEmptyText="true" Strict="false"
                             MaxItems="null" MaxHeight="320"
                             AdornmentIcon="@Icons.Material.Filled.ArrowDropDown"
                             Adornment="Adornment.End"
                             UserAttributes="@(new Dictionary<string, object?> { ["title"] = "Empresa — escribí para filtrar la lista" })" />

            @* Interno: en cascada con el combo 1 (con empresa elegida solo se listan SUS
               internos). La búsqueda entiende el número suelto: "21" → NT0021 primero. *@
            <MudAutocomplete T="string"
                             Value="@_selUCb"
                             ValueChanged="@(v => OnUCbChanged(v ?? ""))"
                             SearchFunc="@BuscarInternos"
                             Disabled="@_verCancelados"
                             Placeholder="Todos/Internos"
                             Class="@($"filtro-ac {(string.IsNullOrEmpty(_selUCb) ? "" : "filtro-ac--activo")}")"
                             PopoverClass="filtro-ac-popover"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                             Clearable="true" ResetValueOnEmptyText="true" Strict="false"
                             MaxItems="null" MaxHeight="320"
                             AdornmentIcon="@Icons.Material.Filled.ArrowDropDown"
                             Adornment="Adornment.End"
                             UserAttributes="@(new Dictionary<string, object?> { ["title"] = "Interno — escribí el número (ej. 21) o el código (NT0021)" })" />

            @* S/C — servicios sin unidad asignada (cronograma = 'S/C') *@
            <button class="filtro-btn @(_soloSinCronograma ? "filtro-btn--on" : "")"
                    disabled="@_verCancelados"
                    @onclick="ToggleSinCronograma"
                    title="S/C — servicios sin unidad asignada (sin cronograma)">
                <MudIcon Icon="@Icons.Material.Filled.EventBusy" Style="font-size:1rem;" />
                <span>S/C</span>
                <span class="filtro-btn__count">@_filas.Count(f => f.UCb == "S/C")</span>
            </button>

            @* Cxl — vista de servicios cancelados del día *@
            <button class="filtro-btn @(_verCancelados ? "filtro-btn--on filtro-btn--cxl-on" : "")"
                    @onclick="ToggleCancelados"
                    title="Cxl — ver los servicios cancelados del día (con motivo)">
                <MudIcon Icon="@Icons.Material.Filled.Cancel" Style="font-size:1rem;" />
                <span>Cxl</span>
                <span class="filtro-btn__count">@_cancelados.Count</span>
            </button>
        </div>

        <MudDivider Vertical="true" FlexItem="true" />

        @* Filtros de tipo de ingreso (réplica de los botones Emp/Tur + checkbox Nortur del FoxPro) *@
        <div class="d-flex align-center" style="gap:6px;">
            <button class="filtro-btn @(_verEmpresa ? "filtro-btn--on" : "")"
                    disabled="@_verCancelados"
                    @onclick="@(() => { _verEmpresa = !_verEmpresa; RecalcularVisibles(); })"
                    title="Empresa — servicios de plantilla (origen P) de clientes, excluye los internos del botón NORTUR">
                <MudIcon Icon="@Icons.Material.Filled.Business" Style="font-size:1rem;" />
                <span>Empresa</span>
                <span class="filtro-btn__count">@_filas.Count(f => f.Origen == "P" && !f.EsNortur)</span>
                @if (_verEmpresa) {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:0.85rem; opacity:0.9;" />
                }
            </button>

            <button class="filtro-btn @(_verTurismo ? "filtro-btn--on" : "")"
                    disabled="@_verCancelados"
                    @onclick="@(() => { _verTurismo = !_verTurismo; RecalcularVisibles(); })"
                    title="Turismo — transportación turística (origen T) de clientes, excluye los internos del botón NORTUR">
                <MudIcon Icon="@Icons.Material.Filled.Flight" Style="font-size:1rem;" />
                <span>Turismo</span>
                <span class="filtro-btn__count">@_filas.Count(f => f.Origen == "T" && !f.EsNortur)</span>
                @if (_verTurismo) {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:0.85rem; opacity:0.9;" />
                }
            </button>

            <button class="filtro-btn filtro-btn--nortur @(_verNortur ? "filtro-btn--on filtro-btn--nortur-on" : "")"
                    disabled="@_verCancelados"
                    @onclick="@(() => { _verNortur = !_verNortur; RecalcularVisibles(); })"
                    title="Nortur — servicios internos de la empresa (columna Cliente = NORTUR): turnos médicos, guardias, engrases, VTV, etc. No aparecen en Empresa ni en Turismo.">
                <MudIcon Icon="@Icons.Material.Filled.DirectionsBus" Style="font-size:1rem;" />
                <span>Nortur</span>
                <span class="filtro-btn__count">@_filas.Count(f => f.EsNortur)</span>
                @if (_verNortur) {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:0.85rem; opacity:0.9;" />
                }
            </button>
        </div>

        <MudDivider Vertical="true" FlexItem="true" />

        @* ── Buscador (rediseñado 23/07/2026) — busca SOLO en Recorrido / Chofer / Cliente:
             selector de campo (1a) + sub-selector origen/destino para Recorrido (2a).
             Antes matcheaba 8 campos (incl. Vuelo/Unidad/Grupo/Fletero) en cada tecla; ahora
             es predecible y con debounce. Ver TextoCoincide/RecorridoCoincide en @code. ── *@
        <div class="busc-wrap">
            @* 1a — en qué campo buscar (por defecto los tres) *@
            <select class="filtro-combo busc-campo @(_filtroCampo != "todos" ? "filtro-combo--activo" : "")"
                    value="@_filtroCampo"
                    @onchange="@(e => OnCampoBuscarChanged(e.Value?.ToString() ?? "todos"))"
                    title="Elegí en qué campo buscar">
                <option value="todos">Todos</option>
                <option value="recorrido">Recorrido</option>
                <option value="chofer">Chofer</option>
                <option value="cliente">Cliente</option>
            </select>

            @* 2a — origen/destino del recorrido; aparece solo cuando el campo es Recorrido, ANTES
                 del campo de texto (se lee como una cadena de combos que va acotando la búsqueda
                 de izquierda a derecha). Combo, no botones — evita el solapamiento con Excel que
                 daban los 3 botones y usa el mismo ancho/estilo que "Buscar en". *@
            @if (_filtroCampo == "recorrido")
            {
                <select class="filtro-combo busc-recmodo @(_filtroRecModo != "todo" ? "filtro-combo--activo" : "")"
                        value="@_filtroRecModo"
                        @onchange="@(e => SetRecModo(e.Value?.ToString() ?? "todo"))"
                        title="Buscar en origen o destino del recorrido">
                    <option value="todo">Todo</option>
                    <option value="desde">Desde</option>
                    <option value="hasta">Hasta</option>
                </select>
            }

            @* OJO: el Style de MudTextField se aplica al .mud-input INTERNO (contenedor columna) →
               poner flex/flex-basis ahí infla la ALTURA. El ancho va por CSS en .busc-text, que
               es el .mud-input-control externo (el flex item real de la barra). *@
            <MudTextField @bind-Value="_filtro" @bind-Value:after="RecalcularVisibles"
                          Placeholder="@PlaceholderBuscar" Class="busc-text"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" DebounceInterval="200" Clearable="true"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>

        <MudSpacer />

        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                   Class="busc-excel"
                   StartIcon="@Icons.Material.Filled.Download"
                   OnClick="DescargarExcel"
                   Disabled="@(_cargando || (_verCancelados ? _cancelados.Count == 0 : _filas.Count == 0))">
            Excel
        </MudButton>
    </div>
</MudPaper>

@* ════════════ Banner de filtro server-side activo (Aplicar Filtros) ════════════
   Aparece cuando hay un filtro de rango aplicado. La grilla muestra el resultado de la
   re-consulta (posiblemente varios días); "Quitar filtro" vuelve a la vista de día único. *@
@if (_filtroActivo is not null)
{
    <MudPaper Class="pa-2 mb-2 d-flex align-center flex-wrap planilla-page__filtro" Elevation="0"
              Style="gap:10px; background:#FFF4E5; border:1px solid #F99410; border-radius:8px;">
        <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Style="color:#F99410;" />
        <span style="font-weight:600; color:#7A4E00;">Filtro activo:</span>
        <span style="color:#7A4E00;">@DescripcionFiltro</span>
        <span style="color:#9A6A00;">· @_filas.Count servicios</span>
        <MudSpacer />
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Edit" OnClick="EditarFiltro" Class="mr-2">
            Editar filtro
        </MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Close" OnClick="QuitarFiltro">
            Quitar filtro
        </MudButton>
    </MudPaper>
}

@{
    // Filas tras aplicar Emp/Tur/Nortur + unidades + buscador. Los KPIs y la grilla usan este mismo conjunto.
    // MEMOIZADO: se recalculan solo cuando cambian datos o filtros (ver RecalcularVisibles),
    // no en cada render. Con 300 filas, recalcular el filtro en cada re-render era parte del lag.
    var visibles = _visibles;
    var canceladosVisibles = _canceladosVisibles;
}

@if (_verCancelados)
{
    @* ════════════ Vista cancelados — réplica del caption "... SERVICIOS CANCELADOS" ════════════ *@
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-2" Dense="true">
        SERVICIOS CANCELADOS — @TituloFecha — Cantidad de Servicios: @canceladosVisibles.Count
    </MudAlert>
}
else
{
    @* ════════════ Chip de foco por estado ════════════
       La botonera vive al pie del panel (siempre visible), pero el filtro tiene que ser
       imposible de pasar por alto desde arriba: este chip lo canta al lado de los KPIs
       y lo saca de un clic. Solo aparece cuando hay estados enfocados. *@
    @if (_estadosFoco.Count > 0)
    {
        <div class="estado-foco mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Flag" Style="font-size:1rem;" />
            <span>Filtrado por estado:</span>
            @foreach (var est in EstadosLeyenda.Where(_estadosFoco.Contains))
            {
                <span class="estado-foco__pill" style="@EstadoLeyendaFondo(est)">@TraficoFilaRow.EstadoLabel(est)</span>
            }
            <span class="estado-foco__cuenta">@visibles.Count de @_totalSinEstado servicios</span>
            <button type="button" class="estado-foco__quitar" @onclick="LimpiarEstados"
                    title="Quitar el filtro de estado">
                <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:0.9rem;" />
                <span>Quitar</span>
            </button>
        </div>
    }

    @* ════════════ KPIs del día — franja continua "stat strip" (23/07/2026) ════════════
       Reemplaza las 4 KpiCard sueltas: mismo dato, mitad de alto, sin huecos entre
       segmentos. Buses se mudó acá (era un filtro-btn en la fila Empresa/Turismo/Nortur)
       como último segmento, a la derecha — abre el mismo panel de flota de siempre. *@
    <div class="kpi-strip planilla-page__kpis mb-2">
        <div class="kpi-strip__seg">
            <span class="kpi-strip__dot" style="background:@NorturColors.Azul;"></span>
            <span class="kpi-strip__label">Servicios</span>
            <span class="kpi-strip__value" style="color:@NorturColors.Azul;">@Fmt(visibles.Count)</span>
            <span class="kpi-strip__sub">@(_filtroActivo is not null ? DescripcionFiltro : TituloFecha)</span>
        </div>
        <div class="kpi-strip__seg">
            <span class="kpi-strip__dot" style="background:@NorturColors.Verde;"></span>
            <span class="kpi-strip__label">Total pax</span>
            <span class="kpi-strip__value" style="color:@NorturColors.Verde;">@Fmt(visibles.Sum(f => f.Pax ?? 0))</span>
            <span class="kpi-strip__sub">pasajeros del día</span>
        </div>
        <div class="kpi-strip__seg">
            <span class="kpi-strip__dot" style="background:@NorturColors.Naranja;"></span>
            <span class="kpi-strip__label">Choferes</span>
            <span class="kpi-strip__value" style="color:@NorturColors.Naranja;">@visibles.Where(f => !string.IsNullOrWhiteSpace(f.Chofer)).Select(f => f.Chofer).Distinct().Count()</span>
            <span class="kpi-strip__sub">distintos asignados</span>
        </div>
        <div class="kpi-strip__seg">
            @* EstadoDisplay (no el estado crudo): así este número coincide SIEMPRE con el
               contador del botón SIN ASIGNAR de la leyenda. Las chequeadas se cuentan aparte,
               en el botón CHEQUEO — que es como se ven en la grilla (fila celeste). *@
            <span class="kpi-strip__dot" style="background:@NorturColors.Rojo;"></span>
            <span class="kpi-strip__label">Sin asignar</span>
            <span class="kpi-strip__value" style="color:@NorturColors.Rojo;">@visibles.Count(f => f.EstadoDisplay == "SIN ASIGNAR")</span>
            <span class="kpi-strip__sub">servicios pendientes</span>
        </div>
        @* Los botones "Novedad" y "F1" que estaban acá se sacaron (06/08/2026, pedido del
           usuario) para descargar la franja: la novedad suelta pasó al menú contextual de la
           grilla ("Novedad sin reserva") y la ayuda quedó SOLO en la tecla F1. *@

        @* Avisos (03/08/2026) — réplica del checkbox "Chequeo" del toolbar de trafico2.scx: es
           el interruptor del motor de alarmas (Timer1, 60 s). Solo aparece si el usuario tiene
           el permiso 'C' (Avisos de chequeos) y parametro.aviso_cheq = 'S', igual que el Init
           del FoxPro. ⚠️ SUPERVISOR no tiene 'C' → con ese usuario el botón no se ve.
           Plano: docs/PlanoFoxPro/trafico/TRAFICO_F4_AVISO.md *@
        @if (_avisosDisponibles)
        {
            <button type="button" class="kpi-strip__seg kpi-strip__seg--buses @(_avisosActivos ? "kpi-strip__seg--buses-on" : "")"
                    @onclick="ToggleAvisos"
                    title="@(_avisosActivos
                        ? $"Avisos encendidos — se chequea cada 60 s y suena cuando falta{(_avisoConfig.MinutosDefault == 1 ? "" : "n")} {_avisoConfig.MinutosDefault} min para un servicio (o a la hora cargada con F4)"
                        : "Avisos apagados — no vas a recibir la alarma de los servicios que están por salir")"
            >@* Mismo truco del whitespace que el botón Buses: todo en una línea. *@<span class="kpi-strip__checkbox" aria-hidden="true">@(_avisosActivos ? (MarkupString)"✓" : (MarkupString)"")</span><MudIcon Icon="@(_avisosActivos ? Icons.Material.Filled.NotificationsActive : Icons.Material.Filled.NotificationsOff)" Style="font-size:1rem;" /><span class="kpi-strip__label">Avisos</span></button>
        }
        @* Libro de novedades (19/08/2026, pedido del usuario) — mismo destino que el ítem
           "Novedad sin reserva" del menú contextual, pero a un clic desde la franja. No es un
           toggle: es una acción, igual que Ocupación (sin checkbox ni contador). Tampoco depende
           de las filas a la vista (el libro suelto es de los últimos 7 días), por eso no se
           deshabilita. Mismo markup en una sola línea por lo del whitespace explicado abajo. *@
        <button type="button" class="kpi-strip__seg kpi-strip__seg--buses kpi-strip__seg--tablero"
                @onclick="AbrirNovedadSuelta"
                title="Libro de novedades — novedades sueltas (sin reserva asociada) de los últimos 7 días"
        ><MudIcon Icon="@Icons.Material.Filled.MenuBook" Style="font-size:1rem;" /><span class="kpi-strip__label">Libro de novedades</span></button>

        @* Ocupación (31/07/2026) — abre el Tablero de ocupación de flota con los servicios que
           están A LA VISTA (mismos filtros que la grilla). A diferencia de Buses no es un
           toggle: es una acción, por eso no lleva checkbox ni contador. Mismo markup en una
           sola línea, por lo del whitespace explicado abajo.
           Va ANTES de Buses por pedido del usuario (01/08/2026): Buses queda siempre último,
           pegado al borde derecho de la franja — es el ancla que ya tiene memorizada. *@
        <button type="button" class="kpi-strip__seg kpi-strip__seg--buses kpi-strip__seg--tablero"
                @onclick="AbrirOcupacion"
                disabled="@(_cargando || _verCancelados || visibles.Count == 0)"
                title="Ocupación — tablero de barras horarias por unidad programada, con los servicios que estás viendo"
        ><MudIcon Icon="@Icons.Material.Filled.Schedule" Style="font-size:1rem;" /><span class="kpi-strip__label">Ocupación</span></button>

        @* El contador SIEMPRE está en el DOM (solo cambia su visibility) para que el botón
           nunca cambie de ancho al tildar/destildar — antes el @if lo insertaba/sacaba y el
           botón "saltaba" de tamaño (reportado 25/07/2026). *@
        <button type="button" class="kpi-strip__seg kpi-strip__seg--buses @(_verBuses ? "kpi-strip__seg--buses-on" : "")"
                @onclick="ToggleBuses"
                title="Buses — estado actual de la flota (unidad, chofer, franco)"
        >@* Sin espacios/saltos entre los hijos (25/07/2026): el botón es flex, y el whitespace
             de Razor entre tags se convierte en flex-items de texto propios, con su propia
             caja de línea — eso desalineaba verticalmente "BUSES" respecto al ícono/checkbox.
             Todo en una sola línea de markup evita esos nodos de texto fantasma. *@<span class="kpi-strip__checkbox" aria-hidden="true">@(_verBuses ? (MarkupString)"✓" : (MarkupString)"")</span><MudIcon Icon="@Icons.Material.Filled.DepartureBoard" Style="font-size:1rem;" /><span class="kpi-strip__label">Buses</span><span class="filtro-btn__count" style="visibility:@(_verBuses ? "visible" : "hidden");">@(_verBuses ? _buses.Count : 0)</span></button>
    </div>
}

@* ════════════ Grilla ════════════ *@
@if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-8" />
}
else if (_verCancelados)
{
    @* Grilla de cancelados — columnas según arma_grid_viaje_sup_cnl del FoxPro *@
    @if (_cancelados.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No hay servicios cancelados para @TituloFecha.
        </MudAlert>
    }
    else
    {
        <MudPaper Elevation="2" Class="planilla-page__grid" Style="border-radius:8px; overflow:hidden;">
            <div class="trafico-wrap">
                <table class="trafico-grid">
                    @* Anchos fijos (igual criterio que la grilla principal). *@
                    <colgroup>
                        <col style="width:34px;" />   @* Ob *@
                        <col style="width:64px;" />   @* Nro Res. *@
                        <col style="width:78px;" />   @* Reserva *@
                        <col style="width:48px;" />   @* H.Ini *@
                        <col style="width:48px;" />   @* H.Fin *@
                        <col style="width:48px;" />   @* H.Avi *@
                        <col style="width:48px;" />   @* H.Cie *@
                        <col style="width:58px;" />   @* U/Pr *@
                        <col style="width:58px;" />   @* U/Cb *@
                        <col style="width:58px;" />   @* U/As *@
                        <col style="width:36px;" />   @* Chq *@
                        <col style="width:276px;" />  @* Recorrido — 276px: 240 + 15% (18/08/2026, pedido del usuario).
                                       Sigue siendo la columna más ancha; lo que no entra trunca con …
                                       y se lee entero en el tooltip. *@
                        <col style="width:160px;" />  @* Motivo (largo → tooltip) *@
                        <col style="width:56px;" />   @* Veh — 56px: 44px útiles. Medido en el browser con la fuente
                                       de la grilla: HIACE (el tipo más largo con uso real) mide 34,7px,
                                       AUTO 30,3, MINI 27,4, BUS/VAN 22,6. Ninguno se recorta. *@
                        <col style="width:72px;" />   @* Cliente *@
                        <col style="width:42px;" />   @* Pax *@
                        <col style="width:208px;" />  @* Comentario (largo → tooltip) — +30% (03/08/2026) *@
