    // Los helpers de presentación de fila (EstadoCss / EstadoLabel / PartirRecorrido) viven
    // como public static en Components/Shared/TraficoFilaRow.razor — ahí es donde se usan en
    // el caso principal. La grilla de cancelados y el panel Buses los reusan desde acá.


    // Recalcula los conjuntos filtrados y los guarda en los campos memoizados.
    // Llamar SOLO cuando cambian los datos (_filas/_cancelados) o un filtro
    // (Emp/Tur/Nortur, combos de unidad, S/C, buscador, vista cancelados).
    private void RecalcularVisibles()
    {
        // 1) Conjunto base: TODOS los filtros menos el de estado. Alimenta los contadores de
        //    la botonera del pie (así "SIN ASIG 2 + ... + FACT 41" suma lo que muestra la grilla).
        var baseSinEstado = FilasVisibles();
        _totalSinEstado = baseSinEstado.Count;

        _conteoEstados = new Dictionary<string, int>(EstadosLeyenda.Length, StringComparer.Ordinal);
        foreach (var e in EstadosLeyenda) _conteoEstados[e] = 0;
        foreach (var f in baseSinEstado)
        {
            // Un estado fuera de la leyenda (p. ej. CANCELADO, que vive en la vista Cxl) no
            // rompe nada: simplemente no tiene botón y no se cuenta.
            if (_conteoEstados.TryGetValue(f.EstadoDisplay, out var n))
                _conteoEstados[f.EstadoDisplay] = n + 1;
        }

        // 2) Foco por estado (en memoria, sin re-query).
        _visibles = _estadosFoco.Count == 0
            ? baseSinEstado
            : baseSinEstado.Where(f => _estadosFoco.Contains(f.EstadoDisplay)).ToList();

        _canceladosVisibles = CanceladosVisibles();

        // Nº de orden 1-based por IdViaje (la grilla lo lee O(1) dentro de <Virtualize>).
        _indices = new Dictionary<int, int>(_visibles.Count);
        for (int i = 0; i < _visibles.Count; i++)
            _indices[_visibles[i].IdViaje] = i + 1;
    }

    // ── Botonera de estados de la leyenda (pie del panel) y chip de estado de cada fila ──
    // Semántica acordada con el usuario (20/07/2026, ajustada el mismo día):
    // el clic simple SUMA/QUITA — los estados se acumulan sin necesidad de Ctrl. Empezando de
    // "sin filtro", el 1er clic deja solo ese estado; el 2º clic en otro botón suma el segundo.
    // Volver a clickear un estado activo lo saca; si era el último, se ve todo de nuevo.
    // (La versión anterior era foco exclusivo con Ctrl+clic para sumar: el Ctrl no se descubría.)
    private void ToggleEstado(string estado)
    {
        // Remove devuelve false si no estaba → en ese caso se agrega.
        if (!_estadosFoco.Remove(estado)) _estadosFoco.Add(estado);
        RecalcularVisibles();
    }

    private void LimpiarEstados()
    {
        if (_estadosFoco.Count == 0) return;
        _estadosFoco.Clear();
        RecalcularVisibles();
    }

    // ── Buscador reducido: handlers + coincidencia (23/07/2026) ──────────────────
    // Placeholder que guía según el campo/modo elegido (ya no menciona "vuelo").
    private string PlaceholderBuscar => _filtroCampo switch
    {
        "chofer"    => "Buscar chofer…",
        "cliente"   => "Buscar cliente…",
        "recorrido" => _filtroRecModo switch
        {
            "desde" => "Buscar origen — de dónde sale…",
            "hasta" => "Buscar destino — a dónde va…",
            _       => "Buscar en el recorrido…",
        },
        _ => "Buscar recorrido, chofer o cliente…",
    };

    private void OnCampoBuscarChanged(string campo)
    {
        _filtroCampo = campo;
        // El sub-selector Desde/Hasta solo existe para Recorrido: al salir de Recorrido volvemos
        // a "todo" para que el modo no siga aplicándose de forma invisible en la rama "todos".
        if (campo != "recorrido") _filtroRecModo = "todo";
        RecalcularVisibles();
    }

    private void SetRecModo(string modo)
    {
        _filtroRecModo = modo;
        RecalcularVisibles();
    }

    // Contains(OrdinalIgnoreCase): case-insensitive SIN alocar strings (antes se re-uppercaseaba
    // cada campo de cada fila en cada tecla). Junto con el DebounceInterval del campo, el buscador
    // deja de recalcular en cada pulsación.
    private static bool Contiene(string? hay, string needle) =>
        hay?.Contains(needle, StringComparison.OrdinalIgnoreCase) ?? false;

    // Coincidencia sobre el Recorrido según el modo origen/destino. Reusa PartirRecorrido (mismo
    // criterio que la grilla al pintar "DESDE ➜ HASTA"): usa el largo del tramo origen que calcula
    // el SQL, no busca el ' a ' (hay tramos con ' a ' adentro). Si el recorrido no es partible
    // (sin destino), el string entero es el origen → "hasta" no matchea, "desde"/"todo" sí.
    private bool RecorridoCoincide(string recorrido, int recDesdeLen, string needle)
    {
        if (_filtroRecModo == "todo") return Contiene(recorrido, needle);
        if (TraficoFilaRow.PartirRecorrido(recorrido ?? "", recDesdeLen) is { } p)
            return Contiene(_filtroRecModo == "desde" ? p.Desde : p.Hasta, needle);
        return _filtroRecModo == "desde" && Contiene(recorrido, needle);
    }

    // Buscador reducido: SOLO Recorrido / Chofer / Cliente, con el campo elegido (todos por defecto).
    // chofer es nullable porque la grilla de cancelados no tiene esa columna.
    private bool TextoCoincide(string recorrido, int recDesdeLen, string? chofer, string cliente)
    {
        if (string.IsNullOrWhiteSpace(_filtro)) return true;
        var t = _filtro.Trim();
        return _filtroCampo switch
        {
            "recorrido" => RecorridoCoincide(recorrido, recDesdeLen, t),
            "chofer"    => Contiene(chofer, t),
            "cliente"   => Contiene(cliente, t),
            _           => RecorridoCoincide(recorrido, recDesdeLen, t)
                           || Contiene(chofer, t) || Contiene(cliente, t),
        };
    }

    // Filas que pasan todos los filtros MENOS el de estado (ese se aplica en
    // RecalcularVisibles, después de contar cuántas hay de cada estado).
    private List<PlanillaTraficoRow> FilasVisibles()
    {
        IEnumerable<PlanillaTraficoRow> q = _filas;

        // ── Filtro de tipo de ingreso: TRES categorías independientes y excluyentes ──
        // (rediseñado 22/07/2026, validado con el usuario). Cada botón es su propia categoría
        // y la grilla muestra la UNIÓN de las tildadas:
        //   • Empresa = origen 'P' que NO es interno NORTUR
        //   • Turismo = origen 'T' que NO es interno NORTUR
        //   • Nortur  = interno NORTUR (EsNortur, cualquier origen)
        // Los internos viven SOLO en Nortur (antes se contaban además en Empresa → 307 vs 299) y
        // con solo Nortur tildado se ven los internos (antes daba grilla vacía). Sin ninguno → vacío.
        // 03/08/2026: EsNortur pasó a ser id_cliente = 'NORTUR' (la columna Cliente de la grilla),
        // ya no el placeholder de diagramación por cronograma/chofer. Ver MapPlanillaRow.
        q = q.Where(f =>
            (_verEmpresa && f.Origen == "P" && !f.EsNortur) ||
            (_verTurismo && f.Origen == "T" && !f.EsNortur) ||
            (_verNortur  && f.EsNortur));

        // ── Filtro de unidad (cascada empresa → interno, 16/07/2026) ──
        // S/C excluye a los combos (como en el FoxPro). Entre los combos: el INTERNO (combo 2)
        // manda cuando está elegido — ya es un subconjunto de la empresa por la cascada del
        // combo —; si no, filtra la EMPRESA (combo 1).
        if (_soloSinCronograma)
            q = q.Where(f => f.UCb == "S/C");
        else if (!string.IsNullOrEmpty(_selUCb))
            q = q.Where(f => f.UCb == _selUCb);
        else if (_selUPr == "NORTUR")
            // "NORTUR" = la empresa propia = todas sus unidades NT#### juntas (el combo muestra
            // un único ítem NORTUR en vez de las 60+ unidades; ver GetCombosUnidadesTraficoAsync).
            q = q.Where(f => f.UPr != null && f.UPr.StartsWith("NT", StringComparison.OrdinalIgnoreCase));
        else if (!string.IsNullOrEmpty(_selUPr))
            q = q.Where(f => f.UPr == _selUPr);

        // ── Buscador de texto: SOLO Recorrido / Chofer / Cliente (campo elegido + origen/destino) ──
        if (!string.IsNullOrWhiteSpace(_filtro))
            q = q.Where(f => TextoCoincide(f.Recorrido, f.RecorridoDesdeLen, f.Chofer, f.Cliente));

        return q.ToList();
    }

    // Cancelados visibles: aplica solo el buscador de texto (los demás filtros
    // quedan deshabilitados en esta vista, igual que en el FoxPro).
    private List<TraficoCanceladoRow> CanceladosVisibles()
    {
        if (!_verCancelados) return new();

        IEnumerable<TraficoCanceladoRow> q = _cancelados;
        // Mismo buscador reducido; la grilla de cancelados no tiene columna Chofer → se pasa null
        // (si el campo elegido es "chofer", no hay dato que matchear en esta vista).
        if (!string.IsNullOrWhiteSpace(_filtro))
            q = q.Where(f => TextoCoincide(f.Recorrido, f.RecorridoDesdeLen, null, f.Cliente));
        return q.ToList();
    }

