@page "/planilla-trafico"
@inject ReportService Reports
@inject ExcelExportService Excel
@inject NorturAuthStateProvider AuthState
@inject IPermissionService Permisos
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDialogService DialogService
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>BusLink</PageTitle>

@* Columna a pantalla completa: toolbar + KPIs fijos arriba, grilla flexible abajo.
   La ventana no scrollea (body.planilla-fixed); solo scrollea la grilla. *@
<div class="planilla-page">

@* ════════════ Barra superior: navegación de día + acciones ════════════ *@
<MudPaper Class="pa-3 mb-3 planilla-page__toolbar" Elevation="2" Style="border-radius:12px;">
    <div class="d-flex align-center flex-wrap" style="gap:12px;">

        @* Navegación de día (<<  fecha  >>) *@
        <div class="d-flex align-center" style="gap:6px;">
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                           Variant="Variant.Filled" Color="Color.Primary"
                           Title="Día anterior" OnClick="DiaAnterior"
                           Disabled="@(_cargando || _filtroActivo is not null)" />
            <MudDatePicker Date="_fecha" DateFormat="dddd dd/MM/yyyy"
                           Editable="true" Style="min-width:210px;"
                           MinDate="_min" MaxDate="_max"
                           Disabled="@(_filtroActivo is not null)"
                           Culture="@_ar" PickerVariant="PickerVariant.Dialog"
                           DateChanged="OnFechaChanged" />
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                           Variant="Variant.Filled" Color="Color.Primary"
                           Title="Día siguiente" OnClick="DiaSiguiente"
                           Disabled="@(_cargando || _filtroActivo is not null)" />
            <MudButton Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Today"
                       OnClick="IrHoy" Disabled="@(_cargando || _filtroActivo is not null)">Hoy</MudButton>
        </div>

        <MudDivider Vertical="true" FlexItem="true" />

        @* Unidades (réplica de los combos cronogramaCbio/cronograma + botones S/C y Cxl del FoxPro) *@
        <div class="d-flex align-center" style="gap:6px;">
            @* Combo 1 — Unidad Programada (interno por empresa) → filtra U/Pr.
               La ✕ va como hermano del <select> (un select nativo no admite hijos que no sean
               <option>): superpuesta con z-index, se come el click y no despliega la lista. *@
            <span class="filtro-combo-wrap">
                <select class="filtro-combo @(!string.IsNullOrEmpty(_selUPr) ? "filtro-combo--activo filtro-combo--clearable" : "")"
                        disabled="@_verCancelados"
                        value="@_selUPr"
                        @onchange="@(e => OnUPrChanged(e.Value?.ToString() ?? ""))"
                        title="Empresa">
                    <option value="">Todas/Empresas</option>
                    @foreach (var u in _combos.Programadas)
                    {
                        <option value="@u">@u</option>
                    }
                </select>
                @if (!string.IsNullOrEmpty(_selUPr) && !_verCancelados)
                {
                    <button type="button" class="filtro-combo__clear"
                            @onclick="@(() => OnUPrChanged(""))"
                            title="Quitar el filtro de empresa"
                            aria-label="Quitar el filtro de empresa">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                    </button>
                }
            </span>

            @* Combo 2 — Unidad Asignada (internos) → filtra U/Cb. En cascada con el combo 1:
               con una empresa elegida solo se listan SUS internos. Su ✕ quita solo el interno:
               la empresa se conserva (volvés un paso atrás en la cascada, no al principio). *@
            <span class="filtro-combo-wrap">
                <select class="filtro-combo @(!string.IsNullOrEmpty(_selUCb) ? "filtro-combo--activo filtro-combo--clearable" : "")"
                        disabled="@_verCancelados"
                        value="@_selUCb"
                        @onchange="@(e => OnUCbChanged(e.Value?.ToString() ?? ""))"
                        title="Interno">
                    <option value="">Todos/Internos</option>
                    @foreach (var u in InternosDelCombo())
                    {
                        <option value="@u">@u</option>
                    }
                </select>
                @if (!string.IsNullOrEmpty(_selUCb) && !_verCancelados)
                {
                    <button type="button" class="filtro-combo__clear"
                            @onclick="@(() => OnUCbChanged(""))"
                            title="Quitar el filtro de interno"
                            aria-label="Quitar el filtro de interno">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                    </button>
                }
            </span>

            @* S/C — servicios sin unidad asignada (cronograma = 'S/C') *@
            <button class="filtro-btn @(_soloSinCronograma ? "filtro-btn--on" : "")"
                    disabled="@_verCancelados"
                    @onclick="ToggleSinCronograma"
                    title="S/C — servicios sin unidad asignada (sin cronograma)">
                <MudIcon Icon="@Icons.Material.Filled.EventBusy" Style="font-size:1rem;" />
                <span>S/C</span>
                <span class="filtro-btn__count">@_filas.Count(f => f.UCb == "S/C")</span>
            </button>

            @* Cxl — vista de servicios cancelados del día *@
            <button class="filtro-btn @(_verCancelados ? "filtro-btn--on filtro-btn--cxl-on" : "")"
                    @onclick="ToggleCancelados"
                    title="Cxl — ver los servicios cancelados del día (con motivo)">
                <MudIcon Icon="@Icons.Material.Filled.Cancel" Style="font-size:1rem;" />
                <span>Cxl</span>
                <span class="filtro-btn__count">@_cancelados.Count</span>
            </button>
        </div>

        <MudDivider Vertical="true" FlexItem="true" />

        @* Filtros de tipo de ingreso (réplica de los botones Emp/Tur + checkbox Nortur del FoxPro) *@
        <div class="d-flex align-center" style="gap:6px;">
            <button class="filtro-btn @(_verEmpresa ? "filtro-btn--on" : "")"
                    disabled="@_verCancelados"
                    @onclick="@(() => { _verEmpresa = !_verEmpresa; RecalcularVisibles(); })"
                    title="Empresa — servicios de plantilla (origen P)">
                <MudIcon Icon="@Icons.Material.Filled.Business" Style="font-size:1rem;" />
                <span>Empresa</span>
                <span class="filtro-btn__count">@_filas.Count(f => f.Origen == "P")</span>
                @if (_verEmpresa) {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:0.85rem; opacity:0.9;" />
                }
            </button>

            <button class="filtro-btn @(_verTurismo ? "filtro-btn--on" : "")"
                    disabled="@_verCancelados"
                    @onclick="@(() => { _verTurismo = !_verTurismo; RecalcularVisibles(); })"
                    title="Turismo — transportación turística (origen T)">
                <MudIcon Icon="@Icons.Material.Filled.Flight" Style="font-size:1rem;" />
                <span>Turismo</span>
                <span class="filtro-btn__count">@_filas.Count(f => f.Origen == "T")</span>
                @if (_verTurismo) {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:0.85rem; opacity:0.9;" />
                }
            </button>

            <button class="filtro-btn filtro-btn--nortur @(_verNortur ? "filtro-btn--on filtro-btn--nortur-on" : "")"
                    disabled="@_verCancelados"
                    @onclick="@(() => { _verNortur = !_verNortur; RecalcularVisibles(); })"
                    title="Servicios internos de NORTUR">
                <MudIcon Icon="@Icons.Material.Filled.DirectionsBus" Style="font-size:1rem;" />
                <span>Nortur</span>
                <span class="filtro-btn__count">@_filas.Count(f => f.EsNortur)</span>
                @if (_verNortur) {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:0.85rem; opacity:0.9;" />
                }
            </button>

            @* Buses — réplica del checkbox verBuses: abre el panel de flota (grid2) a la derecha *@
            <button class="filtro-btn @(_verBuses ? "filtro-btn--on" : "")"
                    disabled="@_verCancelados"
                    @onclick="ToggleBuses"
                    title="Buses — estado actual de la flota (unidad, chofer, franco)">
                <MudIcon Icon="@Icons.Material.Filled.DepartureBoard" Style="font-size:1rem;" />
                <span>Buses</span>
                @if (_verBuses) {
                    <span class="filtro-btn__count">@_buses.Count</span>
                }
            </button>
        </div>

        <MudDivider Vertical="true" FlexItem="true" />

        @* Buscador *@
        <MudTextField @bind-Value="_filtro" @bind-Value:after="RecalcularVisibles"
                      Placeholder="Buscar recorrido, chofer, cliente, vuelo..."
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" Clearable="true" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Style="min-width:240px; flex:1;" />

        <MudSpacer />

        <MudButton Variant="Variant.Filled" Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.Download"
                   OnClick="DescargarExcel"
                   Disabled="@(_cargando || (_verCancelados ? _cancelados.Count == 0 : _filas.Count == 0))">
            Excel
        </MudButton>
    </div>
</MudPaper>

@* ════════════ Banner de filtro server-side activo (Aplicar Filtros) ════════════
   Aparece cuando hay un filtro de rango aplicado. La grilla muestra el resultado de la
   re-consulta (posiblemente varios días); "Quitar filtro" vuelve a la vista de día único. *@
@if (_filtroActivo is not null)
{
    <MudPaper Class="pa-2 mb-2 d-flex align-center flex-wrap planilla-page__filtro" Elevation="0"
              Style="gap:10px; background:#FFF4E5; border:1px solid #F99410; border-radius:8px;">
        <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Style="color:#F99410;" />
        <span style="font-weight:600; color:#7A4E00;">Filtro activo:</span>
        <span style="color:#7A4E00;">@DescripcionFiltro</span>
        <span style="color:#9A6A00;">· @_filas.Count servicios</span>
        <MudSpacer />
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Edit" OnClick="EditarFiltro" Class="mr-2">
            Editar filtro
        </MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Close" OnClick="QuitarFiltro">
            Quitar filtro
        </MudButton>
    </MudPaper>
}

@{
    // Filas tras aplicar Emp/Tur/Nortur + unidades + buscador. Los KPIs y la grilla usan este mismo conjunto.
    // MEMOIZADO: se recalculan solo cuando cambian datos o filtros (ver RecalcularVisibles),
    // no en cada render. Con 300 filas, recalcular el filtro en cada re-render era parte del lag.
    var visibles = _visibles;
    var canceladosVisibles = _canceladosVisibles;
}

@if (_verCancelados)
{
    @* ════════════ Vista cancelados — réplica del caption "... SERVICIOS CANCELADOS" ════════════ *@
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-2" Dense="true">
        SERVICIOS CANCELADOS — @TituloFecha — Cantidad de Servicios: @canceladosVisibles.Count
    </MudAlert>
}
else
{
    @* ════════════ Chip de foco por estado ════════════
       La botonera vive al pie del panel (siempre visible), pero el filtro tiene que ser
       imposible de pasar por alto desde arriba: este chip lo canta al lado de los KPIs
       y lo saca de un clic. Solo aparece cuando hay estados enfocados. *@
    @if (_estadosFoco.Count > 0)
    {
        <div class="estado-foco mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Flag" Style="font-size:1rem;" />
            <span>Filtrado por estado:</span>
            @foreach (var est in EstadosLeyenda.Where(_estadosFoco.Contains))
            {
                <span class="estado-foco__pill" style="@EstadoLeyendaFondo(est)">@TraficoFilaRow.EstadoLabel(est)</span>
            }
            <span class="estado-foco__cuenta">@visibles.Count de @_totalSinEstado servicios</span>
            <button type="button" class="estado-foco__quitar" @onclick="LimpiarEstados"
                    title="Quitar el filtro de estado">
                <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:0.9rem;" />
                <span>Quitar</span>
            </button>
        </div>
    }

    @* ════════════ KPIs del día ════════════ *@
    <div class="d-flex mb-2 planilla-page__kpis" style="gap:10px;">
        <div style="flex:1;">
            <KpiCard Label="Servicios" Value="@Fmt(visibles.Count)"
                     Sub="@(_filtroActivo is not null ? DescripcionFiltro : TituloFecha)" Color="@NorturColors.Azul" />
        </div>
        <div style="flex:1;">
            <KpiCard Label="Total pax" Value="@Fmt(visibles.Sum(f => f.Pax ?? 0))"
                     Sub="pasajeros del día" Color="@NorturColors.Verde" />
        </div>
        <div style="flex:1;">
            <KpiCard Label="Choferes" Value="@visibles.Where(f => !string.IsNullOrWhiteSpace(f.Chofer)).Select(f => f.Chofer).Distinct().Count().ToString()"
                     Sub="distintos asignados" Color="@NorturColors.Naranja" />
        </div>
        <div style="flex:1;">
            @* EstadoDisplay (no el estado crudo): así este número coincide SIEMPRE con el
               contador del botón SIN ASIGNAR de la leyenda. Las chequeadas se cuentan aparte,
               en el botón CHEQUEO — que es como se ven en la grilla (fila celeste). *@
            <KpiCard Label="Sin asignar" Value="@visibles.Count(f => f.EstadoDisplay == "SIN ASIGNAR").ToString()"
                     Sub="servicios pendientes" Color="@NorturColors.Rojo" />
        </div>
    </div>
}

@* ════════════ Grilla ════════════ *@
@if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-8" />
}
else if (_verCancelados)
{
    @* Grilla de cancelados — columnas según arma_grid_viaje_sup_cnl del FoxPro *@
    @if (_cancelados.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No hay servicios cancelados para @TituloFecha.
        </MudAlert>
    }
    else
    {
        <MudPaper Elevation="2" Class="planilla-page__grid" Style="border-radius:8px; overflow:hidden;">
            <div class="trafico-wrap">
                <table class="trafico-grid">
                    @* Anchos fijos (igual criterio que la grilla principal). *@
                    <colgroup>
                        <col style="width:30px;" />   @* # *@
                        <col style="width:34px;" />   @* Ob *@
                        <col style="width:34px;" />   @* Ad *@
                        <col style="width:78px;" />   @* Reserva *@
                        <col style="width:48px;" />   @* H.Ini *@
                        <col style="width:48px;" />   @* H.Fin *@
                        <col style="width:48px;" />   @* H.Avi *@
                        <col style="width:48px;" />   @* H.Cie *@
                        <col style="width:58px;" />   @* U/Pr *@
                        <col style="width:58px;" />   @* U/Cb *@
                        <col style="width:58px;" />   @* U/As *@
                        <col style="width:36px;" />   @* Chq *@
                        <col style="width:240px;" />  @* Recorrido (largo → tooltip) *@
                        <col style="width:160px;" />  @* Motivo (largo → tooltip) *@
                        <col style="width:46px;" />   @* Veh *@
                        <col style="width:72px;" />   @* Cliente *@
                        <col style="width:42px;" />   @* Pax *@
                        <col style="width:160px;" />  @* Comentario (largo → tooltip) *@
                        <col style="width:96px;" />   @* Grupo *@
                        <col style="width:84px;" />   @* Vuelo *@
                        <col style="width:72px;" />   @* Guia *@
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="r" data-tooltip="Número de orden">#</th>
                            <th class="c" data-tooltip="Observaciones del viaje">Ob</th>
                            <th class="c" data-tooltip="Adjuntos vinculados al viaje">Ad</th>
                            <th data-tooltip="Fecha de la reserva">Reserva</th>
                            <th data-tooltip="Hora de inicio del servicio">H.Ini</th>
                            <th data-tooltip="Hora de fin del servicio (estimada)">H.Fin</th>
                            <th data-tooltip="Hora de aviso previo al cliente">H.Avi</th>
                            <th data-tooltip="Hora de cierre del servicio">H.Cie</th>
                            <th data-tooltip="Unidad programada (vehículo asignado en la programación)">U/Pr</th>
                            <th data-tooltip="Unidad de cabecera">U/Cb</th>
                            <th data-tooltip="Unidad asignada definitivamente al viaje">U/As</th>
                            <th class="c" data-tooltip="Chequeo: el chofer confirmó el servicio">Chq</th>
                            <th data-tooltip="Recorrido completo del viaje (origen → destino)">Recorrido</th>
                            <th data-tooltip="Motivo registrado de la cancelación">Motivo</th>
                            <th data-tooltip="Número interno del vehículo asignado">Veh</th>
                            <th data-tooltip="Código del cliente que solicitó el servicio">Cliente</th>
                            <th class="r" data-tooltip="Cantidad de pasajeros confirmados">Pax</th>
                            <th data-tooltip="Observaciones internas del operador">Comentario</th>
                            <th data-tooltip="Grupo de reservas al que pertenece este viaje">Grupo</th>
                            <th data-tooltip="Número de vuelo asociado al traslado">Vuelo</th>
                            <th data-tooltip="Guía de turismo asignado al servicio">Guia</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int _nroCxl = 0; }
                        @foreach (var f in canceladosVisibles)
                        {
                            _nroCxl++;
                            var esActivaCxl = _filaActiva == f.IdViaje;
                            <tr @key="f.IdViaje"
                                class="@(esActivaCxl ? "fila-activa" : "")"
                                style="cursor:pointer;"
                                title="Doble click para ver el detalle del viaje"
                                @onclick="() => _filaActiva = (_filaActiva == f.IdViaje ? 0 : f.IdViaje)"
                                @ondblclick="() => AbrirZoom(f.IdViaje, f.Fecha)">
                                <td class="r" style="color:#9AA7BC; font-size:0.72rem;">@_nroCxl</td>
                                <td class="c">@f.Ob</td>
                                <td class="c">@f.Ad</td>
                                @* title propio: pisa el del <tr> para mostrar el nº de reserva (en cancelados no hay chip Estado) *@
                                <td title="Reserva Nº @f.IdViaje">@f.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@f.HIni</td>
                                <td>@f.HFin</td>
                                <td>@f.HAvi</td>
                                <td>@f.HCie</td>
                                <td>@f.UPr</td>
                                <td>@f.UCb</td>
                                <td>@f.UAs</td>
                                <td class="c">@f.Chq</td>
                                @* Recorrido "DESDE ➜ HASTA" — mismo tratamiento que la vista normal. *@
                                <td class="td-bold" title="@f.Recorrido">
                                    @if (TraficoFilaRow.PartirRecorrido(f.Recorrido, f.RecorridoDesdeLen) is { } rec)
                                    {
                                        @rec.Desde<span class="rec-flecha"> ➜ </span>@rec.Hasta
                                    }
                                    else
                                    {
                                        @f.Recorrido
                                    }
                                </td>
                                <td style="color:#DC2626; font-weight:600;" title="@f.Motivo">@f.Motivo</td>
                                <td>@f.Veh</td>
                                <td>@f.Cliente</td>
                                <td class="r">@f.Pax</td>
                                <td title="@f.Comentario">@f.Comentario</td>
                                <td>@(string.IsNullOrWhiteSpace(f.Grupo) ? "SIN GRUPO" : f.Grupo)</td>
                                <td>@(string.IsNullOrWhiteSpace(f.Vuelo) ? "SIN VUELO" : f.Vuelo)</td>
                                <td>@(string.IsNullOrWhiteSpace(f.Guia) ? "SIN GUIA" : f.Guia)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </MudPaper>

        <div class="d-flex align-center flex-wrap mt-2" style="gap:14px; font-size:0.78rem; color:#5B6B82;">
            <span style="margin-left:auto;">@canceladosVisibles.Count de @_cancelados.Count servicios cancelados</span>
        </div>
    }
}
else
{
    @* Layout flexible: planilla a la izquierda + panel Buses (grid2) a la derecha,
       igual que el FoxPro cuando se tilda verBuses (grid1 se achica, grid2 aparece). *@
    <div class="trafico-layout">
    <div class="trafico-layout__main">

    @if (_filas.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No hay servicios cargados para @TituloFecha. Usá las flechas para cambiar de día.
        </MudAlert>
    }
    else
    {
    <MudPaper Elevation="2" Class="trafico-panel" Style="border-radius:8px; overflow:hidden;">
        @* tabindex="0" hace focuseable el contenedor scrolleable para capturar las flechas
           ↑/↓ SOLO cuando la grilla tiene el foco (no roba el teclado al buscador ni al
           datepicker). @onkeydown:preventDefault frena el scroll nativo del navegador en
           ↑/↓/Enter; el resto de teclas pasa normal. Ver OnGridKeyDown / MoverSeleccion. *@
        <div class="trafico-wrap trafico-wrap--nav" tabindex="0"
             @ref="_gridWrap"
             @onkeydown="OnGridKeyDown"
             @onkeydown:preventDefault="_preventDefaultTecla">
            <table class="trafico-grid trafico-grid--filas-fijas">
                @* Anchos FIJOS por columna (table-layout:fixed en app.css los respeta).
                   Calibrados al contenido típico: las largas (Recorrido/Chofer/Comentario)
                   truncan con … y muestran el texto completo en el tooltip (title). *@
                <colgroup>
                    <col style="width:30px;" />   @* # *@
                    <col style="width:106px;" />  @* Estado (chip — ancho fijo uniforme) *@
                    <col style="width:78px;" />   @* Reserva dd/MM/yyyy *@
                    <col style="width:48px;" />   @* H.Pre *@
                    <col style="width:48px;" />   @* H.Ini *@
                    <col style="width:48px;" />   @* H.Fin *@
                    <col style="width:48px;" />   @* H.Avi *@
                    <col style="width:48px;" />   @* H.Cie *@
                    <col style="width:58px;" />   @* U/Pr *@
                    <col style="width:58px;" />   @* U/Cb *@
                    <col style="width:58px;" />   @* U/As *@
                    <col style="width:36px;" />   @* Chq *@
                    <col style="width:32px;" />   @* Ag *@
                    <col style="width:240px;" />  @* Recorrido (largo → tooltip) *@
                    <col style="width:82px;" />   @* Fletero *@
                    <col style="width:170px;" />  @* Chofer (largo → tooltip) *@
                    <col style="width:46px;" />   @* Veh *@
                    <col style="width:72px;" />   @* Cliente *@
                    <col style="width:42px;" />   @* Pax *@
                    <col style="width:46px;" />   @* Agua *@
                    <col style="width:40px;" />   @* Adj *@
                    <col style="width:160px;" />  @* Comentario (largo → tooltip) *@
                    <col style="width:96px;" />   @* Grupo *@
                    <col style="width:84px;" />   @* Vuelo *@
                    <col style="width:72px;" />   @* Guia *@
                </colgroup>
                <thead>
                    <tr>
                        <th class="r" data-tooltip="Número de orden del servicio del día">#</th>
                        <th data-tooltip="Estado actual: SIN ASIGNAR / ASIGNADO / EN CURSO / FINALIZADO / FACTURADO">Estado</th>
                        <th data-tooltip="Fecha de la reserva">Reserva</th>
                        <th data-tooltip="Hora de presentación del chofer en origen">H.Pre</th>
                        <th data-tooltip="Hora de inicio del servicio">H.Ini</th>
                        <th data-tooltip="Hora de fin del servicio (estimada)">H.Fin</th>
                        <th data-tooltip="Hora de aviso previo al cliente">H.Avi</th>
                        <th data-tooltip="Hora de cierre del servicio">H.Cie</th>
                        <th data-tooltip="Unidad programada (vehículo asignado en la programación)">U/Pr</th>
                        <th data-tooltip="Unidad de cabecera">U/Cb</th>
                        <th data-tooltip="Unidad asignada definitivamente al viaje">U/As</th>
                        <th class="c" data-tooltip="Chequeo: el chofer confirmó el servicio">Chq</th>
                        <th class="c" data-tooltip="Agencia u operador intermediario">Ag</th>
                        <th data-tooltip="Recorrido completo del viaje (origen → destino)">Recorrido</th>
                        <th data-tooltip="Empresa propietaria del vehículo (NORTUR u otro fletero)">Fletero</th>
                        <th data-tooltip="Nombre del chofer asignado al servicio">Chofer</th>
                        <th data-tooltip="Número interno del vehículo asignado">Veh</th>
                        <th data-tooltip="Código del cliente que solicitó el servicio">Cliente</th>
                        <th class="r" data-tooltip="Cantidad de pasajeros confirmados">Pax</th>
                        <th class="c" data-tooltip="Litros de agua requeridos para el servicio">Agua</th>
                        <th class="c" data-tooltip="Adjuntos: documentos o archivos vinculados al viaje">Adj</th>
                        <th data-tooltip="Observaciones internas del operador">Comentario</th>
                        <th data-tooltip="Grupo de reservas al que pertenece este viaje">Grupo</th>
                        <th data-tooltip="Número de vuelo asociado al traslado">Vuelo</th>
                        <th data-tooltip="Guía de turismo asignado al servicio">Guia</th>
                    </tr>
                </thead>
                <tbody>
                    @* <Virtualize>: mantiene en el DOM solo las filas del viewport + OverscanCount
                       (medido: 82 en un día de 331), no las ~400 del día. Blazor diffea ese puñado
                       en cada interacción → el patch SignalR es chico y la UI responde.

                       ItemSize=AltoFila (20) DEBE ser el alto REAL de fila en px — está fijado en
                       app.css (.trafico-grid--filas-fijas tbody tr.tg-row {height:20px} +
                       line-height 16px). Al coincidir EXACTO, Virtualize no acumula error en la
                       posición de los spacers → el scroll no salta. Si cambia uno, cambian los dos.

                       SpacerElement="tr": CRÍTICO porque <Virtualize> está dentro de un <tbody>.
                       Por defecto inserta sus spacers como <div>, y un <div> hijo directo de
                       <tbody> es HTML inválido → el navegador lo reubica y el cálculo de scroll se
                       rompe. (Doc oficial .NET 10, "Control the spacer element tag name".)

                       ⚠ LIMITACIÓN CONOCIDA, MEDIDA Y ACEPTADA (18/07/2026): con scroll RÁPIDO la
                       grilla queda un instante en blanco (6 de 6 saltos en la medición) — el
                       scroll le gana al round-trip de SignalR. Es arquitectural de <Virtualize>
                       en Blazor Server.

                       Se probó DOS VECES el camino contrario (render completo + content-visibility)
                       y las dos veces se revirtió. La 2ª vez (18/07/2026) fue CON el gate de fila
                       ya puesto y con mediciones: elimina el blanco (0/6) pero degrada la
                       interacción — click→selección 146→689 ms, ráfaga de flechas 335→2004 ms,
                       menú contextual 109→271 ms. Con 331 componentes, el costo no es el diff de
                       cada fila (el gate lo evita) sino que Blazor VISITA el árbol entero en cada
                       render del padre. Conclusión: 689 ms en el click es peor que el parpadeo.

                       Mitigación vigente: filas fantasma bajo el hueco (app.css) — el blanco se
                       lee como "cargando" en vez de "se rompió".

                       Mediciones completas y qué NO volver a intentar:
                       docs/performance/PENDIENTE_GRILLA_TRAFICO_BLANQUEO.md — leerlo ANTES de
                       tocar esto de nuevo. *@
                    <Virtualize Items="visibles" Context="f" ItemSize="AltoFila" OverscanCount="20"
                                SpacerElement="tr">
                        @* Al agregar una dependencia nueva a la fila: sumarla como [Parameter] Y
                           compararla en el ShouldRender de TraficoFilaRow — ver el aviso ahí.
                           Si no, la celda queda desactualizada (el gate se come el render). *@
                        <TraficoFilaRow @key="f.IdViaje"
                                        Fila="f"
                                        Nro="_indices.GetValueOrDefault(f.IdViaje)"
                                        EsActiva="_filaActiva == f.IdViaje"
                                        EsFlash="_filasCambiadas.Contains(f.IdViaje)"
                                        OnClick="fila => SeleccionarFilaClick(fila.IdViaje)"
                                        OnDobleClick="fila => AbrirZoom(fila.IdViaje, fila.Fecha)"
                                        OnMenuContexto="arg => AbrirMenuContexto(arg.E, arg.Fila)"
                                        OnEstadoClick="ToggleEstado" />
                    </Virtualize>
                </tbody>
            </table>
        </div>

        @* Referencia de colores (leyenda) + estado del auto-refresh.
           Va DENTRO del panel, debajo de .trafico-wrap: la tabla scrollea y esta
           barra queda fija al pie del panel, siempre visible. *@
        <div class="trafico-pie d-flex align-center flex-wrap" style="gap:14px; font-size:0.78rem; color:#5B6B82;">
            @* La leyenda de colores es TAMBIÉN la botonera de filtro por estado (20/07/2026).
               Semántica (decidida con el usuario): el clic SUMA/QUITA estados — se acumulan,
               sin Ctrl. Reclic en un estado activo lo saca; sacar el último = ver todo.
               Filtra por EstadoDisplay (el estado PINTADO, con CURSO y CHEQUEO derivados como
               el FoxPro), NO por viaje.estado_via crudo: el botón filtra lo que el color dice. *@
            <span style="font-weight:600;">Estados:</span>
            @foreach (var est in EstadosLeyenda)
            {
                var on = _estadosFoco.Contains(est);
                var cuenta = _conteoEstados.GetValueOrDefault(est);
                var etiqueta = TraficoFilaRow.EstadoLabel(est);
                @* Un estado sin servicios se deshabilita: filtrarlo solo llevaría a una grilla
                   vacía. Si está enfocado NO se deshabilita, para poder sacarle el foco. *@
                <button type="button"
                        class="leyenda leyenda--btn @(on ? "leyenda--on" : "") @(_estadosFoco.Count > 0 && !on ? "leyenda--off" : "")"
                        style="@EstadoLeyendaFondo(est)"
                        disabled="@(cuenta == 0 && !on)"
                        title="@(cuenta == 0 && !on
                                 ? $"No hay servicios en {etiqueta}"
                                 : on
                                 ? $"Quitar {etiqueta} del filtro"
                                 : _estadosFoco.Count == 0
                                 ? $"Ver solo los servicios en {etiqueta}"
                                 : $"Sumar {etiqueta} al filtro")"
                        @onclick="() => ToggleEstado(est)">
                    <span>@etiqueta</span>
                    <span class="leyenda__count">@cuenta</span>
                    @if (on)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:0.8rem;" />
                    }
                </button>
            }
            @if (_estadosFoco.Count > 0)
            {
                <button type="button" class="leyenda-todos" @onclick="LimpiarEstados"
                        title="Quitar el filtro de estado y ver todos los servicios">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:0.85rem;" />
                    <span>Ver todos</span>
                </button>
            }
            else
            {
                @* Hint: sin él, que los botones se acumulen no se descubre hasta probarlo.
                   Solo cuando NO hay filtro (ya con uno puesto, "Ver todos" ocupa el lugar). *@
                <span class="leyenda-hint">clic para sumar o quitar estados</span>
            }
            @* Clase propia (no solo el margin-left): los tests leen de acá el "N de M servicios"
               sin que el regex se coma el contador del botón de estado anterior. *@
            <span class="trafico-pie__cuenta" style="margin-left:auto;">
                @visibles.Count de @_filas.Count servicios
                @if (_filtroActivo is null && _fecha is not null && EsFechaViva(DateOnly.FromDateTime(_fecha.Value)))
                {
                    @if (_ultimoRefresh is not null)
                    {
                        <span title="La planilla chequea cambios en la base cada 60 segundos y se actualiza sola">
                            · <span style="color:#16A34A;">●</span> actualizado @_ultimoRefresh.Value.ToString("HH:mm:ss") · auto 60s
                        </span>
                    }
                }
                else if (_filtroActivo is not null)
                {
                    <span title="Con un filtro de rango activo la planilla muestra un resultado fijo y no se auto-actualiza. Quitá el filtro para volver a la vista de día con auto-actualización.">
                        · <span style="color:#F99410;">●</span> filtro activo · sin auto-actualización
                    </span>
                }
                else
                {
                    <span title="Fecha histórica: Metrocar ya no modifica estos datos, así que la planilla no se auto-actualiza (se cargó una sola vez).">
                        · <span style="color:#9AA7BC;">●</span> histórico · sin auto-actualización
                    </span>
                }
            </span>
        </div>
    </MudPaper>
    }

    </div>

    @* ════════════ Panel Buses — réplica de grid2 (arma_grid_vehiculo) ════════════ *@
    @if (_verBuses)
    {
        <MudPaper Elevation="2" Class="buses-panel" Style="border-radius:8px; overflow:hidden;">
            <div class="buses-panel__header">
                <MudIcon Icon="@Icons.Material.Filled.DepartureBoard" Style="font-size:1rem;" />
                <span>Buses — estado de flota</span>
                <span style="margin-left:auto; font-weight:400; opacity:.85;">@_buses.Count unidades</span>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                               Style="color:#fff; margin:-4px -6px -4px 0;"
                               title="Cerrar panel" OnClick="ToggleBuses" />
            </div>
            <div class="trafico-wrap buses-panel__wrap">
                <table class="trafico-grid">
                    <thead>
                        <tr>
                            <th class="sortable" @onclick='() => OrdenarBuses("Fletero")'>Fletero@(SortFlecha("Fletero"))</th>
                            <th class="sortable r" @onclick='() => OrdenarBuses("Interno")'>Interno@(SortFlecha("Interno"))</th>
                            <th class="sortable" @onclick='() => OrdenarBuses("Chofer")'>Chofer@(SortFlecha("Chofer"))</th>
                            <th class="sortable" @onclick='() => OrdenarBuses("Chofer2")'>2ª Chofer@(SortFlecha("Chofer2"))</th>
                            <th class="sortable c" @onclick='() => OrdenarBuses("Franco")'>Franco@(SortFlecha("Franco"))</th>
                            <th class="sortable" @onclick='() => OrdenarBuses("Estado")'>Estado@(SortFlecha("Estado"))</th>
                            <th class="sortable r" @onclick='() => OrdenarBuses("IdViaje")'>Nº Viaje@(SortFlecha("IdViaje"))</th>
                            <th class="sortable" @onclick='() => OrdenarBuses("Zona")'>Zona@(SortFlecha("Zona"))</th>
                            <th class="sortable" @onclick='() => OrdenarBuses("Nextel")'>Nextel@(SortFlecha("Nextel"))</th>
                            <th class="sortable r" @onclick='() => OrdenarBuses("Pax")'>Pax@(SortFlecha("Pax"))</th>
                            <th class="sortable" @onclick='() => OrdenarBuses("Vehiculo")'>Vehiculo@(SortFlecha("Vehiculo"))</th>
                            <th class="sortable" @onclick='() => OrdenarBuses("HsInicio")'>Hs. Inicio@(SortFlecha("HsInicio"))</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in BusesVisibles())
                        {
                            <tr class="@TraficoFilaRow.EstadoCss(b.Estado)">
                                <td>@b.Fletero</td>
                                <td class="r">@b.Interno</td>
                                <td>@b.Chofer</td>
                                <td>@b.Chofer2</td>
                                <td class="c">@b.Franco</td>
                                <td>@b.Estado</td>
                                <td class="r">@(b.IdViaje is > 0 ? b.IdViaje : null)</td>
                                <td>@b.Zona</td>
                                <td>@b.Nextel</td>
                                <td class="r">@b.Pax</td>
                                <td>@b.Vehiculo</td>
                                <td>@(b.HsInicio?.ToString("dd/MM HH:mm") ?? "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </MudPaper>
    }

    </div>
}

@* ════════════ Menú contextual (botón derecho) — réplica del popup de Tráfico FoxPro (trafico2.scx) ════════════
   UN solo MudMenu compartido para TODA la grilla. No se pone uno por fila: con <Virtualize> y ~400
   filas sería un derroche y rompería el render. Se dispara por programa desde el @oncontextmenu de
   cada fila (AbrirMenuContexto), se posiciona en el cursor (PositionAtCursor) y recuerda la fila
   clickeada en _filaCtx; los ítems actúan sobre esa fila.

   PRIMER LOTE = infraestructura + 1 demo: solo "Ver detalle del viaje" está activo (reusa el Zoom).
   El resto se muestra DESHABILITADO para dejar a la vista la forma del menú del Metrocar. Los de
   ESCRITURA (Novedad, Mantenimiento Viajes, Copiar Cronogramas) seguirán en FoxPro hasta que se
   migre la escritura de Tráfico (regla estranguladora: Blazor en Tráfico es SOLO LECTURA). *@
<MudMenu @ref="_menuCtx" PositionAtCursor="true" Dense="true">
    <ActivatorContent>
        @* Sin activador visible: el menú se abre por programa con el click derecho de la fila. *@
        <span style="display:none;"></span>
    </ActivatorContent>
    <ChildContent>
        <MudMenuItem Icon="@Icons.Material.Filled.ZoomIn" OnClick="VerDetalleContexto">
            Ver detalle del viaje
        </MudMenuItem>
        <MudDivider />
        @* GPS — promovidos al menú principal (antes anidados bajo "Ubicar en GPS", popup
           "ubicarengp" de trafico2.scx). Quedan sueltos, uno debajo del otro, para que se
           vean directamente sin abrir un submenú. Cada uno abre el sitio GPS (hoy
           metrocar.nortur.ar) en una pestaña nueva, igual que el Shell.Open del método
           ubicar_gps. "Recorrido en Grilla" se eliminó (el endpoint Inf_Hist.aspx del sitio
           nuevo da 404). Se deshabilitan si la fila no tiene una unidad válida para ubicar. *@
        @* Ambos ítems GPS se habilitan SOLO para unidades de la flota propia NORTUR
           (código NT####): son las únicas con GPS propio. *@
        <MudMenuItem Icon="@Icons.Material.Filled.MyLocation"
                     Disabled="@(_filaCtx is null || !EsUnidadNortur(_filaCtx))"
                     OnClick="UbicarUnidadGps">Ubicar unidad</MudMenuItem>
        @* "Recorrido en WEB" — solo habilitado para viajes de los últimos 45 días Y con unidad
           de la flota NORTUR (código NT####), que son las que tienen GPS propio con histórico
           de recorrido. Fuera de ese rango / fletero externo → el GPS no tiene el dato. *@
        <MudMenuItem Icon="@Icons.Material.Filled.Map"
                     Disabled="@(_filaCtx is null || !RecorridoWebHabilitado(_filaCtx))"
                     OnClick="RecorridoWebGps">Recorrido en WEB</MudMenuItem>
        <MudDivider />
        <MudMenuItem Icon="@Icons.Material.Filled.Refresh" Disabled="true" style="display:none">Refresh</MudMenuItem>
        @* "Novedad sobre el viaje" — SOLO LECTURA: el FoxPro daba de alta una novedad en
           `libro_novedad`; acá listamos las novedades ya cargadas de ese viaje (la escritura
           sigue en FoxPro). Diálogo NovedadViajeDialog. *@
        <MudMenuItem Icon="@Icons.Material.Filled.NoteAlt" OnClick="VerNovedadesContexto">Novedad sobre el viaje</MudMenuItem>
        <MudDivider />
        <MudMenuItem Icon="@Icons.Material.Filled.FilterAlt" Disabled="true">Aplicar Filtros s/viaje ▸</MudMenuItem>
        @* Aplicar Filtros — submenú server-side: re-consulta `viaje` por rango de fechas
           (réplica de la rama "Aplicar Filtros" de arma_grid_viaje). Por ahora está activo
           "Rango de Fechas" (el fundacional); el resto se va sumando con la misma mecánica. *@
        @* StartIcon (no Icon): con Icon, un MudMenu anidado renderiza solo el ícono y oculta el Label. *@
        <MudMenu Label="Aplicar Filtros" StartIcon="@Icons.Material.Filled.FilterList" Dense="true">
            <MudMenuItem Icon="@Icons.Material.Filled.DateRange" OnClick="@(() => FiltrarRangoFechas())">Rango de Fechas</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Category" OnClick="@(() => FiltrarTipoReserva())">Tipo de Reserva</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.LocalShipping" OnClick="@(() => FiltrarFletero())">Fleteros</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Badge" OnClick="@(() => FiltrarConductor())">Conductores</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.DirectionsBus" OnClick="@(() => FiltrarInterno())">Nº Interno</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Flag" OnClick="@(() => FiltrarEstado())">Estados de la Reserva</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Flight" OnClick="@(() => FiltrarVuelo())">Números de Vuelos</MudMenuItem>
            <MudDivider />
            <MudMenuItem Disabled="true">Cliente y Grupo</MudMenuItem>
            <MudMenuItem Disabled="true">Cliente y Varios Grupos</MudMenuItem>
            <MudDivider />
            <MudMenuItem Icon="@Icons.Material.Filled.Numbers" OnClick="@(() => FiltrarReserva())">Nº Reserva</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.AltRoute" OnClick="@(() => FiltrarReservaRuta())">Nº Reserva En Ruta</MudMenuItem>
        </MudMenu>
        <MudDivider />
        <MudMenuItem Icon="@Icons.Material.Filled.Print" Disabled="true" style="display:none">Imprimir ▸</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.GridOn" Disabled="true" style="display:none">Exportar a Excel ▸</MudMenuItem>
        <MudDivider />
        <MudMenuItem Icon="@Icons.Material.Filled.EditNote" Disabled="true">Mantenimiento Viajes ▸</MudMenuItem>
        @* "Lista de pasajeros" — SOLO LECTURA: muestra la planilla CNRT del viaje si está
           generada (viaje_pasajero + detalle); si no, avisa que no hay lista. Diálogo
           ListaPasajerosDialog. La carga/impresión sigue en FoxPro. *@
        <MudMenuItem Icon="@Icons.Material.Filled.People" OnClick="VerListaPasajerosContexto">Lista de pasajeros</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.History" OnClick="VerHistorialContexto">Historia del viaje</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.ContentCopy" Disabled="true" style="display:none">Copiar Cronogramas</MudMenuItem>
        @* Ver Datos Extras — submenú anidado (réplica del popup "verdatosex" de trafico2.scx).
           Abre la ficha de solo lectura del Vehículo / Cliente / Chofer de la fila clickeada,
           reusando los diálogos que ya existen (VehiculoDetalleDialog / ClienteDetalleDialog /
           ChoferDetalleDialog). Cada ítem se deshabilita si la fila no tiene esa clave (ej. un
           servicio sin unidad asignada no tiene id_vehicul). Operador / Adjunto / Recorrido /
           Adicionales quedan fuera de este lote (mantienen la forma del menú del FoxPro).
           StartIcon (no Icon): con Icon, un MudMenu anidado oculta el Label. *@
        <MudMenu Label="Ver Datos Extras" StartIcon="@Icons.Material.Filled.MoreHoriz" Dense="true">
            <MudMenuItem Icon="@Icons.Material.Filled.SupportAgent"
                         Disabled="@(string.IsNullOrWhiteSpace(_filaCtx?.IdOperador))"
                         OnClick="VerDatosOperador">Ver Datos Operador</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.DirectionsBus"
                         Disabled="@(string.IsNullOrWhiteSpace(_filaCtx?.IdVehiculo))"
                         OnClick="VerDatosVehiculo">Ver Datos Vehículo</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Badge"
                         Disabled="@(string.IsNullOrWhiteSpace(_filaCtx?.IdChofer) || _filaCtx?.IdChofer == "NORTUR")"
                         OnClick="VerDatosChofer">Ver Datos Chofer</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.ManageAccounts"
                         Disabled="@(string.IsNullOrWhiteSpace(_filaCtx?.Cliente))"
                         OnClick="VerDatosCliente">Ver Datos Cliente</MudMenuItem>
            <MudDivider />
            @* Ver Adjunto — abre el archivo de viaje.file (PDF/imagen) en pestaña nueva.
               Se deshabilita si la fila no tiene adjunto. *@
            <MudMenuItem Icon="@Icons.Material.Filled.AttachFile"
                         Disabled="@(string.IsNullOrWhiteSpace(_filaCtx?.Adjunto))"
                         OnClick="VerAdjunto">Ver Adjunto</MudMenuItem>
            @* Ver Recorrido — texto del circuito de cabecera (viaje.gps_cod → cabecera.recorrido). *@
            <MudMenuItem Icon="@Icons.Material.Filled.Route"
                         Disabled="@(string.IsNullOrWhiteSpace(_filaCtx?.GpsCod))"
                         OnClick="VerRecorrido">Ver Recorrido</MudMenuItem>
            @* Ver Adicionales — grilla de viaje_adicional del viaje (siempre habilitado; el
               diálogo avisa si no hay adicionales, igual que el form FoxPro). *@
            <MudMenuItem Icon="@Icons.Material.Filled.AddShoppingCart"
                         OnClick="VerAdicionales">Ver Adicionales</MudMenuItem>
        </MudMenu>
    </ChildContent>
</MudMenu>

</div>@* /.planilla-page *@

@code {
    private readonly System.Globalization.CultureInfo _ar =
        System.Globalization.CultureInfo.GetCultureInfo("es-AR");
    private readonly DateTime _min = ReportService.FechaMinValida.ToDateTime(TimeOnly.MinValue);
    private readonly DateTime _max = ReportService.FechaMaxValida.ToDateTime(TimeOnly.MinValue);

    private DateTime? _fecha = DateTime.Today;
    private string _filtro = "";
    private List<PlanillaTraficoRow> _filas = new();
    private bool _cargando;
    private int _filaActiva;   // IdViaje de la fila seleccionada por click/teclado (0 = ninguna)

    // ── Navegación por teclado (↑/↓ mueven la selección; Enter abre el Zoom) ──
    // Alto de fila en px. DEBE coincidir con ItemSize de <Virtualize> y con el alto real
    // de .tg-row en app.css (20px). Lo usa el scroll programático para ubicar la fila activa.
    private const int AltoFila = 20;
    // Contenedor scrolleable de la grilla principal; se enfoca para recibir el teclado y se
    // le calcula el scroll para mantener visible la fila activa.
    private ElementReference _gridWrap;
    // Controla @onkeydown:preventDefault de forma dinámica: solo frenamos el scroll nativo
    // del navegador en las teclas que manejamos (↑/↓/Enter/Home/End), no en el resto.
    private bool _preventDefaultTecla;
    // Throttle del key-repeat: en Blazor Server cada keydown es un round-trip SignalR. Si el
    // usuario MANTIENE apretada la flecha, ignoramos los ticks que llegan a menos de ~45ms del
    // anterior para no saturar el canal. flecha-flecha-flecha normal pasa siempre.
    private DateTime _ultimaTecla = DateTime.MinValue;
    private static readonly TimeSpan ThrottleTecla = TimeSpan.FromMilliseconds(45);

    // Menú contextual (botón derecho): un único MudMenu compartido para toda la grilla.
    // _filaCtx = la fila sobre la que se hizo click derecho; los ítems del menú la usan.
    private MudMenu _menuCtx = default!;
    private PlanillaTraficoRow? _filaCtx;

