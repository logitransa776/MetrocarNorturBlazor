                        <tr>
                            <th class="sortable" @onclick='() => OrdenarBuses("Fletero")'>Fletero@(SortFlecha("Fletero"))</th>
                            <th class="sortable r" @onclick='() => OrdenarBuses("Interno")'>Interno@(SortFlecha("Interno"))</th>
                            <th class="sortable" @onclick='() => OrdenarBuses("Chofer")'>Chofer@(SortFlecha("Chofer"))</th>
                            <th class="sortable" @onclick='() => OrdenarBuses("Chofer2")'>2ª Chofer@(SortFlecha("Chofer2"))</th>
                            <th class="sortable c" @onclick='() => OrdenarBuses("Franco")'>Franco@(SortFlecha("Franco"))</th>
                            <th class="sortable" @onclick='() => OrdenarBuses("Estado")'>Estado@(SortFlecha("Estado"))</th>
                            <th class="sortable r" @onclick='() => OrdenarBuses("IdViaje")'>Nº Viaje@(SortFlecha("IdViaje"))</th>
                            <th class="sortable" @onclick='() => OrdenarBuses("Zona")'>Zona@(SortFlecha("Zona"))</th>
                            <th class="sortable" @onclick='() => OrdenarBuses("Nextel")'>Nextel@(SortFlecha("Nextel"))</th>
                            <th class="sortable r" @onclick='() => OrdenarBuses("Pax")'>Pax@(SortFlecha("Pax"))</th>
                            <th class="sortable" @onclick='() => OrdenarBuses("Vehiculo")'>Vehiculo@(SortFlecha("Vehiculo"))</th>
                            <th class="sortable" @onclick='() => OrdenarBuses("HsInicio")'>Hs. Inicio@(SortFlecha("HsInicio"))</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in BusesVisibles())
                        {
                            <tr class="@EstadoCss(b.Estado)">
                                <td>@b.Fletero</td>
                                <td class="r">@b.Interno</td>
                                <td>@b.Chofer</td>
                                <td>@b.Chofer2</td>
                                <td class="c">@b.Franco</td>
                                <td>@b.Estado</td>
                                <td class="r">@(b.IdViaje is > 0 ? b.IdViaje : null)</td>
                                <td>@b.Zona</td>
                                <td>@b.Nextel</td>
                                <td class="r">@b.Pax</td>
                                <td>@b.Vehiculo</td>
                                <td>@(b.HsInicio?.ToString("dd/MM HH:mm") ?? "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </MudPaper>
    }

    </div>
}

</div>@* /.planilla-page *@

@code {
    private readonly System.Globalization.CultureInfo _ar =
        System.Globalization.CultureInfo.GetCultureInfo("es-AR");
    private readonly DateTime _min = ReportService.FechaMinValida.ToDateTime(TimeOnly.MinValue);
    private readonly DateTime _max = ReportService.FechaMaxValida.ToDateTime(TimeOnly.MinValue);

    private DateTime? _fecha = DateTime.Today;
    private string _filtro = "";
    private List<PlanillaTraficoRow> _filas = new();
    private bool _cargando;
    private int _filaActiva;   // IdViaje de la fila seleccionada por click (0 = ninguna)

    // Resultado memoizado de los filtros. La grilla y los KPIs leen estos campos en el
    // render; se recalculan solo al cambiar datos o filtros (RecalcularVisibles), no en
    // cada render. Evita recorrer/filtrar las ~300 filas en cada interacción.
    private List<PlanillaTraficoRow> _visibles = new();
    private List<TraficoCanceladoRow> _canceladosVisibles = new();

    // Nº de orden por fila (IdViaje → posición 1-based en _visibles). Memoizado: dentro de
    // <Virtualize> no se puede usar IndexOf (sería O(n²) por scroll); el diccionario es O(1).
    // Se reconstruye junto con _visibles en RecalcularVisibles.
    private Dictionary<int, int> _indices = new();

    // Filtros de tipo de ingreso (réplica de Emp/Tur/Nortur del FoxPro).
    // Por defecto todo visible, igual que el form original (Nortur tildado).
    private bool _verEmpresa = true;   // origen 'P'
    private bool _verTurismo = true;   // origen 'T'
    private bool _verNortur = true;    // mostrar servicios internos de NORTUR

    // Filtros de unidad (réplica de los combos cronogramaCbio/cronograma + botón S/C).
    // Son mutuamente excluyentes, igual que en el FoxPro (GotFocus limpia el otro combo).
    private CombosUnidadesTrafico _combos = new(new(), new());
    private string? _selUPr;                 // combo 1 — Unidad Programada (interno por empresa)
    private string? _selUCb;                 // combo 2 — Unidad Asignada (todos los internos)
    private bool _soloSinCronograma;         // botón S/C → cronograma = 'S/C'

    // Vista cancelados (réplica del botón Cxl → arma_grid_viaje caso CANCELADO).
    private bool _verCancelados;
    private List<TraficoCanceladoRow> _cancelados = new();

    // Panel Buses (réplica del checkbox verBuses → grid2 / arma_grid_vehiculo).
    private bool _verBuses;
    private List<PanelBusRow> _buses = new();
    private string _busesOrdenCol = "";    // orden por click en header (réplica de ClickMHeader2)
    private bool _busesOrdenAsc = true;

    // Auto-refresh inteligente: cada 60s una query liviana (GetTraficoVersionAsync) chequea
    // si algo cambió en la base; solo entonces se recarga la grilla. Las filas nuevas o
    // modificadas se resaltan 3s con .fila-flash y la grilla se reordena sola por horario.
    private PeriodicTimer? _timerRefresh;
    private TraficoVersion? _version;
    private HashSet<int> _filasCambiadas = new();
    private DateTime? _ultimoRefresh;

    // Ventana "viva" del auto-refresh: hoy, los últimos 15 días y cualquier fecha futura.
    // Las fechas más viejas están congeladas (Metrocar/FoxPro ya no las edita), así que se
    // cargan una sola vez y no se vuelven a pollear: evita round-trips inútiles que castigan
    // al SQL Server 2012. Tráfico es un módulo de solo lectura (Blazor nunca escribe).
    private const int DiasVentanaViva = 15;
    private static bool EsFechaViva(DateOnly dia) =>
        dia >= DateOnly.FromDateTime(DateTime.Today).AddDays(-DiasVentanaViva);

    private string TituloFecha => _fecha?.ToString("dddd dd/MM/yyyy", _ar) ?? "";

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthState.EstaAutenticadoAsync())
        {
            Nav.NavigateTo($"/login?destino={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: false);
            return;
        }
        if (!Permisos.Tiene('T'))   // módulo Tráfico
        {
            Nav.NavigateTo("/", forceLoad: false);
            return;
        }
        // Combos de unidades (réplica del Init de trafico2: cursorCronogramaTrafico/Diagrama)
        _combos = await Reports.GetCombosUnidadesTraficoAsync();
        await Cargar();
        _ = AutoRefreshLoop();   // fire-and-forget: vive mientras viva el circuito
    }

    // Mientras esta página esté montada, la ventana NO scrollea: la planilla ocupa
    // exactamente el viewport y la única región scrolleable es la grilla de viajes.
    // La clase la pone/saca JS sobre <body> (ver bloquearScrollVentana en descarga.js).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("bloquearScrollVentana", true);
    }

    private async Task Cargar()
    {
        if (_fecha is null) return;
        _cargando = true;
        StateHasChanged();

        var dia = DateOnly.FromDateTime(_fecha.Value);
        _filaActiva = 0;
        _filasCambiadas.Clear();
        _filas = await Reports.GetPlanillaTraficoAsync(dia);
        // Cancelados del día: alimenta el contador del botón Cxl y la vista cancelados.
        _cancelados = await Reports.GetTraficoCanceladosAsync(dia);
        // El FoxPro rearma grid2 tras cada operación; acá lo refresca el auto-refresh.
        if (_verBuses)
            _buses = await Reports.GetPanelBusesAsync();

        // Token de versión inicial: contra esto compara el auto-refresh. Solo para fechas
        // vivas; las congeladas no se pollean, así que no gastamos la consulta.
        _version = EsFechaViva(dia) ? await Reports.GetTraficoVersionAsync(dia) : null;
        _ultimoRefresh = DateTime.Now;

        RecalcularVisibles();   // datos nuevos → refrescar el conjunto memoizado
        _cargando = false;
    }

    // ── Auto-refresh inteligente (timer 60s) ──

    private async Task AutoRefreshLoop()
    {
        _timerRefresh = new PeriodicTimer(TimeSpan.FromSeconds(60));
        try
        {
            while (await _timerRefresh.WaitForNextTickAsync())
            {
                if (_cargando || _fecha is null) continue;
                try
                {
                    var dia = DateOnly.FromDateTime(_fecha.Value);
                    // Fechas congeladas (más viejas que la ventana viva): no se pollea nada.
                    // Metrocar ya no las edita → re-consultarlas solo castiga al SQL Server.
                    if (!EsFechaViva(dia)) continue;
                    var version = await Reports.GetTraficoVersionAsync(dia);

                    if (_version is not null && version == _version)
                    {
                        // Sin cambios en la base: solo actualizar el reloj de la leyenda.
                        _ultimoRefresh = DateTime.Now;
                        await InvokeAsync(StateHasChanged);
                        continue;
                    }

                    _version = version;
                    await RefrescarConFlash(dia);
                }
                catch
                {
                    // Tick fallido (réplica caída, timeout): se reintenta en el próximo.
                }
            }
        }
        catch (ObjectDisposedException) { /* la página se cerró */ }
    }

    private async Task RefrescarConFlash(DateOnly dia)
    {
        // Forzar datos frescos aunque el TTL del caché (55s) no haya vencido.
        Reports.InvalidarCacheTrafico(dia);

        var previas = _filas.ToDictionary(f => f.IdViaje);
        var filas = await Reports.GetPlanillaTraficoAsync(dia);
        var cancelados = await Reports.GetTraficoCanceladosAsync(dia);
        var buses = _verBuses ? await Reports.GetPanelBusesAsync() : _buses;

        // PlanillaTraficoRow es record → la igualdad por valor detecta cualquier
        // campo modificado. Fila nueva o distinta ⇒ flash.
        var cambiadas = filas
            .Where(f => !previas.TryGetValue(f.IdViaje, out var ant) || ant != f)
            .Select(f => f.IdViaje)
            .ToHashSet();

        await InvokeAsync(() =>
        {
            // La query ya viene ordenada por hs_inicio ⇒ reordenamiento automático.
            _filas = filas;
            _cancelados = cancelados;
            _buses = buses;
            _filasCambiadas = cambiadas;
            _ultimoRefresh = DateTime.Now;
            RecalcularVisibles();   // datos nuevos → refrescar el conjunto memoizado
            StateHasChanged();
        });

        if (cambiadas.Count > 0)
        {
            // Quitar la clase .fila-flash cuando termina la animación (3s) para que
            // un próximo cambio sobre la misma fila vuelva a destellar.
            await Task.Delay(3500);
            await InvokeAsync(() =>
            {
                _filasCambiadas.Clear();
                StateHasChanged();
            });
        }
    }

    public void Dispose()
    {
        _timerRefresh?.Dispose();
        // Devolver el scroll normal a la ventana al salir de la planilla. Fire-and-forget:
        // si el circuito ya se cerró, la interop falla silenciosamente (no pasa nada).
        try { _ = JS.InvokeVoidAsync("bloquearScrollVentana", false); } catch { }
    }

    private async Task OnFechaChanged(DateTime? nueva)
    {
        _fecha = nueva;
        await Cargar();
    }

    private async Task DiaAnterior()
    {
        _fecha = (_fecha ?? DateTime.Today).AddDays(-1);
        await Cargar();
    }

    private async Task DiaSiguiente()
    {
        _fecha = (_fecha ?? DateTime.Today).AddDays(1);
        await Cargar();
    }

    private async Task IrHoy()
    {
        _fecha = DateTime.Today;
        await Cargar();
    }

    // ── Combos de unidad: mutuamente excluyentes (réplica del GotFocus del FoxPro) ──

    private void OnUPrChanged(string? valor)
    {
        _selUPr = valor;
        if (!string.IsNullOrEmpty(valor))
        {
            _selUCb = null;
            _soloSinCronograma = false;
        }
        RecalcularVisibles();
    }

    private void OnUCbChanged(string? valor)
    {
        _selUCb = valor;
        if (!string.IsNullOrEmpty(valor))
        {
            _selUPr = null;
            _soloSinCronograma = false;
        }
        RecalcularVisibles();
    }

    // Botón S/C: filtra cronograma = 'S/C' y limpia los combos (réplica de bSinCronograma.Click)
    private void ToggleSinCronograma()
    {
        _soloSinCronograma = !_soloSinCronograma;
        if (_soloSinCronograma)
        {
            _selUPr = null;
            _selUCb = null;
        }
        RecalcularVisibles();
    }

    // Botón Cxl: alterna la vista de cancelados. Igual que el FoxPro (Command3.Click):
    // limpia los combos y deja solo la navegación de día activa.
    private void ToggleCancelados()
    {
        _verCancelados = !_verCancelados;
        if (_verCancelados)
        {
            _selUPr = null;
            _selUCb = null;
            _soloSinCronograma = false;
            _verBuses = false;   // el FoxPro apaga verBuses al entrar a cancelados
        }
        RecalcularVisibles();
    }

    // ── Panel Buses (checkbox verBuses del FoxPro) ──

    private async Task ToggleBuses()
    {
        _verBuses = !_verBuses;
        if (_verBuses && _buses.Count == 0)
            _buses = await Reports.GetPanelBusesAsync();
    }

    private void OrdenarBuses(string col)
    {
        if (_busesOrdenCol == col)
            _busesOrdenAsc = !_busesOrdenAsc;
        else
        {
            _busesOrdenCol = col;
            _busesOrdenAsc = true;
        }
    }

    private string SortFlecha(string col) =>
        _busesOrdenCol != col ? "" : (_busesOrdenAsc ? " ▲" : " ▼");

    private List<PanelBusRow> BusesVisibles()
    {
        if (string.IsNullOrEmpty(_busesOrdenCol)) return _buses;
        Func<PanelBusRow, object> clave = _busesOrdenCol switch
        {
            "Fletero"  => b => b.Fletero,
            "Interno"  => b => b.Interno,
            "Chofer"   => b => b.Chofer,
            "Chofer2"  => b => b.Chofer2,
            "Franco"   => b => b.Franco,
            "Estado"   => b => b.Estado,
            "IdViaje"  => b => b.IdViaje ?? 0,
            "Zona"     => b => b.Zona,
            "Nextel"   => b => b.Nextel,
            "Pax"      => b => b.Pax ?? 0,
            "Vehiculo" => b => b.Vehiculo,
            "HsInicio" => b => b.HsInicio ?? DateTime.MinValue,
            _          => b => b.Interno
        };
        return (_busesOrdenAsc ? _buses.OrderBy(clave) : _buses.OrderByDescending(clave)).ToList();
    }

    // Clase CSS de fila según estado — mismo código de color que grid_color_viaje /
    // grid_color_vehiculo (funcion.prg), pero con la paleta desaturada "Ops Densa"
    // (tinte de fondo + barra de acento a la izquierda, definidos en app.css).
    private static string EstadoCss(string estado) => estado switch
    {
        "ASIGNADO"   => "fila-estado--asignado",
        "CURSO"      => "fila-estado--curso",
        "FINALIZADO" => "fila-estado--finalizado",
        "FACTURADO"  => "fila-estado--facturado",
        "CHEQUEO"    => "fila-estado--chequeo",
        _            => ""    // SIN ASIGNAR y otros: fila blanca
    };

    // Recalcula los conjuntos filtrados y los guarda en los campos memoizados.
    // Llamar SOLO cuando cambian los datos (_filas/_cancelados) o un filtro
    // (Emp/Tur/Nortur, combos de unidad, S/C, buscador, vista cancelados).
    private void RecalcularVisibles()
    {
        _visibles = FilasVisibles();
        _canceladosVisibles = CanceladosVisibles();

        // Nº de orden 1-based por IdViaje (la grilla lo lee O(1) dentro de <Virtualize>).
        _indices = new Dictionary<int, int>(_visibles.Count);
        for (int i = 0; i < _visibles.Count; i++)
            _indices[_visibles[i].IdViaje] = i + 1;
    }

    private List<PlanillaTraficoRow> FilasVisibles()
    {
        IEnumerable<PlanillaTraficoRow> q = _filas;

        // ── Filtro de tipo de ingreso (Emp = origen 'P', Tur = origen 'T') ──
        // Si ambos están activos no filtra nada; si solo uno, deja ese origen.
        if (_verEmpresa ^ _verTurismo)
        {
            var origen = _verEmpresa ? "P" : "T";
            q = q.Where(f => f.Origen == origen);
        }
        else if (!_verEmpresa && !_verTurismo)
        {
            // Ninguno activo → no se muestra ningún servicio de transporte.
            q = Enumerable.Empty<PlanillaTraficoRow>();
        }

        // ── Filtro Nortur (réplica de chkNortur): destildado oculta servicios internos ──
        if (!_verNortur)
            q = q.Where(f => !f.EsNortur);

        // ── Filtro de unidad (réplica de los filtros CRONOGRAMA / _CRONOGRAMACBIO) ──
        // S/C y los dos combos son excluyentes entre sí, igual que en el FoxPro.
        if (_soloSinCronograma)
            q = q.Where(f => f.UCb == "S/C");
        else if (!string.IsNullOrEmpty(_selUCb))
            q = q.Where(f => f.UCb == _selUCb);
        else if (!string.IsNullOrEmpty(_selUPr))
            q = q.Where(f => f.UPr == _selUPr);

        // ── Buscador de texto ──
        if (!string.IsNullOrWhiteSpace(_filtro))
        {
            var t = _filtro.Trim().ToUpperInvariant();
            q = q.Where(f =>
                (f.Recorrido?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.Chofer?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.Cliente?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.Fletero?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.Vuelo?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.UPr?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.UAs?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.Grupo?.ToUpperInvariant().Contains(t) ?? false));
        }

        return q.ToList();
    }

    // Cancelados visibles: aplica solo el buscador de texto (los demás filtros
    // quedan deshabilitados en esta vista, igual que en el FoxPro).
    private List<TraficoCanceladoRow> CanceladosVisibles()
    {
        if (!_verCancelados) return new();

        IEnumerable<TraficoCanceladoRow> q = _cancelados;
        if (!string.IsNullOrWhiteSpace(_filtro))
        {
            var t = _filtro.Trim().ToUpperInvariant();
            q = q.Where(f =>
                (f.Recorrido?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.Motivo?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.Cliente?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.Comentario?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.Vuelo?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.UPr?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.UCb?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.Grupo?.ToUpperInvariant().Contains(t) ?? false));
        }
        return q.ToList();
    }

    // Doble click en una fila → abre el modal "Zoom del Viaje" (solo lectura),
    // réplica del form FoxPro trafico_zoom.scx.
    private async Task AbrirZoom(int idViaje, DateOnly fecha)
    {
        var parametros = new DialogParameters<ZoomViajeDialog>
        {
            { x => x.IdViaje, idViaje },
            // La fecha de la fila permite que el detalle haga SEEK por f_reserva
            // en vez de scanear toda la tabla viaje (clave para la performance del Zoom).
            { x => x.FReserva, fecha }
        };
        var opciones = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = false,
            CloseOnEscapeKey = true,
            BackdropClick = true
        };
        await DialogService.ShowAsync<ZoomViajeDialog>("Zoom del Viaje", parametros, opciones);
    }

    private async Task DescargarExcel()
    {
        if (_fecha is null) return;
        var dia = DateOnly.FromDateTime(_fecha.Value);
        // Exporta lo que se ve en pantalla (respeta los filtros activos y el buscador).
        byte[] bytes;
        string nombre;
        if (_verCancelados)
        {
            bytes = Excel.TraficoCancelados(CanceladosVisibles(), dia);
            nombre = $"trafico_cancelados_{dia:yyyyMMdd}.xlsx";
        }
        else
        {
            bytes = Excel.PlanillaTrafico(FilasVisibles(), dia);
            nombre = $"planilla_trafico_{dia:yyyyMMdd}.xlsx";
        }
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("descargarArchivo", nombre, streamRef);
    }

    private string Fmt(int n) => n.ToString("#,0", _ar);
}
