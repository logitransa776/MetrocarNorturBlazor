    // Click en una fila: togglea la selección (igual que antes) y, además, da foco al
    // contenedor de la grilla para que las flechas ↑/↓ funcionen sin un click extra.
    private async Task SeleccionarFilaClick(int idViaje)
    {
        _filaActiva = (_filaActiva == idViaje) ? 0 : idViaje;
        await _gridWrap.FocusAsync();
    }

    // ── Navegación por teclado sobre la grilla principal (réplica del cursor de FoxPro) ──

    // Captura las teclas cuando el contenedor de la grilla tiene el foco. Solo actuamos sobre
    // ↑/↓ (mover selección), Enter (abrir Zoom de la fila activa) y Home/End (primera/última).
    // El resto de teclas se ignora y sigue su curso normal. Opera 100% sobre _visibles (en
    // memoria): no toca SQL ni red. El único costo es 1 interop de scroll por movimiento.
    private async Task OnGridKeyDown(KeyboardEventArgs e)
    {
        // ¿Es una tecla que manejamos? Decide también si frenamos el scroll nativo.
        // F4 = "Aviso sobre el viaje" (trafico2.scx → nKeyCode -3 → viaje_hora_aviso).
        // Criterio del mapa de teclas de Buslink (decisión del usuario, 03/08/2026): se
        // capturan SOLO las teclas F que el navegador no usa. F4 está libre en Chrome/Edge;
        // F5 (recargar) y F11 (pantalla completa) se le dejan al navegador y esas funciones
        // viven en el menú contextual / la barra. F12 (DevTools) directamente no se puede
        // interceptar. Ver TRAFICO_F4_AVISO.md §5.2.
        // F6-F9 = cambio de cronograma. Ctrl+F8 = copiar el del diagramador (el .exe lo usa
        // así; en el fuente en disco Ctrl+F8 todavía era el toggle de cancelados, que en
        // Buslink ya vive en el botón Cxl).
        // F1 = ayuda · F2 = novedad · F3 = refresh manual.
        // ⚠️ F1 abre la ayuda DEL NAVEGADOR y F3 es "buscar siguiente": las dos se interceptan
        // con preventDefault (funciona en Chrome/Edge/Firefox). F5 y F11 siguen siendo del
        // navegador por la regla del mapa de teclas — ver TRAFICO_F4_AVISO.md §5.2.
        bool teclaF = e.Key is "F1" or "F2" or "F3" or "F4" or "F6" or "F7" or "F8" or "F9";
        // Cualquier LETRA o DÍGITO abre el cambio de cronograma con esa letra, como el FoxPro
        // (KeyPress: Between(nKeyCode,48,57) / 65-90 / 97-122). Solo cuando el foco está en la
        // grilla: el buscador es un input aparte y se queda con sus propias teclas.
        // ⚠️ Enter NO entra acá aunque el FoxPro lo incluya: en Buslink ya abre el Zoom.
        bool esLetraOdigito = e.Key.Length == 1 && char.IsLetterOrDigit(e.Key[0]) && !e.CtrlKey && !e.AltKey;

        bool manejada = e.Key is "ArrowDown" or "ArrowUp" or "Enter" or "Home" or "End"
                        || teclaF || esLetraOdigito;
        _preventDefaultTecla = manejada;
        if (!manejada) return;

        // Throttle del key-repeat (Blazor Server): descartar ticks demasiado seguidos.
        var ahora = DateTime.UtcNow;
        if (ahora - _ultimaTecla < ThrottleTecla) return;
        _ultimaTecla = ahora;

        // F1 se atiende ANTES del corte por grilla vacía: un día sin servicios es justo cuando
        // alguien nuevo busca la ayuda.
        // Decisión del usuario (07/08/2026): F1 = AYUDA ONLINE (el manual de Buslink, como en
        // cualquier sistema web) y Ctrl+F1 = la tabla de atajos, que además quedó en el botón
        // «Ayuda» de la barra superior. Antes F1 abría los atajos.
        if (e.Key == "F1")
        {
            if (e.CtrlKey) await AbrirAyuda();
            else           await AbrirAyudaOnline();
            return;
        }

        if (_visibles.Count == 0) return;

        switch (e.Key)
        {
            case "ArrowDown": await MoverSeleccion(+1); break;
            case "ArrowUp":   await MoverSeleccion(-1); break;
            case "Home":      await IrAFila(0); break;
            case "End":       await IrAFila(_visibles.Count - 1); break;
            case "Enter":
                // Enter sobre la fila activa = doble click (abre el Zoom). Igual que FoxPro.
                if (_filaActiva != 0)
                {
                    var fila = _visibles.FirstOrDefault(f => f.IdViaje == _filaActiva);
                    if (fila is not null) await AbrirZoom(fila.IdViaje, fila.Fecha);
                }
                break;
            // (F1 = ayuda de comandos — se atiende más arriba, antes del corte por grilla vacía.)
            // F2 = cargar una novedad sobre el servicio de la fila activa.
            case "F2": await AbrirNovedadFilaActiva(); break;
            // F3 = refresh manual. En Buslink la planilla ya se actualiza sola cada 60s; esto
            // fuerza la recarga sin esperar el tick, para quien viene del Metrocar.
            case "F3":
                if (_fecha is not null && _filtroActivo is null && !_cargando)
                    await RefrescarConFlash(DateOnly.FromDateTime(_fecha.Value));
                break;
            // F4 = Aviso sobre el viaje (mismo ítem del menú contextual).
            case "F4": await AbrirAvisoFilaActiva(); break;
            // F6-F9 = cambio de cronograma con la opción pre-seleccionada.
            case "F6": case "F7": case "F9":
                await AbrirCronogramaFilaActiva(e.Key); break;
            case "F8":
                // Ctrl+F8 copia el cronograma del diagramador sin abrir nada.
                if (e.CtrlKey)
                {
                    var f8 = _visibles.FirstOrDefault(f => f.IdViaje == _filaActiva);
                    if (f8 is not null) await CopiarCronograma(f8);
                }
                else await AbrirCronogramaFilaActiva("F8");
                break;
            default:
                // Letra o dígito: abre el diálogo posicionando el combo de internos, como el
                // `Keyboard lpLetra Clear` del FoxPro.
                if (esLetraOdigito) await AbrirCronogramaFilaActiva("F8", e.Key.ToUpperInvariant());
                break;
        }
    }

    // Mueve la selección 'delta' filas (±1) respecto de la fila activa actual. Si no hay
    // nada seleccionado, ↓ selecciona la primera y ↑ la última (arranque natural del cursor).
    private async Task MoverSeleccion(int delta)
    {
        int destino;
        if (_filaActiva == 0 || !_indices.TryGetValue(_filaActiva, out var pos1Based))
        {
            // Sin selección previa: ↓ → primera; ↑ → última.
            destino = delta > 0 ? 0 : _visibles.Count - 1;
        }
        else
        {
            // _indices guarda posición 1-based; pasar a 0-based y aplicar el delta acotado.
            destino = Math.Clamp((pos1Based - 1) + delta, 0, _visibles.Count - 1);
        }
        await IrAFila(destino);
    }

    // ── Posicionamiento automático en la hora actual (réplica de ir_hora_actual) ──
    // Al abrir la planilla en el día de HOY, la grilla se planta en el servicio de la hora
    // en vez de arrancar arriba de todo (03:40 de la madrugada). El FoxPro hace lo mismo
    // desde el Init del form y desde F3/Ref; NO lo hace al navegar de día ni en cancelados
    // (ver docs/PlanoFoxPro/trafico/TRAFICO_IR_HORA_ACTUAL.md).
    //
    // El scroll queda CENTRADO: la fila de "ahora" a mitad de grilla, lo que está corriendo
    // arriba y lo que viene abajo. El FoxPro la deja pegada al pie y no muestra futuro.
    private async Task PosicionarEnHoraActual()
    {
        _irHoraActualPendiente = false;
        if (_visibles.Count == 0) return;

        var ahora = DateTime.Now;

        // FoxPro: Go Top / Do While !Eof() / If hs_inicio >= Datetime() → Exit.
        // Sin coincidencia = Eof(): ya arrancaron todos los servicios del día y el FoxPro
        // queda al final de la grilla. Acá el clamp del JS hace lo mismo.
        var idx = _visibles.FindIndex(f => f.HsInicio is { } h && h >= ahora);
        if (idx < 0) idx = _visibles.Count - 1;

        await JS.InvokeVoidAsync("traficoIrHoraActual", ".trafico-wrap--nav", idx, AltoFila);
    }

    // Selecciona la fila en la posición 0-based dada y asegura que quede visible en el viewport
    // de <Virtualize> mediante scroll calculado (la fila destino puede no estar en el DOM).
    private async Task IrAFila(int indice)
    {
        if (indice < 0 || indice >= _visibles.Count) return;
        _filaActiva = _visibles[indice].IdViaje;
        // El scroll programático va contra el contenedor de ESTA grilla. Se calcula por
        // aritmética (indice * AltoFila), no por scrollIntoView, porque la fila puede no
        // estar renderizada. Ver traficoScrollFila en descarga.js.
        await JS.InvokeVoidAsync("traficoScrollFila", ".trafico-wrap--nav", indice, AltoFila);
    }

