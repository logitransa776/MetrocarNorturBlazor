    // Muestra el GPS embebido en un modal (iframe) dentro de la misma app, en vez de abrir
    // una pestaña nueva. La URL ya viene armada y validada por quien llama. Recorrido/horarios
    // son opcionales: solo "Recorrido en WEB" los pasa (se ven en la sublínea de la barra azul);
    // "Ubicar unidad" los deja en null y la barra queda en una sola línea.
    private async Task AbrirGpsEnDialog(string url, string titulo, string? unidad, string icono,
        string? recorrido = null, DateTime? hsInicio = null, DateTime? hsFin = null)
    {
        var parametros = new DialogParameters<GpsMapaDialog>
        {
            { x => x.Url, url },
            { x => x.Titulo, titulo },
            { x => x.Unidad, unidad },
            { x => x.Icono, icono },
            { x => x.Recorrido, recorrido },
            { x => x.HsInicio, hsInicio },
            { x => x.HsFin, hsFin }
        };
        await DialogService.ShowAsync<GpsMapaDialog>(titulo, parametros, GpsDialogOptions);
    }

    // Réplica del MessageBox del FoxPro cuando el servicio no tiene unidad/cronograma válidos.
    private async Task AvisarSinGps() =>
        await JS.InvokeVoidAsync("alert",
            "El servicio no tiene una unidad asignada con datos válidos para ubicarlo en el GPS " +
            "(sin unidad asignada ni cronograma).");

    // ── Aplicar Filtros (server-side) — réplica de la rama "Aplicar Filtros" de arma_grid_viaje ──

    // Texto del filtro activo para el banner y el KPI.
    private string DescripcionFiltro => _filtroActivo switch
    {
        null => "",
        { Tipo: TraficoFiltroTipo.Fecha } f => f.Desde == f.Hasta
            ? $"Fecha {f.Desde:dd/MM/yyyy}"
            : $"Rango de fechas {f.Desde:dd/MM/yyyy} – {f.Hasta:dd/MM/yyyy}",
        // Tipo de Reserva: Texto = "T"|"P"|null (null = Ambos).
        { Tipo: TraficoFiltroTipo.TipoReserva } f =>
            $"Tipo de reserva {(f.Texto switch { "T" => "Transportación", "P" => "Plantilla", _ => "Ambos" })} · {(f.Desde == f.Hasta ? $"{f.Desde:dd/MM/yyyy}" : $"{f.Desde:dd/MM/yyyy} – {f.Hasta:dd/MM/yyyy}")}",
        { Tipo: TraficoFiltroTipo.Fletero } f =>
            $"Fletero {f.Texto} · {(f.Desde == f.Hasta ? $"{f.Desde:dd/MM/yyyy}" : $"{f.Desde:dd/MM/yyyy} – {f.Hasta:dd/MM/yyyy}")}",
        { Tipo: TraficoFiltroTipo.Choferes } f =>
            $"Conductor {f.Texto} · {(f.Desde == f.Hasta ? $"{f.Desde:dd/MM/yyyy}" : $"{f.Desde:dd/MM/yyyy} – {f.Hasta:dd/MM/yyyy}")}",
        { Tipo: TraficoFiltroTipo.Interno } f =>
            $"Unidad {f.Texto} · {(f.Desde == f.Hasta ? $"{f.Desde:dd/MM/yyyy}" : $"{f.Desde:dd/MM/yyyy} – {f.Hasta:dd/MM/yyyy}")}",
        { Tipo: TraficoFiltroTipo.Estado } f =>
            $"Estado {f.Texto} · {(f.Desde == f.Hasta ? $"{f.Desde:dd/MM/yyyy}" : $"{f.Desde:dd/MM/yyyy} – {f.Hasta:dd/MM/yyyy}")}",
        { Tipo: TraficoFiltroTipo.Vuelo } f =>
            $"Vuelo {f.Texto} · {(f.Desde == f.Hasta ? $"{f.Desde:dd/MM/yyyy}" : $"{f.Desde:dd/MM/yyyy} – {f.Hasta:dd/MM/yyyy}")}",
        // Nº Reserva / Nº Reserva En Ruta no usan rango (buscan en toda la base) → solo el número.
        { Tipo: TraficoFiltroTipo.Reserva } f => $"Nº Reserva {f.Numero}",
        { Tipo: TraficoFiltroTipo.ReservaRuta } f => $"Nº Reserva En Ruta {f.Numero}",
        var f => f.Tipo.ToString()
    };

    // Rango de Fechas: abre el diálogo; si el usuario acepta, pasa a modo filtro server-side.
    // El parámetro `actual` (≠ null en modo "editar filtro") precarga los campos del diálogo.
