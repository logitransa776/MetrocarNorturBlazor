    private static readonly string[] EstadosLeyenda =
        { "SIN ASIGNAR", "ASIGNADO", "CURSO", "FINALIZADO", "FACTURADO", "CHEQUEO" };

    // Contador de cada botón. Se calcula sobre el conjunto filtrado por TODO menos el propio
    // estado (Emp/Tur/Nortur + unidad + buscador) → los números siempre suman lo que se ve.
    private Dictionary<string, int> _conteoEstados = new();
    private int _totalSinEstado;   // filas que pasan todos los filtros MENOS el de estado

    // Fondo de cada botón de la leyenda = color REAL de la fila en la grilla
    // (.fila-estado--* en app.css). SIN ASIGNAR no tiene clase: la fila queda blanca.
    private static string EstadoLeyendaFondo(string estado) => estado switch
