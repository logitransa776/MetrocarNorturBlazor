    // ── Combos de unidad en CASCADA (16/07/2026): combo 1 = empresa, combo 2 = interno ──
    // La empresa elegida achica la lista del combo 2 a SUS internos (en memoria, sin re-query)
    // y filtra la grilla por empresa; si además se elige un interno, la grilla filtra por ese
    // interno (más específico). Cambiar de empresa limpia el interno elegido (estándar de
    // combos en cascada). Reemplaza la exclusión mutua del FoxPro (GotFocus).

    // Internos que muestra el combo 2: los de la empresa elegida, o todos si no hay empresa.
    private IEnumerable<string> InternosDelCombo() =>
        string.IsNullOrEmpty(_selUPr)
            ? _combos.Asignadas.Select(u => u.Interno)
            : _combos.Asignadas.Where(u => u.Empresa == _selUPr).Select(u => u.Interno);

    private void OnUPrChanged(string? valor)
    {
        _selUPr = valor;
        _selUCb = null;   // cambiar (o quitar) la empresa resetea el interno elegido
        if (!string.IsNullOrEmpty(valor))
            _soloSinCronograma = false;
        RecalcularVisibles();
    }

    private void OnUCbChanged(string? valor)
    {
        _selUCb = valor;
        if (!string.IsNullOrEmpty(valor))
            _soloSinCronograma = false;   // la empresa (_selUPr) se CONSERVA: sigue guiando la lista
        RecalcularVisibles();
    }

    // Botón S/C: filtra cronograma = 'S/C' y limpia los combos (réplica de bSinCronograma.Click)
    private void ToggleSinCronograma()
    {
        _soloSinCronograma = !_soloSinCronograma;
        if (_soloSinCronograma)
        {
            _selUPr = null;
            _selUCb = null;
        }
        RecalcularVisibles();
    }

    // Botón Cxl: alterna la vista de cancelados. Igual que el FoxPro (Command3.Click):
    // limpia los combos y deja solo la navegación de día activa.
    private void ToggleCancelados()
    {
        _verCancelados = !_verCancelados;
        if (_verCancelados)
        {
            _selUPr = null;
            _selUCb = null;
            _soloSinCronograma = false;
            _verBuses = false;   // el FoxPro apaga verBuses al entrar a cancelados
        }
        RecalcularVisibles();
    }

    // ── Panel Buses (checkbox verBuses del FoxPro) ──

    private async Task ToggleBuses()
