                else
                {
                    <span title="Fecha histórica: Metrocar ya no modifica estos datos, así que la planilla no se auto-actualiza (se cargó una sola vez).">
                        · <span style="color:#9AA7BC;">●</span> histórico · sin auto-actualización
                    </span>
                }
