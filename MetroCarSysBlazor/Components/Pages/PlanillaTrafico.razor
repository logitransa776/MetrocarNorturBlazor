    // ── Combos de unidad en CASCADA (16/07/2026): combo 1 = empresa, combo 2 = interno ──
    // La empresa elegida achica la lista del combo 2 a SUS internos (en memoria, sin re-query)
    // y filtra la grilla por empresa; si además se elige un interno, la grilla filtra por ese
    // interno (más específico). Cambiar de empresa limpia el interno elegido (estándar de
    // combos en cascada). Reemplaza la exclusión mutua del FoxPro (GotFocus).

    // Internos que muestra el combo 2: los de la empresa elegida, o todos si no hay empresa.
    private IEnumerable<string> InternosDelCombo() =>
        string.IsNullOrEmpty(_selUPr)
            ? _combos.Asignadas.Select(u => u.Interno)
            : _combos.Asignadas.Where(u => u.Empresa == _selUPr).Select(u => u.Interno);

    // ── Búsqueda de los combos (MudAutocomplete, 19/08/2026) ──
    // Empresa: contiene, sin distinguir mayúsculas ni acentos de más. Texto vacío = lista entera
    // (con OpenOnFocus el operador ve todo al hacer clic, igual que con el <select> de antes).
    private Task<IEnumerable<string>> BuscarEmpresas(string? texto, CancellationToken ct)
    {
        var lista = _combos.Programadas;
        if (string.IsNullOrWhiteSpace(texto)) return Task.FromResult<IEnumerable<string>>(lista);
        var t = texto.Trim();
        return Task.FromResult<IEnumerable<string>>(
            lista.Where(e => e.Contains(t, StringComparison.OrdinalIgnoreCase)).ToList());
    }

    // Interno: los códigos son 2 letras + 4 dígitos (NT0021, NU0010, TB0125) y el operador
    // piensa en el NÚMERO, no en el código. Tipear "21" tiene que traer NT0021 arriba de todo.
    // Orden: (1) número exacto, (2) el número como prefijo (1 → 10, 12, 109), (3) contiene.
    private Task<IEnumerable<string>> BuscarInternos(string? texto, CancellationToken ct)
    {
        var lista = InternosDelCombo().ToList();
        if (string.IsNullOrWhiteSpace(texto)) return Task.FromResult<IEnumerable<string>>(lista);

        var t = texto.Trim();
        if (t.All(char.IsDigit))
        {
            var buscado = t.TrimStart('0');
            var exactos = new List<string>();
            var prefijo = new List<string>();
            var resto = new List<string>();
            foreach (var cod in lista)
            {
                var num = NumeroDeInterno(cod);
                if (num == buscado) exactos.Add(cod);
                else if (num.StartsWith(buscado, StringComparison.Ordinal)) prefijo.Add(cod);
                else if (num.Contains(buscado, StringComparison.Ordinal)) resto.Add(cod);
            }
            return Task.FromResult<IEnumerable<string>>(exactos.Concat(prefijo).Concat(resto).ToList());
        }

        return Task.FromResult<IEnumerable<string>>(
            lista.Where(c => c.Contains(t, StringComparison.OrdinalIgnoreCase)).ToList());
    }

    // "NT0021" → "21". Los ceros a la izquierda molestan para comparar contra lo tipeado.
    private static string NumeroDeInterno(string codigo)
    {
        var digitos = new string(codigo.Where(char.IsDigit).ToArray()).TrimStart('0');
        return digitos.Length == 0 ? "0" : digitos;
    }

