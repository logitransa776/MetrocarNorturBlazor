    private void OrdenarBuses(string col)
    {
        if (_busesOrdenCol == col)
            _busesOrdenAsc = !_busesOrdenAsc;
        else
        {
            _busesOrdenCol = col;
            _busesOrdenAsc = true;
        }
    }

    private string SortFlecha(string col) =>
        _busesOrdenCol != col ? "" : (_busesOrdenAsc ? " ▲" : " ▼");

    private List<PanelBusRow> BusesVisibles()
    {
        if (string.IsNullOrEmpty(_busesOrdenCol)) return _buses;
        Func<PanelBusRow, object> clave = _busesOrdenCol switch
        {
            "Fletero"  => b => b.Fletero,
            "Interno"  => b => b.Interno,
            "Chofer"   => b => b.Chofer,
            "Chofer2"  => b => b.Chofer2,
            "Franco"   => b => b.Franco,
            "Estado"   => b => b.Estado,
            "IdViaje"  => b => b.IdViaje ?? 0,
            "Zona"     => b => b.Zona,
            "Nextel"   => b => b.Nextel,
            "Pax"      => b => b.Pax ?? 0,
            "Vehiculo" => b => b.Vehiculo,
            "HsInicio" => b => b.HsInicio ?? DateTime.MinValue,
            _          => b => b.Interno
        };
        return (_busesOrdenAsc ? _buses.OrderBy(clave) : _buses.OrderByDescending(clave)).ToList();
    }

    // Los helpers de presentación de fila (EstadoCss / EstadoLabel / PartirRecorrido) viven
    // como public static en Components/Shared/TraficoFilaRow.razor — ahí es donde se usan en
    // el caso principal. La grilla de cancelados y el panel Buses los reusan desde acá.


    // Recalcula los conjuntos filtrados y los guarda en los campos memoizados.
    // Llamar SOLO cuando cambian los datos (_filas/_cancelados) o un filtro
    // (Emp/Tur/Nortur, combos de unidad, S/C, buscador, vista cancelados).
    private void RecalcularVisibles()
    {
        // 1) Conjunto base: TODOS los filtros menos el de estado. Alimenta los contadores de
        //    la botonera del pie (así "SIN ASIG 2 + ... + FACT 41" suma lo que muestra la grilla).
        var baseSinEstado = FilasVisibles();
        _totalSinEstado = baseSinEstado.Count;

        _conteoEstados = new Dictionary<string, int>(EstadosLeyenda.Length, StringComparer.Ordinal);
        foreach (var e in EstadosLeyenda) _conteoEstados[e] = 0;
        foreach (var f in baseSinEstado)
        {
            // Un estado fuera de la leyenda (p. ej. CANCELADO, que vive en la vista Cxl) no
            // rompe nada: simplemente no tiene botón y no se cuenta.
            if (_conteoEstados.TryGetValue(f.EstadoDisplay, out var n))
                _conteoEstados[f.EstadoDisplay] = n + 1;
        }

        // 2) Foco por estado (en memoria, sin re-query).
        _visibles = _estadosFoco.Count == 0
            ? baseSinEstado
            : baseSinEstado.Where(f => _estadosFoco.Contains(f.EstadoDisplay)).ToList();

        _canceladosVisibles = CanceladosVisibles();

        // Nº de orden 1-based por IdViaje (la grilla lo lee O(1) dentro de <Virtualize>).
        _indices = new Dictionary<int, int>(_visibles.Count);
        for (int i = 0; i < _visibles.Count; i++)
            _indices[_visibles[i].IdViaje] = i + 1;
    }

    // ── Botonera de estados de la leyenda (pie del panel) y chip de estado de cada fila ──
    // Semántica acordada con el usuario (20/07/2026, ajustada el mismo día):
    // el clic simple SUMA/QUITA — los estados se acumulan sin necesidad de Ctrl. Empezando de
    // "sin filtro", el 1er clic deja solo ese estado; el 2º clic en otro botón suma el segundo.
    // Volver a clickear un estado activo lo saca; si era el último, se ve todo de nuevo.
    // (La versión anterior era foco exclusivo con Ctrl+clic para sumar: el Ctrl no se descubría.)
    private void ToggleEstado(string estado)
    {
        // Remove devuelve false si no estaba → en ese caso se agrega.
        if (!_estadosFoco.Remove(estado)) _estadosFoco.Add(estado);
        RecalcularVisibles();
    }

    private void LimpiarEstados()
    {
        if (_estadosFoco.Count == 0) return;
        _estadosFoco.Clear();
        RecalcularVisibles();
    }

    // Filas que pasan todos los filtros MENOS el de estado (ese se aplica en
    // RecalcularVisibles, después de contar cuántas hay de cada estado).
    private List<PlanillaTraficoRow> FilasVisibles()
    {
        IEnumerable<PlanillaTraficoRow> q = _filas;

        // ── Filtro de tipo de ingreso (Emp = origen 'P', Tur = origen 'T') ──
        // Si ambos están activos no filtra nada; si solo uno, deja ese origen.
        if (_verEmpresa ^ _verTurismo)
        {
            var origen = _verEmpresa ? "P" : "T";
            q = q.Where(f => f.Origen == origen);
        }
        else if (!_verEmpresa && !_verTurismo)
        {
            // Ninguno activo → no se muestra ningún servicio de transporte.
            q = Enumerable.Empty<PlanillaTraficoRow>();
        }

        // ── Filtro Nortur (réplica de chkNortur): destildado oculta servicios internos ──
        if (!_verNortur)
            q = q.Where(f => !f.EsNortur);

        // ── Filtro de unidad (cascada empresa → interno, 16/07/2026) ──
        // S/C excluye a los combos (como en el FoxPro). Entre los combos: el INTERNO (combo 2)
        // manda cuando está elegido — ya es un subconjunto de la empresa por la cascada del
        // combo —; si no, filtra la EMPRESA (combo 1).
        if (_soloSinCronograma)
            q = q.Where(f => f.UCb == "S/C");
        else if (!string.IsNullOrEmpty(_selUCb))
            q = q.Where(f => f.UCb == _selUCb);
        else if (_selUPr == "NORTUR")
            // "NORTUR" = la empresa propia = todas sus unidades NT#### juntas (el combo muestra
            // un único ítem NORTUR en vez de las 60+ unidades; ver GetCombosUnidadesTraficoAsync).
            q = q.Where(f => f.UPr != null && f.UPr.StartsWith("NT", StringComparison.OrdinalIgnoreCase));
        else if (!string.IsNullOrEmpty(_selUPr))
            q = q.Where(f => f.UPr == _selUPr);

        // ── Buscador de texto ──
        if (!string.IsNullOrWhiteSpace(_filtro))
        {
            var t = _filtro.Trim().ToUpperInvariant();
            q = q.Where(f =>
                (f.Recorrido?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.Chofer?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.Cliente?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.Fletero?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.Vuelo?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.UPr?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.UAs?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.Grupo?.ToUpperInvariant().Contains(t) ?? false));
        }

        return q.ToList();
    }

    // Cancelados visibles: aplica solo el buscador de texto (los demás filtros
    // quedan deshabilitados en esta vista, igual que en el FoxPro).
    private List<TraficoCanceladoRow> CanceladosVisibles()
    {
        if (!_verCancelados) return new();

        IEnumerable<TraficoCanceladoRow> q = _cancelados;
        if (!string.IsNullOrWhiteSpace(_filtro))
        {
            var t = _filtro.Trim().ToUpperInvariant();
            q = q.Where(f =>
                (f.Recorrido?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.Motivo?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.Cliente?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.Comentario?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.Vuelo?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.UPr?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.UCb?.ToUpperInvariant().Contains(t) ?? false) ||
                (f.Grupo?.ToUpperInvariant().Contains(t) ?? false));
        }
        return q.ToList();
    }

    // Doble click en una fila → abre el modal "Zoom del Viaje" (solo lectura),
    // réplica del form FoxPro trafico_zoom.scx.
    private async Task AbrirZoom(int idViaje, DateOnly fecha)
    {
        var parametros = new DialogParameters<ZoomViajeDialog>
        {
            { x => x.IdViaje, idViaje },
            // La fecha de la fila permite que el detalle haga SEEK por f_reserva
            // en vez de scanear toda la tabla viaje (clave para la performance del Zoom).
            { x => x.FReserva, fecha }
        };
        var opciones = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = false,
            CloseOnEscapeKey = true,
            BackdropClick = true
        };
        await DialogService.ShowAsync<ZoomViajeDialog>("Zoom del Viaje", parametros, opciones);
    }

    // Click en una fila: togglea la selección (igual que antes) y, además, da foco al
    // contenedor de la grilla para que las flechas ↑/↓ funcionen sin un click extra.
    private async Task SeleccionarFilaClick(int idViaje)
    {
        _filaActiva = (_filaActiva == idViaje) ? 0 : idViaje;
        await _gridWrap.FocusAsync();
    }

    // ── Navegación por teclado sobre la grilla principal (réplica del cursor de FoxPro) ──

    // Captura las teclas cuando el contenedor de la grilla tiene el foco. Solo actuamos sobre
    // ↑/↓ (mover selección), Enter (abrir Zoom de la fila activa) y Home/End (primera/última).
    // El resto de teclas se ignora y sigue su curso normal. Opera 100% sobre _visibles (en
    // memoria): no toca SQL ni red. El único costo es 1 interop de scroll por movimiento.
    private async Task OnGridKeyDown(KeyboardEventArgs e)
    {
        // ¿Es una tecla que manejamos? Decide también si frenamos el scroll nativo.
        bool manejada = e.Key is "ArrowDown" or "ArrowUp" or "Enter" or "Home" or "End";
        _preventDefaultTecla = manejada;
        if (!manejada) return;

        // Throttle del key-repeat (Blazor Server): descartar ticks demasiado seguidos.
        var ahora = DateTime.UtcNow;
        if (ahora - _ultimaTecla < ThrottleTecla) return;
        _ultimaTecla = ahora;

        if (_visibles.Count == 0) return;

        switch (e.Key)
        {
            case "ArrowDown": await MoverSeleccion(+1); break;
            case "ArrowUp":   await MoverSeleccion(-1); break;
            case "Home":      await IrAFila(0); break;
            case "End":       await IrAFila(_visibles.Count - 1); break;
            case "Enter":
                // Enter sobre la fila activa = doble click (abre el Zoom). Igual que FoxPro.
                if (_filaActiva != 0)
                {
                    var fila = _visibles.FirstOrDefault(f => f.IdViaje == _filaActiva);
                    if (fila is not null) await AbrirZoom(fila.IdViaje, fila.Fecha);
                }
                break;
        }
    }

    // Mueve la selección 'delta' filas (±1) respecto de la fila activa actual. Si no hay
    // nada seleccionado, ↓ selecciona la primera y ↑ la última (arranque natural del cursor).
    private async Task MoverSeleccion(int delta)
    {
        int destino;
        if (_filaActiva == 0 || !_indices.TryGetValue(_filaActiva, out var pos1Based))
        {
            // Sin selección previa: ↓ → primera; ↑ → última.
            destino = delta > 0 ? 0 : _visibles.Count - 1;
        }
        else
        {
            // _indices guarda posición 1-based; pasar a 0-based y aplicar el delta acotado.
            destino = Math.Clamp((pos1Based - 1) + delta, 0, _visibles.Count - 1);
        }
        await IrAFila(destino);
    }

    // Selecciona la fila en la posición 0-based dada y asegura que quede visible en el viewport
    // de <Virtualize> mediante scroll calculado (la fila destino puede no estar en el DOM).
    private async Task IrAFila(int indice)
    {
        if (indice < 0 || indice >= _visibles.Count) return;
        _filaActiva = _visibles[indice].IdViaje;
        // El scroll programático va contra el contenedor de ESTA grilla. Se calcula por
        // aritmética (indice * AltoFila), no por scrollIntoView, porque la fila puede no
        // estar renderizada. Ver traficoScrollFila en descarga.js.
        await JS.InvokeVoidAsync("traficoScrollFila", ".trafico-wrap--nav", indice, AltoFila);
    }

