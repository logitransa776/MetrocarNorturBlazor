    // Conductores: diálogo trafico_filtro_chofer.scx (rango + checkbox "solo activos" + combo
    // de conductor). Filtra viaje por id_chofer = X sobre el rango de fechas.
    private async Task FiltrarConductor(TraficoFiltro? actual = null)
    {
        var dia = _fecha is not null ? DateOnly.FromDateTime(_fecha.Value) : DateOnly.FromDateTime(DateTime.Today);
        var parametros = new DialogParameters<TraficoFiltroConductorDialog> { { x => x.DiaActual, dia }, { x => x.FiltroInicial, actual } };
        var opciones = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<TraficoFiltroConductorDialog>("Buscar reservas por Conductor", parametros, opciones);
        var res = await dialog.Result;
        if (res is { Canceled: false, Data: TraficoFiltro filtro })
            await AplicarFiltro(filtro);
    }

    // Nº de Interno: diálogo trafico_filtro_interno.scx (rango + interno validado contra la flota).
    // Filtra viaje por interno = N sobre el rango de fechas.
    private async Task FiltrarInterno(TraficoFiltro? actual = null)
    {
        var dia = _fecha is not null ? DateOnly.FromDateTime(_fecha.Value) : DateOnly.FromDateTime(DateTime.Today);
        var parametros = new DialogParameters<TraficoFiltroInternoDialog> { { x => x.DiaActual, dia }, { x => x.FiltroInicial, actual } };
        var opciones = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<TraficoFiltroInternoDialog>("Filtro por Nº de Interno", parametros, opciones);
        var res = await dialog.Result;
        if (res is { Canceled: false, Data: TraficoFiltro filtro })
            await AplicarFiltro(filtro);
    }

    // Estados de la Reserva: diálogo trafico_filtro_tipo_estado.scx (rango + combo de estado).
    // Filtra viaje por estado_via = X sobre el rango (esta rama SÍ puede traer CANCELADO).
    private async Task FiltrarEstado(TraficoFiltro? actual = null)
    {
        var dia = _fecha is not null ? DateOnly.FromDateTime(_fecha.Value) : DateOnly.FromDateTime(DateTime.Today);
        var parametros = new DialogParameters<TraficoFiltroEstadoDialog> { { x => x.DiaActual, dia }, { x => x.FiltroInicial, actual } };
        var opciones = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<TraficoFiltroEstadoDialog>("Buscar reservas por Tipo de Estado", parametros, opciones);
        var res = await dialog.Result;
        if (res is { Canceled: false, Data: TraficoFiltro filtro })
            await AplicarFiltro(filtro);
    }

    // Números de Vuelos: diálogo trafico_filtro_vuelo.scx (rango + 3 modos Sin/Con/A confirmar).
    // Filtra viaje por vuelo = X sobre el rango de fechas.
    private async Task FiltrarVuelo(TraficoFiltro? actual = null)
    {
        var dia = _fecha is not null ? DateOnly.FromDateTime(_fecha.Value) : DateOnly.FromDateTime(DateTime.Today);
        var parametros = new DialogParameters<TraficoFiltroVueloDialog> { { x => x.DiaActual, dia }, { x => x.FiltroInicial, actual } };
        var opciones = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<TraficoFiltroVueloDialog>("Buscar reservas por Nº de Vuelo", parametros, opciones);
        var res = await dialog.Result;
        if (res is { Canceled: false, Data: TraficoFiltro filtro })
            await AplicarFiltro(filtro);
    }

    // Nº Reserva: diálogo trafico_nro_reserva.scx (un número, sin rango). Filtra viaje por
    // id_viaje = N en toda la base (devuelve un solo viaje).
    private async Task FiltrarReserva(TraficoFiltro? actual = null) => await PedirNumeroReserva(
        TraficoFiltroTipo.Reserva, "Buscar Reserva por Número", actual);

    // Nº Reserva En Ruta: mismo diálogo en modo ruta. Filtra viaje por id_viaje_i = N (el
    // correlativo que agrupa los viajes/días de una reserva "en ruta" multi-día).
    private async Task FiltrarReservaRuta(TraficoFiltro? actual = null) => await PedirNumeroReserva(
        TraficoFiltroTipo.ReservaRuta, "Buscar Reserva En Ruta por Número", actual);

    // Abre TraficoFiltroReservaDialog en el modo dado y aplica el filtro si el usuario acepta.
    private async Task PedirNumeroReserva(TraficoFiltroTipo modo, string titulo, TraficoFiltro? actual = null)
    {
        var parametros = new DialogParameters<TraficoFiltroReservaDialog> { { x => x.Modo, modo }, { x => x.FiltroInicial, actual } };
        var opciones = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<TraficoFiltroReservaDialog>(titulo, parametros, opciones);
        var res = await dialog.Result;
        if (res is { Canceled: false, Data: TraficoFiltro filtro })
            await AplicarFiltro(filtro);
    }

    private async Task AplicarFiltro(TraficoFiltro filtro)
    {
        _filtroActivo = filtro;
        _verCancelados = false;   // el filtro server-side opera sobre la vista normal
        await CargarFiltrado();
    }

    // Carga la grilla desde el filtro server-side (re-consulta `viaje` con WHERE por rango).
    private async Task CargarFiltrado()
    {
        if (_filtroActivo is null) return;
        _cargando = true;
        StateHasChanged();

        _filaActiva = 0;
        _filasCambiadas.Clear();
        _filas = await Reports.GetPlanillaTraficoFiltradaAsync(_filtroActivo);
        _cancelados = new();      // sin vista de cancelados en modo filtro
        _version = null;          // el auto-refresh queda en pausa mientras dure el filtro
        _ultimoRefresh = DateTime.Now;

        RecalcularVisibles();
        _cargando = false;
    }

    // Reabre el diálogo del filtro activo con sus valores precargados, para ajustar fechas/criterio
    // sin tener que quitar y volver a armar el filtro desde cero. Cada diálogo recibe el filtro
    // vigente vía FiltroInicial; al aceptar, AplicarFiltro re-consulta con el filtro modificado.
    private async Task EditarFiltro()
    {
        if (_filtroActivo is null) return;
        var f = _filtroActivo;
        var tarea = f.Tipo switch
        {
            TraficoFiltroTipo.Fecha => FiltrarRangoFechas(f),
            TraficoFiltroTipo.TipoReserva => FiltrarTipoReserva(f),
            TraficoFiltroTipo.Fletero => FiltrarFletero(f),
            TraficoFiltroTipo.Choferes => FiltrarConductor(f),
            TraficoFiltroTipo.Interno => FiltrarInterno(f),
            TraficoFiltroTipo.Estado => FiltrarEstado(f),
            TraficoFiltroTipo.Vuelo => FiltrarVuelo(f),
            TraficoFiltroTipo.Reserva => FiltrarReserva(f),
            TraficoFiltroTipo.ReservaRuta => FiltrarReservaRuta(f),
            _ => Task.CompletedTask
        };
        await tarea;
    }

    // Quita el filtro y vuelve a la vista de día único (con auto-refresh).
    private async Task QuitarFiltro()
    {
        _filtroActivo = null;
        await Cargar();
    }

    private async Task DescargarExcel()
    {
        if (_fecha is null) return;
        var dia = DateOnly.FromDateTime(_fecha.Value);
        // Exporta lo que se ve en pantalla (respeta los filtros activos y el buscador).
        byte[] bytes;
        string nombre;
        if (_verCancelados)
        {
            bytes = Excel.TraficoCancelados(CanceladosVisibles(), dia);
            nombre = $"trafico_cancelados_{dia:yyyyMMdd}.xlsx";
        }
        else
        {
            bytes = Excel.PlanillaTrafico(FilasVisibles(), dia);
            nombre = $"planilla_trafico_{dia:yyyyMMdd}.xlsx";
        }
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("descargarArchivo", nombre, streamRef);
    }

    private string Fmt(int n) => n.ToString("#,0", _ar);
}
