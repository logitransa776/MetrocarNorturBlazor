    };

    // Filtros de unidad (réplica de los combos cronogramaCbio/cronograma + botón S/C).
    // Son mutuamente excluyentes, igual que en el FoxPro (GotFocus limpia el otro combo).
    private CombosUnidadesTrafico _combos = new(new(), new());
    private string? _selUPr;                 // combo 1 — Unidad Programada (interno por empresa)
    private string? _selUCb;                 // combo 2 — Unidad Asignada (todos los internos)
    private bool _soloSinCronograma;         // botón S/C → cronograma = 'S/C'

    // Vista cancelados (réplica del botón Cxl → arma_grid_viaje caso CANCELADO).
    private bool _verCancelados;
    private List<TraficoCanceladoRow> _cancelados = new();

    // Panel Buses (réplica del checkbox verBuses → grid2 / arma_grid_vehiculo).
    private bool _verBuses;
    private List<PanelBusRow> _buses = new();
    private string _busesOrdenCol = "";    // orden por click en header (réplica de ClickMHeader2)
    private bool _busesOrdenAsc = true;

    // Auto-refresh inteligente: cada 60s una query liviana (GetTraficoVersionAsync) chequea
    // si algo cambió en la base; solo entonces se recarga la grilla. Las filas nuevas o
    // modificadas se resaltan 3s con .fila-flash y la grilla se reordena sola por horario.
    private PeriodicTimer? _timerRefresh;
    private TraficoVersion? _version;
    private HashSet<int> _filasCambiadas = new();
    private DateTime? _ultimoRefresh;

    // ── F6-F9 · Cambio de cronograma (diagramación) ──
    // El MODO lo decide el permiso, no la pantalla: 'D' → diagramador (escribe U/Pr y U/Cb,
    // sin motivo, habilita el masivo), si no 'T' → operador (solo U/Cb, motivo obligatorio,
    // deja log). Réplica del Do Case del KeyPress de trafico2.scx, donde 'D' gana sobre 'T'.
    // Hoy son 3 diagramadores (ANDRES, LEONARDO, SUPERVISOR) contra 25 operadores.
    private bool EsDiagramador => Permisos.Tiene('D');
    // Texto del tercer radio y del ítem de menú: parametro.id_cliente_prueba (hoy NORTUR).
    private string _nombreEmpresa = "NORTUR";

    // ── F4 · Avisos de Tráfico (motor de alarmas) ──
    // Réplica del Timer1 (60 s) + checkbox "Chequeo" de trafico2.scx. NO lleva timer propio: se
    // cuelga del PeriodicTimer del auto-refresh, que ya late al mismo ritmo que el FoxPro.
    // Plano: docs/PlanoFoxPro/trafico/TRAFICO_F4_AVISO.md
    private AvisoConfig _avisoConfig = AvisoConfig.Apagado;
    private bool _avisosDisponibles;   // parametro.aviso_cheq = 'S' Y el usuario tiene 'C'
    private bool _avisosActivos;       // el toggle de la barra (verchequeo del FoxPro)
    // Ventana de gracia: el FoxPro compara HH:MM EXACTO, así que si nadie estaba mirando la
    // pantalla ese minuto el aviso se perdía para siempre. En la web eso pega más fuerte
    // (recargar, cambiar de pestaña), así que se piden los últimos minutos y se descarta lo ya
    // mostrado. Decisión del usuario (03/08/2026): 5 minutos.
    private const int MinutosGraciaAviso = 5;
    private readonly HashSet<int> _avisosMostrados = new();
    private bool _avisoPopupAbierto;   // evita apilar popups si el operador no cierra el anterior

    // Ventana "viva" del auto-refresh: hoy, los últimos 15 días y cualquier fecha futura.
    // Las fechas más viejas están congeladas (Metrocar/FoxPro ya no las edita), así que se
    // cargan una sola vez y no se vuelven a pollear: evita round-trips inútiles que castigan
    // al SQL Server 2012. Tráfico es un módulo de solo lectura (Blazor nunca escribe).
    private const int DiasVentanaViva = 15;
    private static bool EsFechaViva(DateOnly dia) =>
        dia >= DateOnly.FromDateTime(DateTime.Today).AddDays(-DiasVentanaViva);

    private string TituloFecha => _fecha?.ToString("dddd dd/MM/yyyy", _ar) ?? "";

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthState.EstaAutenticadoAsync())
        {
            Nav.NavigateTo($"/login?destino={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: false);
            return;
        }
        if (!Permisos.Tiene('T'))   // módulo Tráfico
        {
            Nav.NavigateTo("/", forceLoad: false);
            return;
        }
        // Avisos: mismo gating que el Init de trafico2.scx —
        //   If parametro.aviso_chequeo = "S" And "C" $ cAcceso  →  timer prendido
        // El permiso 'C' (Avisos de chequeos) lo tienen los 13 operadores de la mesa de tráfico;
        // SUPERVISOR NO lo tiene, así que con ese usuario el botón ni aparece.
        _nombreEmpresa = await Reports.GetClientePruebaAsync();
        _avisoConfig = await Reports.GetAvisoConfigAsync();
        _avisosDisponibles = _avisoConfig.Activo && Permisos.Tiene('C');
        _avisosActivos = _avisosDisponibles;

        // Combos de unidades (réplica del Init de trafico2: cursorCronogramaTrafico/Diagrama)
        _combos = await Reports.GetCombosUnidadesTraficoAsync();
        await Cargar();
        // Igual que el Init de trafico2.scx, que llama aplica_filtro("REFRESH") y ese
        // camino sí prende lHoraActual: al abrir la planilla, saltar a la hora.
        _irHoraActualPendiente = EsDiaDeHoy;
        _ = AutoRefreshLoop();   // fire-and-forget: vive mientras viva el circuito
    }

    // El día mostrado es hoy y la grilla es la vista normal del día (no cancelados ni el
    // resultado de un filtro por rango). Única condición para saltar a la hora actual.
    private bool EsDiaDeHoy =>
        _fecha?.Date == DateTime.Today && _filtroActivo is null && !_verCancelados;

    // Mientras esta página esté montada, la ventana NO scrollea: la planilla ocupa
    // exactamente el viewport y la única región scrolleable es la grilla de viajes.
    // La clase la pone/saca JS sobre <body> (ver bloquearScrollVentana en descarga.js).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("bloquearScrollVentana", true);

        // Suavizado del scroll de rueda (ver traficoSuavizarScroll en descarga.js): la rueda
        // avanza ~30% más lento y con easing, para que el render de <Virtualize> alcance a
        // llegar y no se vea el hueco en blanco. Se engancha en CADA render, no solo en el
        // primero, porque la grilla vive dentro de un @if: al cargar/filtrar el contenedor se
        // destruye y se vuelve a crear, y el listener se iría con el nodo viejo. La función
        // JS es idempotente (si ya está enganchado, no hace nada), así que repetir no cuesta.
        await JS.InvokeVoidAsync("traficoSuavizarScroll", ".trafico-wrap--nav", true);

        // Mismo easing para la lista desplegable de los combos Empresa/Interno: el popover de
        // MudBlazor sí vive en el DOM (el <select> nativo que había antes NO, su lista la dibuja
        // el sistema operativo y por eso saltaba). Listener único sobre document, idempotente.
        if (firstRender)
            await JS.InvokeVoidAsync("suavizarScrollPopover", ".filtro-ac-popover", true);

        // Salto a la hora actual. Va acá y no en Cargar() porque necesita que la grilla ya
        // esté en el DOM: el scroll se calcula contra el alto real del contenedor. Las mismas
        // condiciones del @if del markup — con _cargando o sin filas no existe .trafico-wrap.
        if (_irHoraActualPendiente && !_cargando && !_verCancelados && _filas.Count > 0)
        {
            // Foco inicial en la grilla (06/08/2026). Antes el teclado recién funcionaba
            // después de clickear una fila; desde que la ayuda dejó de tener botón, F1 es su
            // única puerta y tiene que responder apenas se entra a la pantalla. Va acá porque
            // es el punto donde ya sabemos que .trafico-wrap está en el DOM. Solo corre al
            // entrar y al apretar HOY (los dos casos que prenden _irHoraActualPendiente), así
            // que no le roba el foco al buscador mientras el operador tipea.
            await _gridWrap.FocusAsync();
            await PosicionarEnHoraActual();
        }
    }

    private async Task Cargar()
    {
        if (_fecha is null) return;
        _cargando = true;
        StateHasChanged();

        var dia = DateOnly.FromDateTime(_fecha.Value);
        _filaActiva = 0;
        _filasCambiadas.Clear();
        _filas = await Reports.GetPlanillaTraficoAsync(dia);
        // Cancelados del día: alimenta el contador del botón Cxl y la vista cancelados.
        _cancelados = await Reports.GetTraficoCanceladosAsync(dia);
        // El FoxPro rearma grid2 tras cada operación; acá lo refresca el auto-refresh.
        if (_verBuses)
            _buses = await Reports.GetPanelBusesAsync();

        // Token de versión inicial: contra esto compara el auto-refresh. Solo para fechas
        // vivas; las congeladas no se pollean, así que no gastamos la consulta.
        _version = EsFechaViva(dia) ? await Reports.GetTraficoVersionAsync(dia) : null;
        _ultimoRefresh = DateTime.Now;

        RecalcularVisibles();   // datos nuevos → refrescar el conjunto memoizado
        _cargando = false;
    }

    // ── Auto-refresh inteligente (timer 60s) ──

    private async Task AutoRefreshLoop()
    {
        _timerRefresh = new PeriodicTimer(TimeSpan.FromSeconds(60));
        try
        {
            while (await _timerRefresh.WaitForNextTickAsync())
            {
                // Los avisos van PRIMERO y fuera de los `continue` de abajo: la alarma es
                // siempre de los servicios de HOY, mire la grilla el día que mire (el FoxPro
                // arma su cursor con DATE(), no con la fecha de trabajo). Que el operador esté
                // consultando el martes que viene no puede callar la alarma de esta tarde.
                try { await ChequearAvisos(); } catch { /* un tick fallido no corta el timer */ }

                if (_cargando || _fecha is null) continue;
                if (_filtroActivo is not null) continue;   // con filtro de rango activo, sin polling por día
                try
                {
                    var dia = DateOnly.FromDateTime(_fecha.Value);
                    // Fechas congeladas (más viejas que la ventana viva): no se pollea nada.
                    // Metrocar ya no las edita → re-consultarlas solo castiga al SQL Server.
                    if (!EsFechaViva(dia)) continue;
                    var version = await Reports.GetTraficoVersionAsync(dia);

                    if (_version is not null && version == _version)
                    {
                        // Sin cambios en la base: solo actualizar el reloj de la leyenda.
                        _ultimoRefresh = DateTime.Now;
                        await InvokeAsync(StateHasChanged);
                        continue;
                    }

                    _version = version;
                    await RefrescarConFlash(dia);
                }
                catch
                {
                    // Tick fallido (réplica caída, timeout): se reintenta en el próximo.
                }
            }
        }
        catch (ObjectDisposedException) { /* la página se cerró */ }
    }

    // ── F4 · Motor de avisos (réplica de Timer1 + formInicioServicio de trafico2.scx) ──

    /// <summary>Interruptor del motor de avisos — el checkbox "Chequeo" del toolbar FoxPro.</summary>
    private void ToggleAvisos()
    {
        _avisosActivos = !_avisosActivos;
        // Al reactivar no se re-disparan los avisos ya mostrados ni los que sonaron mientras
        // estaba apagado: apagarlo es una decisión del operador, no una pausa con playback.
        if (_avisosActivos) _avisosMostrados.Clear();
    }

    /// <summary>
    /// Un tick del motor: ¿hay servicios cuyo aviso cae en la ventana [ahora−5min, ahora]?
    /// Los que ya se mostraron en esta sesión se descartan (dedupe por id_viaje), así la
    /// ventana de gracia no repite la misma alarma minuto a minuto.
    /// </summary>
    private async Task ChequearAvisos()
    {
        if (!_avisosActivos || _avisoPopupAbierto) return;

        var ahora = DateTime.Now;
        var minutoActual = new DateTime(ahora.Year, ahora.Month, ahora.Day, ahora.Hour, ahora.Minute, 0);
        var desde = minutoActual.AddMinutes(-MinutosGraciaAviso);
        var hasta = minutoActual.AddSeconds(59);

        // La query se ocupa sola del rango de f_reserva (incluye los servicios de mañana de
        // madrugada, cuyo aviso cae hoy a la noche — 1.226 casos en 2026).
        var pendientes = await Reports.GetAvisosPendientesAsync(
            desde, hasta, _avisoConfig.MinutosDefault);

        var nuevos = pendientes.Where(a => !_avisosMostrados.Contains(a.IdViaje)).ToList();
        if (nuevos.Count == 0) return;

        foreach (var a in nuevos) _avisosMostrados.Add(a.IdViaje);
        await InvokeAsync(() => MostrarPopupAvisos(nuevos, minutoActual));
    }

    /// <summary>Abre el popup de la alarma. Si el operador hace doble clic en un servicio,
    /// encadena con el Zoom del Viaje (que es a dónde va a querer ir).</summary>
    private async Task MostrarPopupAvisos(List<AvisoViajeRow> avisos, DateTime minuto)
    {
        _avisoPopupAbierto = true;
        try
        {
            var parametros = new DialogParameters<AvisosDisparadosDialog>
            {
                { x => x.Avisos, avisos },
                { x => x.Hora, minuto.ToString("HH:mm") }
            };
            var opciones = new DialogOptions
            {
                MaxWidth = MaxWidth.Large,
                FullWidth = true,
                CloseButton = false,
                CloseOnEscapeKey = true,
                BackdropClick = true
            };
            var dlg = await DialogService.ShowAsync<AvisosDisparadosDialog>("Aviso de servicios", parametros, opciones);
            var res = await dlg.Result;
            if (res is { Canceled: false, Data: AvisoViajeRow elegido })
                await AbrirZoom(elegido.IdViaje, DateOnly.FromDateTime(minuto));
        }
        finally
        {
            _avisoPopupAbierto = false;
        }
    }

    // ── F6-F9 / Ctrl+F8 · Cambio de cronograma ──

    /// <summary>Solo tiene sentido copiar U/Pr → U/Cb si hay algo programado y difiere.</summary>
    private static bool PuedeCopiarDiagramador(PlanillaTraficoRow? f) =>
        f is not null
        && !string.IsNullOrWhiteSpace(f.UPr)
        && (f.UPr ?? "").Trim() != (f.UCb ?? "").Trim();

    private async Task AbrirCronogramaContexto(string atajo)
    {
        if (_filaCtx is null) return;
        await AbrirCronograma(_filaCtx, atajo, "");
    }

    /// <summary>Teclas F6-F9 sobre la grilla: actúan sobre la fila activa.</summary>
    private async Task AbrirCronogramaFilaActiva(string atajo, string letra = "")
    {
        if (_filaActiva == 0) return;
        var fila = _visibles.FirstOrDefault(f => f.IdViaje == _filaActiva);
        if (fila is not null) await AbrirCronograma(fila, atajo, letra);
    }

    private async Task AbrirCronograma(PlanillaTraficoRow fila, string atajo, string letra)
    {
        var parametros = new DialogParameters<CronogramaDialog>
        {
            { x => x.Fila, fila },
            // El universo del masivo es lo que está A LA VISTA, igual que el cursor del FoxPro.
            { x => x.Visibles, _visibles },
            { x => x.EsDiagramador, EsDiagramador },
            { x => x.Atajo, atajo },
            { x => x.Letra, letra },
            { x => x.Usuario, AuthState.UsuarioActual ?? "" }
        };
        var opciones = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = false,
            CloseOnEscapeKey = true,
            BackdropClick = true
        };
        var dlg = await DialogService.ShowAsync<CronogramaDialog>("Cambiar cronograma", parametros, opciones);
        var res = await dlg.Result;
        if (res is { Canceled: false, Data: true } && _fecha is not null && _filtroActivo is null)
            await RefrescarConFlash(DateOnly.FromDateTime(_fecha.Value));
    }

    /// <summary>Ctrl+F8 — copia la unidad programada (U/Pr) sobre la vigente (U/Cb), sin diálogo.</summary>
    private async Task CopiarCronogramaContexto()
    {
        if (_filaCtx is null) return;
        await CopiarCronograma(_filaCtx);
    }

    private async Task CopiarCronograma(PlanillaTraficoRow fila)
    {
        if (!PuedeCopiarDiagramador(fila)) return;
        var modo = EsDiagramador ? AbmService.ModoCronograma.Diagramador : AbmService.ModoCronograma.Operador;
        var r = await Abm.CopiarCronogramaDiagramadorAsync(fila.IdViaje, fila.Fecha, modo, AuthState.UsuarioActual ?? "");
        Snackbar.Add(
            r.Ok ? $"Reserva #{fila.IdViaje}: U/Cb queda en {fila.UPr}" : r.Error ?? "No se pudo copiar",
            r.Ok ? Severity.Success : Severity.Warning);
        if (r.Ok && _fecha is not null && _filtroActivo is null)
            await RefrescarConFlash(DateOnly.FromDateTime(_fecha.Value));
    }

    // ── F4 · Aviso sobre el viaje (setter) ──

    /// <summary>Ítem "Aviso sobre el viaje" del menú contextual.</summary>
    private async Task AbrirAvisoContexto()
    {
        if (_filaCtx is null) return;
        await AbrirAviso(_filaCtx);
    }

    /// <summary>Tecla F4 sobre la grilla: actúa sobre la fila ACTIVA (la seleccionada), igual
    /// que el FoxPro, que trabaja sobre el registro actual del cursor.</summary>
    private async Task AbrirAvisoFilaActiva()
    {
        if (_filaActiva == 0) return;
        var fila = _visibles.FirstOrDefault(f => f.IdViaje == _filaActiva);
        if (fila is not null) await AbrirAviso(fila);
    }

    private async Task AbrirAviso(PlanillaTraficoRow fila)
    {
        var parametros = new DialogParameters<AvisoViajeDialog>
        {
            { x => x.IdViaje, fila.IdViaje },
            { x => x.FReserva, fila.Fecha },
            { x => x.Usuario, AuthState.UsuarioActual ?? "" }
        };
        var opciones = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = false,
            CloseOnEscapeKey = true,
            BackdropClick = true
        };
        var dlg = await DialogService.ShowAsync<AvisoViajeDialog>("Aviso sobre el viaje", parametros, opciones);
        var res = await dlg.Result;
        // Grabó: refrescar para que la columna H.Avi muestre la hora nueva sin esperar el timer.
        if (res is { Canceled: false, Data: true } && _fecha is not null && _filtroActivo is null)
            await RefrescarConFlash(DateOnly.FromDateTime(_fecha.Value));
    }

    private async Task RefrescarConFlash(DateOnly dia)
    {
        // Forzar datos frescos aunque el TTL del caché (55s) no haya vencido.
        Reports.InvalidarCacheTrafico(dia);

        var previas = _filas.ToDictionary(f => f.IdViaje);
        var filas = await Reports.GetPlanillaTraficoAsync(dia);
        var cancelados = await Reports.GetTraficoCanceladosAsync(dia);
        var buses = _verBuses ? await Reports.GetPanelBusesAsync() : _buses;

        // PlanillaTraficoRow es record → la igualdad por valor detecta cualquier
        // campo modificado. Fila nueva o distinta ⇒ flash.
        var cambiadas = filas
            .Where(f => !previas.TryGetValue(f.IdViaje, out var ant) || ant != f)
            .Select(f => f.IdViaje)
            .ToHashSet();

        await InvokeAsync(() =>
        {
            // La query ya viene ordenada por hs_inicio ⇒ reordenamiento automático.
            _filas = filas;
            _cancelados = cancelados;
            _buses = buses;
            _filasCambiadas = cambiadas;
            _ultimoRefresh = DateTime.Now;
            RecalcularVisibles();   // datos nuevos → refrescar el conjunto memoizado
            StateHasChanged();
        });

        if (cambiadas.Count > 0)
        {
            // Quitar la clase .fila-flash cuando termina la animación (3s) para que
            // un próximo cambio sobre la misma fila vuelva a destellar.
            await Task.Delay(3500);
            await InvokeAsync(() =>
            {
                _filasCambiadas.Clear();
                StateHasChanged();
            });
        }
    }

    public void Dispose()
    {
        _timerRefresh?.Dispose();
        // Devolver el scroll normal a la ventana al salir de la planilla. Fire-and-forget:
        // si el circuito ya se cerró, la interop falla silenciosamente (no pasa nada).
        try { _ = JS.InvokeVoidAsync("bloquearScrollVentana", false); } catch { }
        // Soltar el listener de rueda y cortar cualquier animación de scroll en curso.
        try { _ = JS.InvokeVoidAsync("traficoSuavizarScroll", ".trafico-wrap--nav", false); } catch { }
        try { _ = JS.InvokeVoidAsync("suavizarScrollPopover", ".filtro-ac-popover", false); } catch { }
    }

    private async Task OnFechaChanged(DateTime? nueva)
    {
        _fecha = nueva;
        await Cargar();
    }

    private async Task DiaAnterior()
    {
        _fecha = (_fecha ?? DateTime.Today).AddDays(-1);
        await Cargar();
    }

    private async Task DiaSiguiente()
    {
        _fecha = (_fecha ?? DateTime.Today).AddDays(1);
        await Cargar();
    }

    private async Task IrHoy()
