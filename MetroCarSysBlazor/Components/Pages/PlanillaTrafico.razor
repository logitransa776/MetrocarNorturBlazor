    private async Task AplicarFiltro(TraficoFiltro filtro)
    {
        _filtroActivo = filtro;
        _verCancelados = false;   // el filtro server-side opera sobre la vista normal
        await CargarFiltrado();
    }

    // Carga la grilla desde el filtro server-side (re-consulta `viaje` con WHERE por rango).
    private async Task CargarFiltrado()
    {
        if (_filtroActivo is null) return;
        _cargando = true;
        StateHasChanged();

        _filaActiva = 0;
        _filasCambiadas.Clear();
        _filas = await Reports.GetPlanillaTraficoFiltradaAsync(_filtroActivo);
        _cancelados = new();      // sin vista de cancelados en modo filtro
        _version = null;          // el auto-refresh queda en pausa mientras dure el filtro
        _ultimoRefresh = DateTime.Now;

        RecalcularVisibles();
        _cargando = false;
    }

    // Reabre el diálogo del filtro activo con sus valores precargados, para ajustar fechas/criterio
    // sin tener que quitar y volver a armar el filtro desde cero. Cada diálogo recibe el filtro
    // vigente vía FiltroInicial; al aceptar, AplicarFiltro re-consulta con el filtro modificado.
    private async Task EditarFiltro()
    {
        if (_filtroActivo is null) return;
        var f = _filtroActivo;
        var tarea = f.Tipo switch
        {
            TraficoFiltroTipo.Fecha => FiltrarRangoFechas(f),
            TraficoFiltroTipo.TipoReserva => FiltrarTipoReserva(f),
            TraficoFiltroTipo.Fletero => FiltrarFletero(f),
            TraficoFiltroTipo.Choferes => FiltrarConductor(f),
            TraficoFiltroTipo.Interno => FiltrarInterno(f),
            TraficoFiltroTipo.Estado => FiltrarEstado(f),
            TraficoFiltroTipo.Vuelo => FiltrarVuelo(f),
            TraficoFiltroTipo.Reserva => FiltrarReserva(f),
            TraficoFiltroTipo.ReservaRuta => FiltrarReservaRuta(f),
            _ => Task.CompletedTask
        };
        await tarea;
    }

    // Quita el filtro y vuelve a la vista de día único (con auto-refresh).
    private async Task QuitarFiltro()
    {
        _filtroActivo = null;
        await Cargar();
    }

    private async Task DescargarExcel()
    {
        if (_fecha is null) return;
        var dia = DateOnly.FromDateTime(_fecha.Value);
        // Exporta lo que se ve en pantalla (respeta los filtros activos y el buscador).
        byte[] bytes;
        string nombre;
        if (_verCancelados)
        {
            bytes = Excel.TraficoCancelados(CanceladosVisibles(), dia);
            nombre = $"trafico_cancelados_{dia:yyyyMMdd}.xlsx";
        }
        else
        {
            bytes = Excel.PlanillaTrafico(FilasVisibles(), dia);
            nombre = $"planilla_trafico_{dia:yyyyMMdd}.xlsx";
        }
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("descargarArchivo", nombre, streamRef);
    }

    private string Fmt(int n) => n.ToString("#,0", _ar);
