    // ── Guardas de habilitación (las mismas del .mpr, evaluadas sobre la fila) ──
    // Se replican acá para deshabilitar el ítem en vez de dejar apretar y mostrar un cartel:
    // el FoxPro no tenía forma de hacerlo, pero el motivo se ve igual en el diálogo.

    // Solo la flota propia NORTUR tiene GPS. vehiculo.cronograma YA es el código que entiende
    // el sitio ("NT0042"), así que no hay que armarlo — y de paso se evita el bug del original,
    // que truncaba el interno a 2 dígitos con Right("00"+Str(interno), 2).
    private static bool BusTieneGps(PanelBusRow? b) =>
        b is not null && b.Cronograma.StartsWith("NT", StringComparison.OrdinalIgnoreCase);

    // Logonear (bars 10/14): la unidad tiene que estar LIBERADA; el 2º exige que esté el 1º
    // y que no haya ya un 2º.
    private static bool PuedeLogonear(PanelBusRow? b, bool segundo)
    {
        if (b is null || b.Estado != "LIBERADO") return false;
        return segundo
            ? !string.IsNullOrWhiteSpace(b.Chofer) && string.IsNullOrWhiteSpace(b.Chofer2)
            : string.IsNullOrWhiteSpace(b.Chofer);
    }

    // DesLogonear (bars 11/15): no en TALLER/GUARDIA, no con viaje en curso, y el 1º no se
    // puede sacar si todavía está el 2º ("¡ Deslogonee al 2º conductor !").
    private static bool PuedeDeslogonear(PanelBusRow? b, bool segundo)
    {
        if (b is null || b.Estado is "TALLER" or "GUARDIA" || b.IdViaje is > 0) return false;
        return segundo
            ? !string.IsNullOrWhiteSpace(b.Chofer2)
            : !string.IsNullOrWhiteSpace(b.Chofer) && string.IsNullOrWhiteSpace(b.Chofer2);
    }

