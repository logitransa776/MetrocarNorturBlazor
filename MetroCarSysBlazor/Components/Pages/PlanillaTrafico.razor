    // ── Bar 20 · Ir al Viaje ──
    // Réplica de buscar_viaje(): si el viaje es un tramo de RUTA (id_viaje_int ≠ 0) filtra por
    // ruta; si no, lo busca en la grilla del día y —si no está— ofrece filtrar por Nº de reserva.
    private async Task IrAlViajeDeLaUnidad()
    {
        if (_busCtx?.IdViaje is not > 0) return;
        var idViaje = _busCtx.IdViaje.Value;
        var dia = DateOnly.FromDateTime(_fecha ?? DateTime.Today);

        if (_busCtx.IdViajeInt is > 0)
        {
            // El FoxPro aplica el filtro VARIO_RUTA directo, sin preguntar.
            await AplicarFiltro(new TraficoFiltro(
                TraficoFiltroTipo.ReservaRuta, dia, dia, Numero: _busCtx.IdViajeInt.Value));
            return;
        }

        // ¿Está en la grilla que se está mirando? Entonces solo hay que seleccionarla y
        // llevarla a la vista (el FoxPro hace Locate + grid1.SetFocus).
        var idx = _visibles.FindIndex(f => f.IdViaje == idViaje);
        if (idx >= 0) { await IrAFila(idx); return; }

        // "Registro no encontrado en las reservas actuales / ¿Desea aplicar filtro con ese
        // Nº de reserva?" — el diálogo de filtro por reserva ya viene con el número cargado.
        await FiltrarReserva(new TraficoFiltro(TraficoFiltroTipo.Reserva, dia, dia, Numero: idViaje));
    }

