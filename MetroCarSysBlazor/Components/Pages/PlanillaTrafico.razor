    // ── Ubicar en GPS — réplica del método ubicar_gps de trafico2.scx ──
    // El FoxPro abría el sitio GPS con Shell.Open(url); acá abrimos la URL en pestaña nueva.
    //
    // ⚠️ El servidor viejo del FoxPro (embedded.sytes.net:8085) YA NO EXISTE (DNS NXDOMAIN).
    // El GPS hoy vive en metrocar.nortur.ar y cambió el formato de la URL respecto del FoxPro:
    //   · dominio:  embedded.sytes.net:8085   →  metrocar.nortur.ar
    //   · cod:      94 (ubicar) / 12640 (rec) →  12640 para AMBOS
    //   · int:      2 dígitos del interno      →  el CÓDIGO DE UNIDAD COMPLETO (ej "NT0042")
    // Verificado contra el sitio productivo (movil.aspx y Maps.aspx responden 200; el marcador
    // del mapa se rotula con el int que se le pasa, ej "NT0042"). "Recorrido en Grilla"
    // (Inf_Hist.aspx) da 404 en el sitio nuevo → queda deshabilitado en el menú.
    private const string GpsBaseUrl = "http://metrocar.nortur.ar";
    private const string GpsCod = "12640";

    // Código de unidad que entiende el GPS (ej "NT0042"). Prioridad: id_interno (U/As) →
    // cronograma (U/Cb) → cronograma2 (U/Pr), descartando vacíos y los literales no-unidad
    // ("S/C" sin asignar, "NORTUR" servicio de prueba). Devuelve null si no hay unidad válida.
    private static string? UnidadGps(PlanillaTraficoRow f)
    {
        foreach (var cand in new[] { f.UAs, f.UCb, f.UPr })
        {
            var u = cand?.Trim();
            if (string.IsNullOrEmpty(u)) continue;
            if (u is "S/C" or "NORTUR") continue;
            return u;
        }
        return null;
    }

    // Ubicar unidad → movil.aspx (cTipo_consulta = "UBICAR" en el FoxPro).
    // Antes abría una pestaña nueva (AbrirGps); ahora muestra el GPS embebido en un modal
    // (GpsMapaDialog) dentro de la misma app, sin salir a otra pestaña.
    private async Task UbicarUnidadGps()
    {
        if (_filaCtx is null) return;
        if (!EsUnidadNortur(_filaCtx)) return;   // guarda: el menú ya lo deshabilita
        var unidad = UnidadGps(_filaCtx);
        if (unidad is null) { await AvisarSinGps(); return; }
        var url = $"{GpsBaseUrl}/movil.aspx?cod={GpsCod}&int={Uri.EscapeDataString(unidad)}";
        await AbrirGpsEnDialog(url, "Ubicación de la unidad", unidad, Icons.Material.Filled.LocationOn);
    }

    // Ventana de días hacia atrás en que el GPS conserva el histórico de recorrido de la unidad.
    private const int RecorridoWebDiasAtras = 45;

    // La fila tiene una unidad de la flota NORTUR (código NT####) — las únicas con GPS propio.
    // Es la condición para habilitar los dos ítems de GPS del menú contextual.
    private static bool EsUnidadNortur(PlanillaTraficoRow f)
    {
        var unidad = UnidadGps(f);
        return unidad is not null && unidad.StartsWith("NT", StringComparison.OrdinalIgnoreCase);
    }

    // "Recorrido en WEB" se habilita solo si la fila cumple las dos condiciones:
    //   1) la unidad es de la flota NORTUR (código NT####) — las únicas con GPS propio;
    //   2) la fecha del viaje está dentro de los últimos 45 días (el GPS no guarda más histórico).
    private static bool RecorridoWebHabilitado(PlanillaTraficoRow f)
    {
        if (!EsUnidadNortur(f)) return false;
        var hoy = DateOnly.FromDateTime(DateTime.Today);
        return f.Fecha >= hoy.AddDays(-RecorridoWebDiasAtras) && f.Fecha <= hoy;
    }

    // Recorrido en WEB → Maps.aspx (cTipo_consulta = "RECORRIDO"). Pasa desde/hasta como
    // hs_inicio/hs_fin en formato YYYYMMDDHHMMSS (Ttoc(...,1) del FoxPro); hs_fin vacío → ahora.
    // Igual que Ubicar unidad, ahora se muestra embebido en un modal (no abre pestaña nueva).
    private async Task RecorridoWebGps()
    {
        if (_filaCtx is null) return;
        if (!RecorridoWebHabilitado(_filaCtx)) return;   // guarda: el menú ya lo deshabilita
        var unidad = UnidadGps(_filaCtx);
        if (unidad is null) { await AvisarSinGps(); return; }
        var desde = FmtGps(_filaCtx.HsInicio ?? DateTime.Now);
        var hasta = FmtGps(_filaCtx.HsFin ?? DateTime.Now);
        var url = $"{GpsBaseUrl}/Maps.aspx?cod={GpsCod}&int={Uri.EscapeDataString(unidad)}&desde={desde}&hasta={hasta}";
        await AbrirGpsEnDialog(url, "Unidad", unidad, Icons.Material.Filled.Map,
            recorrido: _filaCtx.Recorrido, hsInicio: _filaCtx.HsInicio, hsFin: _filaCtx.HsFin);
    }

    // Formato de fecha/hora que espera el sitio GPS (igual a Ttoc(dt,1) de FoxPro): YYYYMMDDHHMMSS.
    private static string FmtGps(DateTime dt) => dt.ToString("yyyyMMddHHmmss", System.Globalization.CultureInfo.InvariantCulture);

    // Abre la URL del GPS en una pestaña nueva; si el navegador bloquea el pop-up, avisa.
    private async Task AbrirGps(string url)
    {
        var ok = await JS.InvokeAsync<bool>("abrirEnNuevaPestana", url);
        if (!ok)
            await JS.InvokeVoidAsync("alert",
                "El navegador bloqueó la ventana del GPS. Habilitá las ventanas emergentes para este sitio e intentá de nuevo.");
    }

    // Opciones del modal del GPS: ancho extra grande, casi pantalla completa, para que el
    // mapa embebido se vea cómodo. Se cierra con Esc o con el botón ✕ de la barra.
    private static readonly DialogOptions GpsDialogOptions = new()
    {
