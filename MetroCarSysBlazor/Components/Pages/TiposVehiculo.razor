@page "/tipos-vehiculo"
@using MetroCarSysBlazor.Components.Shared
@inject ReportService Reports
@inject NorturAuthStateProvider AuthState
@inject IPermissionService Permisos
@inject NavigationManager Nav
@inject ExcelExportService ExcelSvc
@inject IDialogService DialogService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Tipo de Vehículos — NORTUR</PageTitle>

@* ── Encabezado de página ── *@
<div class="page-header mb-4">
    <MudText Typo="Typo.h5" Style="font-weight:800; color:#112F5B;">
        Tipo de Vehículos
    </MudText>
    <MudText Typo="Typo.body2" Style="color:#7A90AD; margin-top:2px;">
        Vehículos y Choferes · Categorías de la flota — vista de solo lectura (lista para el ABM)
    </MudText>
</div>

@* ── Filtros (réplica de la toolbar FoxPro vehiculo_tipo.scx) ── *@
<MudPaper Class="pa-2 mb-3" Elevation="1" Style="border-radius:14px; border-top:4px solid #003AA0;">
    <div class="d-flex flex-wrap align-center" style="gap:14px;">
        <MudTextField @bind-Value="_busqueda" Label="Buscar (código o nombre)"
                      Immediate="true" DebounceInterval="200"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Style="min-width:260px;" />
        <MudCheckBox T="bool" @bind-Value="_verEgresados" Label="Ver dados de baja" Color="Color.Primary" Size="Size.Small" />
        <MudChip T="string" Variant="Variant.Text" Color="Color.Default" Size="Size.Small">
            @Filtrados.Count() de @_tipos.Count
        </MudChip>

        <span style="flex:1 1 auto;"></span>
        <div class="d-flex align-center" style="gap:6px;">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Refresh" OnClick="Refrescar" Disabled="_cargando">
                Actualizar
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Download" OnClick="DescargarExcel"
                       Disabled="_cargando || !Filtrados.Any()">
                Excel
            </MudButton>
        </div>
    </div>
</MudPaper>

@if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" Style="border-radius:4px;" />
}
else
{
    <MudPaper Elevation="1" Style="border-radius:14px; overflow:hidden;">
        <MudTable Items="Filtrados" Dense="true" Hover="true" Striped="true"
                  FixedHeader="true" Height="calc(100vh - 320px)"
                  Bordered="false" Class="cli-grid grid-compacta"
                  RowClass="cli-grid__row" RowClassFunc="@RowClass"
                  OnRowClick="@OnRowClick" T="TipoVehiculoRow">
            <HeaderContent>
                <MudTh><MudTableSortLabel InitialDirection="SortDirection.Ascending" SortBy="new Func<TipoVehiculoRow, object>(x => x.Codigo)">Código</MudTableSortLabel></MudTh>
                <MudTh>Nombre</MudTh>
                <MudTh Style="text-align:right"><MudTableSortLabel SortBy="new Func<TipoVehiculoRow, object>(x => x.Pax)">Pax</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:center">Subtipo</MudTh>
                <MudTh Style="text-align:right">Consumo mín.</MudTh>
                <MudTh Style="text-align:right">Consumo máx.</MudTh>
                <MudTh Style="text-align:center">Vende</MudTh>
                <MudTh>Baja</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Código" Style="font-weight:700; color:#003AA0;">@context.Codigo</MudTd>
                <MudTd DataLabel="Nombre" Style="font-weight:600;">@context.Nombre</MudTd>
                <MudTd DataLabel="Pax" Style="text-align:right">@context.Pax</MudTd>
                <MudTd DataLabel="Subtipo" Style="text-align:center">@(string.IsNullOrWhiteSpace(context.Subtipo) ? "·" : context.Subtipo)</MudTd>
                <MudTd DataLabel="Consumo mín." Style="text-align:right">@Cons(context.ConsumoMin)</MudTd>
                <MudTd DataLabel="Consumo máx." Style="text-align:right">@Cons(context.ConsumoMax)</MudTd>
                <MudTd DataLabel="Vende" Style="text-align:center">
                    @if (context.Vende)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Style="color:#16A34A;" />
                    }
                </MudTd>
                <MudTd DataLabel="Baja">@(context.FDelete is null ? "" : context.FDelete.Value.ToString("dd/MM/yy"))</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Class="pa-4">No hay tipos de vehículo para el filtro aplicado.</MudText>
            </NoRecordsContent>
        </MudTable>

        @* ── Botonera réplica FoxPro — ANDAMIAJE: se habilita con AbmFeatureFlags.TiposVehiculoAbmActivo (hoy false) ── *@
        <div class="cli-toolbar usr-toolbar">
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add"
                       Size="Size.Medium" Class="usr-toolbar__btn" OnClick="Agregar" Disabled="!_abmActivo">Agregar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                       Size="Size.Medium" Class="usr-toolbar__btn" OnClick="Eliminar" Disabled="!_abmActivo || _sel is null">Eliminar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                       Size="Size.Medium" Class="usr-toolbar__btn" OnClick="Modificar" Disabled="!_abmActivo || _sel is null">Modificar</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Visibility"
                       Size="Size.Medium" Class="usr-toolbar__btn" OnClick="Ver" Disabled="_sel is null">Ver ficha</MudButton>
            <span style="flex:1;"></span>
            <span class="cli-toolbar__hint">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                @(_abmActivo
                    ? "ABM habilitado · doble clic para ver la ficha"
                    : "Solo lectura · el ABM se activa el día del corte a Buslink · doble clic para ver la ficha")
            </span>
        </div>
    </MudPaper>
}

@code {
    // Interruptor del andamiaje (centralizado). Hoy false → botonera de escritura deshabilitada.
    private static bool _abmActivo => AbmFeatureFlags.TiposVehiculoAbmActivo;

    private List<TipoVehiculoRow> _tipos = new();
    private bool _cargando = true;
    private string? _busqueda;
    private bool _verEgresados;
    private TipoVehiculoRow? _sel;

    private readonly System.Globalization.CultureInfo _ar =
        System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    private IEnumerable<TipoVehiculoRow> Filtrados =>
        _tipos.Where(t =>
            (string.IsNullOrWhiteSpace(_busqueda)
                || t.Codigo.Contains(_busqueda, StringComparison.OrdinalIgnoreCase)
                || t.Nombre.Contains(_busqueda, StringComparison.OrdinalIgnoreCase))
            && (_verEgresados || t.FDelete is null));

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthState.EstaAutenticadoAsync())
        {
            Nav.NavigateTo($"/login?destino={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: false);
            return;
        }
        if (!Permisos.Tiene('V'))   // módulo Vehículos y Choferes
        {
            Nav.NavigateTo("/", forceLoad: false);
            return;
        }
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        StateHasChanged();
        _tipos = await Reports.GetTiposVehiculoAsync();
        if (_sel is not null)
            _sel = _tipos.FirstOrDefault(t => t.Id == _sel.Id);
        _cargando = false;
    }

    private async Task Refrescar()
    {
        Reports.InvalidarCacheAbm();
        await CargarAsync();
    }

    private string RowClass(TipoVehiculoRow t, int _) =>
        (t.FDelete is not null ? "cli-grid__row--egresado " : "")
        + (_sel is not null && _sel.Id == t.Id ? "cli-grid__row--sel" : "");

    private void OnRowClick(TableRowClickEventArgs<TipoVehiculoRow> args)
    {
        _sel = args.Item;
        if (args.MouseEventArgs.Detail >= 2 && _sel is not null)
            _ = AbrirDialog("ver", _sel.Id);
    }

    private Task Agregar() => AbrirDialog("alta", 0);
    private Task Ver() => _sel is null ? Task.CompletedTask : AbrirDialog("ver", _sel.Id);
    private Task Modificar() => _sel is null ? Task.CompletedTask : AbrirDialog("modifica", _sel.Id);
    private Task Eliminar() => _sel is null ? Task.CompletedTask : AbrirDialog("baja", _sel.Id);

    private async Task AbrirDialog(string modo, int id)
    {
        var parametros = new DialogParameters<TipoVehiculoEditorDialog>
        {
            { x => x.Modo, modo },
            { x => x.Id, id }
        };
        var opciones = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = false,
            CloseOnEscapeKey = true,
            BackdropClick = false
        };
        var dlg = await DialogService.ShowAsync<TipoVehiculoEditorDialog>("Tipo de Vehículo", parametros, opciones);
        var res = await dlg.Result;
        if (res is not null && !res.Canceled && res.Data is bool grabo && grabo)
            await Refrescar();
    }

    private async Task DescargarExcel()
    {
        var bytes = ExcelSvc.TiposVehiculo(Filtrados.ToList());
        await JS.InvokeVoidAsync("downloadFile", "TiposVehiculo.xlsx", Convert.ToBase64String(bytes));
    }

    private string Cons(decimal? d) => d is decimal v ? v.ToString("0.##", _ar) : "—";
}
