@page "/reservas-fecha-servicio"
@using ApexCharts
@using MudColor = MudBlazor.Color
@using MudSize = MudBlazor.Size
@inject ReportService Reports
@inject ExcelExportService Excel
@inject NorturAuthStateProvider AuthState
@inject IPermissionService Permisos
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<PageTitle>BusLink</PageTitle>

@* ── Encabezado de página ── *@
<div class="page-header mb-3">
    <MudText Typo="Typo.h5" Style="font-weight:800; color:#112F5B;">
        Reservas por fecha y servicio
    </MudText>
    <MudText Typo="Typo.body2" Style="color:#7A90AD; margin-top:2px;">
        Nortur · datos en vivo desde replicaVPF
    </MudText>
</div>

@* ── Barra de filtros (horizontal, compacta) ── *@
<MudPaper Elevation="1" Class="rfs-filtros mb-4">
    <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="MudSize.Small" Style="color:#003AA0; flex-shrink:0;" />

    @* Desde/Hasta juntos como un par (gap chico), separados del resto de los filtros *@
    <div class="rfs-fechas">
        <MudDatePicker Label="Desde" Date="_desde" DateChanged="@(d => { _desde = d; })"
                       MinDate="_min" MaxDate="_max" DateFormat="dd/MM/yyyy"
                       PickerVariant="PickerVariant.Dialog" Editable="true"
                       Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:160px;" />
        <MudDatePicker Label="Hasta" Date="_hasta" DateChanged="@(d => { _hasta = d; })"
                       MinDate="_min" MaxDate="_max" DateFormat="dd/MM/yyyy"
                       PickerVariant="PickerVariant.Dialog" Editable="true"
                       Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:160px;" />
    </div>

    @* Línea de negocio (30/07/2026, pedido del frente final). Sale de `servicio.modo_uso`, que
       en el ABM del FoxPro es el radio "Uso": Ambos / Especial / Transporte de Personal. Antes
       este informe mostraba de hecho SOLO Turismo — no por un filtro, sino porque el Transporte
       de Personal viaja entero bajo CABECERA_KM/SERV y las cabeceras se excluyen siempre.
       "Internos" (cliente propio NORTUR) reemplazó al viejo switch y se aplica AL INSTANTE. *@
    @* El texto de ayuda va como `title` nativo y NO envuelto en MudTooltip: el popover del
       tooltip pelea con el desplegable del select (posicionamiento y clics). *@
    <MudSelect T="string" Label="Tipo de servicio" MultiSelection="true"
               SelectedValues="_tiposSel" SelectedValuesChanged="CambiarTipos"
               SelectAll="true" SelectAllText="Todos" Dense="true"
               Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:215px;"
               title="Turismo = servicios especiales (city tours, traslados, cenas). Transporte de Personal = las cabeceras de empresas (AEROLINEAS, YPF, CONUAR) y las guardias. Internos = viajes del propio NORTUR (taller, engrase, movimientos). Se aplica al instante."
               MultiSelectionTextFunc="@(s => s.Count == ReportService.TiposServicio.Count ? "Todos" : string.Join(", ", s.Select(EtiquetaTipoCorta)))">
        @foreach (var t in ReportService.TiposServicio)
        {
            <MudSelectItem T="string" Value="@t">@EtiquetaTipo(t)</MudSelectItem>
        }
    </MudSelect>

    @* Dimensión del desglose. Por CLIENTE es lo único que hace legible el Transporte de Personal:
       ahí el servicio es siempre "CABECERA POR KILOMETRO" y el dato útil es la empresa. *@
    <MudSelect T="string" Label="Desglosar por" Value="_dimension" ValueChanged="CambiarDimension"
               Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:150px;"
               title="Con qué abrir el informe: por servicio (city tours, EZEIZA…) o por cliente (AEROLINEAS, YPF, CONUAR…). Para Transporte de Personal conviene por cliente: el servicio siempre es CABECERA. Se aplica al instante.">
        <MudSelectItem T="string" Value="@ReportService.DimServicio">Servicio</MudSelectItem>
        <MudSelectItem T="string" Value="@ReportService.DimCliente">Cliente</MudSelectItem>
    </MudSelect>

    @* Este desplegable ACOMPAÑA al desglose (30/07/2026): con "Desglosar por = Servicio" lista
       servicios; con "= Cliente", los clientes del período. Antes seguía ofreciendo servicios
       aunque el informe ya estuviera abierto por cliente — filtrar por una cosa y leer otra.
       En los dos casos solo lo que TUVO viajes en el período (el catálogo entero traía 22
       códigos muertos: ATOMICA, CONUAR*, AR.EZEIZA*…). *@
    <MudSelect T="string" Label="Servicios/Clientes" MultiSelection="true"
               SelectedValues="_catSel" SelectedValuesChanged="v => _catSel = v.ToHashSet()"
               SelectAll="true" SelectAllText="Todos" Dense="true"
               Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:225px;"
               title="Qué servicios (o qué clientes, si el informe está desglosado por cliente) entran en el informe. Solo aparecen los que tuvieron viajes en el período. Se aplica con el botón Aplicar filtros."
               MultiSelectionTextFunc="@(s => s.Count == _catVisibles.Count ? "Todos" : $"{s.Count} de {_catVisibles.Count}")">
        @foreach (var c in _catVisibles)
        {
            <MudSelectItem T="string" Value="@c.Cod">@c.Nombre</MudSelectItem>
        }
    </MudSelect>

    <MudSelect T="string" Label="Estados" MultiSelection="true"
               SelectedValues="_estadosSel" SelectedValuesChanged="v => _estadosSel = v.ToHashSet()"
               SelectAll="true" SelectAllText="Todos" Dense="true"
               Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:190px;"
               MultiSelectionTextFunc="@(s => s.Count == ReportService.EstadosViaje.Count ? "Todos" : $"{s.Count} de {ReportService.EstadosViaje.Count}")">
        @foreach (var e in ReportService.EstadosViaje)
        {
            <MudSelectItem T="string" Value="@e">@e</MudSelectItem>
        }
    </MudSelect>

    <div class="rfs-metrica">
        <MudRadioGroup T="string" Value="_metrica" ValueChanged="CambiarMetrica">
            <MudRadio T="string" Value="@("Reservas")" Color="MudColor.Primary" Size="MudSize.Small" Dense="true">Reservas</MudRadio>
            <MudRadio T="string" Value="@("Pax")" Color="MudColor.Primary" Size="MudSize.Small" Dense="true">Pax</MudRadio>
        </MudRadioGroup>
    </div>

    <span style="flex:1 1 auto;"></span>

    @* El botón avisa cuándo hay filtros tocados y NO aplicados: la clienta tildaba "Internos"
       y creía que el informe estaba roto porque nada cambiaba hasta apretar acá (30/07/2026). *@
    <MudButton Variant="Variant.Filled" Color="@(_pendientes > 0 ? MudColor.Warning : MudColor.Primary)"
               OnClick="Cargar" Disabled="_cargando"
               StartIcon="@(_pendientes > 0 ? Icons.Material.Filled.PriorityHigh : Icons.Material.Filled.Search)"
               Class="@(_pendientes > 0 ? "rfs-btn-pendiente" : "")"
               Style="border-radius:8px; height:40px; text-transform:none; flex-shrink:0;">
        @(_cargando ? "Cargando..." : _pendientes > 0 ? $"Aplicar filtros ({_pendientes})" : "Aplicar filtros")
    </MudButton>
</MudPaper>

@if (_pendientes > 0 && !_cargando)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Style="border-radius:12px;"
              Icon="@Icons.Material.Filled.Update">
        Lo que se ve abajo <b>todavía no incluye</b> @(_pendientes == 1 ? "el filtro que cambiaste" : $"los {_pendientes} filtros que cambiaste") —
        apretá <b>Aplicar filtros</b> para actualizar.
    </MudAlert>
}

@if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Color="MudColor.Primary" Class="mb-4" Style="border-radius:4px;" />
}
else if (_detalle.Count == 0)
{
    <MudAlert Severity="Severity.Warning" Style="border-radius:12px;">No hay reservas para los filtros seleccionados.</MudAlert>
}
else
{
    @* Todo el tablero se atenúa mientras haya filtros sin aplicar: refuerza el aviso de arriba
       (los números que se ven son los del último Aplicar, no los de los filtros en pantalla). *@
    <div class="@(_pendientes > 0 ? "rfs-desactualizado" : "")">

    @* ── KPIs ── (flex: las tarjetas se reparten parejo, sean 4 o 5) *@
    <div class="rfs-kpis mb-3">
        <KpiCard Label="Total reservas" Value="@Fmt(_totalRes)" Sub="@PeriodoCortoTxt" Color="@NorturColors.Azul" />
        <KpiCard Label="Total pax" Value="@Fmt(_totalPax)" Sub="pasajeros" Color="@NorturColors.Verde" />
        <KpiCard Label="Canceladas" Value="@(CanceladasEnFiltro ? Fmt(_totalCan) : "—")"
                 Sub="@(CanceladasEnFiltro ? $"{_pctCan:0.0}% del total" : "fuera del filtro")"
                 Color="@NorturColors.Rojo" />
        <KpiCard Label="@($"{DimPluralTit} distintos")" Value="@_nServicios.ToString()" Sub="en el período" Color="@NorturColors.Naranja" />
        @if (_mostrarKpiCabecera)
        {
            @* Volumen de las cabeceras que quedaron afuera — transparencia sin ensuciar el desglose. *@
            <KpiCard Label="Viajes cabecera" Value="@Fmt(_cabRes)"
                     Sub="@($"excluidos · {Fmt(_cabPax)} pax")" Color="#64748B" />
        }
    </div>

    <div @key="_chartsKey">
        @* ── Evolución diaria ── *@
        <MudPaper Class="pa-4 mb-3" Elevation="1" Style="border-radius:14px;">
            <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight:700; color:#112F5B;">
                Evolución diaria — @_metrica
            </MudText>
            <ApexChart TItem="SerieDia" Options="_optsArea" Height="180" @ref="_areaChart">
                <ApexPointSeries TItem="SerieDia"
                                 Items="_serieDias"
                                 Name="@_metrica"
                                 SeriesType="SeriesType.Area"
                                 XValue="@(x => x.Dia)"
                                 YValue="@(x => x.Valor)" />
            </ApexChart>
        </MudPaper>

        @* ── Ranking + distribución ── *@
        <MudGrid Spacing="3" Class="mb-3" Style="align-items:stretch;">
            <MudItem xs="12" md="7" Style="display:flex; flex-direction:column;">
                <MudPaper Class="pa-4" Elevation="1" Style="border-radius:14px; flex:1;">
                    @* Cabecera del panel de barras: título + selector "Mostrar" (compacto) juntos a la
                       izquierda, y el chip de foco (cross-filter) a la derecha. *@
                    <div class="rfs-bar-head mb-2">
                        <div class="rfs-bar-title">
                            <MudText Typo="Typo.subtitle2" Style="font-weight:700; color:#112F5B;">@($"{_metrica} por {DimSingular} — {TituloTopN}")</MudText>
                            @* Selector compacto: cuántos servicios mostrar en las barras (Top 10/15/20/Todos). *@
                            <MudSelect T="int" Value="_topN" ValueChanged="CambiarTopN"
                                       Label="Mostrar" Dense="true" Margin="Margin.Dense"
                                       Variant="Variant.Outlined" Class="rfs-topn-select">
                                <MudSelectItem T="int" Value="10">Top 10</MudSelectItem>
                                <MudSelectItem T="int" Value="15">Top 15</MudSelectItem>
                                <MudSelectItem T="int" Value="20">Top 20</MudSelectItem>
                                <MudSelectItem T="int" Value="999">Todos (@_pivTotCol.Count)</MudSelectItem>
                            </MudSelect>
                        </div>
                        @if (_servicioFocus is not null)
                        {
                            <div class="rfs-focus">
                                <span class="rfs-focus__lbl">Filtrado:</span>
                                <span class="rfs-focus__val" style="@($"background:{ColorDe(_servicioFocus)};")">@_servicioFocus</span>
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="MudSize.Small"
                                               OnClick="LimpiarFoco" title="Quitar filtro"
                                               Style="color:#64748B; padding:2px;" />
                            </div>
                        }
                        else
                        {
                            <span class="rfs-focus-hint">💡 Clic en un @DimSingular para enfocar el tablero</span>
                        }
                    </div>
                    <ApexChart TItem="BarItem" Options="_optsBar" Height="@_altoBarras" @ref="_barChart"
                               OnDataPointSelection="OnBarSelection">
                        <ApexPointSeries TItem="BarItem"
                                         Items="_barItems"
                                         Name="@_metrica"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(x => x.Servicio)"
                                         YValue="@(x => x.Valor)"
                                         ShowDataLabels="true" />
                    </ApexChart>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="5" Style="display:flex; flex-direction:column;">
                <MudPaper Class="pa-4" Elevation="1" Style="border-radius:14px; flex:1;">
                    @* Misma cabecera título + chip de foco que el panel de barras (control duplicado). *@
                    @CabeceraFoco("Distribución — top 10 + otros")
                    @* Torta LIMPIA + la cantidad y el % al lado de cada servicio en la LEYENDA de abajo
                       (Legend.Formatter, ej: "LA PLATA 1/2 DIA: 171 (19%)"). @key propio: se remonta en
                       cada foco para redibujar bien la torta + su leyenda (el update en el lugar dejaba la
                       leyenda con valores/posiciones del render previo — regla del cross-filter). *@
                    <ApexChart @key="_pieChartKey" TItem="PieItem" Options="_optsPie" Height="360" @ref="_pieChart"
                               OnDataPointSelection="OnPieSelection">
                        <ApexPointSeries TItem="PieItem"
                                         Items="_pieItems"
                                         Name="@_metrica"
                                         SeriesType="SeriesType.Pie"
                                         XValue="@(x => x.Servicio)"
                                         YValue="@(x => x.Valor)" />
                    </ApexChart>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </div>

    @* ── Tabla pivote fecha × servicio ── *@
    <MudPaper Class="pa-4" Elevation="1" Style="border-radius:14px;">
        <div class="d-flex justify-space-between align-center flex-wrap mb-3" style="gap:16px;">
            <div class="d-flex align-center flex-wrap" style="gap:16px;">
                <div>
                    <MudText Typo="Typo.subtitle2" Style="font-weight:700; color:#112F5B;">
                        Detalle: @_metrica.ToLower() por fecha y @DimSingular
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color:#8FA3BC;">
                        Click en una celda para ver las reservas una por una
                    </MudText>
                </div>
                @* Orden de las columnas de servicio — al lado del título; cambia al instante, sin re-query. *@
                <MudSelect T="string" Value="_ordenColumnas" ValueChanged="CambiarOrdenColumnas"
                           Label="Ordenar columnas" Dense="true" Margin="Margin.Dense"
                           Variant="Variant.Outlined" Style="width:240px;">
                    <MudSelectItem T="string" Value="@("PorTotal")">Por total (mayor primero)</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Alfabetico")">Alfabético (A–Z)</MudSelectItem>
                </MudSelect>
            </div>
            <MudButton Variant="Variant.Filled" Color="MudColor.Success"
                       StartIcon="@Icons.Material.Filled.Download"
                       OnClick="DescargarExcel" Disabled="_cargandoDet"
                       Style="border-radius:8px; text-transform:none;">
                Descargar Excel
            </MudButton>
        </div>
        @if (_cargandoDet)
        {
            <MudProgressLinear Indeterminate="true" Color="MudColor.Primary" Class="mb-2" Style="border-radius:4px;" />
        }
        <div class="rfs-tabla-wrap">
            <table class="rfs-tabla">
                <thead>
                    <tr>
                        <th class="rfs-col-fecha">Fecha</th>
                        @foreach (var s in _pivServicios)
                        {
                            <th class="rfs-th-serv rfs-click @(EnFoco(s) ? "rfs-th-foco" : "")"
                                title="Clic para enfocar el tablero en @s"
                                @onclick="() => ToggleFoco(s)">@s</th>
                        }
                        <th class="rfs-th-total">TOTAL</th>
                    </tr>
                </thead>
                <tbody>
                    @* Virtualize: un rango largo de fechas puede superar las ~150 filas
                       (regla de performance del proyecto). SpacerElement="tr" porque los
                       spacers viven dentro de un <tbody>. *@
                    <Virtualize Items="_pivFechas" Context="f" ItemSize="30" OverscanCount="12" SpacerElement="tr">
                        <tr>
                            <td class="rfs-col-fecha @(EsFinde(f) ? "rfs-finde" : "")">@FmtFecha(f)</td>
                            @foreach (var s in _pivServicios)
                            {
                                var v = PivVal(f, s);
                                var atenua = _servicioFocus is not null && !EnFoco(s) ? "rfs-atenua" : "";
                                if (v > 0)
                                {
                                    <td class="rfs-num rfs-click @atenua" title="Ver reservas de @s el @f.ToString("dd/MM")"
                                        @onclick="() => AbrirDetalleCelda(f, s)">@Fmt(v)</td>
                                }
                                else
                                {
                                    <td class="rfs-num rfs-cero @atenua">·</td>
                                }
                            }
                            <td class="rfs-num rfs-tot rfs-click" title="Ver todas las reservas del día"
                                @onclick="() => AbrirDetalleDia(f)">@Fmt(PivTotFila(f))</td>
                        </tr>
                    </Virtualize>
                </tbody>
                <tfoot>
                    <tr>
                        <td class="rfs-col-fecha rfs-tot">TOTAL</td>
                        @foreach (var s in _pivServicios)
                        {
                            <td class="rfs-num rfs-tot rfs-click @(EnFoco(s) ? "rfs-col-foco" : "")"
                                title="Clic para enfocar el tablero en @s"
                                @onclick="() => ToggleFoco(s)">@Fmt(PivTotCol(s))</td>
                        }
                        <td class="rfs-num rfs-tot rfs-grantot">@Fmt(_granTotal)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </MudPaper>

    </div>   @* /rfs-desactualizado *@
}

@code {
    private readonly DateTime _min = ReportService.FechaMinValida.ToDateTime(TimeOnly.MinValue);
    private readonly DateTime _max = ReportService.FechaMaxValida.ToDateTime(TimeOnly.MinValue);

    // ── Filtros en edición ──
    private DateTime? _desde = DateTime.Today.AddMonths(-2);
    private DateTime? _hasta = DateTime.Today;
    // Selección del desplegable de categorías: son códigos de SERVICIO o de CLIENTE según
    // el desglose vigente (por eso se resetea a "todos" cuando el desglose cambia).
    private IReadOnlyCollection<string> _catSel = new HashSet<string>();
    private IReadOnlyCollection<string> _estadosSel = new HashSet<string>(ReportService.EstadosViaje);
    // Línea de negocio. Default = Turismo + Transporte de Personal, SIN internos: reproduce
    // exactamente lo que mostraba el informe antes del cambio del 30/07/2026 (el viejo switch
    // "Internos" apagado), así la clienta no ve saltar los números de un día para el otro.
    private IReadOnlyCollection<string> _tiposSel =
        new HashSet<string> { ReportService.TipoTurismo, ReportService.TipoPersonal };
    private string _dimension = ReportService.DimServicio;
    private string _metrica = "Reservas";
    private bool _todasCategorias => _catVisibles.Count > 0 && _catSel.Count == _catVisibles.Count;

    // ── Textos que dependen del desglose elegido ──
    private bool EsPorCliente => _dimAp == ReportService.DimCliente;
    private string DimSingular => EsPorCliente ? "cliente" : "servicio";
    private string DimPluralTit => EsPorCliente ? "Clientes" : "Servicios";

    private static string EtiquetaTipo(string tipo) => tipo switch
    {
        ReportService.TipoPersonal => "Transporte de Personal",
        ReportService.TipoInternos => "Internos (NORTUR)",
        _ => "Turismo"
    };

    // Versión corta para el resumen del desplegable (donde entran 2-3 juntas).
    private static string EtiquetaTipoCorta(string tipo) => tipo switch
    {
        ReportService.TipoPersonal => "Personal",
        ReportService.TipoInternos => "Internos",
        _ => "Turismo"
    };

    // ── Foco / cross-filter (estilo Power BI) ──
    // Servicio "enfocado": KPIs, evolución diaria y tabla se recalculan a ese servicio; los
    // gráficos de servicio (barras/donut) siguen mostrando TODOS pero atenúan los demás (así el
    // usuario puede cambiar de foco). Todo en memoria, sin re-query. null = sin foco (todos).
    private string? _servicioFocus;
    private bool EnFoco(string servicio) => _servicioFocus is null || _servicioFocus == servicio;

    // ── Filtros APLICADOS (snapshot al tocar "Aplicar"): el drill-down y el Excel
    //    tienen que corresponder a lo que se está viendo, no a lo editado a medias ──
    private DateOnly _fDesdeAp, _fHastaAp;
    private List<string> _catAp = new();
    private List<string> _estAp = new();
    private List<string> _tiposAp = new();
    private string _dimAp = ReportService.DimServicio;
    private bool _exclCabAp = true;

    // ── Filtros tocados y todavía NO aplicados ──
    // El "Tipo de servicio", el desglose y la métrica se aplican solos (un clic, query cacheada),
    // así que nunca cuentan acá. Las fechas y los multiselect de Servicios/Estados sí esperan el
    // botón: sin este aviso, tildar algo y no ver ningún cambio parece un informe roto.
    private int _pendientes
    {
        get
        {
            if (_detalle.Count == 0 && !_cargando) return 0;   // todavía no hay nada aplicado
            var n = 0;
            if (_desde is not null && DateOnly.FromDateTime(_desde.Value) != _fDesdeAp) n++;
            if (_hasta is not null && DateOnly.FromDateTime(_hasta.Value) != _fHastaAp) n++;
            var catAhora = _todasCategorias ? new List<string>() : _catSel.ToList();
            if (!catAhora.OrderBy(x => x).SequenceEqual(_catAp.OrderBy(x => x))) n++;
            var estAhora = _estadosSel.Count == ReportService.EstadosViaje.Count ? new List<string>() : _estadosSel.ToList();
            if (!estAhora.OrderBy(x => x).SequenceEqual(_estAp.OrderBy(x => x))) n++;
            return n;
        }
    }

    // Categorías (servicios O clientes, según el desglose) con movimiento en el período aplicado:
    // el desplegable ya no ofrece el catálogo entero — ATOMICA y los 21 códigos muertos no tienen
    // un solo viaje desde 2021.
    private List<CategoriaMovimientoDto> _categorias = new();

    // …y de esas, las de la línea de negocio filtrada. Solo recorta SERVICIOS (modo_uso 'A'
    // = Ambos cae en las dos líneas); la lista de clientes ya viene filtrada por la query.
    private List<CategoriaMovimientoDto> _catVisibles = new();

    // Desglose con el que se armó _categorias: si cambió, la selección anterior ya no aplica
    // (son códigos de otra cosa) y se vuelve a "todos".
    private string _dimCategorias = ReportService.DimServicio;

    private List<CategoriaMovimientoDto> FiltrarPorTipo(List<CategoriaMovimientoDto> servicios)
    {
        var letras = new HashSet<string>();
        if (_tiposSel.Contains(ReportService.TipoTurismo)) { letras.Add("T"); letras.Add("A"); }
        if (_tiposSel.Contains(ReportService.TipoPersonal)) { letras.Add("P"); letras.Add("A"); }
        // Solo "Internos": no es una línea de servicios, se muestran todos los del período.
        if (letras.Count == 0) return servicios;
        return servicios.Where(s => letras.Contains(s.ModoUso)).ToList();
    }
    private List<ReservaFechaServicioRow> _detalle = new();
    private List<ReservaFsDetalleRow>? _detalleReservas;   // lazy: se trae al primer drill-down/Excel
    private bool _cargando;
    private bool _cargandoDet;
    private Guid _chartsKey = Guid.NewGuid();
    // Key propio de la torta "Distribución": cambia con cada foco para forzar su remonte. El update
