@page "/reservas-banda-horaria"
@using ApexCharts
@using MudColor = MudBlazor.Color
@using MudSize = MudBlazor.Size
@inject ReportService Reports
@inject ExcelExportService Excel
@inject NorturAuthStateProvider AuthState
@inject IPermissionService Permisos
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDialogService DialogService
@rendermode InteractiveServer

<PageTitle>Reservas por banda horaria</PageTitle>

@* ── Encabezado de página ── *@
<div class="page-header mb-3">
    <MudText Typo="Typo.h5" Style="font-weight:800; color:#112F5B;">
        Reservas por banda horaria
    </MudText>
    <MudText Typo="Typo.body2" Style="color:#7A90AD; margin-top:2px;">
        Metrocar Nortur · viajes de transportación por franja horaria de inicio
    </MudText>
</div>

@* ── Barra de filtros (horizontal, compacta) — mismo patrón que Reservas por fecha y servicio ── *@
<MudPaper Elevation="1" Class="rfs-filtros mb-4">
    <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="MudSize.Small" Style="color:#003AA0; flex-shrink:0;" />

    @* Desde/Hasta juntos como par (gap chico), separados del resto de los filtros *@
    <div class="rfs-fechas">
        <MudDatePicker Label="Desde" @bind-Date="_desde"
                       MinDate="_min" MaxDate="_max" DateFormat="dd/MM/yyyy"
                       PickerVariant="PickerVariant.Dialog" Editable="true"
                       Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:160px;" />
        <MudDatePicker Label="Hasta" @bind-Date="_hasta"
                       MinDate="_min" MaxDate="_max" DateFormat="dd/MM/yyyy"
                       PickerVariant="PickerVariant.Dialog" Editable="true"
                       Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:160px;" />
    </div>

    <MudSelect T="string" Label="Tipo de vehículo" MultiSelection="true" @bind-SelectedValues="_vehiculosSel"
               SelectAll="true" SelectAllText="Todos" Dense="true"
               Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:200px;"
               MultiSelectionTextFunc="@(s => s.Count == _vehiculos.Count ? "Todos" : $"{s.Count} de {_vehiculos.Count}")">
        @foreach (var v in _vehiculos)
        {
            <MudSelectItem T="string" Value="@v.Id">@v.Nombre</MudSelectItem>
        }
    </MudSelect>

    <MudSelect T="string" Label="Estados" MultiSelection="true" @bind-SelectedValues="_estadosSel"
               SelectAll="true" SelectAllText="Todos" Dense="true"
               Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:190px;"
               MultiSelectionTextFunc="@(s => s.Count == ReportService.EstadosViaje.Count ? "Todos" : $"{s.Count} de {ReportService.EstadosViaje.Count}")">
        @foreach (var e in ReportService.EstadosViaje)
        {
            <MudSelectItem T="string" Value="@e">@e</MudSelectItem>
        }
    </MudSelect>

    <div class="rfs-metrica">
        <MudRadioGroup T="string" Value="_metrica" ValueChanged="CambiarMetrica">
            <MudRadio T="string" Value="@("Reservas")" Color="MudColor.Primary" Size="MudSize.Small" Dense="true">Viajes</MudRadio>
            <MudRadio T="string" Value="@("Pax")" Color="MudColor.Primary" Size="MudSize.Small" Dense="true">Pax</MudRadio>
        </MudRadioGroup>
    </div>

    <span style="flex:1 1 auto;"></span>

    <MudButton Variant="Variant.Filled" Color="MudColor.Primary"
               OnClick="Cargar" Disabled="_cargando" StartIcon="@Icons.Material.Filled.Search"
               Style="border-radius:8px; height:40px; text-transform:none; flex-shrink:0;">
        @(_cargando ? "Cargando..." : "Aplicar filtros")
    </MudButton>
</MudPaper>

@if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Color="MudColor.Primary" Class="mb-4" Style="border-radius:4px;" />
}
else if (_filas.Count == 0)
{
    <MudAlert Severity="Severity.Warning" Style="border-radius:12px;">No hay viajes para los filtros seleccionados.</MudAlert>
}
else
{
    @* ── KPIs ── (flex: se reparten parejo). Con foco activo se recalculan al subconjunto
       enfocado (cross-filter): el total, los días y los líderes son del recorte. *@
    <div class="rfs-kpis mb-3">
        <KpiCard Label="@(_metrica == "Pax" ? "Total pax" : "Total viajes")" Value="@Fmt(_totalMetrica)"
                 Sub="@($"prom. {Fmt(_promedioDiario)} {UnidadMetrica}/día")" Color="@NorturColors.Azul" />
        <KpiCard Label="Días con actividad" Value="@_diasConActividad.ToString()" Sub="en el período" Color="@NorturColors.Verde" />
        <KpiCard Label="Banda más cargada" Value="@_bandaMasCargada"
                 Sub="@($"{Fmt(_maxBanda)} {UnidadMetrica}")" Color="@NorturColors.Naranja" />
        <KpiCard Label="Vehículo líder" Value="@_vehiculoLider"
                 Sub="@($"{Fmt(_maxVehiculo)} {UnidadMetrica}")" Color="@NorturColors.Rojo" />
    </div>

    <div @key="_chartsKey">
        @* ── Gráfico barras apiladas por fecha × banda ── *@
        <MudPaper Class="pa-4 mb-3" Elevation="1" Style="border-radius:14px;">
            @CabeceraFoco($"{(_metrica == "Pax" ? "Pax" : "Viajes")} por día y banda horaria")
            <ApexChart TItem="ChartItem" Options="_optsBar" Height="240" @ref="_barChart"
                       OnDataPointSelection="OnBarSelection" OnLegendClicked="OnBarLegendClicked">
                @foreach (var banda in _bandasPresentes)
                {
                    var b = banda;
                    <ApexPointSeries TItem="ChartItem"
                                     Items="_chartData.Where(x => x.Banda == b).ToList()"
                                     Name="@b"
                                     SeriesType="SeriesType.Bar"
                                     XValue="@(x => x.Fecha)"
                                     YValue="@(x => x.Valor)" />
                }
            </ApexChart>
        </MudPaper>

        @* ── Donuts: por banda + por vehículo ── *@
        <MudGrid Spacing="3" Class="mb-3" Style="align-items:stretch;">
            <MudItem xs="12" md="6" Style="display:flex; flex-direction:column;">
                <MudPaper Class="pa-4" Elevation="1" Style="border-radius:14px; flex:1;">
                    @CabeceraFoco("Distribución por banda horaria")
                    @* @key propio que cambia con cada foco: fuerza el REMONTE de este chart de barras
                       al enfocar. Es necesario porque el update en el lugar (UpdateOptions+UpdateSeries)
                       reposiciona MAL los datalabels de barra (quedan con y del render anterior, fuera
                       de la caja). El remonte los redibuja bien. Solo remonta este panel, no los otros. *@
                    <ApexChart @key="_bandaChartKey" TItem="DonutItem" Options="_optsPieBanda" Height="320" @ref="_pieBandaChart"
                               OnDataPointSelection="OnPieBandaSelection" OnLegendClicked="OnPieBandaLegendClicked">
                        <ApexPointSeries TItem="DonutItem"
                                         Items="_donutBanda"
                                         Name="@UnidadMetrica"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(x => x.Label)"
                                         YValue="@(x => x.Valor)"
                                         ShowDataLabels="true" />
                    </ApexChart>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6" Style="display:flex; flex-direction:column;">
                <MudPaper Class="pa-4" Elevation="1" Style="border-radius:14px; flex:1;">
                    @CabeceraFoco("Distribución por tipo de vehículo")
                    @* @key propio: se remonta en cada foco para redibujar bien la torta + su leyenda
                       (el update en el lugar dejaba la leyenda con valores/posiciones del render previo). *@
                    <ApexChart @key="_vehChartKey" TItem="DonutItem" Options="_optsPieVeh" Height="320" @ref="_pieVehChart"
                               OnDataPointSelection="OnPieVehSelection" OnLegendClicked="OnPieVehLegendClicked">
                        <ApexPointSeries TItem="DonutItem"
                                         Items="_donutVehiculo"
                                         Name="@UnidadMetrica"
                                         SeriesType="SeriesType.Pie"
                                         XValue="@(x => x.Label)"
                                         YValue="@(x => x.Valor)" />
                    </ApexChart>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </div>

    @* ── Tabla pivote fecha × banda ── *@
    <MudPaper Class="pa-4" Elevation="1" Style="border-radius:14px;">
        <div class="d-flex justify-space-between align-center flex-wrap mb-3" style="gap:8px;">
            <div>
                <MudText Typo="Typo.subtitle2" Style="font-weight:700; color:#112F5B;">
                    Detalle: @(_metrica == "Pax" ? "pax" : "viajes") por fecha y banda horaria
                </MudText>
                <MudText Typo="Typo.caption" Style="color:#8FA3BC;">
                    Click en una celda para ver los viajes uno por uno · click en el encabezado de una banda para enfocar el tablero
                </MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="MudColor.Success"
                       StartIcon="@Icons.Material.Filled.Download"
                       OnClick="DescargarExcel" Disabled="_cargandoDet"
                       Style="border-radius:8px; text-transform:none;">
                Descargar Excel
            </MudButton>
        </div>
        @if (_cargandoDet)
        {
            <MudProgressLinear Indeterminate="true" Color="MudColor.Primary" Class="mb-2" Style="border-radius:4px;" />
        }
        <div class="rfs-tabla-wrap">
            <table class="rfs-tabla">
                <thead>
                    <tr>
                        <th class="rfs-col-fecha">Fecha</th>
                        @foreach (var b in _bandas)
                        {
                            var banda = b;
                            <th class="rfs-th-serv rfs-click @(EnFocoBanda(banda) ? "rfs-th-foco" : "")"
                                title="Clic para enfocar el tablero en la banda @banda"
                                @onclick="() => ToggleFocoBanda(banda)">
                                <span class="rbh-legend-dot" style="background:@ColorBanda(banda);"></span>@banda
                            </th>
                        }
                        <th class="rfs-th-total">TOTAL</th>
                    </tr>
                </thead>
                <tbody>
                    @* Virtualize: un rango largo de fechas puede superar las ~150 filas
                       (regla de performance del proyecto). SpacerElement="tr" porque los
                       spacers viven dentro de un <tbody>. *@
                    <Virtualize Items="_pivFechas" Context="f" ItemSize="30" OverscanCount="12" SpacerElement="tr">
                        <tr>
                            <td class="rfs-col-fecha @(EsFinde(f) ? "rfs-finde" : "")">@FmtFecha(f)</td>
                            @foreach (var b in _bandas)
                            {
                                var banda = b;
                                var v = PivVal(f, banda);
                                var atenua = _bandaFocus is not null && !EnFocoBanda(banda) ? "rfs-atenua" : "";
                                if (v > 0)
                                {
                                    <td class="rfs-num rfs-click @atenua" title="Ver viajes de la banda @banda el @f.ToString("dd/MM")"
                                        @onclick="() => AbrirDetalleCelda(f, banda)">@Fmt(v)</td>
                                }
                                else
                                {
                                    <td class="rfs-num rfs-cero @atenua">·</td>
                                }
                            }
                            <td class="rfs-num rfs-tot rfs-click" title="Ver todos los viajes del día"
                                @onclick="() => AbrirDetalleDia(f)">@Fmt(PivTotFila(f))</td>
                        </tr>
                    </Virtualize>
                </tbody>
                <tfoot>
                    <tr>
                        <td class="rfs-col-fecha rfs-tot">TOTAL</td>
                        @foreach (var b in _bandas)
                        {
                            var banda = b;
                            <td class="rfs-num rfs-tot rfs-click @(EnFocoBanda(banda) ? "rfs-col-foco" : "")"
                                title="Clic para enfocar el tablero en la banda @banda"
                                @onclick="() => ToggleFocoBanda(banda)">@Fmt(PivTotCol(banda))</td>
                        }
                        <td class="rfs-num rfs-tot rfs-grantot">@Fmt(_granTotal)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </MudPaper>
}

@code {
    private readonly DateTime _min = ReportService.FechaMinValida.ToDateTime(TimeOnly.MinValue);
    private readonly DateTime _max = ReportService.FechaMaxValida.ToDateTime(TimeOnly.MinValue);

    // ── Filtros en edición ──
    private DateTime? _desde = DateTime.Today.AddMonths(-1);
    private DateTime? _hasta = DateTime.Today;
    private IReadOnlyCollection<string> _vehiculosSel = new HashSet<string>();
    // Default: todos los estados MENOS cancelado (fiel al FoxPro, que hardcodea <> CANCELADO).
    private IReadOnlyCollection<string> _estadosSel =
        new HashSet<string>(ReportService.EstadosViaje.Where(e => e != "CANCELADO"));
    private string _metrica = "Reservas";   // "Reservas" (viajes) | "Pax"
    private bool _todosVehiculos => _vehiculos.Count > 0 && _vehiculosSel.Count == _vehiculos.Count;

    // ── Foco / cross-filter (estilo Power BI) — DOS dimensiones combinables ──
    // Cada dimensión enfocada RESALTA en sus propios visuales (las demás categorías se atenúan,
    // para poder cambiar de foco) y FILTRA los visuales de la otra dimensión, los KPIs y la
    // tabla. Los dos focos se combinan (banda AND vehículo), como en Power BI. Todo en memoria,
    // sin re-query. null = sin foco.
    private string? _bandaFocus;
    private string? _vehiculoFocus;
    private bool EnFocoBanda(string banda) => _bandaFocus is null || _bandaFocus == banda;

    // ── Filtros APLICADOS (snapshot al tocar "Aplicar"): el drill-down y el Excel
    //    tienen que corresponder a lo que se está viendo, no a lo editado a medias ──
    private DateOnly _fDesdeAp, _fHastaAp;
    private List<string> _vehAp = new();
    private List<string> _estAp = new();

    private List<VehiculoTipoDto> _vehiculos = new();
    private List<BandaHorariaRow> _filas = new();
    private List<BandaHorariaDetalleRow>? _detalle;   // lazy: se trae al primer drill-down/Excel
    private bool _cargando;
    private bool _cargandoDet;
    private bool _yaConsultado;
    private Guid _chartsKey = Guid.NewGuid();
    // Key propio del chart de barras "Distribución por banda": cambia con cada foco para forzar su
    // remonte (el update en el lugar reposiciona mal sus datalabels — ver nota en el markup).
    private Guid _bandaChartKey = Guid.NewGuid();
    // Ídem para el pie "Distribución por tipo de vehículo" (mismo bug de posición de datalabels).
    private Guid _vehChartKey = Guid.NewGuid();

    // Las 6 bandas en orden fijo (desde el service).
    private static readonly IReadOnlyList<string> _bandas = ReportService.BandasHorarias;

    // KPIs
    private int _totalMetrica;
    private int _diasConActividad;
    private int _promedioDiario;
    private string _bandaMasCargada = "—";
    private int _maxBanda;
    private string _vehiculoLider = "—";
    private int _maxVehiculo;
    private string PeriodoTxt => $"{_fDesdeAp:dd/MM/yyyy} – {_fHastaAp:dd/MM/yyyy}";
    private string UnidadMetrica => _metrica == "Pax" ? "pax" : "viajes";

    // ── Gráficos ApexCharts ──
    private record ChartItem(string Fecha, string Banda, decimal Valor);
    private record DonutItem(string Label, decimal Valor);
    private List<ChartItem> _chartData = new();
    private List<string> _bandasPresentes = new();
    private List<DonutItem> _donutBanda = new();
    private List<DonutItem> _donutVehiculo = new();

    // Referencias a los charts para actualizarlos EN SU LUGAR al cambiar el foco (sin remontar
    // → sin parpadeo). El @key/_chartsKey se reserva para cuando cambian los datos (Aplicar/métrica).
    private ApexChart<ChartItem>? _barChart;
    private ApexChart<DonutItem>? _pieBandaChart;
    private ApexChart<DonutItem>? _pieVehChart;

    // Paleta por banda (una por franja, orden fijo). Frío → cálido siguiendo la hora del día.
    private static readonly List<string> _paletteBanda = new()
    {
        "#0EA5E9", "#7C3AED", "#16A34A", "#2058D0", "#F99410", "#DC2626"
    };
    // Paleta categórica para vehículos (validada dataviz; gris neutro al final para "Otros").
    private static readonly List<string> _paletteVeh = new()
    {
        "#2058D0", "#F99410", "#16A34A", "#DC2626",
        "#0EA5E9", "#7C3AED", "#B45309", "#94A3B8"
    };

    private static string ColorBanda(string banda)
    {
        var i = _bandas.ToList().IndexOf(banda);
        return i >= 0 && i < _paletteBanda.Count ? _paletteBanda[i] : "#94A3B8";
    }

    // Mapa vehículo → color por ranking del dataset COMPLETO (color y orden estables: no
    // cambian al enfocar). Color por entidad, no por posición (regla dataviz).
    private Dictionary<string, string> _colorPorVehiculo = new();
    private string ColorVeh(string veh) => _colorPorVehiculo.TryGetValue(veh, out var c) ? c : "#94A3B8";

    // Color ATENUADO (gris claro) si hay foco en esa dimensión y no es la categoría enfocada —
    // efecto highlight de Power BI. Sin foco → color pleno.
    private string ColorFocoBanda(string banda) =>
        (_bandaFocus is null || banda == _bandaFocus) ? ColorBanda(banda) : "#D9E1EC";
    private string ColorFocoVeh(string veh) =>
        (_vehiculoFocus is null || veh == _vehiculoFocus) ? ColorVeh(veh) : "#D9E1EC";

    // Cabecera de un panel de gráfico: título a la izquierda + chips de foco (o hint) a la
    // derecha. Duplicada en los tres paneles (control repetido, como en Reservas por fecha y
    // servicio): la ✕ de cualquier chip limpia ESE foco en todo el tablero.
    private RenderFragment CabeceraFoco(string titulo) => __builder =>
    {
        <div class="rfs-bar-head mb-3">
            <MudText Typo="Typo.subtitle2" Style="font-weight:700; color:#112F5B;">@titulo</MudText>
            @if (_bandaFocus is not null || _vehiculoFocus is not null)
            {
                <div style="display:inline-flex; align-items:center; gap:6px; flex-wrap:wrap;">
                    @if (_bandaFocus is not null)
                    {
                        <div class="rfs-focus">
                            <span class="rfs-focus__lbl">Banda:</span>
                            <span class="rfs-focus__val" style="@($"background:{ColorBanda(_bandaFocus)};")">@_bandaFocus</span>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="MudSize.Small"
                                           OnClick="LimpiarFocoBanda" Title="Quitar filtro de banda"
                                           Style="color:#64748B; padding:2px;" />
                        </div>
                    }
                    @if (_vehiculoFocus is not null)
                    {
                        <div class="rfs-focus">
                            <span class="rfs-focus__lbl">Vehículo:</span>
                            <span class="rfs-focus__val" style="@($"background:{ColorVeh(_vehiculoFocus)};")">@_vehiculoFocus</span>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="MudSize.Small"
                                           OnClick="LimpiarFocoVehiculo" Title="Quitar filtro de vehículo"
                                           Style="color:#64748B; padding:2px;" />
                        </div>
                    }
                </div>
            }
            else
            {
                <span class="rfs-focus-hint">💡 Clic en una banda o un tipo de vehículo para enfocar el tablero</span>
            }
        </div>
    };

    private readonly ApexChartOptions<ChartItem> _optsBar = new()
    {
        Chart = new() { Toolbar = new() { Show = false }, Background = "transparent", Stacked = true, Animations = new() { Enabled = false } },
        PlotOptions = new() { Bar = new() { BorderRadius = 2, BorderRadiusApplication = BorderRadiusApplication.End } },
        Colors = _paletteBanda,
        Xaxis = new() { Labels = new() { Style = new() { FontSize = "10px", Colors = "#7A90AD" }, Rotate = -45, HideOverlappingLabels = true } },
        Yaxis = new List<YAxis> { new() { Labels = new() { Style = new() { FontSize = "11px", Colors = "#7A90AD" } } } },
        Tooltip = new() { Y = new() { Formatter = "function(val){ return val.toLocaleString('es-AR'); }" } },
        Grid = new() { BorderColor = "#E8EFF9", StrokeDashArray = 4 },
        // Click en la leyenda = foco (no ocultar la serie, que es el default de ApexCharts).
        Legend = new() { Position = LegendPosition.Top, FontSize = "11px", OnItemClick = new() { ToggleDataSeries = false } },
        Theme = new() { Mode = Mode.Light },
        // Sin realce interno de ApexCharts (selección/hover): el highlight del foco es por color.
        // Evita el doble-resaltado al clickear (regla del cross-filter, skill blazor-nortur).
        States = new()
        {
            Active = new() { AllowMultipleDataPointsSelection = false, Filter = new() { Type = StatesFilterType.none } },
            Hover = new() { Filter = new() { Type = StatesFilterType.none } },
        },
    };

    // "Distribución por banda horaria": barras horizontales con "cantidad (%)" afuera (patrón
    // blazor-nortur § Datalabels). Antes era donut; se pasó a barras para el número + % legible.
    // El % se inyecta con el total en Recalcular (placeholder __TOTAL__). Se conserva la leyenda
    // (clic en leyenda = foco, igual que cuando era donut).
    private readonly ApexChartOptions<DonutItem> _optsPieBanda = new()
    {
        Chart = new() { Toolbar = new() { Show = false }, Background = "transparent", Animations = new() { Enabled = false } },
        PlotOptions = new()
        {
            Bar = new()
            {
                Horizontal = true, BorderRadius = 4, BorderRadiusApplication = BorderRadiusApplication.End, Distributed = true,
                DataLabels = new() { Position = BarDataLabelPosition.Top }
            }
        },
        Colors = _paletteBanda,
        // Leyenda conservada (clic = foco, no ocultar serie). Con barras distribuidas ApexCharts la
        // arma desde las categorías; si el clic no dispara OnLegendClicked, el foco por clic en la
        // barra sigue funcionando.
        Legend = new() { Show = true, Position = LegendPosition.Bottom, FontSize = "11px", OnItemClick = new() { ToggleDataSeries = false } },
        DataLabels = new()
        {
            Enabled = true,
            TextAnchor = TextAnchor.Start,
            OffsetX = 8,
            Style = new() { FontSize = "11px", FontWeight = "600", Colors = new List<string> { "#334155" } },
            Formatter = "function(val){ var p = __TOTAL__ > 0 ? Math.round(val * 100 / __TOTAL__) : 0; return val.toLocaleString('es-AR') + ' (' + p + '%)'; }",
        },
        Xaxis = new() { Labels = new() { Style = new() { FontSize = "11px", Colors = "#7A90AD" } } },
        Yaxis = new List<YAxis> { new() { Labels = new() { Style = new() { FontSize = "11px", Colors = "#7A90AD" }, MaxWidth = 120 } } },
        Tooltip = new() { Y = new() { Formatter = "function(val){ return val.toLocaleString('es-AR'); }" } },
        Grid = new() { BorderColor = "#E8EFF9", StrokeDashArray = 4 },
        States = new()
        {
            Active = new() { AllowMultipleDataPointsSelection = false, Filter = new() { Type = StatesFilterType.none } },
            Hover = new() { Filter = new() { Type = StatesFilterType.none } },
        },
    };

    // "Distribución por tipo de vehículo": torta LLENA (pie) limpia + la cantidad y el % al lado de
    // cada ícono en la LEYENDA de abajo (Legend.Formatter, ej: "BUS: 162 (74%)"). Así se evita el
    // problema de las etiquetas encimadas sobre la torta y las leader lines (que ApexCharts no tiene).
    // El % del legend se calcula con el total inyectado en Recalcular (placeholder __TOTALVEH__).
    private readonly ApexChartOptions<DonutItem> _optsPieVeh = new()
    {
        Chart = new() { Toolbar = new() { Show = false }, Background = "transparent", Animations = new() { Enabled = false } },
        Colors = _paletteVeh,
        Legend = new()
        {
            Show = true, Position = LegendPosition.Bottom, FontSize = "12px",
            OnItemClick = new() { ToggleDataSeries = false },
            // Cantidad + % al lado de cada ícono. globals.series trae los valores; el total se inyecta
            // en Recalcular (reemplaza __TOTALVEH__). seriesIndex mapea al orden de _donutVehiculo.
            Formatter = "function(name, opts){ var v = opts.w.globals.series[opts.seriesIndex]; var p = __TOTALVEH__ > 0 ? Math.round(v * 100 / __TOTALVEH__) : 0; return name + ': ' + v.toLocaleString('es-AR') + ' (' + p + '%)'; }",
        },
        DataLabels = new() { Enabled = false },   // sin etiquetas sobre la torta (van en la leyenda)
        Tooltip = new() { Y = new() { Formatter = "function(val){ return val.toLocaleString('es-AR'); }" } },
        States = new()
        {
            Active = new() { AllowMultipleDataPointsSelection = false, Filter = new() { Type = StatesFilterType.none } },
            Hover = new() { Filter = new() { Type = StatesFilterType.none } },
        },
    };

    // ── Pivote ──
    private List<DateOnly> _pivFechas = new();
    private Dictionary<(DateOnly, string), int> _pivMap = new();
    private Dictionary<DateOnly, int> _pivTotFila = new();
    private Dictionary<string, int> _pivTotCol = new();
    private int _granTotal;

    private static readonly string[] _dias = { "dom", "lun", "mar", "mié", "jue", "vie", "sáb" };
    private static string FmtFecha(DateOnly f) => $"{_dias[(int)f.DayOfWeek]} {f:dd/MM/yyyy}";
    private static bool EsFinde(DateOnly f) => f.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthState.EstaAutenticadoAsync())
        {
            Nav.NavigateTo($"/login?destino={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: false);
            return;
        }
        if (!Permisos.Tiene('R'))   // módulo Reservas
        {
            Nav.NavigateTo("/", forceLoad: false);
            return;
        }
        _vehiculos = await Reports.GetVehiculosTipoAsync();
        _vehiculosSel = new HashSet<string>(_vehiculos.Select(v => v.Id));
        await Cargar();
    }

    private async Task Cargar()
    {
        if (_desde is null || _hasta is null) return;
        _cargando = true;
        StateHasChanged();

        // Snapshot de filtros aplicados (convención del service: lista vacía = todos)
        _fDesdeAp = DateOnly.FromDateTime(_desde.Value);
        _fHastaAp = DateOnly.FromDateTime(_hasta.Value);
        _vehAp = _todosVehiculos ? new List<string>() : _vehiculosSel.ToList();
        _estAp = _estadosSel.Count == ReportService.EstadosViaje.Count ? new List<string>() : _estadosSel.ToList();
        _detalle = null;
        // Un nuevo conjunto de filtros descarta los focos anteriores (el dataset puede no contenerlos).
        _bandaFocus = null;
        _vehiculoFocus = null;

        _filas = await Reports.GetReservasPorBandaHorariaAsync(_fDesdeAp, _fHastaAp, _vehAp, _estAp);
        _yaConsultado = true;
        Recalcular();
        _chartsKey = Guid.NewGuid();   // datos nuevos → remontar los charts (el key fuerza el remount)

        _cargando = false;
    }

    // Cambio de métrica: recálculo en memoria, sin nueva query. Cambia la forma de los gráficos
    // (valores y escala) → se remontan con un key nuevo.
    private void CambiarMetrica(string metrica)
    {
        _metrica = metrica;
        if (_filas.Count > 0)
        {
            Recalcular();
            _chartsKey = Guid.NewGuid();
        }
    }

    private void Recalcular()
    {
        Func<BandaHorariaRow, int> val = _metrica == "Pax" ? f => f.Pax : f => f.Reservas;

        // Subconjuntos según el foco (modelo Power BI: donde clickeás resalta, en el resto
        // filtra): los visuales de BANDA usan los datos filtrados por vehículo (el foco de banda
        // en ellos se expresa como resaltado por color), el visual de VEHÍCULO usa los filtrados
        // por banda, y los KPIs / totales de fila usan AMBOS focos combinados.
        var datosVeh = _vehiculoFocus is null ? _filas : _filas.Where(f => f.TipoVehiculo == _vehiculoFocus).ToList();
        var datosBanda = _bandaFocus is null ? _filas : _filas.Where(f => f.Banda == _bandaFocus).ToList();
        var datos = _bandaFocus is null ? datosVeh : datosVeh.Where(f => f.Banda == _bandaFocus).ToList();

        // ── KPIs: sobre el dataset con ambos focos ──
        _totalMetrica = datos.Sum(val);
        _diasConActividad = datos.Select(f => f.Fecha).Distinct().Count();
        _promedioDiario = _diasConActividad > 0 ? (int)Math.Round((double)_totalMetrica / _diasConActividad) : 0;

        // Banda más cargada
        var porBanda = datos.GroupBy(f => f.Banda)
            .Select(g => (Banda: g.Key, Total: g.Sum(val)))
            .OrderByDescending(x => x.Total).ToList();
        _bandaMasCargada = porBanda.FirstOrDefault().Banda ?? "—";
        _maxBanda = porBanda.FirstOrDefault().Total;

        // Vehículo líder
        var porVeh = datos.GroupBy(f => f.TipoVehiculo)
            .Select(g => (Veh: g.Key, Total: g.Sum(val)))
            .OrderByDescending(x => x.Total).ToList();
        _vehiculoLider = porVeh.FirstOrDefault().Veh ?? "—";
        _maxVehiculo = porVeh.FirstOrDefault().Total;

        // ── Pivote: celdas y totales de columna con foco de VEHÍCULO (las columnas de banda
        //    quedan todas visibles — el foco de banda se expresa atenuando por CSS); las filas,
        //    el total de fila y el gran total llevan AMBOS focos (como los KPIs) ──
        _pivFechas = datos.Select(f => f.Fecha).Distinct().OrderBy(d => d).ToList();
        _pivMap = datosVeh
            .GroupBy(f => (f.Fecha, f.Banda))
            .ToDictionary(g => g.Key, g => g.Sum(val));
        _pivTotFila = datos.GroupBy(f => f.Fecha).ToDictionary(g => g.Key, g => g.Sum(val));
        _pivTotCol = datosVeh.GroupBy(f => f.Banda).ToDictionary(g => g.Key, g => g.Sum(val));
        _granTotal = _totalMetrica;

        // ── Barras apiladas: las series son las bandas del dataset COMPLETO (cantidad estable
        //    para poder actualizar en el lugar, sin remontar) con valores del foco de vehículo.
        //    El eje de fechas NO se recorta con el foco de banda (highlight, no filter). ──
        _bandasPresentes = _bandas.Where(b => _filas.Any(f => f.Banda == b)).ToList();
        var chartFechas = datosVeh.Select(f => f.Fecha).Distinct().OrderBy(d => d).ToList();
        _chartData = chartFechas
            .SelectMany(fecha => _bandasPresentes.Select(banda =>
                new ChartItem(fecha.ToString("dd/MM"), banda, PivVal(fecha, banda))))
            .ToList();

        // ── Distribución por banda (barras) + por vehículo (donut): categorías SIEMPRE completas
        //    y en orden estable (con 0 si el foco de la otra dimensión las vacía) — así el update
        //    en el lugar no reordena ──
        _donutBanda = _bandasPresentes
            .Select(b => new DonutItem(b, PivTotCol(b)))
            .ToList();

        // Datalabels "cantidad (%)" de las barras de banda: inyectar el total (base del %) y el
        // margen del eje X para que el label de la barra más larga no se corte (patrón blazor-nortur).
        // Panel a 6/12 → factor +30% (entre el ancho 7/12 y el angosto 5/12).
        var totalBanda = _donutBanda.Sum(d => (int)d.Valor);
        var maxBanda = _donutBanda.Count > 0 ? _donutBanda.Max(d => (int)d.Valor) : 0;
        if (_optsPieBanda.DataLabels is not null)
            _optsPieBanda.DataLabels.Formatter =
                $"function(val){{ var p = {totalBanda} > 0 ? Math.round(val * 100 / {totalBanda}) : 0; return val.toLocaleString('es-AR') + ' (' + p + '%)'; }}";
        if (_optsPieBanda.Xaxis is not null) { _optsPieBanda.Xaxis.Min = 0; _optsPieBanda.Xaxis.Max = maxBanda > 0 ? maxBanda * 1.30 : 1; }

        // Vehículos: ranking por volumen del dataset COMPLETO (color y orden estables) con
        // valores del foco de banda.
        var rankingVeh = _filas.GroupBy(f => f.TipoVehiculo)
            .Select(g => (Veh: g.Key, Total: g.Sum(val)))
            .OrderByDescending(x => x.Total).ThenBy(x => x.Veh).ToList();
        _colorPorVehiculo = rankingVeh
            .Select((x, i) => (x.Veh, i))
            .ToDictionary(t => t.Veh, t => t.i < _paletteVeh.Count ? _paletteVeh[t.i] : "#94A3B8");
        var vehValores = datosBanda.GroupBy(f => f.TipoVehiculo).ToDictionary(g => g.Key, g => g.Sum(val));
        _donutVehiculo = rankingVeh
            .Select(x => new DonutItem(x.Veh, vehValores.TryGetValue(x.Veh, out var v) ? v : 0))
            .ToList();

        // "Distribución por tipo de vehículo" es torta con la cantidad y el % en la LEYENDA: inyectar
        // el total en el Legend.Formatter (reemplaza __TOTALVEH__) para calcular el % de cada ítem.
        var totalVeh = _donutVehiculo.Sum(d => (int)d.Valor);
        if (_optsPieVeh.Legend is not null)
            _optsPieVeh.Legend.Formatter =
                $"function(name, opts){{ var v = opts.w.globals.series[opts.seriesIndex]; var p = {totalVeh} > 0 ? Math.round(v * 100 / {totalVeh}) : 0; return name + ': ' + v.toLocaleString('es-AR') + ' (' + p + '%)'; }}";

        // Colores de cada gráfico, atenuando lo no enfocado (efecto highlight de Power BI).
        _optsBar.Colors = _bandasPresentes.Select(ColorFocoBanda).ToList();
        _optsPieBanda.Colors = _donutBanda.Select(d => ColorFocoBanda(d.Label)).ToList();
        _optsPieVeh.Colors = _donutVehiculo.Select(d => ColorFocoVeh(d.Label)).ToList();
    }

    private int PivVal(DateOnly f, string b) => _pivMap.TryGetValue((f, b), out var v) ? v : 0;
    private int PivTotFila(DateOnly f) => _pivTotFila.TryGetValue(f, out var v) ? v : 0;
    private int PivTotCol(string b) => _pivTotCol.TryGetValue(b, out var v) ? v : 0;

    // ── Cross-filter: toggles y actualización de los charts ──

    private async Task ToggleFocoBanda(string banda)
    {
        // Toggle: clic en la misma banda enfocada la quita.
        _bandaFocus = _bandaFocus == banda ? null : banda;
        Recalcular();                 // recalcula KPIs/tabla/valores/colores (en memoria, sin re-query)
        _bandaChartKey = Guid.NewGuid(); // remonta el chart de barras de banda (sus datalabels se reposicionan bien)
        _vehChartKey = Guid.NewGuid();   // ídem el pie de vehículo (sus valores cambian con el foco de banda)
        await ActualizarGraficos();   // repinta los OTROS charts EN SU LUGAR (sin remontar → sin parpadeo)
    }

    private async Task ToggleFocoVehiculo(string veh)
    {
        _vehiculoFocus = _vehiculoFocus == veh ? null : veh;
        Recalcular();
        _bandaChartKey = Guid.NewGuid(); // el foco de vehículo también cambia los valores de banda → remonte
        _vehChartKey = Guid.NewGuid();   // y el propio pie de vehículo (highlight + reposición de datalabels)
        await ActualizarGraficos();
    }

    private Task LimpiarFocoBanda() => ToggleFocoBanda(_bandaFocus ?? "");
    private Task LimpiarFocoVehiculo() => ToggleFocoVehiculo(_vehiculoFocus ?? "");

    // A diferencia de Reservas por fecha y servicio (donde el foco solo cambiaba COLORES),
    // acá el foco de una dimensión también cambia los VALORES de los otros gráficos →
    // UpdateOptions (colores) + UpdateSeries (valores) en los tres.
    private async Task ActualizarGraficos()
    {
        if (_barChart is not null)
        {
            await _barChart.UpdateOptionsAsync(true, true, false);
            await _barChart.UpdateSeriesAsync(true);
        }
        // _pieBandaChart y _pieVehChart NO se actualizan acá: se remontan vía _bandaChartKey /
        // _vehChartKey (el update en el lugar les rompía la posición de los datalabels). El remonte
        // los redibuja completos y bien.
    }

    // ApexCharts entrega el punto clickeado en e.DataPoint; sus Items son los TItem agrupados
    // en ese punto. En el apilado cada serie ya viene filtrada por banda → el primer item trae
    // la banda de la serie clickeada.
    private async Task OnBarSelection(SelectedData<ChartItem> e)
    {
        var banda = e.DataPoint?.Items?.FirstOrDefault()?.Banda;
        if (banda is not null) await ToggleFocoBanda(banda);
    }

    // Click en un ítem de la leyenda del apilado = mismo foco que clickear la serie
    // (el ToggleDataSeries de ApexCharts está apagado para que no oculte la serie).
    private async Task OnBarLegendClicked(LegendClicked<ChartItem> e)
    {
        var banda = e.Series?.Name;
        if (!string.IsNullOrEmpty(banda)) await ToggleFocoBanda(banda);
    }

    private async Task OnPieBandaSelection(SelectedData<DonutItem> e)
    {
        var banda = e.DataPoint?.Items?.FirstOrDefault()?.Label;
        if (banda is not null) await ToggleFocoBanda(banda);
    }

    private async Task OnPieBandaLegendClicked(LegendClicked<DonutItem> e)
    {
        var banda = e.DataPoint?.Items?.FirstOrDefault()?.Label;
        if (banda is not null) await ToggleFocoBanda(banda);
    }

    private async Task OnPieVehSelection(SelectedData<DonutItem> e)
    {
        var veh = e.DataPoint?.Items?.FirstOrDefault()?.Label;
        if (veh is not null) await ToggleFocoVehiculo(veh);
    }

    private async Task OnPieVehLegendClicked(LegendClicked<DonutItem> e)
    {
        var veh = e.DataPoint?.Items?.FirstOrDefault()?.Label;
        if (veh is not null) await ToggleFocoVehiculo(veh);
    }

    // ── Drill-down: los viajes uno por uno detrás del número ──

    // El detalle del período se trae UNA vez por combinación de filtros (con caché en el
    // service) recién cuando se usa: primer click en una celda o descarga de Excel.
    private async Task<List<BandaHorariaDetalleRow>> GetDetalleAsync()
    {
        if (_detalle is null)
        {
            _cargandoDet = true;
            StateHasChanged();
            _detalle = await Reports.GetReservasBandaHorariaDetalleAsync(_fDesdeAp, _fHastaAp, _vehAp, _estAp);
            _cargandoDet = false;
        }
        return _detalle;
    }

    // Los drills respetan el foco activo: el número visible en la celda/fila corresponde al
    // subconjunto enfocado y el detalle tiene que mostrar EXACTAMENTE esos viajes.
    private bool PasaFocoVeh(BandaHorariaDetalleRow d) => _vehiculoFocus is null || d.TipoVehiculo == _vehiculoFocus;
    private bool PasaFocoBanda(BandaHorariaDetalleRow d) => _bandaFocus is null || d.Banda == _bandaFocus;
    private string SufijoFocoVeh => _vehiculoFocus is null ? "" : $" · {_vehiculoFocus}";

    private Task AbrirDetalleCelda(DateOnly f, string banda) =>
        AbrirDetalle(d => d.Reserva.Fecha == f && d.Banda == banda && PasaFocoVeh(d),
                     $"Banda {banda} — {FmtFecha(f)}{SufijoFocoVeh}");

    private Task AbrirDetalleDia(DateOnly f) =>
        AbrirDetalle(d => d.Reserva.Fecha == f && PasaFocoBanda(d) && PasaFocoVeh(d),
                     $"{(_bandaFocus is null ? "Todas las bandas" : $"Banda {_bandaFocus}")} — {FmtFecha(f)}{SufijoFocoVeh}");

    private async Task AbrirDetalle(Func<BandaHorariaDetalleRow, bool> filtro, string subtitulo)
    {
        var todas = await GetDetalleAsync();
        var items = todas.Where(filtro).Select(d => d.Reserva).ToList();
        if (items.Count == 0) return;

        var parametros = new DialogParameters<ReservasFsDetalleDialog>
        {
            { x => x.Items, items },
            { x => x.Subtitulo, subtitulo }
        };
        var opciones = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseButton = false,
            CloseOnEscapeKey = true,
            BackdropClick = true
        };
        await DialogService.ShowAsync<ReservasFsDetalleDialog>("Detalle de viajes", parametros, opciones);
    }

    private async Task DescargarExcel()
    {
        var viajes = await GetDetalleAsync();
        var bytes = Excel.BandaHoraria(_filas, _metrica, viajes);
        var nombre = $"banda_horaria_{_fDesdeAp:yyyyMMdd}_{_fHastaAp:yyyyMMdd}.xlsx";
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("descargarArchivo", nombre, streamRef);
    }

    private static string Fmt(int n) => n.ToString("#,0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));
}
