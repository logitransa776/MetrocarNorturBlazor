@page "/guardias"
@using MetroCarSysBlazor.Components.Shared
@inject ReportService Reports
@inject NorturAuthStateProvider AuthState
@inject IPermissionService Permisos
@inject NavigationManager Nav
@inject ExcelExportService ExcelSvc
@inject IDialogService DialogService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Guardias — NORTUR</PageTitle>

<div class="page-header mb-4">
    <MudText Typo="Typo.h5" Style="font-weight:800; color:#112F5B;">Guardias</MudText>
    <MudText Typo="Typo.body2" Style="color:#7A90AD; margin-top:2px;">
        Tráfico · Guardias de choferes y unidades — vista de solo lectura (lista para el ABM)
    </MudText>
</div>

@* ── Filtros (réplica de la toolbar FoxPro trafico_guardia.scx: rango de fechas) ── *@
<MudPaper Class="pa-2 mb-3" Elevation="1" Style="border-radius:14px; border-top:4px solid #003AA0;">
    <div class="d-flex flex-wrap align-center" style="gap:14px;">
        <div class="d-flex align-center" style="gap:6px;">
            <MudDatePicker @bind-Date="_desde" Label="Desde" DateFormat="dd/MM/yyyy"
                           PickerVariant="PickerVariant.Dialog" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:160px;" />
            <MudDatePicker @bind-Date="_hasta" Label="Hasta" DateFormat="dd/MM/yyyy"
                           PickerVariant="PickerVariant.Dialog" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:160px;" />
        </div>
        <MudChip T="string" Variant="Variant.Text" Color="Color.Default" Size="Size.Small">@_items.Count guardias</MudChip>

        <span style="flex:1 1 auto;"></span>
        <div class="d-flex align-center" style="gap:6px;">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.FilterAlt" OnClick="CargarAsync" Disabled="_cargando">Filtro</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Refresh" OnClick="Refrescar" Disabled="_cargando">Actualizar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Download" OnClick="DescargarExcel"
                       Disabled="_cargando || _items.Count == 0">Excel</MudButton>
        </div>
    </div>
</MudPaper>

@* ── KPIs ── *@
<div class="d-flex flex-wrap mb-3" style="gap:12px;">
    <div style="flex:1 1 0; min-width:180px;"><KpiCard Label="Guardias" Value="@_items.Count.ToString("N0")" /></div>
    <div style="flex:1 1 0; min-width:180px;"><KpiCard Label="Choferes" Value="@_items.Select(g => g.IdChofer).Distinct().Count().ToString("N0")" /></div>
    <div style="flex:1 1 0; min-width:180px;"><KpiCard Label="En franco" Value="@_items.Count(g => g.Franco).ToString("N0")" Color="@NorturColors.Naranja" /></div>
    <div style="flex:1 1 0; min-width:180px;"><KpiCard Label="Pagadas" Value="@_items.Count(g => g.Pagada).ToString("N0")" Color="@NorturColors.Verde" /></div>
</div>

@if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" Style="border-radius:4px;" />
}
else
{
    <MudPaper Elevation="1" Style="border-radius:14px; overflow:hidden;">
        <MudTable Items="_items" Dense="true" Hover="true" Striped="true"
                  FixedHeader="true" Height="calc(100vh - 400px)"
                  Bordered="false" Class="cli-grid grid-compacta"
                  RowClass="cli-grid__row" RowClassFunc="@RowClass"
                  OnRowClick="@OnRowClick" T="GuardiaRow">
            <HeaderContent>
                <MudTh>Interno</MudTh>
                <MudTh>Vehículo</MudTh>
                <MudTh>Chofer</MudTh>
                <MudTh>Nombre</MudTh>
                <MudTh>Franco</MudTh>
                <MudTh>Fecha</MudTh>
                <MudTh>Hs. Inicio</MudTh>
                <MudTh>Hs. Fin</MudTh>
                <MudTh>F. Pago</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Interno" Style="font-weight:700; color:#003AA0;">@context.InternoNT</MudTd>
                <MudTd DataLabel="Vehículo">@context.IdVehiculo</MudTd>
                <MudTd DataLabel="Chofer">@context.IdChofer</MudTd>
                <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
                <MudTd DataLabel="Franco" Style="text-align:center;">@(context.Franco ? "Sí" : "")</MudTd>
                <MudTd DataLabel="Fecha">@(context.Fecha?.ToString("dd/MM/yyyy") ?? "")</MudTd>
                <MudTd DataLabel="Hs. Inicio">@(context.HsInicio?.ToString("dd/MM HH:mm") ?? "")</MudTd>
                <MudTd DataLabel="Hs. Fin">@(context.HsFin?.ToString("dd/MM HH:mm") ?? "")</MudTd>
                <MudTd DataLabel="F. Pago">@(context.FPago?.ToString("dd/MM/yyyy") ?? "")</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Class="pa-4">No hay guardias en el rango de fechas.</MudText>
            </NoRecordsContent>
        </MudTable>

        <div class="cli-toolbar usr-toolbar">
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add"
                       Size="Size.Medium" Class="usr-toolbar__btn" OnClick="Agregar" Disabled="!_abmActivo">Agregar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                       Size="Size.Medium" Class="usr-toolbar__btn" OnClick="Eliminar" Disabled="!_abmActivo || _sel is null">Eliminar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                       Size="Size.Medium" Class="usr-toolbar__btn" OnClick="Modificar" Disabled="!_abmActivo || _sel is null">Modificar</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Visibility"
                       Size="Size.Medium" Class="usr-toolbar__btn" OnClick="Ver" Disabled="_sel is null">Ver ficha</MudButton>
            <span style="flex:1;"></span>
            <span class="cli-toolbar__hint">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                @(_abmActivo
                    ? "ABM habilitado · doble clic para ver la ficha"
                    : "Solo lectura · el ABM se activa el día del corte a Buslink · doble clic para ver la ficha")
            </span>
        </div>
    </MudPaper>
}

@code {
    private static bool _abmActivo => AbmFeatureFlags.GuardiaAbmActivo;

    private List<GuardiaRow> _items = new();
    // La tabla viaje_guardia es chica y casi sin uso reciente (últimos registros ~2008).
    // Arrancamos con un rango amplio para que la pantalla muestre las guardias que existan;
    // el usuario acota con el filtro de fechas cuando la operación vuelva a cargar guardias.
    private DateTime? _desde = new DateTime(DateTime.Today.Year - 20, 1, 1);
    private DateTime? _hasta = DateTime.Today;
    private bool _cargando = true;
    private GuardiaRow? _sel;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthState.EstaAutenticadoAsync())
        {
            Nav.NavigateTo($"/login?destino={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: false);
            return;
        }
        if (!Permisos.Tiene('T'))
        {
            Nav.NavigateTo("/", forceLoad: false);
            return;
        }
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        StateHasChanged();
        var d = DateOnly.FromDateTime(_desde ?? DateTime.Today.AddMonths(-1));
        var h = DateOnly.FromDateTime(_hasta ?? DateTime.Today);
        _items = await Reports.GetGuardiasAsync(d, h);
        if (_sel is not null)
            _sel = _items.FirstOrDefault(g => g.Id == _sel.Id);
        _cargando = false;
    }

    private Task Refrescar() => CargarAsync();

    private string RowClass(GuardiaRow g, int _) =>
        (g.Franco ? "cli-grid__row--egresado " : "")
        + (_sel is not null && _sel.Id == g.Id ? "cli-grid__row--sel" : "");

    private void OnRowClick(TableRowClickEventArgs<GuardiaRow> args)
    {
        _sel = args.Item;
        if (args.MouseEventArgs.Detail >= 2 && _sel is not null)
            _ = AbrirDialog("ver", _sel);
    }

    private Task Agregar() => AbrirDialog("alta", null);
    private Task Ver() => _sel is null ? Task.CompletedTask : AbrirDialog("ver", _sel);
    private Task Modificar() => _sel is null ? Task.CompletedTask : AbrirDialog("modifica", _sel);
    private Task Eliminar() => _sel is null ? Task.CompletedTask : AbrirDialog("baja", _sel);

    private async Task AbrirDialog(string modo, GuardiaRow? fila)
    {
        var parametros = new DialogParameters<GuardiaEditorDialog>
        {
            { x => x.Modo, modo },
            { x => x.Id, fila?.Id ?? 0 },
            { x => x.Fila, fila }
        };
        var opciones = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = false,
            CloseOnEscapeKey = true, BackdropClick = false
        };
        var dlg = await DialogService.ShowAsync<GuardiaEditorDialog>("Guardia", parametros, opciones);
        var res = await dlg.Result;
        if (res is not null && !res.Canceled && res.Data is bool grabo && grabo)
            await CargarAsync();
    }

    private async Task DescargarExcel()
    {
        var bytes = ExcelSvc.Guardias(_items);
        await JS.InvokeVoidAsync("downloadFile", "Guardias.xlsx", Convert.ToBase64String(bytes));
    }
}
