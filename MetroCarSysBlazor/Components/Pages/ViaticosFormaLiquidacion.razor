@page "/viaticos-forma-liquidacion"
@using MetroCarSysBlazor.Components.Shared
@inject ReportService Reports
@inject AbmService Abm
@inject NorturAuthStateProvider AuthState
@inject IPermissionService Permisos
@inject NavigationManager Nav
@inject IDialogService DialogService
@rendermode InteractiveServer

<PageTitle>Formas de Liquidación de Viático — NORTUR</PageTitle>

<div class="page-header mb-4">
    <MudText Typo="Typo.h5" Style="font-weight:800; color:#112F5B;">Formas de Liquidación de Viático</MudText>
    <MudText Typo="Typo.body2" Style="color:#7A90AD; margin-top:2px;">
        Tráfico · Catálogo de formas de liquidación de viático — vista de solo lectura (lista para el ABM)
    </MudText>
</div>

<MudPaper Class="pa-2 mb-3" Elevation="1" Style="border-radius:14px; border-top:4px solid #003AA0;">
    <div class="d-flex flex-wrap align-center" style="gap:14px;">
        <MudChip T="string" Variant="Variant.Text" Color="Color.Default" Size="Size.Small">@_items.Count formas</MudChip>
        <span style="flex:1 1 auto;"></span>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Refresh" OnClick="Refrescar" Disabled="_cargando">Actualizar</MudButton>
    </div>
</MudPaper>

@if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" Style="border-radius:4px;" />
}
else
{
    <MudPaper Elevation="1" Style="border-radius:14px; overflow:hidden; max-width:640px;">
        <MudTable Items="_items" Dense="true" Hover="true" Striped="true"
                  Bordered="false" Class="cli-grid grid-compacta"
                  RowClass="cli-grid__row" RowClassFunc="@RowClass"
                  OnRowClick="@OnRowClick" T="CatalogoSimpleRow">
            <HeaderContent>
                <MudTh Style="width:100px;">Código</MudTh>
                <MudTh>Nombre</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Código" Style="font-weight:700; color:#003AA0;">@context.Id</MudTd>
                <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Class="pa-4">
                    No hay formas de liquidación cargadas. (El módulo de Viáticos no tuvo uso en el sistema FoxPro.)
                </MudText>
            </NoRecordsContent>
        </MudTable>

        <div class="cli-toolbar usr-toolbar">
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add"
                       Size="Size.Medium" Class="usr-toolbar__btn" OnClick="Agregar" Disabled="!_abmActivo">Agregar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                       Size="Size.Medium" Class="usr-toolbar__btn" OnClick="Eliminar" Disabled="!_abmActivo || _sel is null">Eliminar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                       Size="Size.Medium" Class="usr-toolbar__btn" OnClick="Modificar" Disabled="!_abmActivo || _sel is null">Modificar</MudButton>
            <span style="flex:1;"></span>
            <span class="cli-toolbar__hint">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                @(_abmActivo ? "ABM habilitado" : "Solo lectura · el ABM se activa el día del corte a Buslink")
            </span>
        </div>
    </MudPaper>
}

@code {
    private static bool _abmActivo => AbmFeatureFlags.ViaticoCatalogosAbmActivo;

    private List<CatalogoSimpleRow> _items = new();
    private bool _cargando = true;
    private CatalogoSimpleRow? _sel;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthState.EstaAutenticadoAsync())
        {
            Nav.NavigateTo($"/login?destino={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: false);
            return;
        }
        if (!Permisos.Tiene('T'))
        {
            Nav.NavigateTo("/", forceLoad: false);
            return;
        }
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        StateHasChanged();
        _items = await Reports.GetViaticoLiquidaAsync();
        if (_sel is not null)
            _sel = _items.FirstOrDefault(i => i.Id == _sel.Id);
        _cargando = false;
    }

    private async Task Refrescar()
    {
        Reports.InvalidarCacheAbm();
        await CargarAsync();
    }

    private string RowClass(CatalogoSimpleRow i, int _) =>
        _sel is not null && _sel.Id == i.Id ? "cli-grid__row--sel" : "";

    private void OnRowClick(TableRowClickEventArgs<CatalogoSimpleRow> args)
    {
        _sel = args.Item;
        if (args.MouseEventArgs.Detail >= 2 && _sel is not null)
            _ = AbrirDialog("ver", _sel);
    }

    private Task Agregar() => AbrirDialog("alta", null);
    private Task Modificar() => _sel is null ? Task.CompletedTask : AbrirDialog("modifica", _sel);
    private Task Eliminar() => _sel is null ? Task.CompletedTask : AbrirDialog("baja", _sel);

    private async Task AbrirDialog(string modo, CatalogoSimpleRow? fila)
    {
        var parametros = new DialogParameters<CatalogoSimpleEditorDialog>
        {
            { x => x.Modo, modo },
            { x => x.Id, fila?.Id ?? 0 },
            { x => x.Nombre, fila?.Nombre ?? "" },
            { x => x.Entidad, "liquida" },
            { x => x.AbmActivo, _abmActivo },
            { x => x.OnAlta, (Func<string, Task<AbmService.AbmResult>>)Abm.AltaViaticoLiquidaAsync },
            { x => x.OnModifica, (Func<int, string, Task<AbmService.AbmResult>>)Abm.ModificaViaticoLiquidaAsync },
            { x => x.OnBaja, (Func<int, Task<AbmService.AbmResult>>)Abm.BajaViaticoLiquidaAsync }
        };
        var opciones = new DialogOptions
        {
            MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = false,
            CloseOnEscapeKey = true, BackdropClick = false
        };
        var dlg = await DialogService.ShowAsync<CatalogoSimpleEditorDialog>("Forma de liquidación", parametros, opciones);
        var res = await dlg.Result;
        if (res is not null && !res.Canceled && res.Data is bool grabo && grabo)
            await Refrescar();
    }
}
