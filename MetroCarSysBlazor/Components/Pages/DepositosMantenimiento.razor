@page "/depositos-mantenimiento"
@using MetroCarSysBlazor.Components.Shared
@inject ReportService Reports
@inject NorturAuthStateProvider AuthState
@inject IPermissionService Permisos
@inject NavigationManager Nav
@inject ExcelExportService ExcelSvc
@inject IDialogService DialogService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>BusLink</PageTitle>

<div class="page-header mb-3">
    <MudText Typo="Typo.h5" Style="font-weight:800; color:#112F5B;">Mantenimiento de Depósitos</MudText>
    <MudText Typo="Typo.body2" Style="color:#7A90AD; margin-top:2px;">
        Combustible · baja de depósitos por estación — vista de solo lectura, lista para el ABM
    </MudText>
</div>

<MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.History">
    <b>Circuito sin uso desde 2017.</b> La baja de un depósito es <b>física</b> (DELETE). Consulta histórica
    (rango por defecto 2013–2017).
</MudAlert>

<DepositosFiltros @bind-EstacionId="_estacionId" @bind-Desde="_desde" @bind-Hasta="_hasta"
                  Estaciones="_estaciones" Cargando="_cargando"
                  OnAplicar="Aplicar" OnRefrescar="Refrescar" OnExcel="DescargarExcel" PuedeExcel="_depositos.Any()" />

@if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" Style="border-radius:4px;" />
}
else
{
    <div class="rfs-kpis mb-3">
        <KpiCard Label="MOVIMIENTOS" Value="@_depositos.Count.ToString("N0", _ar)" Sub="@PeriodoTexto" />
        <KpiCard Label="INGRESOS" Value="@_depositos.Where(d => !d.EsEgreso).Sum(d => d.Importe).ToString("C0", _ar)"
                 Sub="depósitos" Color="@NorturColors.Verde" />
        <KpiCard Label="EGRESOS" Value="@_depositos.Where(d => d.EsEgreso).Sum(d => d.Importe).ToString("C0", _ar)"
                 Sub="salidas" Color="@NorturColors.Rojo" />
        <KpiCard Label="NETO" Value="@_depositos.Sum(d => d.Importe).ToString("C0", _ar)"
                 Sub="ingresos − egresos" Color="@NorturColors.Azul" />
    </div>

    <MudPaper Elevation="1" Style="border-radius:14px; overflow:hidden;">
        <MudTable Items="_depositos" Dense="true" Hover="true" Striped="true" FixedHeader="true"
                  Height="calc(100vh - 430px)" Bordered="false" Class="cli-grid grid-compacta"
                  RowClassFunc="@RowClass" OnRowClick="@OnRowClick" Virtualize="true" T="DepositoEstacionRow">
            <HeaderContent>
                <MudTh>Estación</MudTh>
                <MudTh>Fecha</MudTh>
                <MudTh style="text-align:center">Tipo</MudTh>
                <MudTh>Forma de pago</MudTh>
                <MudTh Style="text-align:right">Importe</MudTh>
                <MudTh>Usuario</MudTh>
                <MudTh>Comentario</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Estación" Style="font-weight:600;">@context.Estacion</MudTd>
                <MudTd DataLabel="Fecha">@context.Fecha.ToString("dd/MM/yyyy", _ar)</MudTd>
                <MudTd DataLabel="Tipo" Style="text-align:center">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.EsEgreso ? Color.Error : Color.Success)">
                        @(context.EsEgreso ? "EGRESO" : "INGRESO")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Forma de pago">@context.FormaPago</MudTd>
                <MudTd DataLabel="Importe" Style="@($"text-align:right; font-weight:600; color:{(context.EsEgreso ? "#DC2626" : "#16A34A")};")">
                    @context.Importe.ToString("N2", _ar)
                </MudTd>
                <MudTd DataLabel="Usuario">@context.Usuario</MudTd>
                <MudTd DataLabel="Comentario">@context.Comentario</MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2" Class="pa-4">Sin depósitos en el período.</MudText></NoRecordsContent>
        </MudTable>

        <div class="cli-toolbar usr-toolbar">
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                       Size="Size.Small" OnClick="Eliminar" Disabled="!_abmActivo || _sel is null">Eliminar</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Visibility"
                       Size="Size.Small" OnClick="Ver" Disabled="_sel is null">Ver</MudButton>
            <span style="flex:1;"></span>
            <span class="cli-toolbar__hint">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                @(_abmActivo ? "ABM habilitado · la baja es física" : "Solo lectura · circuito histórico (se activa el día del corte)")
            </span>
        </div>
    </MudPaper>
}

@code {
    private static bool _abmActivo => AbmFeatureFlags.DepositosCombustibleAbmActivo;

    private readonly System.Globalization.CultureInfo _ar =
        System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    private List<DepositoEstacionRow> _depositos = new();
    private List<EstacionCombustibleRow> _estaciones = new();
    private DepositoEstacionRow? _sel;
    private bool _cargando = true;
    private int? _estacionId;
    private DateTime? _desde = new DateTime(2013, 1, 1);
    private DateTime? _hasta = new DateTime(2017, 12, 31);

    private string PeriodoTexto => $"{(_desde ?? DateTime.Today):dd/MM/yyyy} – {(_hasta ?? DateTime.Today):dd/MM/yyyy}";

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthState.EstaAutenticadoAsync())
        {
            Nav.NavigateTo($"/login?destino={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: false);
            return;
        }
        if (!Permisos.Tiene('M'))
        {
            Nav.NavigateTo("/", forceLoad: false);
            return;
        }
        _estaciones = await Reports.GetEstacionesCombustibleAsync();
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        StateHasChanged();
        var desde = DateOnly.FromDateTime(_desde ?? new DateTime(2013, 1, 1));
        var hasta = DateOnly.FromDateTime(_hasta ?? new DateTime(2017, 12, 31));
        _depositos = await Reports.GetDepositosEstacionAsync(_estacionId, desde, hasta);
        if (_sel is not null) _sel = _depositos.FirstOrDefault(d => d.Id == _sel.Id);
        _cargando = false;
    }

    private async Task Aplicar() => await CargarAsync();

    private async Task Refrescar()
    {
        Reports.InvalidarCacheAbm();
        await CargarAsync();
    }

    private string RowClass(DepositoEstacionRow d, int _) =>
        _sel is not null && _sel.Id == d.Id ? "cli-grid__row--sel" : "";

    private void OnRowClick(TableRowClickEventArgs<DepositoEstacionRow> args)
    {
        _sel = args.Item;
        if (args.MouseEventArgs.Detail >= 2 && _sel is not null)
            _ = AbrirDialog("ver", _sel.Id);
    }

    private Task Ver() => _sel is null ? Task.CompletedTask : AbrirDialog("ver", _sel.Id);
    private Task Eliminar() => _sel is null ? Task.CompletedTask : AbrirDialog("baja", _sel.Id);

    private async Task AbrirDialog(string modo, int id)
    {
        var parametros = new DialogParameters<DepositoEstacionEditorDialog>
        {
            { x => x.Modo, modo },
            { x => x.Id, id },
        };
        var opciones = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = false,
            CloseOnEscapeKey = true, BackdropClick = false
        };
        var dlg = await DialogService.ShowAsync<DepositoEstacionEditorDialog>("Depósito", parametros, opciones);
        var res = await dlg.Result;
        if (res is not null && !res.Canceled && res.Data is bool grabo && grabo)
            await Refrescar();
    }

    private async Task DescargarExcel()
    {
        var bytes = ExcelSvc.DepositosEstacion(_depositos);
        await JS.InvokeVoidAsync("downloadFile", "Depositos.xlsx", Convert.ToBase64String(bytes));
    }
}
