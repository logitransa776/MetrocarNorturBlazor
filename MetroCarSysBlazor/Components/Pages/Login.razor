@page "/login"
@layout EmptyLayout
@inject AuthService Auth
@inject NorturAuthStateProvider AuthState
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Metrocar Nortur — Login</PageTitle>

<div class="login-bg">
    <div class="login-card">

        <div class="login-logo">
            <img src="images/logo.png" alt="NORTUR" />
        </div>

        <div class="login-field">
            <label class="login-label">Usuario</label>
            <div class="login-input-wrap">
                <span class="login-icon">&#128100;</span>
                <input class="login-input" type="text" placeholder=""
                       @bind="_usuario" @bind:event="oninput"
                       @onkeydown="OnKey" />
            </div>
        </div>

        <div class="login-field">
            <label class="login-label">Contraseña</label>
            <div class="login-input-wrap">
                <span class="login-icon">&#128273;</span>
                <input class="login-input" type="@(_mostrarPassword ? "text" : "password")"
                       @bind="_password" @bind:event="oninput"
                       @onkeydown="OnKey" />
                <span class="login-eye" @onclick="() => _mostrarPassword = !_mostrarPassword"
                      title="@(_mostrarPassword ? "Ocultar" : "Mostrar")">
                    @(_mostrarPassword ? "🙈" : "👁️")
                </span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="login-error">@_error</div>
        }

        <button class="login-btn" disabled="@_cargando" @onclick="Ingresar">
            @(_cargando ? "Validando..." : "Ingresar")
        </button>

        <div class="login-footer">
            Sistema de Gestión de Tráfico
            <strong>Acceso Seguro</strong>
        </div>
    </div>
</div>

@code {
    private string _usuario = "";
    private string _password = "";
    private string? _error;
    private bool _cargando;
    private bool _mostrarPassword;

    protected override void OnInitialized()
    {
        // Si ya hay sesión, ir directo al reporte.
        if (AuthState.UsuarioActual is not null)
            Nav.NavigateTo("/planilla-trafico", forceLoad: false);
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter")
            await Ingresar();
    }

    private async Task Ingresar()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_usuario) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "Por favor completá usuario y contraseña";
            return;
        }

        _cargando = true;
        var ok = await Auth.ValidarCredencialesAsync(_usuario, _password);
        _cargando = false;

        if (ok)
        {
            AuthState.IniciarSesion(_usuario);
            Nav.NavigateTo("/planilla-trafico", forceLoad: false);
        }
        else
        {
            _error = "Usuario o contraseña incorrecto";
        }
    }
}
