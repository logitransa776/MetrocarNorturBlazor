@page "/login"
@layout EmptyLayout
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpCtx
@using Microsoft.AspNetCore.Components.Forms

@* SSR estático (sin rendermode interactivo): el form hace un POST HTML nativo a
   /auth/login, que es donde SignInAsync puede escribir la cookie. Un @onclick
   interactivo NO podría hacerlo (el response HTTP ya se envió). *@

<PageTitle>BusLink</PageTitle>

<div class="login-bg">
    <div class="login-anim"></div>

    <form class="login-container" method="post" action="/auth/login">
        <AntiforgeryToken />
        <input type="hidden" name="destino" value="@_destino" />

        <header class="login-logo-section">
            <div class="login-logo-img">
                <img src="images/logo.png" alt="NORTUR" />
            </div>
        </header>

        <div class="login-forms">
            <div class="login-field">
                <label class="login-label" for="login-user">Usuario</label>
                <div class="login-input-wrap">
                    <input id="login-user" name="usuario" class="login-input" type="text"
                           placeholder="" autocomplete="username"
                           autofocus required />
                </div>
            </div>

            <div class="login-field">
                <label class="login-label" for="login-pass">Contraseña</label>
                <div class="login-input-wrap">
                    <input id="login-pass" name="password" class="login-input login-input--pass"
                           type="password" placeholder=""
                           autocomplete="current-password" required />
                    <span class="login-eye" id="login-eye" title="Mostrar contraseña"
                          onclick="norturLoginEye()">👁️</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="login-error">@_error</div>
            }

            <div class="login-btn-group">
                <button class="login-btn" type="submit">Ingresar</button>
            </div>
        </div>

        <footer class="login-footer">
            <div class="login-footer-logo">
                <img src="images/buslink_icon_e.png" alt="BUS LINK" class="login-footer-img" />
                <span class="login-footer-text">BUS LINK</span>
            </div>
        </footer>
    </form>
</div>

@* Mostrar/ocultar contraseña con JS puro (la página es SSR estática, sin Blazor interactivo). *@
<script>
    function norturLoginEye() {
        var i = document.getElementById('login-pass');
        var e = document.getElementById('login-eye');
        if (i.type === 'password') { i.type = 'text'; e.textContent = '🙈'; e.title = 'Ocultar contraseña'; }
        else { i.type = 'password'; e.textContent = '👁️'; e.title = 'Mostrar contraseña'; }
    }
</script>

@code {
    [SupplyParameterFromQuery] private string? Error { get; set; }

    private string? _error;
    private string _destino = "/";

    protected override void OnInitialized()
    {
        _error = Error;

        // Si ya hay cookie válida, el usuario está logueado: lo mandamos al
        // dashboard en vez de mostrarle el login. El destino sale del query
        // ?destino= (lo setea el guard de las páginas) o "/".
        var user = HttpCtx.HttpContext?.User;
        if (user?.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo(DestinoInicial(user), replace: true);
            return;
        }

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var qs = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (qs.TryGetValue("destino", out var d) && !string.IsNullOrWhiteSpace(d))
            _destino = d!;
    }

    // Primer reporte que el usuario puede ver según sus claims de módulo.
    private static string DestinoInicial(System.Security.Claims.ClaimsPrincipal u)
    {
        bool tiene(char m) => u.HasClaim(NorturClaims.Modulo, char.ToUpperInvariant(m).ToString());
        return tiene('T') ? "/planilla-trafico"
             : tiene('R') ? "/reservas-fecha-servicio"
             : "/";
    }
}
