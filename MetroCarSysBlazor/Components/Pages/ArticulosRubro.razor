@page "/articulos-rubro"
@using MetroCarSysBlazor.Components.Shared
@inject ReportService Reports
@inject NorturAuthStateProvider AuthState
@inject IPermissionService Permisos
@inject NavigationManager Nav
@inject ExcelExportService ExcelSvc
@inject IDialogService DialogService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Artículos por Rubro de Consumo — NORTUR</PageTitle>

<div class="page-header mb-3">
    <MudText Typo="Typo.h5" Style="font-weight:800; color:#112F5B;">Artículos por Rubro de Consumo</MudText>
    <MudText Typo="Typo.body2" Style="color:#7A90AD; margin-top:2px;">
        Combustible · artículos de cada rubro (para rubro combustible = tipos de combustible) — vista de solo lectura, lista para el ABM
    </MudText>
</div>

@* ── Filtros ── *@
<MudPaper Class="pa-2 mb-3" Elevation="1" Style="border-radius:14px; border-top:4px solid #003AA0;">
    <div class="d-flex flex-wrap align-center" style="gap:14px;">
        <MudSelect T="long?" @bind-Value="_rubroFiltro" Label="Rubro" Dense="true" Clearable="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:220px;"
                   SelectedValuesChanged="@(_ => CargarAsync())">
            @foreach (var r in _rubros)
            {
                <MudSelectItem T="long?" Value="@((long?)r.Id)">@r.Rubro</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="_busqueda" Label="Buscar artículo" Immediate="true" DebounceInterval="200"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:220px;" />
        <MudChip T="string" Variant="Variant.Text" Color="Color.Default" Size="Size.Small">
            @Filtrados.Count() de @_articulos.Count
        </MudChip>

        <span style="flex:1 1 auto;"></span>
        <div class="d-flex align-center" style="gap:6px;">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Refresh" OnClick="Refrescar" Disabled="_cargando">Actualizar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Download" OnClick="DescargarExcel"
                       Disabled="_cargando || !Filtrados.Any()">Excel</MudButton>
        </div>
    </div>
</MudPaper>

@if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" Style="border-radius:4px;" />
}
else
{
    <MudPaper Elevation="1" Style="border-radius:14px; overflow:hidden;">
        <MudTable Items="Filtrados" Dense="true" Hover="true" Striped="true" FixedHeader="true"
                  Height="calc(100vh - 320px)" Bordered="false" Class="cli-grid grid-compacta"
                  RowClassFunc="@RowClass" OnRowClick="@OnRowClick" T="ArticuloRubroRow">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<ArticuloRubroRow, object>(x => x.Id)">Código</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel InitialDirection="SortDirection.Ascending" SortBy="new Func<ArticuloRubroRow, object>(x => x.Rubro)">Rubro</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<ArticuloRubroRow, object>(x => x.Nombre)">Artículo</MudTableSortLabel></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Código" Style="font-weight:700; color:#003AA0;">@context.Id</MudTd>
                <MudTd DataLabel="Rubro">@context.Rubro</MudTd>
                <MudTd DataLabel="Artículo" Style="font-weight:600;">@context.Nombre</MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2" Class="pa-4">No hay artículos para el filtro aplicado.</MudText></NoRecordsContent>
        </MudTable>

        @* ── Botonera réplica FoxPro (andamiaje) ── *@
        <div class="cli-toolbar usr-toolbar">
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add"
                       Size="Size.Medium" Class="usr-toolbar__btn" OnClick="Agregar" Disabled="!_abmActivo">Agregar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                       Size="Size.Medium" Class="usr-toolbar__btn" OnClick="Eliminar" Disabled="!_abmActivo || _sel is null">Eliminar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                       Size="Size.Medium" Class="usr-toolbar__btn" OnClick="Modificar" Disabled="!_abmActivo || _sel is null">Modificar</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Visibility"
                       Size="Size.Medium" Class="usr-toolbar__btn" OnClick="Ver" Disabled="_sel is null">Ver</MudButton>
            <span style="flex:1;"></span>
            <span class="cli-toolbar__hint">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                @(_abmActivo
                    ? "ABM habilitado · doble clic para ver"
                    : "Solo lectura · el ABM se activa el día del corte a Buslink · doble clic para ver")
            </span>
        </div>
    </MudPaper>
}

@code {
    private static bool _abmActivo => AbmFeatureFlags.ArticulosRubroAbmActivo;

    private List<ArticuloRubroRow> _articulos = new();
    private List<RubroContactoRow> _rubros = new();
    private ArticuloRubroRow? _sel;
    private bool _cargando = true;
    private long? _rubroFiltro;
    private string? _busqueda;

    private IEnumerable<ArticuloRubroRow> Filtrados =>
        _articulos.Where(a => string.IsNullOrWhiteSpace(_busqueda)
            || a.Nombre.Contains(_busqueda, StringComparison.OrdinalIgnoreCase)
            || a.Rubro.Contains(_busqueda, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthState.EstaAutenticadoAsync())
        {
            Nav.NavigateTo($"/login?destino={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: false);
            return;
        }
        if (!Permisos.Tiene('M'))
        {
            Nav.NavigateTo("/", forceLoad: false);
            return;
        }
        _rubros = await Reports.GetRubrosContactoAsync();
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        StateHasChanged();
        _articulos = await Reports.GetArticulosRubroAsync(_rubroFiltro);
        if (_sel is not null) _sel = _articulos.FirstOrDefault(a => a.Id == _sel.Id);
        _cargando = false;
    }

    private async Task Refrescar()
    {
        Reports.InvalidarCacheAbm();
        await CargarAsync();
    }

    private string RowClass(ArticuloRubroRow a, int _) =>
        _sel is not null && _sel.Id == a.Id ? "cli-grid__row--sel" : "";

    private void OnRowClick(TableRowClickEventArgs<ArticuloRubroRow> args)
    {
        _sel = args.Item;
        if (args.MouseEventArgs.Detail >= 2 && _sel is not null)
            _ = AbrirDialog("ver", _sel.Id);
    }

    private Task Agregar() => AbrirDialog("alta", 0);
    private Task Ver() => _sel is null ? Task.CompletedTask : AbrirDialog("ver", _sel.Id);
    private Task Modificar() => _sel is null ? Task.CompletedTask : AbrirDialog("modifica", _sel.Id);
    private Task Eliminar() => _sel is null ? Task.CompletedTask : AbrirDialog("baja", _sel.Id);

    private async Task AbrirDialog(string modo, int id)
    {
        var parametros = new DialogParameters<ArticuloRubroEditorDialog>
        {
            { x => x.Modo, modo },
            { x => x.Id, id },
        };
        var opciones = new DialogOptions
        {
            MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = false,
            CloseOnEscapeKey = true, BackdropClick = false
        };
        var dlg = await DialogService.ShowAsync<ArticuloRubroEditorDialog>("Artículo", parametros, opciones);
        var res = await dlg.Result;
        if (res is not null && !res.Canceled && res.Data is bool grabo && grabo)
            await Refrescar();
    }

    private async Task DescargarExcel()
    {
        var bytes = ExcelSvc.ArticulosRubro(Filtrados.ToList());
        await JS.InvokeVoidAsync("downloadFile", "ArticulosRubro.xlsx", Convert.ToBase64String(bytes));
    }
}
