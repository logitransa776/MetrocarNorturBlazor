    // ── Pivote ──
    private List<string> _pivMeses = new();
    private List<string> _pivClientes = new();          // IdCliente, orden por total desc
    private Dictionary<(string, string), int> _pivMap = new();
    private Dictionary<string, int> _pivTotFila = new();
    private Dictionary<string, int> _pivTotCol = new();
    private int _granTotal;

    // "2026-02" → "02/2026"
    private static string FmtMes(string mes) =>
        mes.Length == 7 ? $"{mes[5..]}/{mes[..4]}" : mes;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthState.EstaAutenticadoAsync())
        {
            Nav.NavigateTo($"/login?destino={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: false);
            return;
        }
        if (!Permisos.Tiene('R'))   // módulo Reservas
        {
            Nav.NavigateTo("/", forceLoad: false);
            return;
        }
        _motivos = await Reports.GetMotivosCancelacionAsync();
        // Default del modo canceladas: solo "CANCELADO POR CLIENTE" (motivo 2, el del FoxPro).
        _motivosSel = new HashSet<int>(_motivos.Where(m => m.Id == 2).Select(m => m.Id));
        if (_motivosSel.Count == 0)
            _motivosSel = new HashSet<int>(_motivos.Select(m => m.Id));
        await Cargar();
    }

    private async Task Cargar()
    {
        if (_desde is null || _hasta is null) return;
        _cargando = true;
        StateHasChanged();

        // Snapshot de filtros aplicados (convención del service: lista de motivos vacía = todos)
        _fDesdeAp = DateOnly.FromDateTime(_desde.Value);
        _fHastaAp = DateOnly.FromDateTime(_hasta.Value);
        _internosAp = _internos;
        _canceladasAp = _verSel == "Canceladas";
        _motAp = !_canceladasAp || _motivosSel.Count == _motivos.Count
            ? new List<int>()
            : _motivosSel.ToList();
        _detalle = null;
        // Un nuevo conjunto de filtros descarta los focos anteriores.
        _clienteFocus = null;
        _tipoFocus = null;

        _filas = await Reports.GetReservasPorClienteAsync(_fDesdeAp, _fHastaAp, _internosAp, _canceladasAp, _motAp);
        Recalcular();
        _chartsKey = Guid.NewGuid();   // datos nuevos → remontar los charts

        _cargando = false;
    }

    // Cambio de métrica: recálculo en memoria, sin nueva query. Cambia la forma de los
    // gráficos → se remontan con un key nuevo.
    private void CambiarMetrica(string metrica)
    {
        _metrica = metrica;
        if (_filas.Count > 0)
        {
            Recalcular();
            _chartsKey = Guid.NewGuid();
        }
    }

    // Cambio de "Mostrar Top N": cambia la cantidad de barras (la FORMA) → remontar.
    private void CambiarTopN(int topN)
    {
        _topN = topN;
        if (_filas.Count > 0)
        {
            Recalcular();
            _chartsKey = Guid.NewGuid();
        }
    }

    private void Recalcular()
    {
        Func<ReservaClienteRow, int> val = _metrica == "Pax" ? f => f.Pax : f => f.Viajes;

        // Subconjuntos según el foco (modelo Power BI): los visuales de CLIENTE (barras, tabla)
        // usan los datos filtrados por TIPO (el foco de cliente en ellos es resaltado por
        // color/CSS), los visuales de TIPO (apilado mensual, donut) usan los filtrados por
        // CLIENTE, y los KPIs / totales llevan AMBOS focos combinados.
        var datosTipo = _tipoFocus is null ? _filas : _filas.Where(f => f.Tipo == _tipoFocus).ToList();
        var datosCliente = _clienteFocus is null ? _filas : _filas.Where(f => f.IdCliente == _clienteFocus).ToList();
        var datos = _clienteFocus is null ? datosTipo : datosTipo.Where(f => f.IdCliente == _clienteFocus).ToList();

        // Nombre visible por cliente (canónico, del dataset completo).
        _nombrePorCliente = _filas
            .GroupBy(f => f.IdCliente)
            .ToDictionary(g => g.Key, g => g.First().Cliente);

        // ── KPIs: sobre el dataset con ambos focos ──
        _totalMetrica = datos.Sum(val);
        var meses = datos.Select(f => f.Mes).Distinct().Count();
        _promedioMensual = meses > 0 ? (int)Math.Round((double)_totalMetrica / meses) : 0;
        _clientesActivos = datos.Select(f => f.IdCliente).Distinct().Count();

        var porCliente = datos.GroupBy(f => f.IdCliente)
            .Select(g => (Id: g.Key, Total: g.Sum(val)))
            .OrderByDescending(x => x.Total).ToList();
        _clienteLider = porCliente.Count > 0 ? NombreDe(porCliente[0].Id) : "—";
        _maxCliente = porCliente.Count > 0 ? porCliente[0].Total : 0;

        _totalContratado = datos.Where(f => f.Tipo == "CONTRATADO").Sum(val);
        _pctContratado = _totalMetrica > 0 ? (int)Math.Round(100.0 * _totalContratado / _totalMetrica) : 0;

        // ── Pivote: filas = clientes (foco de cliente = resaltado por CSS, la lista completa
        //    queda visible), celdas y totales de fila con foco de TIPO; los totales de columna
        //    y el gran total llevan AMBOS focos ──
        _pivMeses = _filas.Select(f => f.Mes).Distinct().OrderBy(m => m).ToList();
        _pivMap = datosTipo
            .GroupBy(f => (f.IdCliente, f.Mes))
            .ToDictionary(g => ((string, string))g.Key, g => g.Sum(val));
        _pivTotFila = datosTipo.GroupBy(f => f.IdCliente).ToDictionary(g => g.Key, g => g.Sum(val));
        _pivClientes = datosTipo.GroupBy(f => f.IdCliente)
            .Select(g => (Id: g.Key, Total: g.Sum(val)))
            .OrderByDescending(x => x.Total).ThenBy(x => NombreDe(x.Id))
            .Select(x => x.Id).ToList();
        _pivTotCol = datos.GroupBy(f => f.Mes).ToDictionary(g => g.Key, g => g.Sum(val));
        _granTotal = _totalMetrica;

        // ── Apilado mensual: series = tipos del dataset COMPLETO (cantidad estable para el
        //    update en el lugar), valores con foco de CLIENTE, todos los meses con 0-fill ──
        _tiposPresentes = _tipos.Where(t => _filas.Any(f => f.Tipo == t)).ToList();
        var mapaMesTipo = datosCliente
            .GroupBy(f => (f.Mes, f.Tipo))
            .ToDictionary(g => g.Key, g => g.Sum(val));
        _chartData = _pivMeses
            .SelectMany(mes => _tiposPresentes.Select(tipo =>
                new ChartItem(FmtMes(mes), tipo, mapaMesTipo.TryGetValue((mes, tipo), out var v) ? v : 0)))
            .ToList();

        // ── Barras de clientes: ranking y colores del dataset COMPLETO (orden estable),
        //    valores con foco de TIPO ──
        _rankingClientes = _filas.GroupBy(f => f.IdCliente)
            .Select(g => (Id: g.Key, Nombre: g.First().Cliente, Total: g.Sum(val)))
            .OrderByDescending(x => x.Total).ThenBy(x => x.Nombre).ToList();
        _colorPorCliente = _rankingClientes
            .Select((x, i) => (x.Id, i))
            .ToDictionary(t => t.Id, t => t.i < _paletteCli.Count ? _paletteCli[t.i] : _colorOtros);

        // Nombres repetidos entre clientes distintos: desambiguar con el código para que
        // ApexCharts no funda dos barras en una misma etiqueta X.
        var nombresRepetidos = _rankingClientes.GroupBy(x => x.Nombre)
            .Where(g => g.Count() > 1).Select(g => g.Key).ToHashSet();
        var valoresCli = datosTipo.GroupBy(f => f.IdCliente).ToDictionary(g => g.Key, g => g.Sum(val));
        _barItems = _rankingClientes.Take(_topN)
            .Select(x => new BarItem(
                x.Id,
                nombresRepetidos.Contains(x.Nombre) ? $"{x.Nombre} ({x.Id})" : x.Nombre,
                valoresCli.TryGetValue(x.Id, out var v) ? v : 0))
            .ToList();
        _altoBarras = Math.Max(360, _barItems.Count * 30);

        // ── Donut por tipo: categorías completas en orden fijo (0-fill si el foco de cliente
        //    las vacía), valores con foco de CLIENTE ──
        var tipoValores = datosCliente.GroupBy(f => f.Tipo).ToDictionary(g => g.Key, g => g.Sum(val));
        _donutTipo = _tiposPresentes
            .Select(t => new DonutItem(t, tipoValores.TryGetValue(t, out var v) ? v : 0))
            .ToList();

        // Colores de cada gráfico, atenuando lo no enfocado (efecto highlight de Power BI).
        _optsBarMes.Colors = _tiposPresentes.Select(ColorFocoTipo).ToList();
        _optsBarCli.Colors = _barItems.Select(b => ColorFocoCli(b.IdCliente)).ToList();
        _optsPieTipo.Colors = _donutTipo.Select(d => ColorFocoTipo(d.Label)).ToList();
    }

    private int PivVal(string cli, string mes) => _pivMap.TryGetValue((cli, mes), out var v) ? v : 0;
    private int PivTotFila(string cli) => _pivTotFila.TryGetValue(cli, out var v) ? v : 0;
    private int PivTotCol(string mes) => _pivTotCol.TryGetValue(mes, out var v) ? v : 0;

    // ── Comparación mes contra mes ──────────────────────────────────────────────────────
    // El "mes base" de un mes dado es contra quién se compara, según el modo elegido:
    //  · M1  → el mes inmediatamente anterior en la grilla (M-1)
    //  · N   → N meses calendario atrás (busca ese mes en la grilla)
    //  · YoY → el mismo mes del año anterior
    // Devuelve null si no hay mes base (primer mes / fuera del rango cargado).

    private string? MesBaseDe(string mes)
    {
        if (_comparar == "M1")
        {
            var i = _pivMeses.IndexOf(mes);
            return i > 0 ? _pivMeses[i - 1] : null;
        }
        if (_comparar == "N")
        {
            var objetivo = SumarMeses(mes, -_saltoN);
            return _pivMeses.Contains(objetivo) ? objetivo : null;
        }
        // YoY: mismo mes del año anterior — solo si ese mes está en el rango cargado.
        var yoy = SumarMeses(mes, -12);
        return _pivMeses.Contains(yoy) ? yoy : null;
    }

    // "2026-03" + (-2) → "2026-01"; "2026-01" + (-2) → "2025-11"
    private static string SumarMeses(string mes, int delta)
    {
        var y = int.Parse(mes[..4]);
        var m = int.Parse(mes[5..7]);
        var idx = y * 12 + (m - 1) + delta;
        return $"{idx / 12:0000}-{idx % 12 + 1:00}";
    }

    // Δ de una celda (valor del mes menos valor del mes base). null si no hay base.
    private int? PivVar(string cli, string mes)
    {
        var baseMes = MesBaseDe(mes);
        return baseMes is null ? null : PivVal(cli, mes) - PivVal(cli, baseMes);
    }

    // Δ del total de columna (todos los clientes) del mes vs su base. null si no hay base.
    private int? PivVarTotCol(string mes)
    {
        var baseMes = MesBaseDe(mes);
        return baseMes is null ? null : PivTotCol(mes) - PivTotCol(baseMes);
    }

    // ── Columna "Tendencia": Δ del ÚLTIMO mes de la grilla vs su base, por cliente ──
    private string UltimoMes => _pivMeses.Count > 0 ? _pivMeses[^1] : "";

    // (delta, porcentaje o null si la base es 0/no existe) del último mes para un cliente.
    private (int? Delta, double? Pct) TendenciaCliente(string cli)
    {
        var baseMes = MesBaseDe(UltimoMes);
        if (baseMes is null) return (null, null);
        var actual = PivVal(cli, UltimoMes);
        var previo = PivVal(cli, baseMes);
        var delta = actual - previo;
        double? pct = previo > 0 ? 100.0 * delta / previo : null;
        return (delta, pct);
    }

    // Etiqueta legible de la base ("mes anterior", "2 meses atrás", "año pasado") para tooltips/subtítulos.
    private string BaseLbl => _comparar switch
    {
        "M1" => "mes anterior",
        "N" => $"{_saltoN} meses atrás",
        _ => "año pasado",
    };

    // Clase CSS del signo de una variación (verde sube / rojo baja / neutro cero).
    private static string ClaseVar(int? d) =>
        d is null ? "rfs-var-na" : d.Value > 0 ? "rfs-var-up" : d.Value < 0 ? "rfs-var-down" : "rfs-var-flat";

    // "+19" / "−53" / "0" / "—" (base inexistente). Usa el guión largo real para negativos.
    private static string FmtVar(int? d) =>
        d is null ? "—" : d.Value > 0 ? $"+{Fmt(d.Value)}" : d.Value < 0 ? $"−{Fmt(-d.Value)}" : "0";

    // "+18%" / "−35%" (o "" si no hay base con volumen).
    private static string FmtPct(double? p) =>
        p is null ? "" : (p.Value >= 0 ? "+" : "−") + $"{Math.Abs(p.Value):0}%";

    // ── Sparkline SVG inline de la serie mensual de un cliente (o del total) ──
    // 5-6 puntos, ancho fijo; sin librerías. Color según la tendencia del último tramo.
    private MarkupString Sparkline(Func<string, int> serie)
    {
        var vals = _pivMeses.Select(serie).ToList();
        if (vals.Count < 2) return (MarkupString)"";
        const int w = 64, h = 20, pad = 2;
        int max = vals.Max(), min = vals.Min();
        double span = max - min;
        double dx = (w - 2.0 * pad) / (vals.Count - 1);
        double Y(int v) => span <= 0 ? h / 2.0 : h - pad - (v - min) / span * (h - 2.0 * pad);
        var pts = string.Join(" ", vals.Select((v, i) => $"{pad + i * dx:0.#},{Y(v):0.#}"));
        var (delta, _) = (vals[^1] - vals[^2], 0);
        var color = delta > 0 ? "#16A34A" : delta < 0 ? "#DC2626" : "#94A3B8";
        var cx = pad + (vals.Count - 1) * dx;
        var cy = Y(vals[^1]);
        return (MarkupString)(
            $"<svg class=\"rfs-spark\" viewBox=\"0 0 {w} {h}\" width=\"{w}\" height=\"{h}\" preserveAspectRatio=\"none\">" +
            $"<polyline points=\"{pts}\" fill=\"none\" stroke=\"{color}\" stroke-width=\"1.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>" +
            $"<circle cx=\"{cx:0.#}\" cy=\"{cy:0.#}\" r=\"2\" fill=\"{color}\"/>" +
            "</svg>");
    }

    // ── Cross-filter: toggles y actualización de los charts ──

    private async Task ToggleFocoCliente(string idCli)
    {
        _clienteFocus = _clienteFocus == idCli ? null : idCli;
        Recalcular();                 // en memoria, sin re-query
        await ActualizarGraficos();   // repinta EN SU LUGAR (sin remontar → sin parpadeo)
    }

    private async Task ToggleFocoTipo(string tipo)
    {
        _tipoFocus = _tipoFocus == tipo ? null : tipo;
        Recalcular();
        await ActualizarGraficos();
    }

    private Task LimpiarFocoCliente() => ToggleFocoCliente(_clienteFocus ?? "");
    private Task LimpiarFocoTipo() => ToggleFocoTipo(_tipoFocus ?? "");

    // El foco de una dimensión cambia los VALORES de los gráficos de la otra →
    // UpdateOptions (colores) + UpdateSeries (valores) en los tres.
    private async Task ActualizarGraficos()
    {
        if (_barMesChart is not null)
        {
            await _barMesChart.UpdateOptionsAsync(true, true, false);
            await _barMesChart.UpdateSeriesAsync(true);
        }
        if (_barCliChart is not null)
        {
            await _barCliChart.UpdateOptionsAsync(true, true, false);
            await _barCliChart.UpdateSeriesAsync(true);
        }
        if (_pieTipoChart is not null)
        {
            await _pieTipoChart.UpdateOptionsAsync(true, true, false);
            await _pieTipoChart.UpdateSeriesAsync(true);
        }
    }

    // En el apilado cada serie ya viene filtrada por tipo → el primer item trae el tipo
    // de la serie clickeada.
    private async Task OnBarMesSelection(SelectedData<ChartItem> e)
    {
        var tipo = e.DataPoint?.Items?.FirstOrDefault()?.Tipo;
        if (tipo is not null) await ToggleFocoTipo(tipo);
    }

    private async Task OnBarMesLegendClicked(LegendClicked<ChartItem> e)
    {
        var tipo = e.Series?.Name;
        if (!string.IsNullOrEmpty(tipo)) await ToggleFocoTipo(tipo);
    }

    private async Task OnBarCliSelection(SelectedData<BarItem> e)
    {
        var idCli = e.DataPoint?.Items?.FirstOrDefault()?.IdCliente;
        if (idCli is not null) await ToggleFocoCliente(idCli);
    }

    private async Task OnPieTipoSelection(SelectedData<DonutItem> e)
    {
        var tipo = e.DataPoint?.Items?.FirstOrDefault()?.Label;
        if (tipo is not null) await ToggleFocoTipo(tipo);
