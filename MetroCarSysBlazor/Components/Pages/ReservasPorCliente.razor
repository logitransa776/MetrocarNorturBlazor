@page "/reservas-por-cliente"
@using ApexCharts
@using MudColor = MudBlazor.Color
@using MudSize = MudBlazor.Size
@inject ReportService Reports
@inject ExcelExportService Excel
@inject NorturAuthStateProvider AuthState
@inject IPermissionService Permisos
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDialogService DialogService
@rendermode InteractiveServer

<PageTitle>BusLink</PageTitle>

@* ── Encabezado de página ── *@
<div class="page-header mb-3">
    <MudText Typo="Typo.h5" Style="font-weight:800; color:#112F5B;">
        Reservas por cliente
    </MudText>
    <MudText Typo="Typo.body2" Style="color:#7A90AD; margin-top:2px;">
        Metrocar Nortur · viajes de transportación por cliente, mes y tipo de unidad
    </MudText>
</div>

@* ── Barra de filtros (horizontal, compacta) — mismo patrón que los otros informes de Reservas ── *@
<MudPaper Elevation="1" Class="rfs-filtros mb-4">
    <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="MudSize.Small" Style="color:#003AA0; flex-shrink:0;" />

    <div class="rfs-fechas">
        <MudDatePicker Label="Desde" @bind-Date="_desde"
                       MinDate="_min" MaxDate="_max" DateFormat="dd/MM/yyyy"
                       PickerVariant="PickerVariant.Dialog" Editable="true"
                       Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:160px;" />
        <MudDatePicker Label="Hasta" @bind-Date="_hasta"
                       MinDate="_min" MaxDate="_max" DateFormat="dd/MM/yyyy"
                       PickerVariant="PickerVariant.Dialog" Editable="true"
                       Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:160px;" />
    </div>

    @* Ver: reservas activas (no canceladas) o análisis de canceladas. A diferencia del
       FoxPro, el modo canceladas SIEMPRE respeta el período y deja elegir los motivos. *@
    <MudSelect T="string" Label="Ver" @bind-Value="_verSel" Dense="true"
               Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:170px;">
        <MudSelectItem T="string" Value="@("Activas")">Reservas activas</MudSelectItem>
        <MudSelectItem T="string" Value="@("Canceladas")">Canceladas</MudSelectItem>
    </MudSelect>

    @if (_verSel == "Canceladas")
    {
        <MudSelect T="int" Label="Motivos" MultiSelection="true" @bind-SelectedValues="_motivosSel"
                   SelectAll="true" SelectAllText="Todos" Dense="true"
                   Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:230px;"
                   MultiSelectionTextFunc="@(s => s.Count == _motivos.Count ? "Todos" : $"{s.Count} de {_motivos.Count}")">
            @foreach (var m in _motivos)
            {
                <MudSelectItem T="int" Value="@m.Id">@m.Motivo</MudSelectItem>
            }
        </MudSelect>
    }

    @* Internos: suma el cliente interno NORTUR (parametro.id_cliente — guardias y traslados
       internos, ~30% del volumen acá). Excluido por defecto, como en los otros informes. *@
    <MudSwitch T="bool" @bind-Value="_internos" Color="MudColor.Primary" Size="MudSize.Small"
               Label="Internos" LabelPlacement="Placement.End" Style="flex-shrink:0;" />

    <div class="rfs-metrica">
        <MudRadioGroup T="string" Value="_metrica" ValueChanged="CambiarMetrica">
            <MudRadio T="string" Value="@("Reservas")" Color="MudColor.Primary" Size="MudSize.Small" Dense="true">Viajes</MudRadio>
            <MudRadio T="string" Value="@("Pax")" Color="MudColor.Primary" Size="MudSize.Small" Dense="true">Pax</MudRadio>
        </MudRadioGroup>
    </div>

    @* Comparación mes contra mes: contra qué mes comparar cada mes (recálculo en memoria).
       "Interanual" solo tiene números si el período abarca también el año anterior. *@
    <MudSelect T="string" Label="Comparar" @bind-Value="_comparar" Dense="true"
               Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:170px;">
        <MudSelectItem T="string" Value="@("M1")">vs mes anterior</MudSelectItem>
        <MudSelectItem T="string" Value="@("N")">vs N meses atrás</MudSelectItem>
        <MudSelectItem T="string" Value="@("YoY")">vs año pasado</MudSelectItem>
    </MudSelect>

    @if (_comparar == "N")
    {
        <MudSelect T="int" Label="Salto" @bind-Value="_saltoN" Dense="true"
                   Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:120px;">
            <MudSelectItem T="int" Value="2">2 meses</MudSelectItem>
            <MudSelectItem T="int" Value="3">3 meses</MudSelectItem>
            <MudSelectItem T="int" Value="4">4 meses</MudSelectItem>
            <MudSelectItem T="int" Value="6">6 meses</MudSelectItem>
        </MudSelect>
    }

    @* Variación: cambia toda la grilla a modo Δ (cada celda vs su mes base). En memoria. *@
    <MudSwitch T="bool" @bind-Value="_verVariacion" Color="MudColor.Primary" Size="MudSize.Small"
               Label="Variación" LabelPlacement="Placement.End" Style="flex-shrink:0;" />

    <span style="flex:1 1 auto;"></span>

    <MudButton Variant="Variant.Filled" Color="MudColor.Primary"
               OnClick="Cargar" Disabled="_cargando" StartIcon="@Icons.Material.Filled.Search"
               Style="border-radius:8px; height:40px; text-transform:none; flex-shrink:0;">
        @(_cargando ? "Cargando..." : "Aplicar filtros")
    </MudButton>
</MudPaper>

@if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Color="MudColor.Primary" Class="mb-4" Style="border-radius:4px;" />
}
else if (_filas.Count == 0)
{
    <MudAlert Severity="Severity.Warning" Style="border-radius:12px;">No hay viajes para los filtros seleccionados.</MudAlert>
}
else
{
    @* ── KPIs ── con foco activo se recalculan al subconjunto enfocado (cross-filter) *@
    <div class="rfs-kpis mb-3">
        <KpiCard Label="@(_metrica == "Pax" ? "Total pax" : "Total viajes")" Value="@Fmt(_totalMetrica)"
                 Sub="@($"prom. {Fmt(_promedioMensual)} {UnidadMetrica}/mes")" Color="@NorturColors.Azul" />
        <KpiCard Label="Clientes con actividad" Value="@_clientesActivos.ToString()" Sub="en el período" Color="@NorturColors.Verde" />
        <KpiCard Label="Cliente líder" Value="@_clienteLider"
                 Sub="@($"{Fmt(_maxCliente)} {UnidadMetrica}")" Color="@NorturColors.Naranja" />
        <KpiCard Label="Contratados" Value="@Fmt(_totalContratado)"
                 Sub="@($"{_pctContratado}% del total")" Color="@NorturColors.Rojo" />
    </div>

    <div @key="_chartsKey">
        @* ── Barras apiladas mes × tipo (evolución mensual) ── *@
        <MudPaper Class="pa-4 mb-3" Elevation="1" Style="border-radius:14px;">
            @CabeceraFoco($"{(_metrica == "Pax" ? "Pax" : "Viajes")} por mes y tipo de unidad")
            <ApexChart TItem="ChartItem" Options="_optsBarMes" Height="320" @ref="_barMesChart"
                       OnDataPointSelection="OnBarMesSelection" OnLegendClicked="OnBarMesLegendClicked">
                @foreach (var tipo in _tiposPresentes)
                {
                    var t = tipo;
                    <ApexPointSeries TItem="ChartItem"
                                     Items="_chartData.Where(x => x.Tipo == t).ToList()"
                                     Name="@t"
                                     SeriesType="SeriesType.Bar"
                                     XValue="@(x => x.Mes)"
                                     YValue="@(x => x.Valor)" />
                }
            </ApexChart>
        </MudPaper>

        @* ── Ranking de clientes + donut por tipo ── *@
        <MudGrid Spacing="3" Class="mb-3" Style="align-items:stretch;">
            <MudItem xs="12" md="7" Style="display:flex; flex-direction:column;">
                <MudPaper Class="pa-4" Elevation="1" Style="border-radius:14px; flex:1;">
                    <div class="rfs-bar-head mb-2">
                        <div class="rfs-bar-title">
                            <MudText Typo="Typo.subtitle2" Style="font-weight:700; color:#112F5B;">@($"{(_metrica == "Pax" ? "Pax" : "Viajes")} por cliente — {TituloTopN}")</MudText>
                            <MudSelect T="int" Value="_topN" ValueChanged="CambiarTopN"
                                       Label="Mostrar" Dense="true" Margin="Margin.Dense"
                                       Variant="Variant.Outlined" Class="rfs-topn-select">
                                <MudSelectItem T="int" Value="10">Top 10</MudSelectItem>
                                <MudSelectItem T="int" Value="15">Top 15</MudSelectItem>
                                <MudSelectItem T="int" Value="20">Top 20</MudSelectItem>
                                <MudSelectItem T="int" Value="999">Todos (@_rankingClientes.Count)</MudSelectItem>
                            </MudSelect>
                        </div>
                        @ChipsFoco
                    </div>
                    <ApexChart TItem="BarItem" Options="_optsBarCli" Height="@_altoBarras" @ref="_barCliChart"
                               OnDataPointSelection="OnBarCliSelection">
                        <ApexPointSeries TItem="BarItem"
                                         Items="_barItems"
                                         Name="@_metrica"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(x => x.Cliente)"
                                         YValue="@(x => x.Valor)" />
                    </ApexChart>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="5" Style="display:flex; flex-direction:column;">
                <MudPaper Class="pa-4" Elevation="1" Style="border-radius:14px; flex:1;">
                    @CabeceraFoco("Distribución por tipo de unidad")
                    <ApexChart TItem="DonutItem" Options="_optsPieTipo" Height="320" @ref="_pieTipoChart"
                               OnDataPointSelection="OnPieTipoSelection" OnLegendClicked="OnPieTipoLegendClicked">
                        <ApexPointSeries TItem="DonutItem"
                                         Items="_donutTipo"
                                         Name="@UnidadMetrica"
                                         SeriesType="SeriesType.Donut"
                                         XValue="@(x => x.Label)"
                                         YValue="@(x => x.Valor)" />
                    </ApexChart>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </div>

    @* ── Tabla pivote cliente × mes ── *@
    <MudPaper Class="pa-4" Elevation="1" Style="border-radius:14px;">
        <div class="d-flex justify-space-between align-center flex-wrap mb-3" style="gap:8px;">
            <div>
                <MudText Typo="Typo.subtitle2" Style="font-weight:700; color:#112F5B;">
                    Detalle: @(_metrica == "Pax" ? "pax" : "viajes") por cliente y mes
                    @if (_verVariacion)
                    {
                        <span style="color:#8FA3BC; font-weight:600;">· variación vs @BaseLbl</span>
                    }
                </MudText>
                <MudText Typo="Typo.caption" Style="color:#8FA3BC;">
                    @if (_verVariacion)
                    {
                        @:Cada celda muestra el Δ vs @BaseLbl (verde sube · rojo baja) · la columna Tendencia resume el último mes
                    }
                    else
                    {
                        @:Click en una celda para ver los viajes uno por uno · click en el nombre de un cliente para enfocar el tablero
                    }
                </MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="MudColor.Success"
                       StartIcon="@Icons.Material.Filled.Download"
                       OnClick="DescargarExcel" Disabled="_cargandoDet"
                       Style="border-radius:8px; text-transform:none;">
                Descargar Excel
            </MudButton>
        </div>
        @if (_cargandoDet)
        {
            <MudProgressLinear Indeterminate="true" Color="MudColor.Primary" Class="mb-2" Style="border-radius:4px;" />
        }
        <div class="rfs-tabla-wrap">
            <table class="rfs-tabla">
                <thead>
                    <tr>
                        <th class="rfs-col-fecha" style="min-width:220px;">Cliente</th>
                        @foreach (var m in _pivMeses)
                        {
                            <th class="rfs-th-serv">@FmtMes(m)</th>
                        }
                        <th class="rfs-th-total">TOTAL</th>
                        <th class="rfs-th-tend" title="@($"Δ del último mes ({FmtMes(UltimoMes)}) vs {BaseLbl} + evolución")">TENDENCIA</th>
                    </tr>
                </thead>
                <tbody>
                    @* Virtualize: pueden ser cientos de clientes (regla de performance). *@
                    <Virtualize Items="_pivClientes" Context="cli" ItemSize="30" OverscanCount="12" SpacerElement="tr">
                        <tr>
                            @{ var atenua = _clienteFocus is not null && !EnFocoCliente(cli) ? "rfs-atenua" : ""; }
                            <td class="rfs-col-fecha rfs-click @(EnFocoCliente(cli) && _clienteFocus is not null ? "rfs-col-foco" : "") @atenua"
                                style="max-width:280px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                title="Clic para enfocar el tablero en @NombreDe(cli)"
                                @onclick="() => ToggleFocoCliente(cli)">@NombreDe(cli)</td>
                            @foreach (var m in _pivMeses)
                            {
                                var mes = m;
                                var v = PivVal(cli, mes);
                                if (!_verVariacion)
                                {
                                    @* Modo cantidad (default) *@
                                    if (v > 0)
                                    {
                                        <td class="rfs-num rfs-click @atenua" title="Ver viajes de @NombreDe(cli) en @FmtMes(mes)"
                                            @onclick="() => AbrirDetalleCelda(cli, mes)">@Fmt(v)</td>
                                    }
                                    else
                                    {
                                        <td class="rfs-num rfs-cero @atenua">·</td>
                                    }
                                }
                                else
                                {
                                    @* Modo variación: Δ vs mes base, con color. Sin base → "·" *@
                                    var d = PivVar(cli, mes);
                                    if (d is null)
                                    {
                                        <td class="rfs-num rfs-cero @atenua">·</td>
                                    }
                                    else if (v > 0 || d.Value != 0)
                                    {
                                        <td class="rfs-num rfs-var rfs-click @ClaseVar(d) @atenua"
                                            title="@($"{NombreDe(cli)} · {FmtMes(mes)}: {Fmt(v)} (vs {BaseLbl})")"
                                            @onclick="() => AbrirDetalleCelda(cli, mes)">@FmtVar(d)</td>
                                    }
                                    else
                                    {
                                        <td class="rfs-num rfs-cero @atenua">·</td>
                                    }
                                }
                            }
                            <td class="rfs-num rfs-tot rfs-click @atenua" title="Ver todos los viajes de @NombreDe(cli)"
                                @onclick="() => AbrirDetalleCliente(cli)">@Fmt(PivTotFila(cli))</td>
                            @{ var (td, tp) = TendenciaCliente(cli); }
                            <td class="rfs-tend @atenua">
                                <div class="rfs-tend-wrap">
                                    <span class="rfs-tend-delta @ClaseVar(td)" title="@($"{FmtMes(UltimoMes)} vs {BaseLbl}")">
                                        @if (td is not null && td.Value != 0)
                                        {
                                            <span class="rfs-tend-arrow">@(td.Value > 0 ? "▲" : "▼")</span>
                                        }
                                        <span>@FmtVar(td)</span>
                                        @if (tp is not null)
                                        {
                                            <span class="rfs-tend-pct">@FmtPct(tp)</span>
                                        }
                                    </span>
                                    @Sparkline(mes => PivVal(cli, mes))
                                </div>
                            </td>
                        </tr>
                    </Virtualize>
                </tbody>
                <tfoot>
                    <tr>
                        <td class="rfs-col-fecha rfs-tot">TOTAL</td>
                        @foreach (var m in _pivMeses)
                        {
                            var mes = m;
                            if (!_verVariacion)
                            {
                                <td class="rfs-num rfs-tot rfs-click" title="Ver todos los viajes de @FmtMes(mes)"
                                    @onclick="() => AbrirDetalleMes(mes)">@Fmt(PivTotCol(mes))</td>
                            }
                            else
                            {
                                var d = PivVarTotCol(mes);
                                <td class="rfs-num rfs-tot rfs-var rfs-click @ClaseVar(d)"
                                    title="@($"Total {FmtMes(mes)}: {Fmt(PivTotCol(mes))} (vs {BaseLbl})")"
                                    @onclick="() => AbrirDetalleMes(mes)">@FmtVar(d)</td>
                            }
                        }
                        <td class="rfs-num rfs-tot rfs-grantot">@Fmt(_granTotal)</td>
                        @{ var dTot = PivVarTotCol(UltimoMes); }
                        <td class="rfs-tend rfs-tot">
                            <div class="rfs-tend-wrap">
                                <span class="rfs-tend-delta @ClaseVar(dTot)" title="@($"Total {FmtMes(UltimoMes)} vs {BaseLbl}")">
                                    @if (dTot is not null && dTot.Value != 0)
                                    {
                                        <span class="rfs-tend-arrow">@(dTot.Value > 0 ? "▲" : "▼")</span>
                                    }
                                    <span>@FmtVar(dTot)</span>
                                </span>
                                @Sparkline(mes => PivTotCol(mes))
                            </div>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </MudPaper>
}

@code {
    private readonly DateTime _min = ReportService.FechaMinValida.ToDateTime(TimeOnly.MinValue);
    private readonly DateTime _max = ReportService.FechaMaxValida.ToDateTime(TimeOnly.MinValue);

    // ── Filtros en edición ──
    // Default: los últimos 6 meses calendario (el pivote tiene columnas mensuales).
    private DateTime? _desde = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-5);
    private DateTime? _hasta = DateTime.Today;
    private string _verSel = "Activas";                 // "Activas" | "Canceladas"
    private List<MotivoCancelaDto> _motivos = new();
    private IReadOnlyCollection<int> _motivosSel = new HashSet<int>();
    private bool _internos;                             // default: cliente interno NORTUR excluido
    private string _metrica = "Reservas";               // "Reservas" (viajes) | "Pax"

    // ── Comparación mes contra mes (en memoria, sin re-query) ──
    // El usuario elige contra qué mes comparar cada mes: el anterior, N meses atrás, o el
    // mismo mes del año pasado. Con "Variación" tildado la tabla muestra el Δ en cada celda
    // en vez de la cantidad; la columna "Tendencia" (siempre visible) resume el último mes.
    private string _comparar = "M1";     // "M1" (mes anterior) | "N" (N meses atrás) | "YoY" (interanual)
    private int _saltoN = 2;             // salto en meses cuando _comparar == "N"
    private bool _verVariacion;          // false = cantidades (default), true = Δ en cada celda

    // ── Foco / cross-filter (estilo Power BI) — DOS dimensiones combinables ──
    // Cliente AND tipo de unidad, como banda × vehículo en el informe de banda horaria.
    // El foco de una dimensión RESALTA en sus propios visuales y FILTRA los de la otra,
    // los KPIs y la tabla. Todo en memoria, sin re-query. null = sin foco.
    private string? _clienteFocus;   // IdCliente (clave estable; el nombre puede repetirse)
    private string? _tipoFocus;
    private bool EnFocoCliente(string idCli) => _clienteFocus is null || _clienteFocus == idCli;

    // ── Filtros APLICADOS (snapshot al tocar "Aplicar") ──
    private DateOnly _fDesdeAp, _fHastaAp;
    private bool _internosAp;
    private bool _canceladasAp;
    private List<int> _motAp = new();

    private List<ReservaClienteRow> _filas = new();
    private List<ReservaClienteDetalleRow>? _detalle;   // lazy: se trae al primer drill-down/Excel
    private bool _cargando;
    private bool _cargandoDet;
    private Guid _chartsKey = Guid.NewGuid();

    private static readonly IReadOnlyList<string> _tipos = ReportService.TiposReservaCliente;

    // KPIs
    private int _totalMetrica;
    private int _promedioMensual;
    private int _clientesActivos;
    private string _clienteLider = "—";
    private int _maxCliente;
    private int _totalContratado;
    private int _pctContratado;
    private string UnidadMetrica => _metrica == "Pax" ? "pax" : "viajes";

    // ── Gráficos ApexCharts ──
    private record ChartItem(string Mes, string Tipo, decimal Valor);
    private record BarItem(string IdCliente, string Cliente, decimal Valor);
    private record DonutItem(string Label, decimal Valor);
    private List<ChartItem> _chartData = new();
    private List<string> _tiposPresentes = new();
    private List<BarItem> _barItems = new();
    private List<DonutItem> _donutTipo = new();

    private ApexChart<ChartItem>? _barMesChart;
    private ApexChart<BarItem>? _barCliChart;
    private ApexChart<DonutItem>? _pieTipoChart;

    // Color fijo por tipo de unidad (3 categorías, semántica estable en todo el informe):
    // PROPIO azul, CONTRATADO naranja, SIN REALIZAR gris (todavía sin unidad asignada).
    private static readonly Dictionary<string, string> _colorTipo = new()
    {
        ["PROPIO"] = "#2058D0",
        ["CONTRATADO"] = "#F99410",
        ["SIN REALIZAR"] = "#94A3B8",
    };
    private static string ColorTipo(string tipo) => _colorTipo.TryGetValue(tipo, out var c) ? c : "#94A3B8";

    // Paleta categórica de 15 hues para el ranking de clientes (la misma del informe de
    // fecha/servicio, validada con dataviz) + gris para los que caen fuera del top 15.
    private static readonly List<string> _paletteCli = new()
    {
        "#2058D0", "#F99410", "#16A34A", "#DC2626", "#0EA5E9",
        "#7C3AED", "#B45309", "#DB2777", "#0D9488", "#65A30D",
        "#4F46E5", "#EA580C", "#059669", "#9333EA", "#0891B2"
    };
    private const string _colorOtros = "#94A3B8";

    // Mapa cliente → color por ranking del dataset COMPLETO (color y orden estables: no
    // cambian al enfocar). Color por entidad, no por posición (regla dataviz).
    private Dictionary<string, string> _colorPorCliente = new();
    private Dictionary<string, string> _nombrePorCliente = new();
    private string ColorCli(string idCli) => _colorPorCliente.TryGetValue(idCli, out var c) ? c : _colorOtros;
    private string NombreDe(string idCli) => _nombrePorCliente.TryGetValue(idCli, out var n) ? n : idCli;

    // Color ATENUADO (gris claro) si hay foco en esa dimensión y no es la categoría enfocada.
    private string ColorFocoCli(string idCli) =>
        (_clienteFocus is null || idCli == _clienteFocus) ? ColorCli(idCli) : "#D9E1EC";
    private string ColorFocoTipo(string tipo) =>
        (_tipoFocus is null || tipo == _tipoFocus) ? ColorTipo(tipo) : "#D9E1EC";

    // Cuántos clientes muestra el gráfico de barras (selector "Mostrar"). Default Top 10
    // (pedido por el usuario, 13/07/2026); el usuario puede subir a 15/20/Todos.
    private int _topN = 10;
    private List<(string Id, string Nombre, int Total)> _rankingClientes = new();
    private string TituloTopN => _topN >= 999
        ? $"todos ({_barItems.Count})"
        : $"top {Math.Min(_topN, _barItems.Count)}";
    private int _altoBarras = 360;

    // Chips de foco (o hint) — a la derecha del título de cada panel de gráfico. La ✕ de
    // cualquier chip limpia ESE foco en todo el tablero.
    private RenderFragment ChipsFoco => __builder =>
    {
        @if (_clienteFocus is not null || _tipoFocus is not null)
        {
            <div style="display:inline-flex; align-items:center; gap:6px; flex-wrap:wrap;">
                @if (_clienteFocus is not null)
                {
                    <div class="rfs-focus">
                        <span class="rfs-focus__lbl">Cliente:</span>
                        <span class="rfs-focus__val" style="@($"background:{ColorCli(_clienteFocus)};")">@NombreDe(_clienteFocus)</span>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="MudSize.Small"
                                       OnClick="LimpiarFocoCliente" Title="Quitar filtro de cliente"
                                       Style="color:#64748B; padding:2px;" />
                    </div>
                }
                @if (_tipoFocus is not null)
                {
                    <div class="rfs-focus">
                        <span class="rfs-focus__lbl">Tipo:</span>
