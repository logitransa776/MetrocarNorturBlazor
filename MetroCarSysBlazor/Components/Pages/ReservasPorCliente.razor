    private async Task OnPieTipoLegendClicked(LegendClicked<DonutItem> e)
    {
        var tipo = e.DataPoint?.Items?.FirstOrDefault()?.Label;
        if (tipo is not null) await ToggleFocoTipo(tipo);
    }

    // ── Drill-down: los viajes uno por uno detrás del número ──

    private async Task<List<ReservaClienteDetalleRow>> GetDetalleAsync()
    {
        if (_detalle is null)
        {
            _cargandoDet = true;
            StateHasChanged();
            _detalle = await Reports.GetReservasPorClienteDetalleAsync(_fDesdeAp, _fHastaAp, _internosAp, _canceladasAp, _motAp);
            _cargandoDet = false;
        }
        return _detalle;
    }

    // Los drills respetan el foco activo: el número visible corresponde al subconjunto
    // enfocado y el detalle tiene que mostrar EXACTAMENTE esos viajes.
    private bool PasaFocoTipo(ReservaClienteDetalleRow d) => _tipoFocus is null || d.Tipo == _tipoFocus;
    private bool PasaFocoCliente(ReservaClienteDetalleRow d) => _clienteFocus is null || d.IdCliente == _clienteFocus;
    private string SufijoFocoTipo => _tipoFocus is null ? "" : $" · {_tipoFocus}";

    private Task AbrirDetalleCelda(string idCli, string mes) =>
        AbrirDetalle(d => d.IdCliente == idCli && d.Mes == mes && PasaFocoTipo(d),
                     $"{NombreDe(idCli)} — {FmtMes(mes)}{SufijoFocoTipo}");

    private Task AbrirDetalleCliente(string idCli) =>
        AbrirDetalle(d => d.IdCliente == idCli && PasaFocoTipo(d),
                     $"{NombreDe(idCli)} — todo el período{SufijoFocoTipo}");

    private Task AbrirDetalleMes(string mes) =>
        AbrirDetalle(d => d.Mes == mes && PasaFocoCliente(d) && PasaFocoTipo(d),
                     $"{(_clienteFocus is null ? "Todos los clientes" : NombreDe(_clienteFocus))} — {FmtMes(mes)}{SufijoFocoTipo}");

    private async Task AbrirDetalle(Func<ReservaClienteDetalleRow, bool> filtro, string subtitulo)
    {
        var todas = await GetDetalleAsync();
        var items = todas.Where(filtro).Select(d => d.Reserva).ToList();
        if (items.Count == 0) return;

        var parametros = new DialogParameters<ReservasFsDetalleDialog>
        {
            { x => x.Items, items },
            { x => x.Subtitulo, subtitulo }
        };
        var opciones = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseButton = false,
            CloseOnEscapeKey = true,
            BackdropClick = true
        };
        await DialogService.ShowAsync<ReservasFsDetalleDialog>("Detalle de viajes", parametros, opciones);
    }

    private async Task DescargarExcel()
    {
        var viajes = await GetDetalleAsync();
        var bytes = Excel.ReservasPorCliente(_filas, _metrica, viajes);
        var nombre = $"reservas_por_cliente_{_fDesdeAp:yyyyMMdd}_{_fHastaAp:yyyyMMdd}.xlsx";
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("descargarArchivo", nombre, streamRef);
    }

    private static string Fmt(int n) => n.ToString("#,0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));
}
