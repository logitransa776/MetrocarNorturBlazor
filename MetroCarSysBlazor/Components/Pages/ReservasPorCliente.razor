@page "/reservas-por-cliente"
@using ApexCharts
@using MudColor = MudBlazor.Color
@using MudSize = MudBlazor.Size
@inject ReportService Reports
@inject ExcelExportService Excel
@inject NorturAuthStateProvider AuthState
@inject IPermissionService Permisos
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<PageTitle>BusLink</PageTitle>

@* ── Encabezado de página ── *@
<div class="page-header mb-3">
    <MudText Typo="Typo.h5" Style="font-weight:800; color:#112F5B;">
        Reservas por cliente
    </MudText>
    <MudText Typo="Typo.body2" Style="color:#7A90AD; margin-top:2px;">
        Nortur · viajes por cliente y mes, con comparación de períodos y análisis de cancelaciones
    </MudText>
</div>

@* ── Barra de filtros (horizontal, compacta) — filtros a la izquierda, botonera a la derecha ── *@
<MudPaper Elevation="1" Class="rfs-filtros rfs-filtros--fijo mb-4">
    <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="MudSize.Small" Style="color:#003AA0; flex-shrink:0;" />

    <div class="rfs-fechas">
        <MudDatePicker Label="Desde" @bind-Date="_desde"
                       MinDate="_min" MaxDate="_max" DateFormat="dd/MM/yyyy"
                       PickerVariant="PickerVariant.Dialog" Editable="true"
                       Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:160px;" />
        <MudDatePicker Label="Hasta" @bind-Date="_hasta"
                       MinDate="_min" MaxDate="_max" DateFormat="dd/MM/yyyy"
                       PickerVariant="PickerVariant.Dialog" Editable="true"
                       Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:160px;" />
    </div>

    @* Tipo de servicio: mismas 3 categorías que Banda Horaria. Solo Turismo tildado por
       defecto = el alcance histórico del informe (los números no se mueven). *@
    <div class="rfs-campo" style="width:190px;">
        <MudSelect T="string" Label="Tipo de servicio" MultiSelection="true" @bind-SelectedValues="_categoriasSel"
                   SelectAll="true" SelectAllText="Todos" Dense="true"
                   Margin="Margin.Dense" Variant="Variant.Outlined"
                   MultiSelectionTextFunc="@(s => s.Count == _categorias.Count ? "Todos" : string.Join(", ", s))">
            @foreach (var c in _categorias)
            {
                <MudSelectItem T="string" Value="@c">@c</MudSelectItem>
            }
        </MudSelect>
    </div>

    @* Ver: reservas activas (no canceladas) o análisis de canceladas. A diferencia del
       FoxPro, el modo canceladas SIEMPRE respeta el período y deja elegir los motivos. *@
    <div class="rfs-campo" style="width:170px;">
        <MudSelect T="string" Label="Ver" @bind-Value="_verSel" Dense="true"
                   Margin="Margin.Dense" Variant="Variant.Outlined">
            <MudSelectItem T="string" Value="@("Activas")">Reservas activas</MudSelectItem>
            <MudSelectItem T="string" Value="@("Canceladas")">Canceladas</MudSelectItem>
        </MudSelect>
    </div>

    @if (_verSel == "Canceladas")
    {
        <div class="rfs-campo" style="width:200px;">
            <MudSelect T="int" Label="Motivos" MultiSelection="true" @bind-SelectedValues="_motivosSel"
                       SelectAll="true" SelectAllText="Todos" Dense="true"
                       Margin="Margin.Dense" Variant="Variant.Outlined"
                       MultiSelectionTextFunc="@(s => s.Count == _motivos.Count ? "Todos" : $"{s.Count} de {_motivos.Count}")">
                @foreach (var m in _motivos)
                {
                    <MudSelectItem T="int" Value="@m.Id">@m.Motivo</MudSelectItem>
                }
            </MudSelect>
        </div>
    }

    <div class="rfs-metrica">
        <MudRadioGroup T="string" Value="_metrica" ValueChanged="CambiarMetrica">
            <MudRadio T="string" Value="@("Reservas")" Color="MudColor.Primary" Size="MudSize.Small" Dense="true">Viajes</MudRadio>
            <MudRadio T="string" Value="@("Pax")" Color="MudColor.Primary" Size="MudSize.Small" Dense="true">Pax</MudRadio>
        </MudRadioGroup>
    </div>

    @* Comparación de períodos: define un PERÍODO BASE que se trae de la base con una segunda
       consulta (antes se calculaba solo con los meses ya cargados y por eso el interanual
       quedaba vacío). Alimenta los KPIs, el gráfico mensual y la tabla a la vez. *@
    <div class="rfs-campo" style="width:225px;">
        <MudSelect T="string" Label="Comparar con" @bind-Value="_comparar" Dense="true"
                   Margin="Margin.Dense" Variant="Variant.Outlined">
            <MudSelectItem T="string" Value="@(CompNo)">Sin comparación</MudSelectItem>
            <MudSelectItem T="string" Value="@(CompMesAnterior)">Mes anterior</MudSelectItem>
            <MudSelectItem T="string" Value="@(CompAnioAnterior)">Mismo mes del año anterior</MudSelectItem>
        </MudSelect>
    </div>

    <span style="flex:1 1 auto;"></span>

    <div style="display:flex; gap:6px; flex-shrink:0;">
        <MudButton Variant="Variant.Filled" Color="MudColor.Primary"
                   OnClick="Cargar" Disabled="_cargando" StartIcon="@Icons.Material.Filled.Search"
                   Style="border-radius:8px; height:40px; text-transform:none;">
            @(_cargando ? "Cargando..." : "Aplicar filtros")
        </MudButton>
    </div>
</MudPaper>

@if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Color="MudColor.Primary" Class="mb-4" Style="border-radius:4px;" />
}
else if (_filas.Count == 0)
{
    <MudAlert Severity="Severity.Warning" Style="border-radius:12px;">No hay viajes para los filtros seleccionados.</MudAlert>
}
else
{
    @* ── KPIs ── con foco activo se recalculan al subconjunto enfocado (cross-filter).
       En modo Canceladas cambian de identidad: lo que importa ahí es la TASA y el motivo. *@
    <div class="rfs-kpis mb-3">
        @if (!ModoCancel)
        {
            <KpiCard Label="@(_metrica == "Pax" ? "Total pax" : "Total viajes")" Value="@Fmt(_totalMetrica)"
                     Sub="@SubTotal" Color="@NorturColors.Azul"
                     Delta="@DeltaTxt(_totalMetrica, _totalBase)" DeltaClase="@DeltaCls(_totalMetrica, _totalBase)"
                     Title="@TituloComparacion(_totalMetrica, _totalBase)" />
            <KpiCard Label="Clientes activos" Value="@_clientesActivos.ToString()"
                     Sub="@(HayComparacion ? $"vs {_clientesActivosBase}" : "en el período")"
                     Color="@NorturColors.Verde"
                     Delta="@DeltaTxt(_clientesActivos, _clientesActivosBase)" DeltaClase="@DeltaCls(_clientesActivos, _clientesActivosBase)"
                     Title="@TituloComparacion(_clientesActivos, _clientesActivosBase)" />
            <KpiCard Label="Cliente líder" Value="@_clienteLider"
                     Sub="@($"{Fmt(_maxCliente)} {UnidadMetrica}")" Color="@NorturColors.Naranja"
                     Title="@_clienteLider" />
            <KpiCard Label="Contratados" Value="@Fmt(_totalContratado)"
                     Sub="@($"{_pctContratado}% · ver detalle")" Color="@NorturColors.Rojo"
                     Delta="@DeltaTxt(_totalContratado, _totalContratadoBase)" DeltaClase="@DeltaCls(_totalContratado, _totalContratadoBase)"
                     OnClick="@(() => AbrirComposicionTipo("CONTRATADO"))"
                     Title="Clic para ver de qué unidades y clientes está hecho este número" />
        }
        else
        {
            <KpiCard Label="@(_metrica == "Pax" ? "Pax cancelados" : "Canceladas")" Value="@Fmt(_totalMetrica)"
                     Sub="@SubTotal" Color="@NorturColors.Rojo"
                     Delta="@DeltaTxt(_totalMetrica, _totalBase)" DeltaClase="@DeltaClsInverso(_totalMetrica, _totalBase)"
                     Title="@TituloComparacion(_totalMetrica, _totalBase)" />
            <KpiCard Label="Tasa cancelación" Value="@($"{_tasaCancel:0.0}%")"
                     Sub="@($"de {Fmt(_totalPeriodo)} reservas")" Color="@NorturColors.Naranja"
                     Delta="@DeltaPctTxt(_tasaCancel, _tasaCancelBase)" DeltaClase="@DeltaClsInverso(_tasaCancel, _tasaCancelBase)"
                     Title="@($"Canceladas / (canceladas + activas) del mismo período y tipo de servicio{(HayComparacion ? $" · {BaseLbl}: {_tasaCancelBase:0.0}%" : "")}")" />
            @* Los nombres de motivo son larguísimos ("CANCELADO POR CLIENTE") y reventaban la
               tarjeta: se muestra el sufijo, con el nombre completo en el tooltip. *@
            <KpiCard Label="Motivo principal" Value="@MotivoCorto(_motivoLider)"
                     Sub="@($"{Fmt(_maxMotivo)} de {Fmt(_totalMetrica)}")" Color="@NorturColors.Azul"
                     OnClick="@(() => AbrirDetalleDim2(_motivoLider))"
                     Title="@($"{_motivoLider} — clic para ver esas reservas")" />
            <KpiCard Label="Más cancela" Value="@_clienteLider"
                     Sub="@($"{Fmt(_maxCliente)} {UnidadMetrica}")" Color="@NorturColors.Verde"
                     Title="@($"Cliente con más cancelaciones: {_clienteLider}")" />
        }
    </div>

    <div @key="_chartsKey">
        @* ── Evolución mensual ──
           Sin comparación: barras APILADAS por la 2ª dimensión (composición del mes).
           Con comparación: barras AGRUPADAS período vs período base — la lectura "X vs X-1"
           que pidió la clienta, imposible de leer en un apilado. *@
        <MudPaper Class="pa-4 mb-3" Elevation="1" Style="border-radius:14px;">
            @CabeceraFoco(HayComparacion
                ? $"{UnidadMetricaTit} por mes — período vs {BaseLbl}"
                : $"{UnidadMetricaTit} por mes y {Dim2Label.ToLowerInvariant()}")
            <ApexChart TItem="ChartItem" Options="_optsBarMes" Height="320" @ref="_barMesChart"
                       OnDataPointSelection="OnBarMesSelection" OnLegendClicked="OnBarMesLegendClicked">
                @foreach (var serie in _seriesMes)
                {
                    var s = serie;
                    <ApexPointSeries TItem="ChartItem"
                                     Items="_chartData.Where(x => x.Serie == s).ToList()"
                                     Name="@s"
                                     SeriesType="SeriesType.Bar"
                                     XValue="@(x => x.Mes)"
                                     YValue="@(x => x.Valor)" />
                }
            </ApexChart>
        </MudPaper>

        @* ── Ranking de clientes + composición de la 2ª dimensión ── *@
        <MudGrid Spacing="3" Class="mb-3" Style="align-items:stretch;">
            <MudItem xs="12" md="7" Style="display:flex; flex-direction:column;">
                <MudPaper Class="pa-4" Elevation="1" Style="border-radius:14px; flex:1;">
                    <div class="rfs-bar-head mb-2">
                        <div class="rfs-bar-title">
                            <MudText Typo="Typo.subtitle2" Style="font-weight:700; color:#112F5B;">@($"{UnidadMetricaTit} por cliente — {TituloTopN}")</MudText>
                            <MudSelect T="int" Value="_topN" ValueChanged="CambiarTopN"
                                       Label="Mostrar" Dense="true" Margin="Margin.Dense"
                                       Variant="Variant.Outlined" Class="rfs-topn-select">
                                <MudSelectItem T="int" Value="10">Top 10</MudSelectItem>
                                <MudSelectItem T="int" Value="15">Top 15</MudSelectItem>
                                <MudSelectItem T="int" Value="20">Top 20</MudSelectItem>
                                <MudSelectItem T="int" Value="999">Todos (@_rankingClientes.Count)</MudSelectItem>
                            </MudSelect>
                        </div>
                        @ChipsFoco
                    </div>
                    <ApexChart TItem="BarItem" Options="_optsBarCli" Height="@_altoBarras" @ref="_barCliChart"
                               OnDataPointSelection="OnBarCliSelection">
                        <ApexPointSeries TItem="BarItem"
                                         Items="_barItems"
                                         Name="@_metrica"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(x => x.Cliente)"
                                         YValue="@(x => x.Valor)" />
                    </ApexChart>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="5" Style="display:flex; flex-direction:column;">
                <MudPaper Class="pa-4" Elevation="1" Style="border-radius:14px; flex:1;">
                    <div class="rfs-bar-head mb-2">
                        <div class="rfs-bar-title">
                            <MudText Typo="Typo.subtitle2" Style="font-weight:700; color:#112F5B;">
                                @(ModoCancel ? "Cancelaciones por motivo" : "Distribución por tipo de unidad")
                            </MudText>
                            @if (!ModoCancel)
                            {
                                @* El criterio de "contratado" es una definición de negocio abierta: se elige
                                   acá, al lado del gráfico que clasifica, y recalcula en memoria. *@
                                <MudSelect T="string" Value="_criterio" ValueChanged="CambiarCriterio"
                                           Label="Criterio" Dense="true" Margin="Margin.Dense"
                                           Variant="Variant.Outlined" Class="rfs-topn-select" Style="width:190px;">
                                    <MudSelectItem T="string" Value="@ReportService.CriterioUso">Por uso del vehículo</MudSelectItem>
                                    <MudSelectItem T="string" Value="@ReportService.CriterioFletero">Por dueño (fletero)</MudSelectItem>
                                </MudSelect>
                            }
                        </div>
                        @ChipsFoco
                    </div>
                    <ApexChart TItem="DonutItem" Options="_optsPieDim2" Height="300" @ref="_pieDim2Chart"
                               OnDataPointSelection="OnPieDim2Selection" OnLegendClicked="OnPieDim2LegendClicked">
                        <ApexPointSeries TItem="DonutItem"
                                         Items="_donutDim2"
                                         Name="@UnidadMetrica"
                                         SeriesType="SeriesType.Donut"
                                         XValue="@(x => x.Label)"
                                         YValue="@(x => x.Valor)" />
                    </ApexChart>
                    @if (!ModoCancel)
                    {
                        <MudText Typo="Typo.caption" Style="color:#8FA3BC; display:block; margin-top:4px;">
                            @(_criterio == ReportService.CriterioFletero
                                ? "Contratado = la unidad pertenece a un fletero distinto de NORTUR."
                                : "Contratado = la ficha del vehículo tiene uso CONTRATADO.")
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </div>

    @* ── Tabla pivote cliente × (mes | motivo) ── *@
    <MudPaper Class="pa-4" Elevation="1" Style="border-radius:14px;">
        <div class="d-flex justify-space-between align-center flex-wrap mb-3" style="gap:8px;">
            <div>
                <MudText Typo="Typo.subtitle2" Style="font-weight:700; color:#112F5B;">
                    Detalle: @UnidadMetrica por cliente y @(EjeMotivo ? "motivo" : "mes")
                    @if (HayComparacion && !EjeMotivo)
                    {
                        <span style="color:#8FA3BC; font-weight:600;">· comparado con @BaseLbl</span>
                    }
                </MudText>
                <MudText Typo="Typo.caption" Style="color:#8FA3BC;">
                    Click en una celda para ver los viajes uno por uno · click en el nombre de un cliente para enfocar el tablero
                </MudText>
            </div>
            <div style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
                @if (ModoCancel)
                {
                    <MudSelect T="bool" Value="_ejeMotivo" ValueChanged="CambiarEje" Label="Columnas"
                               Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:130px;">
                        <MudSelectItem T="bool" Value="false">Por mes</MudSelectItem>
                        <MudSelectItem T="bool" Value="true">Por motivo</MudSelectItem>
                    </MudSelect>
                }
                @if (HayComparacion && !EjeMotivo)
                {
                    @* Reemplaza al viejo switch "Variación", que vivía arriba en la barra de filtros
                       y por eso parecía no hacer nada: su único efecto está acá abajo. *@
                    <MudSelect T="string" Value="_modoCelda" ValueChanged="CambiarModoCelda" Label="Mostrar"
                               Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:165px;">
                        <MudSelectItem T="string" Value="@CeldaCantidad">Cantidad</MudSelectItem>
                        <MudSelectItem T="string" Value="@CeldaVariacion">Variación</MudSelectItem>
                        <MudSelectItem T="string" Value="@CeldaAmbos">Cantidad y variación</MudSelectItem>
                    </MudSelect>
                }
                <MudButton Variant="Variant.Filled" Color="MudColor.Success"
                           StartIcon="@Icons.Material.Filled.Download"
                           OnClick="DescargarExcel" Disabled="_cargandoDet"
                           Style="border-radius:8px; text-transform:none; height:40px;">
                    Descargar Excel
                </MudButton>
            </div>
        </div>
        @if (_cargandoDet)
        {
            <MudProgressLinear Indeterminate="true" Color="MudColor.Primary" Class="mb-2" Style="border-radius:4px;" />
        }
        @* rfs-tabla-tend: habilita el sticky de la anteúltima columna (TOTAL) porque esta tabla
           lleva una columna extra a la derecha. Los demás pivotes NO la llevan (ver app.css). *@
        <div class="rfs-tabla-wrap">
            <table class="rfs-tabla rfs-tabla-tend @(HayComparacion ? "rfs-tabla-comp" : "")">
                <thead>
                    <tr>
                        <th class="rfs-col-fecha" style="min-width:220px;">Cliente</th>
                        @foreach (var c in _pivCols)
                        {
                            <th class="rfs-th-serv">@ColHeader(c)</th>
                        }
                        <th class="rfs-th-total">TOTAL</th>
                        <th class="rfs-th-tend" title="@ColCompTitulo">@ColCompHeader</th>
                    </tr>
                </thead>
                <tbody>
                    @* Virtualize: pueden ser cientos de clientes (regla de performance). *@
                    <Virtualize Items="_pivClientes" Context="cli" ItemSize="30" OverscanCount="12" SpacerElement="tr">
                        <tr>
                            @{ var atenua = _clienteFocus is not null && !EnFocoCliente(cli) ? "rfs-atenua" : ""; }
                            <td class="rfs-col-fecha rfs-click @(EnFocoCliente(cli) && _clienteFocus is not null ? "rfs-col-foco" : "") @atenua"
                                style="max-width:280px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                title="Clic para enfocar el tablero en @NombreDe(cli)"
                                @onclick="() => ToggleFocoCliente(cli)">@NombreDe(cli)</td>
                            @foreach (var c in _pivCols)
                            {
                                var col = c;
                                @CeldaPivote(cli, col, atenua)
                            }
                            <td class="rfs-num rfs-tot rfs-click @atenua" title="Ver todos los viajes de @NombreDe(cli)"
                                @onclick="() => AbrirDetalleCliente(cli)">@Fmt(PivTotFila(cli))</td>
                            <td class="rfs-tend @atenua">@CeldaComparacion(cli)</td>
                        </tr>
                    </Virtualize>
                </tbody>
                <tfoot>
                    <tr>
                        <td class="rfs-col-fecha rfs-tot">TOTAL</td>
                        @foreach (var c in _pivCols)
                        {
                            var col = c;
                            @CeldaPivoteTotal(col)
                        }
                        <td class="rfs-num rfs-tot rfs-grantot">@Fmt(_granTotal)</td>
                        <td class="rfs-tend rfs-tot">@CeldaComparacion(null)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </MudPaper>
}

@code {
    private readonly DateTime _min = ReportService.FechaMinValida.ToDateTime(TimeOnly.MinValue);
    private readonly DateTime _max = ReportService.FechaMaxValida.ToDateTime(TimeOnly.MinValue);

    // Modos de comparación (definen el PERÍODO BASE, que se trae con una 2ª consulta).
    private const string CompNo = "NO";
    private const string CompMesAnterior = "M1";
    private const string CompAnioAnterior = "YOY";

    // Modos de celda del pivote (reemplazan al viejo switch "Variación").
    private const string CeldaCantidad = "CANT";
    private const string CeldaVariacion = "VAR";
    private const string CeldaAmbos = "AMBOS";

    // ── Filtros en edición ──
    // Default: los últimos 6 meses calendario (el pivote tiene columnas mensuales).
    private DateTime? _desde = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-5);
    private DateTime? _hasta = DateTime.Today;
    private string _verSel = "Activas";                 // "Activas" | "Canceladas"
    private List<MotivoCancelaDto> _motivos = new();
    private IReadOnlyCollection<int> _motivosSel = new HashSet<int>();
    private static readonly IReadOnlyList<string> _categorias = ReportService.CategoriasServicio;
    // Solo Turismo por defecto = el alcance histórico del informe (origen='T' sin el cliente
    // interno). Tildando Empresa se ve la operación completa, que era ~93% del volumen invisible.
    private IReadOnlyCollection<string> _categoriasSel = new HashSet<string> { "Turismo" };
    private string _metrica = "Reservas";               // "Reservas" (viajes) | "Pax"
    private string _comparar = CompNo;

    // ── Controles que recalculan en memoria (no son filtros de consulta) ──
    private string _criterio = ReportService.CriterioUso;   // qué cuenta como unidad CONTRATADA
    private string _modoCelda = CeldaAmbos;                 // cómo se pinta cada celda del pivote
    private bool _ejeMotivo;                                // columnas del pivote: mes (false) | motivo (true)

    // ── Foco / cross-filter (estilo Power BI) — DOS dimensiones combinables ──
    // Cliente AND "dimensión 2", que es el TIPO DE UNIDAD en reservas activas y el MOTIVO en
    // canceladas (en canceladas el tipo de unidad no dice nada: el 100% está SIN REALIZAR).
    private string? _clienteFocus;   // IdCliente (clave estable; el nombre puede repetirse)
    private string? _dim2Focus;
    private bool EnFocoCliente(string idCli) => _clienteFocus is null || _clienteFocus == idCli;

    // ── Filtros APLICADOS (snapshot al tocar "Aplicar") ──
    private DateOnly _fDesdeAp, _fHastaAp;
    private DateOnly _bDesdeAp, _bHastaAp;              // período base de la comparación
    private List<string> _catAp = new();
    private bool _canceladasAp;
    private List<int> _motAp = new();
    private string _compararAp = CompNo;

    private List<ReservaClienteRow> _filas = new();
    private List<ReservaClienteRow> _filasBase = new();      // período de comparación
    private List<ReservaClienteRow> _filasOtroEstado = new(); // activas cuando se ven canceladas (tasa)
    private List<ReservaClienteRow> _filasOtroEstadoBase = new();
    private List<ReservaClienteDetalleRow>? _detalle;   // lazy: se trae al primer drill-down/Excel
    private bool _cargando;
    private bool _cargandoDet;
    private Guid _chartsKey = Guid.NewGuid();

    private static readonly IReadOnlyList<string> _tipos = ReportService.TiposReservaCliente;

    // KPIs
    private int _totalMetrica, _totalBase;
    private int _promedioMensual;
    private int _clientesActivos, _clientesActivosBase;
    private string _clienteLider = "—";
    private int _maxCliente;
    private int _totalContratado, _totalContratadoBase;
    private int _pctContratado;
    private int _totalPeriodo;                          // canceladas + activas (para la tasa)
    private double _tasaCancel, _tasaCancelBase;
    private string _motivoLider = "—";
    private int _maxMotivo;

    private string UnidadMetrica => _metrica == "Pax" ? "pax" : "viajes";
    private string UnidadMetricaTit => _metrica == "Pax" ? "Pax" : "Viajes";

    private bool ModoCancel => _canceladasAp;
    private bool HayComparacion => _compararAp != CompNo;
    private bool EjeMotivo => ModoCancel && _ejeMotivo;
    private string Dim2Label => ModoCancel ? "Motivo" : "Tipo de unidad";

    // ── Gráficos ApexCharts ──
    private record ChartItem(string Mes, string Serie, decimal Valor);
    private record BarItem(string IdCliente, string Cliente, decimal Valor);
    private record DonutItem(string Label, decimal Valor);
    private List<ChartItem> _chartData = new();
    private List<string> _seriesMes = new();
    private List<BarItem> _barItems = new();
    private List<DonutItem> _donutDim2 = new();

    private ApexChart<ChartItem>? _barMesChart;
    private ApexChart<BarItem>? _barCliChart;
    private ApexChart<DonutItem>? _pieDim2Chart;

