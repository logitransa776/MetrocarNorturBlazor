    private RenderFragment CeldaPivote(string cli, string col, string atenua) => __builder =>
    {
        var v = PivVal(cli, col);
        var d = MostrarVariacion ? PivVar(cli, col) : null;

        @if (_modoCelda == CeldaVariacion && MostrarVariacion)
        {
            @if (d is null || (v == 0 && d.Value == 0))
            {
                <td class="rfs-num rfs-cero @atenua">·</td>
            }
            else
            {
                <td class="rfs-num rfs-var rfs-click @ClaseVar(d) @atenua"
                    title="@($"{NombreDe(cli)} · {ColHeader(col)}: {Fmt(v)} · {BaseLbl}: {Fmt(PivValBase(cli, col))}")"
                    @onclick="() => AbrirDetalleCelda(cli, col)">@FmtVar(d)</td>
            }
        }
        else if (v > 0)
        {
            <td class="rfs-num rfs-click @atenua" title="@TituloCelda(cli, col, v)"
                @onclick="() => AbrirDetalleCelda(cli, col)">
                @Fmt(v)
                @if (_modoCelda == CeldaAmbos && MostrarVariacion && d is not null && d.Value != 0)
                {
                    <span class="rfs-celda-delta @ClaseVar(d)">@FmtVar(d)</span>
                }
            </td>
        }
        else
        {
            <td class="rfs-num rfs-cero @atenua">·</td>
        }
    };

