    // "2026-02" → "02/2026"
    private static string FmtMes(string mes) =>
        mes.Length == 7 && mes[4] == '-' ? $"{mes[5..]}/{mes[..4]}" : mes;
    private string ColHeader(string col) => EjeMotivo ? col : FmtMes(col);

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthState.EstaAutenticadoAsync())
        {
            Nav.NavigateTo($"/login?destino={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: false);
            return;
        }
        if (!Permisos.Tiene('R'))   // módulo Reservas
        {
            Nav.NavigateTo("/", forceLoad: false);
            return;
        }
        _motivos = await Reports.GetMotivosCancelacionAsync();
        // Default: TODOS los motivos. El FoxPro traía hardcodeado solo el 2 ("CANCELADO POR
        // CLIENTE"), que escondía las 371 cancelaciones "POR ERROR EN CARGA" de 2025-26.
        _motivosSel = new HashSet<int>(_motivos.Select(m => m.Id));
        await Cargar();
    }

    // El período Desde–Hasta no puede superar este ancho: rangos más largos pegan contra
    // millones de filas de viaje y afectan la performance del servidor (pedido del usuario, 30/07/2026).
    // Ojo: este informe además dispara la 2ª consulta del período base (mismo ancho), así que el
    // costo real del tope se duplica cuando hay comparación activa.
    private const int RangoMaximoDias = 400;

    private async Task Cargar()
    {
        if (_desde is null || _hasta is null) return;

        var dias = (_hasta.Value.Date - _desde.Value.Date).TotalDays;
        if (dias > RangoMaximoDias)
        {
            // Cartel "Contorno" — estándar del proyecto para validaciones bloqueantes (ver app.css § nt-toast-contorno).
            Snackbar.Add(
                $"El rango Desde–Hasta no puede superar los {RangoMaximoDias} días (elegiste {(int)dias}). Achicá el período e intentá de nuevo.",
                Severity.Error,
                config =>
                {
                    config.SnackbarVariant = Variant.Outlined;
                    config.SnackbarTypeClass = "nt-toast-contorno";
                });
            return;
        }

        _cargando = true;
        StateHasChanged();

        // Snapshot de filtros aplicados (convención del service: lista de motivos vacía = todos)
        _fDesdeAp = DateOnly.FromDateTime(_desde.Value);
        _fHastaAp = DateOnly.FromDateTime(_hasta.Value);
        _catAp = _categoriasSel.ToList();
        _canceladasAp = _verSel == "Canceladas";
        _motAp = !_canceladasAp || _motivosSel.Count == _motivos.Count
            ? new List<int>()
            : _motivosSel.ToList();
        _compararAp = _comparar;
        _detalle = null;
        // Un nuevo conjunto de filtros descarta los focos anteriores.
        _clienteFocus = null;
        _dim2Focus = null;
        if (!_canceladasAp) _ejeMotivo = false;

        _filas = await Reports.GetReservasPorClienteAsync(_fDesdeAp, _fHastaAp, _catAp, _canceladasAp, _motAp);

        // Período base: desplazamiento DÍA A DÍA del rango elegido (no meses calendario
        // completos), así la cobertura del mes base espeja la del mes actual y un mes en curso
        // no se compara contra uno completo.
        _filasBase = new();
        if (HayComparacion)
        {
            (_bDesdeAp, _bHastaAp) = RangoBase(_fDesdeAp, _fHastaAp, _compararAp);
            _filasBase = await Reports.GetReservasPorClienteAsync(_bDesdeAp, _bHastaAp, _catAp, _canceladasAp, _motAp);
        }

        // Tasa de cancelación: hace falta el OTRO estado del mismo período para el denominador.
        _filasOtroEstado = new();
        _filasOtroEstadoBase = new();
        if (_canceladasAp)
        {
            _filasOtroEstado = await Reports.GetReservasPorClienteAsync(_fDesdeAp, _fHastaAp, _catAp, false, new List<int>());
            if (HayComparacion)
                _filasOtroEstadoBase = await Reports.GetReservasPorClienteAsync(_bDesdeAp, _bHastaAp, _catAp, false, new List<int>());
        }

        Recalcular();
        _chartsKey = Guid.NewGuid();   // datos nuevos → remontar los charts

        _cargando = false;
    }

    // Rango del período de comparación: el mismo rango corrido un mes o un año atrás.
    private (DateOnly, DateOnly) RangoBase(DateOnly desde, DateOnly hasta, string modo)
    {
        var d = modo == CompAnioAnterior ? desde.AddYears(-1) : desde.AddMonths(-1);
        var h = modo == CompAnioAnterior ? hasta.AddYears(-1) : hasta.AddMonths(-1);
        if (d < ReportService.FechaMinValida) d = ReportService.FechaMinValida;
        if (h < ReportService.FechaMinValida) h = ReportService.FechaMinValida;
        return (d, h);
    }

    // Cambio de métrica: recálculo en memoria, sin nueva query. Cambia la forma de los
    // gráficos → se remontan con un key nuevo.
    private void CambiarMetrica(string metrica)
    {
        _metrica = metrica;
        RecalcularYRemontar();
    }

    private void CambiarTopN(int topN)
    {
        _topN = topN;
        RecalcularYRemontar();
    }

    // Criterio de "contratado": cambia la clasificación de CADA viaje, pero los dos valores ya
    // vienen en el dataset → recálculo en memoria, sin volver a SQL.
    private void CambiarCriterio(string criterio)
    {
        _criterio = criterio;
        _dim2Focus = null;
        RecalcularYRemontar();
    }

    private void CambiarEje(bool ejeMotivo)
    {
        _ejeMotivo = ejeMotivo;
        Recalcular();
    }

    private void CambiarModoCelda(string modo) { _modoCelda = modo; }

    private void RecalcularYRemontar()
    {
        if (_filas.Count > 0)
        {
            Recalcular();
            _chartsKey = Guid.NewGuid();
        }
    }

    private void Recalcular()
    {
        Func<ReservaClienteRow, int> val = _metrica == "Pax" ? f => f.Pax : f => f.Viajes;

        // Subconjuntos según el foco (modelo Power BI): los visuales de CLIENTE (barras, tabla)
        // usan los datos filtrados por la 2ª dimensión (el foco de cliente en ellos es resaltado
        // por color/CSS), los visuales de la 2ª dimensión usan los filtrados por CLIENTE, y los
        // KPIs / totales llevan AMBOS focos.
        var datosDim2 = _dim2Focus is null ? _filas : _filas.Where(f => Dim2De(f) == _dim2Focus).ToList();
        var datosCliente = _clienteFocus is null ? _filas : _filas.Where(f => f.IdCliente == _clienteFocus).ToList();
        var datos = _clienteFocus is null ? datosDim2 : datosDim2.Where(f => f.IdCliente == _clienteFocus).ToList();

        // El período base lleva los MISMOS focos, para que el Δ compare lo mismo contra lo mismo.
        var datosBaseDim2 = _dim2Focus is null ? _filasBase : _filasBase.Where(f => Dim2De(f) == _dim2Focus).ToList();
        var datosBase = _clienteFocus is null ? datosBaseDim2 : datosBaseDim2.Where(f => f.IdCliente == _clienteFocus).ToList();

        // Nombre visible por cliente (canónico, del dataset completo; el base también aporta
        // nombres para los clientes que existían antes y hoy no tienen actividad).
        _nombrePorCliente = _filas.Concat(_filasBase)
            .GroupBy(f => f.IdCliente)
            .ToDictionary(g => g.Key, g => g.First().Cliente);

        // ── Categorías de la 2ª dimensión (orden estable, del dataset COMPLETO) ──
        if (ModoCancel)
        {
            _dim2Cats = _filas.GroupBy(Dim2De)
                .Select(g => (Cat: g.Key, Total: g.Sum(val)))
                .OrderByDescending(x => x.Total).ThenBy(x => x.Cat)
                .Select(x => x.Cat).ToList();
            _colorPorMotivo = _dim2Cats
                .Select((c, i) => (c, i))
                .ToDictionary(t => t.c, t => t.i < _paletteCli.Count ? _paletteCli[t.i] : _colorOtros);
        }
        else
        {
            _dim2Cats = _tipos.Where(t => _filas.Any(f => Dim2De(f) == t)).ToList();
        }

        // ── KPIs: sobre el dataset con ambos focos ──
        _totalMetrica = datos.Sum(val);
        _totalBase = datosBase.Sum(val);
        var meses = datos.Select(f => f.Mes).Distinct().Count();
        _promedioMensual = meses > 0 ? (int)Math.Round((double)_totalMetrica / meses) : 0;
        _clientesActivos = datos.Select(f => f.IdCliente).Distinct().Count();
        _clientesActivosBase = datosBase.Select(f => f.IdCliente).Distinct().Count();

        var porCliente = datos.GroupBy(f => f.IdCliente)
            .Select(g => (Id: g.Key, Total: g.Sum(val)))
            .OrderByDescending(x => x.Total).ToList();
        _clienteLider = porCliente.Count > 0 ? NombreDe(porCliente[0].Id) : "—";
        _maxCliente = porCliente.Count > 0 ? porCliente[0].Total : 0;

        // Contratados (solo modo activas): con el criterio elegido.
        _totalContratado = datos.Where(f => f.TipoSegun(_criterio) == "CONTRATADO").Sum(val);
        _totalContratadoBase = datosBase.Where(f => f.TipoSegun(_criterio) == "CONTRATADO").Sum(val);
        _pctContratado = _totalMetrica > 0 ? (int)Math.Round(100.0 * _totalContratado / _totalMetrica) : 0;

        // Motivo principal + tasa de cancelación (solo modo canceladas).
        if (ModoCancel)
        {
            var porMotivo = datos.GroupBy(Dim2De)
                .Select(g => (Cat: g.Key, Total: g.Sum(val)))
                .OrderByDescending(x => x.Total).ToList();
            _motivoLider = porMotivo.Count > 0 ? porMotivo[0].Cat : "—";
            _maxMotivo = porMotivo.Count > 0 ? porMotivo[0].Total : 0;

            var activas = _clienteFocus is null
                ? _filasOtroEstado
                : _filasOtroEstado.Where(f => f.IdCliente == _clienteFocus).ToList();
            _totalPeriodo = _totalMetrica + activas.Sum(val);
            _tasaCancel = _totalPeriodo > 0 ? 100.0 * _totalMetrica / _totalPeriodo : 0;

            var activasBase = _clienteFocus is null
                ? _filasOtroEstadoBase
                : _filasOtroEstadoBase.Where(f => f.IdCliente == _clienteFocus).ToList();
            var totalBasePeriodo = _totalBase + activasBase.Sum(val);
            _tasaCancelBase = totalBasePeriodo > 0 ? 100.0 * _totalBase / totalBasePeriodo : 0;
        }

        // ── Pivote ──
        // Filas = clientes (el foco de cliente es resaltado por CSS, la lista completa queda
        // visible); celdas y totales de fila con foco de la 2ª dimensión; los totales de
        // columna y el gran total llevan AMBOS focos.
        _pivMeses = _filas.Select(f => f.Mes).Distinct().OrderBy(m => m).ToList();
        _pivCols = EjeMotivo ? _dim2Cats : _pivMeses;

        Func<ReservaClienteRow, string> claveCol = EjeMotivo ? Dim2De : f => f.Mes;

        _pivMap = datosDim2.GroupBy(f => (f.IdCliente, claveCol(f)))
            .ToDictionary(g => g.Key, g => g.Sum(val));
        _pivMapBase = datosBaseDim2.GroupBy(f => (f.IdCliente, claveCol(f)))
            .ToDictionary(g => g.Key, g => g.Sum(val));
        _pivTotFila = datosDim2.GroupBy(f => f.IdCliente).ToDictionary(g => g.Key, g => g.Sum(val));
        _pivTotFilaBase = datosBaseDim2.GroupBy(f => f.IdCliente).ToDictionary(g => g.Key, g => g.Sum(val));
        _pivClientes = datosDim2.GroupBy(f => f.IdCliente)
            .Select(g => (Id: g.Key, Total: g.Sum(val)))
            .OrderByDescending(x => x.Total).ThenBy(x => NombreDe(x.Id))
            .Select(x => x.Id).ToList();
        _pivTotCol = datos.GroupBy(claveCol).ToDictionary(g => g.Key, g => g.Sum(val));
        _pivTotColBase = datosBase.GroupBy(claveCol).ToDictionary(g => g.Key, g => g.Sum(val));
        _granTotal = _totalMetrica;

        // Serie mensual SIEMPRE, aparte del eje del pivote: con columnas por motivo el
        // sparkline igual tiene que mostrar la evolución en el tiempo (si leyera las columnas
        // saldría una línea plana que no significa nada).
        _pivMapMes = EjeMotivo
            ? datosDim2.GroupBy(f => (f.IdCliente, f.Mes)).ToDictionary(g => g.Key, g => g.Sum(val))
            : _pivMap;
        _pivTotColPorMes = EjeMotivo
            ? datos.GroupBy(f => f.Mes).ToDictionary(g => g.Key, g => g.Sum(val))
            : _pivTotCol;

        // ── Evolución mensual ──
        // Con comparación: 2 series agrupadas (período vs base) — la lectura X vs X-1.
        // Sin comparación: apilado por la 2ª dimensión (composición del mes).
        var mapaMes = datosCliente.GroupBy(f => (f.Mes, Cat: Dim2De(f)))
            .ToDictionary(g => g.Key, g => g.Sum(val));
        if (HayComparacion)
        {
            _seriesMes = new List<string> { "Período", BaseLbl };
            var totMes = datosCliente.GroupBy(f => f.Mes).ToDictionary(g => g.Key, g => g.Sum(val));
            var datosBaseCliente = _clienteFocus is null
                ? _filasBase : _filasBase.Where(f => f.IdCliente == _clienteFocus).ToList();
            // Cada mes base se alinea con el mes del período que le corresponde (M-1 o M-12),
            // así las dos barras de una misma columna X son comparables.
            var totMesBase = datosBaseCliente.GroupBy(f => f.Mes).ToDictionary(g => g.Key, g => g.Sum(val));
            _chartData = _pivMeses.SelectMany(mes => new[]
            {
                new ChartItem(FmtMes(mes), "Período", totMes.TryGetValue(mes, out var a) ? a : 0),
                new ChartItem(FmtMes(mes), BaseLbl,
                    totMesBase.TryGetValue(MesBaseDe(mes), out var b) ? b : 0),
            }).ToList();
            _optsBarMes.Chart.Stacked = false;
            _optsBarMes.Colors = new List<string> { "#2058D0", _colorBase };
        }
        else
        {
            _seriesMes = new List<string>(_dim2Cats);
            _chartData = _pivMeses
                .SelectMany(mes => _dim2Cats.Select(cat =>
                    new ChartItem(FmtMes(mes), cat, mapaMes.TryGetValue((mes, cat), out var v) ? v : 0)))
                .ToList();
            _optsBarMes.Chart.Stacked = true;
            _optsBarMes.Colors = _dim2Cats.Select(ColorFocoDim2).ToList();
        }

        // ── Barras de clientes: ranking y colores del dataset COMPLETO (orden estable),
        //    valores con foco de la 2ª dimensión ──
        _rankingClientes = _filas.GroupBy(f => f.IdCliente)
            .Select(g => (Id: g.Key, Nombre: g.First().Cliente, Total: g.Sum(val)))
            .OrderByDescending(x => x.Total).ThenBy(x => x.Nombre).ToList();
        _colorPorCliente = _rankingClientes
            .Select((x, i) => (x.Id, i))
            .ToDictionary(t => t.Id, t => t.i < _paletteCli.Count ? _paletteCli[t.i] : _colorOtros);

        // Nombres repetidos entre clientes distintos: desambiguar con el código para que
        // ApexCharts no funda dos barras en una misma etiqueta X.
        var nombresRepetidos = _rankingClientes.GroupBy(x => x.Nombre)
            .Where(g => g.Count() > 1).Select(g => g.Key).ToHashSet();
        var valoresCli = datosDim2.GroupBy(f => f.IdCliente).ToDictionary(g => g.Key, g => g.Sum(val));
        _barItems = _rankingClientes.Take(_topN)
            .Select(x => new BarItem(
                x.Id,
                nombresRepetidos.Contains(x.Nombre) ? $"{x.Nombre} ({x.Id})" : x.Nombre,
                valoresCli.TryGetValue(x.Id, out var v) ? v : 0))
            .ToList();
        _altoBarras = Math.Max(360, _barItems.Count * 30);
        _optsBarCli.Colors = _barItems.Select(b => ColorFocoCli(b.IdCliente)).ToList();

        // ── Donut de la 2ª dimensión: categorías completas en orden fijo (0-fill si el foco de
        //    cliente las vacía), valores con foco de CLIENTE ──
        var dim2Valores = datosCliente.GroupBy(Dim2De).ToDictionary(g => g.Key, g => g.Sum(val));
        _donutDim2 = _dim2Cats
            .Select(c => new DonutItem(c, dim2Valores.TryGetValue(c, out var v) ? v : 0))
            .ToList();
        _optsPieDim2.Colors = _donutDim2.Select(d => ColorFocoDim2(d.Label)).ToList();
        AplicarTotalEnLeyenda(_donutDim2.Sum(d => (int)d.Valor));
    }

    // Números en la leyenda del donut ("CANCELADO POR CLIENTE: 572 (74%)") — patrón validado:
    // la torta queda limpia y no hay etiquetas encimadas.
    private void AplicarTotalEnLeyenda(int total)
    {
        _optsPieDim2.Legend!.Formatter =
            "function(name, opts){ var v = opts.w.globals.series[opts.seriesIndex]; " +
            $"var t = {total}; var p = t>0?Math.round(v*100/t):0; " +
            "return name + ': ' + v.toLocaleString('es-AR') + ' (' + p + '%)'; }";
    }

    // ── Accesores del pivote ──
    private int PivVal(string cli, string col) => _pivMap.TryGetValue((cli, col), out var v) ? v : 0;
    private int PivValBase(string cli, string col) => _pivMapBase.TryGetValue((cli, MesBaseDe(col)), out var v) ? v : 0;
    private int PivTotFila(string cli) => _pivTotFila.TryGetValue(cli, out var v) ? v : 0;
    private int PivTotFilaBase(string cli) => _pivTotFilaBase.TryGetValue(cli, out var v) ? v : 0;
    private int PivTotCol(string col) => _pivTotCol.TryGetValue(col, out var v) ? v : 0;
    private int PivTotColBase(string col) => _pivTotColBase.TryGetValue(MesBaseDe(col), out var v) ? v : 0;
    // Serie mensual para el sparkline (siempre por mes, aunque las columnas sean motivos).
    private int PivValMes(string cli, string mes) => _pivMapMes.TryGetValue((cli, mes), out var v) ? v : 0;
    private int PivTotColMes(string mes) => _pivTotColPorMes.TryGetValue(mes, out var v) ? v : 0;

    // ── Comparación ────────────────────────────────────────────────────────────────────
    // El mes base de un mes dado según el modo: el mes anterior (M-1) o el mismo mes del año
    // anterior (M-12). Como el período base se trae con su propia consulta, SIEMPRE hay
    // números — antes se buscaba dentro de los meses ya cargados y el interanual quedaba vacío
    // salvo que el usuario ampliara el "Desde" un año entero.
    private string MesBaseDe(string mes) =>
        _compararAp == CompAnioAnterior ? SumarMeses(mes, -12) : SumarMeses(mes, -1);

    // "2026-03" + (-2) → "2026-01"; "2026-01" + (-2) → "2025-11"
    private static string SumarMeses(string mes, int delta)
    {
        if (mes.Length != 7 || mes[4] != '-') return mes;
        var y = int.Parse(mes[..4]);
        var m = int.Parse(mes[5..7]);
        var idx = y * 12 + (m - 1) + delta;
        return $"{idx / 12:0000}-{idx % 12 + 1:00}";
    }

    // Con columnas de motivo no hay eje temporal → no hay variación por celda.
    private bool MostrarVariacion => HayComparacion && !EjeMotivo;

    private int? PivVar(string cli, string col) =>
        MostrarVariacion ? PivVal(cli, col) - PivValBase(cli, col) : null;
    private int? PivVarTotCol(string col) =>
        MostrarVariacion ? PivTotCol(col) - PivTotColBase(col) : null;

    // Etiqueta legible del período base.
    private string BaseLbl => _compararAp switch
    {
        CompAnioAnterior => "año anterior",
        CompMesAnterior => "mes anterior",
        _ => "",
    };

    // Con comparación el Sub queda corto (el detalle con fechas va al tooltip de la tarjeta):
    // con el badge de variación no entra más texto sin recortar la etiqueta.
    private string SubTotal => HayComparacion
        ? $"vs {Fmt(_totalBase)}"
        : $"prom. {Fmt(_promedioMensual)} {UnidadMetrica}/mes";

    // "CANCELADO POR CLIENTE" → "CLIENTE" (el prefijo se repite en los 6 motivos).
    private static string MotivoCorto(string motivo) =>
        motivo.StartsWith("CANCELADO POR ", StringComparison.OrdinalIgnoreCase)
            ? motivo["CANCELADO POR ".Length..]
            : motivo;

    private string ColCompHeader => HayComparacion ? $"VS {BaseLbl.ToUpperInvariant()}" : "EVOLUCIÓN";
    private string ColCompTitulo => HayComparacion
        ? $"Total del período base ({_bDesdeAp:dd/MM/yyyy}–{_bHastaAp:dd/MM/yyyy}) + variación"
        : "Evolución mensual del cliente";

    private string TituloCelda(string cli, string col, int v) => MostrarVariacion
        ? $"{NombreDe(cli)} · {ColHeader(col)}: {Fmt(v)} · {BaseLbl}: {Fmt(PivValBase(cli, col))}"
        : $"Ver viajes de {NombreDe(cli)} en {ColHeader(col)}";

    // ── Formato de variaciones ──
    private static string ClaseVar(int? d) =>
        d is null ? "rfs-var-na" : d.Value > 0 ? "rfs-var-up" : d.Value < 0 ? "rfs-var-down" : "rfs-var-flat";

    // "+19" / "−53" / "0" / "—". Usa el guión largo real para negativos.
    private static string FmtVar(int? d) =>
        d is null ? "—" : d.Value > 0 ? $"+{Fmt(d.Value)}" : d.Value < 0 ? $"−{Fmt(-d.Value)}" : "0";

    private static string FmtPct(double? p) =>
        p is null ? "" : (p.Value >= 0 ? "+" : "−") + $"{Math.Abs(p.Value):0}%";

    // Badge de los KPIs: "▲ +12,1%" (o "▲ +128" si la base es 0 y no hay porcentaje posible).
    private string DeltaTxt(int actual, int previo)
    {
        if (!HayComparacion) return "";
        var d = actual - previo;
        var flecha = d > 0 ? "▲ " : d < 0 ? "▼ " : "";
        if (previo <= 0) return d == 0 ? "" : $"{flecha}{FmtVar(d)}";
        return $"{flecha}{FmtPct(100.0 * d / previo)}";
    }

    private string DeltaPctTxt(double actual, double previo)
    {
        if (!HayComparacion) return "";
        var d = actual - previo;
        if (Math.Abs(d) < 0.05) return "";
        return $"{(d > 0 ? "▲ " : "▼ ")}{Math.Abs(d):0.0} pts";
    }

    private string DeltaCls(double actual, double previo) =>
        !HayComparacion ? "" : actual > previo ? "kpi-delta--up" : actual < previo ? "kpi-delta--down" : "kpi-delta--flat";

    // Para cancelaciones, subir es MALO → los colores se invierten.
    private string DeltaClsInverso(double actual, double previo) =>
        !HayComparacion ? "" : actual > previo ? "kpi-delta--down" : actual < previo ? "kpi-delta--up" : "kpi-delta--flat";

    private string TituloComparacion(int actual, int previo) => HayComparacion
        ? $"Período {_fDesdeAp:dd/MM/yyyy}–{_fHastaAp:dd/MM/yyyy}: {Fmt(actual)} · {BaseLbl} {_bDesdeAp:dd/MM/yyyy}–{_bHastaAp:dd/MM/yyyy}: {Fmt(previo)}"
        : "";

    // ── Sparkline SVG inline de la serie mensual (sin librerías) ──
    private MarkupString Sparkline(Func<string, int> serie)
    {
        var vals = _pivMeses.Select(serie).ToList();
        if (vals.Count < 2) return (MarkupString)"";
        const int w = 64, h = 20, pad = 2;
        int max = vals.Max(), min = vals.Min();
        double span = max - min;
        double dx = (w - 2.0 * pad) / (vals.Count - 1);
        double Y(int v) => span <= 0 ? h / 2.0 : h - pad - (v - min) / span * (h - 2.0 * pad);
        var pts = string.Join(" ", vals.Select((v, i) => $"{pad + i * dx:0.#},{Y(v):0.#}"));
        var delta = vals[^1] - vals[^2];
        var color = delta > 0 ? "#16A34A" : delta < 0 ? "#DC2626" : "#94A3B8";
        var cx = pad + (vals.Count - 1) * dx;
        var cy = Y(vals[^1]);
        return (MarkupString)(
            $"<svg class=\"rfs-spark\" viewBox=\"0 0 {w} {h}\" width=\"{w}\" height=\"{h}\" preserveAspectRatio=\"none\">" +
            $"<polyline points=\"{pts}\" fill=\"none\" stroke=\"{color}\" stroke-width=\"1.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>" +
            $"<circle cx=\"{cx:0.#}\" cy=\"{cy:0.#}\" r=\"2\" fill=\"{color}\"/>" +
            "</svg>");
    }

    // ── Cross-filter: toggles y actualización de los charts ──

    private async Task ToggleFocoCliente(string idCli)
    {
        _clienteFocus = _clienteFocus == idCli ? null : idCli;
        Recalcular();                 // en memoria, sin re-query
        await ActualizarGraficos();   // repinta EN SU LUGAR (sin remontar → sin parpadeo)
    }

    private async Task ToggleFocoDim2(string cat)
    {
        _dim2Focus = _dim2Focus == cat ? null : cat;
        Recalcular();
        await ActualizarGraficos();
    }

    private Task LimpiarFocoCliente() => ToggleFocoCliente(_clienteFocus ?? "");
    private Task LimpiarFocoDim2() => ToggleFocoDim2(_dim2Focus ?? "");

    // El foco de una dimensión cambia los VALORES de los gráficos de la otra →
    // UpdateOptions (colores) + UpdateSeries (valores) en los tres.
    private async Task ActualizarGraficos()
    {
        if (_barMesChart is not null)
        {
            await _barMesChart.UpdateOptionsAsync(true, true, false);
            await _barMesChart.UpdateSeriesAsync(true);
        }
        if (_barCliChart is not null)
        {
            await _barCliChart.UpdateOptionsAsync(true, true, false);
            await _barCliChart.UpdateSeriesAsync(true);
        }
        if (_pieDim2Chart is not null)
        {
            await _pieDim2Chart.UpdateOptionsAsync(true, true, false);
            await _pieDim2Chart.UpdateSeriesAsync(true);
        }
    }

    // En el apilado cada serie ya viene filtrada por categoría → el primer item trae la
    // categoría de la serie clickeada. Con comparación las series son período/base: no enfocan.
    private async Task OnBarMesSelection(SelectedData<ChartItem> e)
    {
        if (HayComparacion) return;
        var cat = e.DataPoint?.Items?.FirstOrDefault()?.Serie;
        if (cat is not null) await ToggleFocoDim2(cat);
    }

    private async Task OnBarMesLegendClicked(LegendClicked<ChartItem> e)
    {
        if (HayComparacion) return;
        var cat = e.Series?.Name;
        if (!string.IsNullOrEmpty(cat)) await ToggleFocoDim2(cat);
    }

    private async Task OnBarCliSelection(SelectedData<BarItem> e)
    {
        var idCli = e.DataPoint?.Items?.FirstOrDefault()?.IdCliente;
        if (idCli is not null) await ToggleFocoCliente(idCli);
    }

    private async Task OnPieDim2Selection(SelectedData<DonutItem> e)
    {
        var cat = e.DataPoint?.Items?.FirstOrDefault()?.Label;
        if (cat is not null) await ToggleFocoDim2(cat);
    }

    private async Task OnPieDim2LegendClicked(LegendClicked<DonutItem> e)
    {
        var cat = e.DataPoint?.Items?.FirstOrDefault()?.Label;
        if (cat is not null) await ToggleFocoDim2(cat);
    }

    // ── Drill-down: los viajes uno por uno detrás del número ──

    private async Task<List<ReservaClienteDetalleRow>> GetDetalleAsync()
    {
        if (_detalle is null)
        {
            _cargandoDet = true;
            StateHasChanged();
            _detalle = await Reports.GetReservasPorClienteDetalleAsync(_fDesdeAp, _fHastaAp, _catAp, _canceladasAp, _motAp);
            _cargandoDet = false;
        }
        return _detalle;
    }

    // Los drills respetan el foco activo: el número visible corresponde al subconjunto
    // enfocado y el detalle tiene que mostrar EXACTAMENTE esos viajes.
    private bool PasaFocoDim2(ReservaClienteDetalleRow d) => _dim2Focus is null || Dim2De(d) == _dim2Focus;
    private bool PasaFocoCliente(ReservaClienteDetalleRow d) => _clienteFocus is null || d.IdCliente == _clienteFocus;
    private string SufijoFocoDim2 => _dim2Focus is null ? "" : $" · {_dim2Focus}";

    private bool EnColumna(ReservaClienteDetalleRow d, string col) =>
        EjeMotivo ? Dim2De(d) == col : d.Mes == col;

    private Task AbrirDetalleCelda(string idCli, string col) =>
        AbrirDetalle(d => d.IdCliente == idCli && EnColumna(d, col) && PasaFocoDim2(d),
                     $"{NombreDe(idCli)} — {ColHeader(col)}{SufijoFocoDim2}");

    private Task AbrirDetalleCliente(string idCli) =>
        AbrirDetalle(d => d.IdCliente == idCli && PasaFocoDim2(d),
                     $"{NombreDe(idCli)} — todo el período{SufijoFocoDim2}");

    private Task AbrirDetalleColumna(string col) =>
        AbrirDetalle(d => EnColumna(d, col) && PasaFocoCliente(d) && PasaFocoDim2(d),
                     $"{(_clienteFocus is null ? "Todos los clientes" : NombreDe(_clienteFocus))} — {ColHeader(col)}{SufijoFocoDim2}");

    private Task AbrirDetalleDim2(string cat) =>
        AbrirDetalle(d => Dim2De(d) == cat && PasaFocoCliente(d), $"{Dim2Label}: {cat}");

    private async Task AbrirDetalle(Func<ReservaClienteDetalleRow, bool> filtro, string subtitulo)
    {
        var todas = await GetDetalleAsync();
        var items = todas.Where(filtro).Select(d => d.Reserva).ToList();
        if (items.Count == 0) return;

        var parametros = new DialogParameters<ReservasFsDetalleDialog>
        {
            { x => x.Items, items },
            { x => x.Subtitulo, subtitulo }
        };
        await DialogService.ShowAsync<ReservasFsDetalleDialog>("Detalle de viajes", parametros, OpcionesDialog);
    }

    // ── Composición del KPI (pedido de la clienta: "¿de qué está hecho el número?") ──
    // Abre el desglose por UNIDAD (interno · dominio · fletero) y por CLIENTE del tipo elegido.
    private async Task AbrirComposicionTipo(string tipo)
    {
        var todas = await GetDetalleAsync();
        var items = todas
            .Where(d => d.TipoSegun(_criterio) == tipo && PasaFocoCliente(d))
            .ToList();
        if (items.Count == 0) return;

        var parametros = new DialogParameters<ComposicionTipoDialog>
        {
            { x => x.Items, items },
            { x => x.Tipo, tipo },
            { x => x.Criterio, _criterio },
            { x => x.Metrica, _metrica },
            { x => x.Subtitulo, $"{_fDesdeAp:dd/MM/yyyy} – {_fHastaAp:dd/MM/yyyy}{(_clienteFocus is null ? "" : $" · {NombreDe(_clienteFocus)}")}" }
        };
        await DialogService.ShowAsync<ComposicionTipoDialog>("Composición", parametros, OpcionesDialog);
    }

    private static DialogOptions OpcionesDialog => new()
    {
        MaxWidth = MaxWidth.ExtraLarge,
        FullWidth = true,
        CloseButton = false,
        CloseOnEscapeKey = true,
        BackdropClick = true
    };

    private async Task DescargarExcel()
    {
        var viajes = await GetDetalleAsync();
        var bytes = Excel.ReservasPorCliente(
            _filas, _metrica, _criterio, _motivos, viajes,
            HayComparacion ? _filasBase : null, BaseLbl);
        var nombre = $"reservas_por_cliente_{_fDesdeAp:yyyyMMdd}_{_fHastaAp:yyyyMMdd}.xlsx";
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("descargarArchivo", nombre, streamRef);
    }

    private static string Fmt(int n) => n.ToString("#,0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));
}
