    // Última columna: sin comparación = solo la evolución (sparkline); con comparación = el
    // valor del período base + Δ + % + sparkline. cli == null → fila TOTAL.
    private RenderFragment CeldaComparacion(string? cli) => __builder =>
    {
        var actual = cli is null ? _granTotal : PivTotFila(cli);
        var previo = cli is null ? _totalBase : PivTotFilaBase(cli);
        Func<string, int> serie = cli is null ? PivTotColMes : mes => PivValMes(cli, mes);

        <div class="rfs-tend-wrap">
            @if (HayComparacion)
            {
                var delta = actual - previo;
                double? pct = previo > 0 ? 100.0 * delta / previo : null;
                <span class="rfs-tend-delta @ClaseVar(delta)"
                      title="@($"{(cli is null ? "Total" : NombreDe(cli))} · período: {Fmt(actual)} · {BaseLbl}: {Fmt(previo)}")">
                    <span class="rfs-tend-base">@Fmt(previo)</span>
                    @if (delta != 0)
                    {
                        <span class="rfs-tend-arrow">@(delta > 0 ? "▲" : "▼")</span>
                    }
                    <span>@FmtVar(delta)</span>
                    @if (pct is not null)
                    {
                        <span class="rfs-tend-pct">@FmtPct(pct)</span>
                    }
                </span>
            }
            @Sparkline(serie)
        </div>
    };

