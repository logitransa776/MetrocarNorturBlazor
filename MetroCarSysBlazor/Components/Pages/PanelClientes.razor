@page "/panel-clientes"
@using ApexCharts
@using MudColor = MudBlazor.Color
@using MudSize = MudBlazor.Size
@inject ReportService Reports
@inject ExcelExportService Excel
@inject NorturAuthStateProvider AuthState
@inject IPermissionService Permisos
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDialogService DialogService
@rendermode InteractiveServer

@* ─────────────────────────────────────────────────────────────────────────────
   Panel de Clientes — informe NUEVO (no existe en el Metrocar/FoxPro).

   Cruza lo que hoy vive en tres pantallas distintas: el padrón (`cliente`), la
   actividad (`viaje`) y la plata (`liquidacion_detalle`). Contesta "quién vale
   cuánto": ranking, participación, concentración y evolución mes a mes.

   Dos consultas (cliente × mes + padrón) y todo lo demás en memoria: cambiar de
   dimensión, de métrica o enfocar una categoría no vuelve a la base.

   ⚠ La plata está DEVENGADA AL MES DEL VIAJE y sale del detalle de liquidación,
   no de `liquidacion.total` (que tiene cargas corruptas). Ver el encabezado de
   Services/ReportService.PanelClientes.cs para el detalle de las decisiones.
   ───────────────────────────────────────────────────────────────────────────── *@

<PageTitle>BusLink</PageTitle>

<div class="page-header mb-3">
    <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
        <MudText Typo="Typo.h5" Style="font-weight:800; color:#112F5B;">
            Panel de Clientes
        </MudText>
        @* El informe está EN DESARROLLO en el catálogo: el badge lo dice también acá, para que
           quien lo abre sepa que está en evaluación y no publicado a la operación. *@
        <span class="nt-badge-dev" title="Informe en evaluación: se publica al módulo Facturación cuando el cliente lo apruebe.">
            <MudIcon Icon="@Icons.Material.Filled.Science" Size="MudSize.Small" />
            En desarrollo
        </span>
        <AyudaReporte Ruta="panel-clientes" />
    </div>
    <MudText Typo="Typo.body2" Style="color:#7A90AD; margin-top:2px;">
        Quién vale cuánto: viajes, pasajeros y facturación por cliente y por tipo · Nortur
    </MudText>
</div>

@* ── Selector de vista ──
   Cartera mide el NEGOCIO en un período; Padrón mide la BASE de datos y no depende de
   fechas. Son dos preguntas distintas sobre el mismo dato, por eso conviven acá y no en
   dos informes: comparten las dos consultas ya cargadas. *@
<div class="pad-vistas mb-3">
    <AyudaReporte Ruta="panel-clientes" Bloque="vistas" Chico="true" />
    <button type="button" class="pad-vista @(_vista == VistaCartera ? "pad-vista--on" : "")"
            @onclick="() => CambiarVista(VistaCartera)">
        <MudIcon Icon="@Icons.Material.Filled.Leaderboard" Size="MudSize.Small" />
        <span>Cartera</span>
        <small>quién vale cuánto</small>
    </button>
    <button type="button" class="pad-vista @(_vista == VistaRetencion ? "pad-vista--on" : "")"
            @onclick="() => CambiarVista(VistaRetencion)">
        <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Size="MudSize.Small" />
        <span>Retención y riesgo</span>
        <small>a quién estoy perdiendo</small>
    </button>
    <button type="button" class="pad-vista @(_vista == VistaPadron ? "pad-vista--on" : "")"
            @onclick="() => CambiarVista(VistaPadron)">
        <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="MudSize.Small" />
        <span>Salud del padrón</span>
        <small>qué hay para limpiar</small>
    </button>
</div>

@* ── Barra de filtros (filtros a la izquierda, acciones juntas a la derecha) ──
   En la vista Padrón se ocultan los filtros de período y desglose: el padrón es el
   catálogo completo, no depende del Desde–Hasta. Solo queda el Excel. *@
<MudPaper Elevation="1" Class="rfs-filtros mb-3">
    <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="MudSize.Small" Style="color:#003AA0; flex-shrink:0;" />

    @if (_vista == VistaPadron)
    {
        <MudText Typo="Typo.body2" Style="color:#7A90AD;">
            El padrón es el catálogo <b>completo</b> de clientes: no depende del período.
            La antigüedad de uso se mide contra el último día con datos (<b>@_corte.ToString("dd/MM/yyyy")</b>).
        </MudText>
    }

    <div class="rfs-fechas" style="@(_vista == VistaPadron ? "display:none;" : "")">
        <MudDatePicker Label="Desde" Date="_desde" DateChanged="@(d => _desde = d)"
                       MinDate="_min" MaxDate="_max" DateFormat="dd/MM/yyyy"
                       PickerVariant="PickerVariant.Dialog" Editable="true"
                       Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:160px;" />
        <MudDatePicker Label="Hasta" Date="_hasta" DateChanged="@(d => _hasta = d)"
                       MinDate="_min" MaxDate="_max" DateFormat="dd/MM/yyyy"
                       PickerVariant="PickerVariant.Dialog" Editable="true"
                       Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:160px;" />
    </div>

    @* En Retención, en lugar del desglose va el selector de período base (que sí re-consulta). *@
    @if (_vista == VistaRetencion)
    {
        <MudSelect T="string" Label="Comparar contra" Value="_periodoBase" ValueChanged="CambiarPeriodoBase"
                   Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:215px;"
                   title="Contra qué período se mide la variación. El período anterior mide el momento; el año pasado saca de encima la estacionalidad, que en turismo es fuerte.">
            <MudSelectItem T="string" Value="@BaseAnterior">Período anterior</MudSelectItem>
            <MudSelectItem T="string" Value="@BaseAnioPasado">Año pasado</MudSelectItem>
        </MudSelect>
    }

    @* Dimensión y métrica son cortes del MISMO dataset → se aplican al instante. *@
    @if (_vista == VistaCartera)
    {
    <MudSelect T="string" Label="Agrupar por" Value="_dimension" ValueChanged="CambiarDimension"
               Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:195px;"
               title="Con qué criterio se clasifica cada cliente. La tabla `cliente` no tiene un campo 'tipo': la línea de negocio y la moneda se DERIVAN de lo que el cliente operó y facturó en el período. Se aplica al instante.">
        @foreach (var d in ReportService.DimensionesClientes)
        {
            <MudSelectItem T="string" Value="@d">@EtiquetaDim(d)</MudSelectItem>
        }
    </MudSelect>
    }

    @* La métrica manda en las dos vistas de negocio (en Retención define contra qué se mide
       la variación: plata, viajes o pasajeros). *@
    @if (_vista != VistaPadron)
    {
        <MudSelect T="string" Label="Métrica" Value="_metrica" ValueChanged="CambiarMetrica"
                   Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:150px;"
                   title="Con qué se mide todo el tablero: plata facturada, cantidad de viajes o pasajeros transportados. Se aplica al instante.">
            @foreach (var m in ReportService.MetricasClientes)
            {
                <MudSelectItem T="string" Value="@m">@m</MudSelectItem>
            }
        </MudSelect>
    }

    <span style="flex:1 1 auto;"></span>

    <div style="display:flex; gap:6px; flex-shrink:0;">
        @if (_vista != VistaPadron)
        {
            <MudButton Variant="Variant.Filled" Color="@(_pendientes > 0 ? MudColor.Warning : MudColor.Primary)"
                       OnClick="Cargar" Disabled="_cargando"
                       StartIcon="@(_pendientes > 0 ? Icons.Material.Filled.PriorityHigh : Icons.Material.Filled.Search)"
                       Style="border-radius:8px; height:40px; text-transform:none;">
                @(_cargando ? "Cargando..." : _pendientes > 0 ? $"Aplicar filtros ({_pendientes})" : "Aplicar filtros")
            </MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="MudColor.Success"
                   StartIcon="@Icons.Material.Filled.Download" OnClick="DescargarExcel"
                   Disabled="@(_cargando || (_vista == VistaCartera ? _ranking.Count == 0 : _padronLista.Count == 0))"
                   Style="border-radius:8px; height:40px; text-transform:none;">
            Excel
        </MudButton>
    </div>
</MudPaper>

@if (_pendientes > 0 && !_cargando && _vista == VistaCartera)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Style="border-radius:12px;"
              Icon="@Icons.Material.Filled.Update">
        Lo que se ve abajo <b>todavía no incluye</b> el cambio de fechas — apretá <b>Aplicar filtros</b> para actualizar.
    </MudAlert>
}

@if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Color="MudColor.Primary" Class="mb-4" Style="border-radius:4px;" />
}
else if (_vista == VistaPadron)
{
    <PadronClientesPanel @ref="_padronPanel" Padron="_padronLista" Corte="_corte" AbrirFicha="AbrirFicha" />
}
else if (_vista == VistaRetencion)
{
    @* 🔴 Metrica va con @: en Razor un parámetro de tipo string SIN @ toma el literal
       ("_metrica") en vez del valor del campo — los de tipo lista sí se evalúan. *@
    <RetencionClientesPanel @ref="_retencionPanel"
                            Actual="_ranking" Base="_rankingBase" Metrica="@_metrica"
                            PeriodoActual="@PeriodoTxt" PeriodoBase="@PeriodoBaseTxt"
                            EsAnioPasado="@(_periodoBase == BaseAnioPasado)"
                            CruzaAnios="@(_bDesdeAp.Year != _hastaAp.Year)"
                            AvisoLiquidacion="@AvisoLiquidacionTxt"
                            AbrirFicha="AbrirFicha" />
}
else if (_ranking.Count == 0)
{
    <MudAlert Severity="Severity.Warning" Style="border-radius:12px;">
        No hay clientes con actividad en el período elegido.
    </MudAlert>
}
else
{
    <div class="@(_pendientes > 0 ? "rfs-desactualizado" : "")">

    @* ── KPIs ── *@
    <div class="rfs-kpis mb-3">
        <KpiCard Label="Clientes" Value="@Fmt(_kClientes)" Sub="@_kClientesSub" Color="@NorturColors.Azul" />
        <KpiCard Label="Facturado" Value="@Plata(_kFacturado)" Sub="@_kFacturadoSub" Color="@NorturColors.Verde" />
        <KpiCard Label="Viajes" Value="@Fmt(_kViajes)" Sub="@_kViajesSub" Color="@NorturColors.Naranja" />
        <KpiCard Label="Pasajeros" Value="@Fmt(_kPax)" Sub="en el período" Color="#0EA5E9" />
        <KpiCard Label="Por viaje" Value="@Plata(_kPorViaje)" Sub="promedio por servicio" Color="#7C3AED" />
        <KpiCard Label="Top 5" Value="@($"{_kConcentracion:0.0} %")" Sub="@_kConcentracionSub" Color="@NorturColors.Rojo" />
    </div>

    @if (_avisoPesos)
    {
        @* Con la inflación argentina, sumar pesos de años distintos no significa nada.
           Se avisa en vez de esconderlo o de inventar un índice de ajuste. *@
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Style="border-radius:12px;"
                  Icon="@Icons.Material.Filled.Info">
            El período abarca <b>más de un año calendario</b>: los importes están en <b>pesos corrientes</b>
            (los de cada momento), así que comparar meses lejanos entre sí sobrestima el crecimiento.
            Para volumen puro, cambiá la métrica a <b>Viajes</b> o <b>Pax</b>.
        </MudAlert>
    }

    @if (_coberturaMes is not null)
    {
        @* El rezago de la liquidación es la explicación #1 de "por qué el último mes cayó":
           los viajes están hechos pero todavía no se facturaron. *@
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Style="border-radius:12px;"
                  Icon="@Icons.Material.Filled.HourglassBottom">
            <b>@_coberturaMes.Value.Mes todavía no está liquidado del todo</b>: solo el
            <b>@($"{_coberturaMes.Value.Pct:0}%")</b> de sus viajes tiene facturación cargada. Los meses recientes
            van a subir cuando se emitan las liquidaciones que faltan — no los leas como una caída.
        </MudAlert>
    }

    @if (_mesEnCursoIncompleto)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Style="border-radius:12px;"
                  Icon="@Icons.Material.Filled.EditCalendar">
            El período termina <b>a mitad de mes</b>: la última columna del pivote tiene días de menos.
            La columna <b>Evolución</b> lo excluye a propósito y compara los dos últimos meses completos.
        </MudAlert>
    }

    @if (_lineasSinTc > 0)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Style="border-radius:12px;"
                  Icon="@Icons.Material.Filled.ReportProblem">
            @_lineasSinTc @(_lineasSinTc == 1 ? "línea facturada en dólares quedó" : "líneas facturadas en dólares quedaron")
            <b>fuera del total en pesos</b>: su liquidación no tiene tipo de cambio cargado. Los dólares sí se cuentan
            en el subtotal en USD.
        </MudAlert>
    }

    @* ── Composición: top clientes por métrica + reparto por categoría ── *@
    <MudGrid @key="_chartsKey" Spacing="3" Class="mb-3" Style="align-items:stretch;">
        <MudItem xs="12" md="7" Style="display:flex; flex-direction:column;">
            <MudPaper Class="pa-4" Elevation="1" Style="border-radius:14px; flex:1;">
                <div class="rfs-bar-head mb-2">
                    <MudText Typo="Typo.subtitle2" Style="font-weight:700; color:#112F5B;">
                        Top @_topN clientes por @_metrica.ToLowerInvariant()
                    </MudText>
                    <div style="display:flex; gap:8px; align-items:center;">
                        <MudSelect T="int" Value="_topN" ValueChanged="CambiarTopN" Label="Mostrar"
                                   Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:110px;">
                            <MudSelectItem T="int" Value="10">Top 10</MudSelectItem>
                            <MudSelectItem T="int" Value="15">Top 15</MudSelectItem>
                            <MudSelectItem T="int" Value="20">Top 20</MudSelectItem>
                            <MudSelectItem T="int" Value="999">Todos</MudSelectItem>
                        </MudSelect>
                    </div>
                </div>
                <ApexChart TItem="BarItem" Options="_optsBar" Height="@_altoBarras" @ref="_barChart">
                    <ApexPointSeries TItem="BarItem" Items="_barItems" Name="@_metrica"
                                     SeriesType="SeriesType.Bar"
                                     XValue="@(x => x.Cat)" YValue="@(x => x.Valor)"
                                     ShowDataLabels="true" />
                </ApexChart>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="5" Style="display:flex; flex-direction:column;">
            <MudPaper Class="pa-4" Elevation="1" Style="border-radius:14px; flex:1;">
                @CabeceraFoco($"Reparto por {EtiquetaDimSingular}")
                @* Torta limpia + cantidad y % en la LEYENDA (ApexCharts no tiene leader lines).
                   @key propio: se remonta en cada foco para que la leyenda no quede con los
                   valores del render anterior (regla del cross-filter del proyecto). *@
                <ApexChart @key="_pieKey" TItem="PieItem" Options="_optsPie" Height="340"
                           OnDataPointSelection="OnPieSelection">
                    <ApexPointSeries TItem="PieItem" Items="_pieItems" Name="@_metrica"
                                     SeriesType="SeriesType.Pie"
                                     XValue="@(x => x.Cat)" YValue="@(x => x.Valor)" />
                </ApexChart>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* ── Ranking de clientes: el corazón del informe ── *@
    <MudPaper Class="pa-4 mb-3" Elevation="1" Style="border-radius:14px;">
        <div class="mb-3">
            <MudText Typo="Typo.subtitle2" Style="font-weight:700; color:#112F5B;">
                Ranking de clientes por @_metrica.ToLowerInvariant()
            </MudText>
            <MudText Typo="Typo.caption" Style="color:#8FA3BC;">
                Click en el nombre para abrir la ficha del cliente · click en su @EtiquetaDimSingular para enfocar el tablero ·
                <b>% acum.</b> es el Pareto: cuántos clientes hacen la mayor parte del negocio
            </MudText>
        </div>
        <div class="rfs-tabla-wrap">
            <table class="rfs-tabla">
                <thead>
                    <tr>
                        <th class="rfs-col-fecha" style="min-width:230px;">Cliente</th>
                        <th class="rfs-th-serv">@EtiquetaDimSingularTit</th>
                        <th class="rfs-num" title="Facturado en el período, devengado al mes del viaje">Facturado</th>
                        <th class="rfs-num" title="Parte del facturado en dólares, expresada en dólares">USD</th>
                        <th class="rfs-num">Viajes</th>
                        <th class="rfs-num" title="Viajes cancelados sobre el total del cliente">% canc.</th>
                        <th class="rfs-num">Pax</th>
                        <th class="rfs-num" title="Facturado dividido los viajes que sí se prestaron">Por viaje</th>
                        <th class="rfs-num" title="Participación del cliente en la métrica elegida">% del total</th>
                        <th class="rfs-num" title="Participación acumulada: el Pareto de la cartera">% acum.</th>
                        <th class="rfs-th-serv" title="Última reserva ya ocurrida del cliente">Última</th>
                    </tr>
                </thead>
                <tbody>
                    @* Virtualize: pueden ser cientos de clientes (regla de performance del proyecto). *@
                    <Virtualize Items="_ranking" Context="c" ItemSize="30" OverscanCount="12" SpacerElement="tr">
                        @{
                            var atenua = EnFoco(c.Categoria) ? "" : "rfs-atenua";
                            var acum = AcumDe(c.IdCliente);
                        }
                        <tr>
                            <td class="rfs-col-fecha rfs-click @atenua"
                                style="max-width:300px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                title="@($"{c.Nombre} ({c.IdCliente}) · abrir la ficha del cliente")"
                                @onclick="() => AbrirFicha(c.IdCliente)">@c.Nombre</td>
                            <td class="rfs-th-serv rfs-click @atenua @(_focus == c.Categoria ? "pfl-cat-foco" : "")"
                                title="@($"Clic para enfocar el tablero en {c.Categoria}")"
                                @onclick="() => ToggleFoco(c.Categoria)">
                                <span class="pfl-punto" style="@($"background:{ColorDe(c.Categoria)};")"></span>@c.Categoria
                            </td>
                            <td class="rfs-num @atenua" title="@PlataFull(c.Facturado)">@Plata(c.Facturado)</td>
                            <td class="rfs-num @atenua">@(c.FacturadoUsd > 0 ? "u$s " + Fmt(c.FacturadoUsd) : "·")</td>
                            <td class="rfs-num @atenua">@Fmt(c.Viajes)</td>
                            <td class="rfs-num @atenua @(c.PctCancelado >= 20 ? "pfl-alerta" : "")"
                                title="@($"{c.Cancelados} cancelados de {c.Viajes} viajes")">
                                @(c.Cancelados > 0 ? $"{c.PctCancelado:0.0}%" : "·")
                            </td>
                            <td class="rfs-num @atenua">@Cero(c.Pax)</td>
                            <td class="rfs-num @atenua">@(c.FacturadoPorViaje is decimal pv && pv > 0 ? Plata(pv) : "·")</td>
                            <td class="rfs-num @atenua">@($"{PctDe(c):0.0}%")</td>
                            <td class="rfs-num @atenua" style="color:#7A90AD;">@($"{acum:0.0}%")</td>
                            <td class="rfs-th-serv @atenua" style="font-weight:500;">@FechaCorta(c.UltimaReserva)</td>
                        </tr>
                    </Virtualize>
                </tbody>
                <tfoot>
                    <tr>
                        <td class="rfs-col-fecha rfs-tot">TOTAL@(_focus is null ? "" : $" ({_focus})")</td>
                        @* _kClientes y no _ranking.Count: el pie tiene que contar lo mismo que
                           suman los totales, o sea los clientes EN FOCO. *@
                        <td class="rfs-th-serv rfs-tot">@_kClientes cliente(s)</td>
                        <td class="rfs-num rfs-tot rfs-grantot" title="@PlataFull(_tFacturado)">@Plata(_tFacturado)</td>
                        <td class="rfs-num rfs-tot">@(_tUsd > 0 ? "u$s " + Fmt(_tUsd) : "·")</td>
                        <td class="rfs-num rfs-tot">@Fmt(_tViajes)</td>
                        <td class="rfs-num rfs-tot">@(_tViajes > 0 ? $"{_tCancelados * 100.0 / _tViajes:0.0}%" : "·")</td>
                        <td class="rfs-num rfs-tot">@Fmt(_tPax)</td>
                        <td class="rfs-num rfs-tot">@Plata(_kPorViaje)</td>
                        <td class="rfs-num rfs-tot">100,0%</td>
                        <td class="rfs-num rfs-tot">·</td>
                        <td class="rfs-th-serv rfs-tot">·</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </MudPaper>

    @* ── Pivote cliente × mes ── *@
    <MudPaper Class="pa-4" Elevation="1" Style="border-radius:14px;">
        <div class="mb-3">
            <MudText Typo="Typo.subtitle2" Style="font-weight:700; color:#112F5B;">
                @_metrica por cliente y mes
            </MudText>
            <MudText Typo="Typo.caption" Style="color:#8FA3BC;">
                La columna <b>Evolución</b> compara el último mes con el anterior y dibuja la serie completa ·
                click en el cliente para abrir su ficha
            </MudText>
        </div>
        <div class="rfs-tabla-wrap">
            <table class="rfs-tabla rfs-tabla-tend">
                <thead>
                    <tr>
                        <th class="rfs-col-fecha" style="min-width:230px;">Cliente</th>
                        @foreach (var m in _meses)
                        {
                            <th class="rfs-th-serv">@MesHeader(m)</th>
                        }
                        <th class="rfs-th-total">TOTAL</th>
                        <th class="rfs-th-tend" title="Último mes contra el anterior + evolución de todo el período">EVOLUCIÓN</th>
                    </tr>
                </thead>
                <tbody>
                    <Virtualize Items="_pivClientes" Context="cli" ItemSize="30" OverscanCount="12" SpacerElement="tr">
                        @{ var at = EnFoco(CatDe(cli)) ? "" : "rfs-atenua"; }
                        <tr>
                            <td class="rfs-col-fecha rfs-click @at"
                                style="max-width:300px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                title="@($"{NombreDe(cli)} · abrir la ficha del cliente")"
                                @onclick="() => AbrirFicha(cli)">@NombreDe(cli)</td>
                            @foreach (var m in _meses)
                            {
                                var mes = m;
                                var v = PivVal(cli, mes);
                                @if (v > 0)
                                {
                                    <td class="rfs-num @at" title="@($"{NombreDe(cli)} · {MesHeader(mes)}: {ValFull(v)}")">@Val(v)</td>
                                }
                                else
                                {
                                    <td class="rfs-num rfs-cero @at">·</td>
                                }
                            }
                            <td class="rfs-num rfs-tot @at" title="@ValFull(PivTotFila(cli))">@Val(PivTotFila(cli))</td>
                            <td class="rfs-tend @at">@CeldaEvolucion(cli)</td>
                        </tr>
                    </Virtualize>
                </tbody>
                <tfoot>
                    <tr>
                        <td class="rfs-col-fecha rfs-tot">TOTAL</td>
                        @foreach (var m in _meses)
                        {
                            <td class="rfs-num rfs-tot" title="@ValFull(PivTotCol(m))">@Val(PivTotCol(m))</td>
