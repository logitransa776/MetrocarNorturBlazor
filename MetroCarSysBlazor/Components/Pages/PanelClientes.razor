    private async Task Cargar()
    {
        if (_desde is null || _hasta is null) return;

        _cargando = true;
        StateHasChanged();

        _desdeAp = DateOnly.FromDateTime(_desde.Value);
        _hastaAp = DateOnly.FromDateTime(_hasta.Value);
        _focus = null;   // datos nuevos: la categoría enfocada puede ya no existir

        CalcularPeriodoBase();

        var actividad = Reports.GetClientesActividadAsync(_desdeAp, _hastaAp);
        // El período base se trae SIEMPRE, aunque la vista abierta sea otra: son consultas
        // cacheadas y así cambiar a Retención es instantáneo, sin un segundo spinner.
        var actividadBase = Reports.GetClientesActividadAsync(_bDesdeAp, _bHastaAp);
        var padron = Reports.GetClientesPadronAsync();
        var corte = Reports.GetFechaCorteDatosAsync();
        var interno = Reports.GetIdClienteInternoAsync();
        await Task.WhenAll(actividad, actividadBase, padron, corte, interno);

        _filas = actividad.Result;
        _filasBase = actividadBase.Result;
        _padronLista = padron.Result;
        // GroupBy + First en vez de ToDictionary directo: un código repetido en el padrón no
        // puede tumbar la pantalla entera con una excepción de clave duplicada.
        _padron = _padronLista
            .GroupBy(p => p.IdCliente, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
        _corte = corte.Result;
        _idInterno = interno.Result;

        Recalcular();
        RemontarGraficos();
        _cargando = false;
    }

    /// <summary>
    /// El período contra el que se compara. "Anterior" = el mismo largo pegado atrás (si el
    /// período es de 5 meses, los 5 meses previos); "Año pasado" = las mismas fechas corridas
    /// 12 meses. El primero mide el momento; el segundo saca de encima la estacionalidad, que
    /// en turismo es fuerte.
    /// </summary>
    private void CalcularPeriodoBase()
    {
        if (_periodoBase == BaseAnioPasado)
        {
            _bDesdeAp = _desdeAp.AddYears(-1);
            _bHastaAp = _hastaAp.AddYears(-1);
        }
        else
        {
            var dias = _hastaAp.DayNumber - _desdeAp.DayNumber + 1;
            _bHastaAp = _desdeAp.AddDays(-1);
            _bDesdeAp = _bHastaAp.AddDays(-(dias - 1));
        }
    }

    private async Task CambiarPeriodoBase(string b)
    {
        _periodoBase = b;
        await Cargar();   // el período base sale de otra consulta
    }

    private void CambiarDimension(string dim)
    {
        _dimension = dim;
        _focus = null;   // el foco era una categoría de la dimensión anterior
