        RemontarGraficos();
    }

    private void CambiarMetrica(string met)
    {
        _metrica = met;
        Recalcular();
        RemontarGraficos();
    }

    private void CambiarTopN(int n)
    {
        _topN = n;
        Recalcular();
        RemontarGraficos();   // cambia la FORMA del gráfico de barras
    }

    private void RemontarGraficos()
    {
        _chartsKey = Guid.NewGuid();
        _pieKey = Guid.NewGuid();
    }

    // ── Clasificación: qué categoría le toca a cada cliente ────────────────────
    //
    // Ninguna de las cuatro sale de un campo "tipo" del padrón (no existe): la línea de
    // negocio y la moneda se DERIVAN de lo que el cliente operó y facturó en el período.

    private string CategoriaDe(string idCliente, List<ClienteMesRow> filasDelCliente) => _dimension switch
    {
        ReportService.DimCliMoneda => CategoriaMoneda(filasDelCliente),
        ReportService.DimCliFiscal => _padron.TryGetValue(idCliente, out var p) ? p.Fiscal : "Sin tipo fiscal",
        ReportService.DimCliActividad => _padron.TryGetValue(idCliente, out var q) ? q.Segmento(_corte) : ClientePadronRow.SegNunca,
        _ => CategoriaLinea(idCliente, filasDelCliente),
    };

    /// <summary>
    /// Línea de negocio del cliente: la del `modo_uso` de los servicios que contrató. El cliente
    /// propio (`parametro.id_cliente`) gana siempre — sus GUARDIA/traslados a taller son internos
    /// aunque el servicio sea de transporte de personal. Mismo criterio que Banda Horaria.
    /// </summary>
    private string CategoriaLinea(string idCliente, List<ClienteMesRow> f)
    {
        if (string.Equals(idCliente, _idInterno, StringComparison.OrdinalIgnoreCase)) return "Internos";
        int t = f.Sum(x => x.ViajesTurismo), p = f.Sum(x => x.ViajesPersonal);
        if (t == 0 && p == 0) return "Sin clasificar";
        return t > p ? "Turismo" : p > t ? "Personal" : "Mixto";
    }

    /// <summary>En qué moneda se le facturó realmente al cliente en el período.</summary>
    private static string CategoriaMoneda(List<ClienteMesRow> f)
    {
        decimal pesos = f.Sum(x => x.FacturadoPesos), usd = f.Sum(x => x.FacturadoUsd);
        if (pesos <= 0 && usd <= 0) return "Sin facturar";
        if (usd > 0 && pesos > 0) return "Ambas";
        return usd > 0 ? "Dólares" : "Pesos";
    }

    private string CatDe(string cli) => _catPorCliente.TryGetValue(cli, out var c) ? c : "Sin clasificar";
    private string NombreDe(string cli) =>
        _padron.TryGetValue(cli, out var p) ? p.Display : (string.IsNullOrWhiteSpace(cli) ? "(sin cliente)" : cli);

    // ── Métrica activa ────────────────────────────────────────────────────────
    private decimal ValorDe(ClienteMesRow r) => _metrica switch
    {
        ReportService.MetCliViajes => r.Viajes,
        ReportService.MetCliPax => r.Pax,
        _ => r.Facturado,
    };

    private void Recalcular()
    {
        var porCliente = _filas.GroupBy(f => f.IdCliente)
                               .ToDictionary(g => g.Key, g => g.ToList());

        // La categoría se calcula SIEMPRE sobre el dataset completo del cliente: el foco
        // atenúa, no reclasifica.
        _catPorCliente = porCliente.ToDictionary(kv => kv.Key, kv => CategoriaDe(kv.Key, kv.Value));

        // ── Ranking: todas las filas (el foco atenúa en la tabla, no las borra) ──
        _ranking = ArmarRanking(_filas);
        _rankingBase = ArmarRanking(_filasBase);

        // Color por entidad: el ranking de categorías por la métrica define el hue, y ese
        // color acompaña a la categoría en la torta y en el punto de la tabla.
        _colorPorCat = _ranking
            .GroupBy(c => c.Categoria)
            .Select(g => (Cat: g.Key, Total: g.Sum(MetricaDe)))
            .OrderByDescending(x => x.Total)
            .Select((x, i) => (x.Cat, i))
            .ToDictionary(t => t.Cat, t => t.i < _palette.Count ? _palette[t.i] : _colorOtros);

        // ── % acumulado (Pareto): sobre el ranking COMPLETO, en el orden en que se ve ──
        var totalMetrica = _ranking.Sum(MetricaDe);
        _acumPorCliente = new();
        decimal corrido = 0;
        foreach (var c in _ranking)
        {
            corrido += MetricaDe(c);
            _acumPorCliente[c.IdCliente] = totalMetrica > 0 ? (double)(corrido * 100 / totalMetrica) : 0;
        }

        // ── Datos con el foco aplicado: KPIs, totales y pivote ──
        var enFoco = _ranking.Where(c => EnFoco(c.Categoria)).ToList();
        var idsEnFoco = enFoco.Select(c => c.IdCliente).ToHashSet();
        var filasFoco = _filas.Where(f => idsEnFoco.Contains(f.IdCliente)).ToList();

        _tFacturado = enFoco.Sum(c => c.Facturado);
        _tUsd = enFoco.Sum(c => c.FacturadoUsd);
        _tViajes = enFoco.Sum(c => c.Viajes);
        _tCancelados = enFoco.Sum(c => c.Cancelados);
        _tPax = enFoco.Sum(c => c.Pax);
        _lineasSinTc = filasFoco.Sum(f => f.LineasSinTipoCambio);

        _kClientes = enFoco.Count;
        _kFacturado = _tFacturado;
        _kViajes = _tViajes;
        _kPax = _tPax;
        var viajesActivos = _tViajes - _tCancelados;
        _kPorViaje = viajesActivos > 0 ? _tFacturado / viajesActivos : 0;

        // Subtítulos deliberadamente cortos: son 6 KPIs en una fila y el texto largo se
        // recorta con "…" (regla del patrón de informe analítico).
        var conFacturacion = enFoco.Count(c => c.Facturado > 0);
        _kClientesSub = $"{conFacturacion} facturan · {_padron.Count} en padrón";
        _kFacturadoSub = _tUsd > 0 ? $"u$s {Fmt(_tUsd)} en dólares" : "devengado al viaje";
        _kViajesSub = _tCancelados > 0
            ? $"{Fmt(_tCancelados)} cancelados ({_tCancelados * 100.0 / Math.Max(_tViajes, 1):0.0} %)"
            : "sin cancelaciones";

        // Concentración: cuánto pesan los 5 primeros. Es el KPI de riesgo de cartera.
        var top5 = enFoco.Take(5).Sum(MetricaDe);
        var totalFoco = enFoco.Sum(MetricaDe);
        _kConcentracion = totalFoco > 0 ? (double)(top5 * 100 / totalFoco) : 0;
        _kConcentracionSub = enFoco.Count > 0
            ? $"de {_metrica.ToLowerInvariant()} en {Math.Min(5, enFoco.Count)} de {enFoco.Count} clientes"
            : "sin clientes";

        // Pesos corrientes: el aviso salta cuando el período cruza años calendario.
        _avisoPesos = _metrica == ReportService.MetCliFacturado && _desdeAp.Year != _hastaAp.Year;

        // ── Gráfico de barras: top N clientes por la métrica (sigue el foco) ──
        _barItems = enFoco.Where(c => MetricaDe(c) > 0)
                          .Take(_topN)
                          .Select(c => new BarItem(Recortar(c.Nombre), MetricaDe(c)))
                          .ToList();
        _altoBarras = Math.Max(280, _barItems.Count * 32);
        AplicarEjeBarras();
        _optsBar.Colors = _barItems.Count > 0
            ? _barItems.Select(_ => "#2058D0").ToList()
            : new List<string> { "#2058D0" };

        // ── Torta por categoría: valores COMPLETOS, el foco solo cambia los colores ──
        _pieItems = _ranking
            .GroupBy(c => c.Categoria)
            .Select(g => new PieItem(g.Key, g.Sum(MetricaDe)))
            .Where(p => p.Valor > 0)
            .OrderByDescending(p => p.Valor)
            .ToList();
        _optsPie.Colors = _pieItems.Select(p => ColorFoco(p.Cat)).ToList();
        AplicarLeyendaTorta(_pieItems.Sum(p => p.Valor));

        // ── Pivote cliente × mes (con el foco aplicado) ──
        _meses = _filas.Select(f => f.Mes).Distinct().OrderBy(m => m).ToList();
        _pivMap = filasFoco
            .GroupBy(f => (f.IdCliente, f.Mes))
            .ToDictionary(g => g.Key, g => g.Sum(ValorDe));
        _pivTotFila = filasFoco.GroupBy(f => f.IdCliente).ToDictionary(g => g.Key, g => g.Sum(ValorDe));
        _pivTotCol = filasFoco.GroupBy(f => f.Mes).ToDictionary(g => g.Key, g => g.Sum(ValorDe));
        _granTotal = filasFoco.Sum(ValorDe);
        _pivClientes = enFoco.Select(c => c.IdCliente)
                             .Where(id => _pivTotFila.ContainsKey(id))
                             .ToList();

        CalcularMesesComparables();
        _mesEnCursoIncompleto = _meses.Count > _mesesComparables.Count;

        // Cobertura de facturación del último mes completo: cuántos de sus viajes ya están
        // liquidados. Es lo que explica por qué los meses recientes "facturan menos" — la
        // liquidación se emite después, y sin este dato el informe parece decir que el
        // negocio se derrumbó.
        _coberturaMes = null;
        if (EsPlata && _mesesComparables.Count > 0)
        {
            var ult = _mesesComparables[^1];
            var f = filasFoco.Where(x => x.Mes == ult).ToList();
            var activos = f.Sum(x => x.ViajesActivos);
            if (activos > 0)
            {
                var cob = f.Sum(x => x.ViajesFacturados) * 100.0 / activos;
                if (cob < 95) _coberturaMes = (MesHeader(ult), cob);
            }
        }
    }

    /// <summary>Mes y % de viajes ya liquidados, cuando el último mes completo está sin cerrar.</summary>
    private (string Mes, double Pct)? _coberturaMes;

    /// <summary>El mismo aviso de rezago, en texto, para la vista de Retención.</summary>
    private string? AvisoLiquidacionTxt => _coberturaMes is null
        ? null
        : $"<b>{_coberturaMes.Value.Mes} todavía no está liquidado del todo</b>: solo el "
          + $"<b>{_coberturaMes.Value.Pct:0}%</b> de sus viajes tiene facturación cargada.";

    /// <summary>
    /// Arma el ranking de clientes a partir de un conjunto de filas cliente × mes. Se usa para
    /// el período pedido y también para el período BASE de la vista de retención, así los dos
    /// se calculan con exactamente el mismo criterio.
    /// </summary>
    private List<ClienteResumenRow> ArmarRanking(List<ClienteMesRow> filas) => filas
        .GroupBy(f => f.IdCliente)
        .Select(g =>
        {
            var p = _padron.TryGetValue(g.Key, out var pad) ? pad : null;
            return new ClienteResumenRow(
                IdCliente: g.Key,
                Nombre: NombreDe(g.Key),
                Categoria: _catPorCliente.TryGetValue(g.Key, out var cat) ? cat : CategoriaDe(g.Key, g.ToList()),
                Viajes: g.Sum(x => x.Viajes),
                Cancelados: g.Sum(x => x.Cancelados),
                Pax: g.Sum(x => x.Pax),
                Facturado: g.Sum(x => x.Facturado),
                FacturadoUsd: g.Sum(x => x.FacturadoUsd),
                UltimaReserva: p?.UltimaReserva,
                Segmento: p?.Segmento(_corte) ?? ClientePadronRow.SegNunca,
                Fiscal: p?.Fiscal ?? "Sin tipo fiscal",
                ListaPrecio: p?.ListaPrecio ?? "");
        })
        .OrderByDescending(MetricaDe)
        .ThenBy(c => c.Nombre)
        .ToList();

    private decimal MetricaDe(ClienteResumenRow c) => _metrica switch
    {
        ReportService.MetCliViajes => c.Viajes,
        ReportService.MetCliPax => c.Pax,
        _ => c.Facturado,
    };

    private double PctDe(ClienteResumenRow c)
    {
        var total = _ranking.Sum(MetricaDe);
        return total > 0 ? (double)(MetricaDe(c) * 100 / total) : 0;
    }

    private double AcumDe(string idCliente) => _acumPorCliente.TryGetValue(idCliente, out var a) ? a : 0;

    /// <summary>
    /// Margen del eje X + formato del datalabel. El % del datalabel se calcula contra el total
    /// de las barras visibles, y los importes se abrevian (con 10 dígitos, el número no entra).
    /// </summary>
    private void AplicarEjeBarras()
    {
        // 🔴 El total se inyecta DENTRO de un literal JavaScript: hay que escribirlo con
        // cultura invariante. Con la cultura es-AR de la app, un decimal sale con coma
        // ("6112345,67") y ApexCharts revienta al parsear las opciones ("Unexpected number"),
        // dejando el gráfico vacío y tirando abajo el circuito de Blazor.
        var total = Math.Round(_barItems.Sum(b => b.Valor))
                        .ToString(System.Globalization.CultureInfo.InvariantCulture);
        var max = _barItems.Count > 0 ? _barItems.Max(b => b.Valor) : 0;
        if (_optsBar.Xaxis is not null)
        {
            _optsBar.Xaxis.Min = 0;
            _optsBar.Xaxis.Max = max > 0 ? (double)max * 1.30 : 1;
        }
        if (_optsBar.DataLabels is not null)
            _optsBar.DataLabels.Formatter = EsPlata
                // Etiqueta compacta ("$436M (8%)"): cuanto más corto el texto, menos riesgo de
                  // que se monte sobre la barra siguiente en un ranking tan desparejo.
                  ? "function(val){ var t = " + total + "; var p = t > 0 ? Math.round(val * 100 / t) : 0; " +
                  "var s = val >= 1e9 ? '$'+(val/1e9).toFixed(1)+'MM' : val >= 1e6 ? '$'+(val/1e6).toFixed(0)+'M' : '$'+Math.round(val).toLocaleString('es-AR'); " +
                  "return s + ' (' + p + '%)'; }"
                : "function(val){ var t = " + total + "; var p = t > 0 ? Math.round(val * 100 / t) : 0; " +
                  "return val.toLocaleString('es-AR') + ' (' + p + '%)'; }";
    }

    private void AplicarLeyendaTorta(decimal total)
    {
        if (_optsPie.Legend is null) return;
        // Mismo cuidado que en las barras: número invariante dentro del literal JS.
        var t = Math.Round(total).ToString(System.Globalization.CultureInfo.InvariantCulture);
        // El % se muestra con un decimal cuando la categoría pesa menos del 1%: con
        // Math.round, "Internos" e "Sin clasificar" salían como "(0%)".
        const string pct = "var p = t>0 ? (v*100/t) : 0; var ps = p>=1 ? Math.round(p) : Math.round(p*10)/10; ";
        _optsPie.Legend.Formatter = EsPlata
            ? "function(name, opts){ var v = opts.w.globals.series[opts.seriesIndex]; var t = " + t + "; " + pct +
              "var s = v >= 1e9 ? '$ '+(v/1e9).toFixed(1)+' MM' : v >= 1e6 ? '$ '+(v/1e6).toFixed(1)+' M' : '$ '+Math.round(v).toLocaleString('es-AR'); " +
              "return name + ': ' + s + ' (' + ps + '%)'; }"
            : "function(name, opts){ var v = opts.w.globals.series[opts.seriesIndex]; var t = " + t + "; " + pct +
              "return name + ': ' + v.toLocaleString('es-AR') + ' (' + ps + '%)'; }";
    }

    private bool EsPlata => _metrica == ReportService.MetCliFacturado;

    // ── Accesores del pivote ──
    private decimal PivVal(string cli, string mes) => _pivMap.TryGetValue((cli, mes), out var v) ? v : 0;
    private decimal PivTotFila(string cli) => _pivTotFila.TryGetValue(cli, out var v) ? v : 0;
    private decimal PivTotCol(string mes) => _pivTotCol.TryGetValue(mes, out var v) ? v : 0;

    // Última columna del pivote: Δ del último mes COMPLETO contra el anterior + sparkline.
    //
    // 🔴 La comparación NO usa las dos últimas columnas a secas: si el período termina a
    // mitad de mes (el caso normal, "hasta = hoy"), ese mes tiene días de menos y toda la
    // columna se llenaba de "−100%", que no dice nada. `_mesesComparables` deja afuera el mes
    // en curso; el sparkline sí dibuja la serie completa, con el último tramo punteado.
    private RenderFragment CeldaEvolucion(string? cli) => __builder =>
    {
        Func<string, decimal> serie = cli is null ? PivTotCol : mes => PivVal(cli, mes);
        var vals = _meses.Select(serie).ToList();
        var comp = _mesesComparables;

        <div class="rfs-tend-wrap">
            @if (comp.Count >= 2)
            {
                var actual = serie(comp[^1]);
                var previo = serie(comp[^2]);
                var delta = actual - previo;
                double? pct = previo > 0 ? (double)(delta * 100 / previo) : null;
                <span class="rfs-tend-delta @ClaseVar(delta)"
                      title="@($"{(cli is null ? "Total" : NombreDe(cli))} · {MesHeader(comp[^1])}: {ValFull(actual)} · {MesHeader(comp[^2])}: {ValFull(previo)}")">
                    @if (delta != 0)
                    {
                        <span class="rfs-tend-arrow">@(delta > 0 ? "▲" : "▼")</span>
                    }
                    <span>@Val(Math.Abs(delta), signo: delta < 0 ? "−" : delta > 0 ? "+" : "")</span>
                    @if (pct is not null)
                    {
                        <span class="rfs-tend-pct">@FmtPct(pct)</span>
                    }
                </span>
            }
            @Sparkline(vals)
        </div>
    };

    /// <summary>
    /// Los meses del período que están COMPLETOS (su último día entra en el rango pedido).
    /// El mes en curso queda afuera: compararlo contra un mes entero es comparar 10 días
    /// contra 31.
    /// </summary>
    private List<string> _mesesComparables = new();

    private void CalcularMesesComparables()
    {
        _mesesComparables = _meses
            .Where(m =>
            {
                if (m.Length != 7) return false;
                var y = int.Parse(m[..4]);
                var mm = int.Parse(m[5..7]);
                var ultimoDia = new DateOnly(y, mm, DateTime.DaysInMonth(y, mm));
                return ultimoDia <= _hastaAp;
            })
            .ToList();
    }

    /// <summary>¿El período corta a mitad de mes? (para avisarlo en pantalla).</summary>
    private bool _mesEnCursoIncompleto;

    private static string ClaseVar(decimal d) =>
        d > 0 ? "rfs-var-up" : d < 0 ? "rfs-var-down" : "rfs-var-flat";

    private static string FmtPct(double? p) =>
        p is null ? "" : (p.Value >= 0 ? "+" : "−") + $"{Math.Abs(p.Value):0}%";

    /// <summary>Sparkline SVG inline de la serie mensual (sin librerías), igual que Reservas.</summary>
    private MarkupString Sparkline(List<decimal> vals)
    {
        if (vals.Count < 2) return (MarkupString)"";
        const int w = 64, h = 20, pad = 2;
        decimal max = vals.Max(), min = vals.Min();
        double span = (double)(max - min);
        double dx = (w - 2.0 * pad) / (vals.Count - 1);
        double Y(decimal v) => span <= 0 ? h / 2.0 : h - pad - (double)(v - min) / span * (h - 2.0 * pad);
        var pts = string.Join(" ", vals.Select((v, i) => $"{pad + i * dx:0.#},{Y(v):0.#}"));
        var delta = vals[^1] - vals[^2];
        var color = delta > 0 ? "#16A34A" : delta < 0 ? "#DC2626" : "#94A3B8";
        var cx = pad + (vals.Count - 1) * dx;
        var cy = Y(vals[^1]);
        return (MarkupString)(
            $"<svg class=\"rfs-spark\" viewBox=\"0 0 {w} {h}\" width=\"{w}\" height=\"{h}\" preserveAspectRatio=\"none\">" +
            $"<polyline points=\"{pts}\" fill=\"none\" stroke=\"{color}\" stroke-width=\"1.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>" +
            $"<circle cx=\"{cx:0.#}\" cy=\"{cy:0.#}\" r=\"2\" fill=\"{color}\"/>" +
            "</svg>");
    }

    // ── Cross-filter ──
    private async Task ToggleFoco(string cat)
    {
        _focus = _focus == cat ? null : cat;
        Recalcular();
        _pieKey = Guid.NewGuid();   // la torta se remonta (el update en el lugar rompe su leyenda)
        // Las barras cambian de VALORES (siguen el foco) → options + series.
        if (_barChart is not null)
        {
            await _barChart.UpdateOptionsAsync(true, true, false);
            await _barChart.UpdateSeriesAsync(true);
        }
    }

    private Task LimpiarFoco() => ToggleFoco(_focus ?? "");

    private async Task OnPieSelection(SelectedData<PieItem> e)
    {
        var cat = e.DataPoint?.Items?.FirstOrDefault()?.Cat;
        if (cat is not null) await ToggleFoco(cat);
    }

    // ── Ficha del cliente (el mismo dialog que usa el ABM de Clientes) ──
    private async Task AbrirFicha(string idCliente)
    {
        if (string.IsNullOrWhiteSpace(idCliente)) return;
        // La ficha muestra la actividad del MISMO período del informe: si el usuario venía
        // mirando marzo-agosto, la solapa Actividad no puede contarle otra historia.
        var parametros = new DialogParameters<ClienteDetalleDialog>
        {
            { x => x.IdCliente, idCliente },
            { x => x.Desde, (DateOnly?)_desdeAp },
            { x => x.Hasta, (DateOnly?)_hastaAp }
        };
        var opciones = new DialogOptions
        {
            MaxWidth = MaxWidth.Large, FullWidth = true,
            CloseButton = false, CloseOnEscapeKey = true, BackdropClick = true
        };
        await DialogService.ShowAsync<ClienteDetalleDialog>("Ficha del cliente", parametros, opciones);
    }

    private async Task DescargarExcel()
    {
        // Cada vista exporta lo suyo, y con los filtros que el usuario dejó puestos: el Excel
        // tiene que ser lo que se está mirando, no un volcado genérico.
        if (_vista == VistaRetencion && _retencionPanel is not null)
        {
            var bytesRet = Excel.RetencionClientes(
                _retencionPanel.Visibles, _metrica, PeriodoTxt, PeriodoBaseTxt);
            var nombreRet = $"retencion_clientes_{_desdeAp:yyyyMMdd}_{_hastaAp:yyyyMMdd}.xlsx";
            using var streamRet = new MemoryStream(bytesRet);
            using var streamRefRet = new DotNetStreamReference(streamRet);
            await JS.InvokeVoidAsync("descargarArchivo", nombreRet, streamRefRet);
            return;
        }

        // Desde la vista Padrón, la hoja del padrón exporta exactamente las filas que se ven
        // (con el problema y el segmento filtrados): es la lista que se manda a corregir.
        var padronExcel = _vista == VistaPadron && _padronPanel is not null
            ? _padronPanel.Visibles
            : _padronLista;

        var bytes = Excel.PanelClientes(
            _ranking, _filas, _meses, padronExcel,
            EtiquetaDimSingularTit, _metrica, _corte, _desdeAp, _hastaAp);
        var nombre = _vista == VistaPadron
            ? $"padron_clientes_{_corte:yyyyMMdd}.xlsx"
            : $"panel_clientes_{_dimension.ToLower()}_{_desdeAp:yyyyMMdd}_{_hastaAp:yyyyMMdd}.xlsx";
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("descargarArchivo", nombre, streamRef);
    }

    // ── Formato ──
    private static string Fmt(int n) => n.ToString("#,0", _ar);
    private static string Fmt(decimal n) => n.ToString("#,0", _ar);
    private static string Cero(int n) => n > 0 ? Fmt(n) : "·";

    /// <summary>
    /// Importes abreviados: con miles de millones, el número completo rompe el ancho de la
    /// columna. El valor exacto va siempre en el `title` de la celda.
    /// </summary>
    private static string Plata(decimal v)
    {
        if (v == 0) return "·";
        var abs = Math.Abs(v);
        if (abs >= 1_000_000_000m) return $"$ {v / 1_000_000_000m:#,0.0} MM";
        if (abs >= 1_000_000m) return $"$ {v / 1_000_000m:#,0.0} M";
        return $"$ {v:#,0}";
    }

    private static string PlataFull(decimal v) => v == 0 ? "sin facturación" : $"$ {v.ToString("#,0.00", _ar)}";

    /// <summary>Un valor de la métrica activa, formateado como plata o como cantidad.</summary>
    private string Val(decimal v, string signo = "") =>
        EsPlata ? signo + Plata(v) : signo + (v == 0 ? "·" : Fmt(v));

    private string ValFull(decimal v) => EsPlata ? PlataFull(v) : Fmt(v) + " " + _metrica.ToLowerInvariant();

    private static string MesHeader(string mes) =>
        mes.Length == 7 ? $"{mes.Substring(5, 2)}/{mes.Substring(2, 2)}" : mes;

    private static string FechaCorta(DateOnly? f) => f is null ? "nunca" : f.Value.ToString("MM/yyyy", _ar);

    /// <summary>Nombres largos en el eje de las barras: se recortan para que no coman el gráfico.</summary>
    private static string Recortar(string s) => s.Length <= 26 ? s : s[..25] + "…";
}
