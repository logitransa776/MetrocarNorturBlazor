@* ───────────────────────────────────────────────────────────────────────────────
   /ayuda — la AYUDA ONLINE de Buslink (07/08/2026).

   Decisión del usuario: la ayuda vive DENTRO de la app, no en un sitio externo.
   Razón práctica: las PCs de la mesa de tráfico trabajan en la LAN de NORTUR; una
   ayuda alojada afuera sería justamente la que no abre el día que hace falta.

   Se llega desde el botón «Ayuda» de la barra superior y con F1 en la Planilla de
   Tráfico. Abre en pestaña nueva, así el operador no pierde la planilla.

   Layout vacío a propósito: es un documento, no una pantalla del sistema — tiene su
   propio índice lateral y su buscador. Para agregar contenido: sumar registros a la
   lista `Secciones` (el índice y el buscador se arman solos).
   ─────────────────────────────────────────────────────────────────────────────── *@

@page "/ayuda"
@layout EmptyLayout
@inject NavigationManager Nav

<PageTitle>Ayuda · Buslink</PageTitle>

<div class="doc">

    <header class="doc__top">
        <div class="doc__marca">
            <img src="images/buslink_icon_e.png" alt="BUS LINK" />
            <div>
                <div class="doc__marca-nombre">BUS LINK</div>
                <div class="doc__marca-sub">Manual del sistema</div>
            </div>
        </div>

        <div class="doc__buscador">
            <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
            <input type="search" placeholder="Buscar en la ayuda… (ej: cancelar, fletero, Excel)"
                   value="@_busca" @oninput="OnBuscar" autocomplete="off" />
            @if (!string.IsNullOrWhiteSpace(_busca))
            {
                <button type="button" class="doc__buscador-x" @onclick="LimpiarBusqueda" title="Limpiar">✕</button>
            }
        </div>

        <a class="doc__volver" href="/" title="Volver al sistema">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
            <span>Volver al sistema</span>
        </a>
    </header>

    <div class="doc__body">

        <nav class="doc__indice">
            @foreach (var modulo in Modulos)
            {
                var secs = Filtradas.Where(s => s.Modulo == modulo).ToList();
                if (secs.Count == 0) continue;

                <div class="doc__indice-mod">@modulo</div>
                @foreach (var s in secs)
                {
                    <a class="doc__indice-link" href="@($"#{s.Ancla}")">@s.Titulo</a>
                }
            }
        </nav>

        <main class="doc__contenido">
            @if (Filtradas.Count == 0)
            {
                <div class="doc__vacio">
                    <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Large" Style="opacity:.35;" />
                    <p>No hay nada con «@_busca».</p>
                    <p class="doc__vacio-hint">Probá con una palabra sola: <em>fletero</em>, <em>cancelar</em>, <em>Excel</em>, <em>permiso</em>.</p>
                </div>
            }
            else
            {
                @foreach (var modulo in Modulos)
                {
                    var secs = Filtradas.Where(s => s.Modulo == modulo).ToList();
                    if (secs.Count == 0) continue;

                    <h2 class="doc__mod">@modulo</h2>

                    @foreach (var s in secs)
                    {
                        <section class="doc__sec" id="@s.Ancla">
                            <h3 class="doc__sec-tit">@s.Titulo</h3>
                            @foreach (var p in s.Parrafos)
                            {
                                <p class="doc__p">@p</p>
                            }
                            @if (s.Puntos.Length > 0)
                            {
                                <ul class="doc__ul">
                                    @foreach (var pt in s.Puntos)
                                    {
                                        <li>@pt</li>
                                    }
                                </ul>
                            }
                        </section>
                    }
                }
            }

            <footer class="doc__pie">
                ¿Falta algo acá? Anotalo y lo sumamos: esta ayuda se actualiza junto con el sistema.
            </footer>
        </main>
    </div>
</div>

@code {
    private string _busca = "";

    private void OnBuscar(ChangeEventArgs e) => _busca = e.Value?.ToString() ?? "";
    private void LimpiarBusqueda() => _busca = "";

    private record Seccion(string Modulo, string Titulo, string[] Parrafos, string[] Puntos)
    {
        /// <summary>Ancla del índice — el título sin acentos ni espacios.</summary>
        public string Ancla => new string(Titulo.ToLowerInvariant()
            .Replace('á', 'a').Replace('é', 'e').Replace('í', 'i').Replace('ó', 'o').Replace('ú', 'u')
            .Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray());

        public bool Coincide(string q) =>
            Titulo.Contains(q, StringComparison.OrdinalIgnoreCase)
            || Modulo.Contains(q, StringComparison.OrdinalIgnoreCase)
            || Parrafos.Any(p => p.Contains(q, StringComparison.OrdinalIgnoreCase))
            || Puntos.Any(p => p.Contains(q, StringComparison.OrdinalIgnoreCase));
    }

    private List<Seccion> Filtradas =>
        string.IsNullOrWhiteSpace(_busca)
            ? Secciones
            : Secciones.Where(s => s.Coincide(_busca.Trim())).ToList();

    private static string[] Modulos => Secciones.Select(s => s.Modulo).Distinct().ToArray();

