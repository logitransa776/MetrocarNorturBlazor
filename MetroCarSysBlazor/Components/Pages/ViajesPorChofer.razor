    // ── Pivote chofer × columna (día o mes) ──
    /// <summary>Una columna del pivote. `Key` es la clave de agrupación de la fecha
    /// ("yyyy-MM-dd" por día, "yyyy-MM" por mes); `Label` lo que se ve en el header.</summary>
    private record PivCol(string Key, string Label, string Title, bool Finde);

    private List<PivCol> _pivCols = new();
    private List<string> _pivChoferes = new();                       // IdChofer, orden por total desc
    private Dictionary<(string, string), int> _pivMap = new();       // (chofer, colKey) → valor
    private HashSet<(string, string)> _pivFrancos = new();           // (chofer, colKey) sin trabajar
    private Dictionary<string, int> _pivTotFila = new();
    private Dictionary<string, int> _pivTotCol = new();
    private int _granTotal;

    // ── Código de color de la grilla (20/08/2026) ──
    /// <summary>Mezcla de una celda por tipo de servicio, en la métrica vigente. Alimenta la
    /// micro-barra de 3 colores que va al pie de cada celda.</summary>
    private readonly record struct CatMix(int Empresa, int Turismo, int Nortur)
    {
        public int Total => Empresa + Turismo + Nortur;
    }

    private Dictionary<(string, string), CatMix> _pivMix = new();   // (chofer, colKey) → mezcla
    private Dictionary<string, CatMix> _pivMixFila = new();         // chofer → mezcla (col TOTAL)
    private Dictionary<(string, string), int> _pivTotColCat = new();// (categoría, colKey) → total
    private Dictionary<string, int> _pivTotCat = new();             // categoría → gran total
    private List<string> _catsGrilla = new();                       // categorías con datos en la grilla

    /// <summary>Las sub-filas de TOTAL por categoría solo tienen sentido si hay más de una
    /// categoría a la vista: con un foco activo repetirían el TOTAL fila por fila.</summary>
    private bool MostrarSubTotales => _categoriaFocus is null && _catsGrilla.Count > 1;

    /// <summary>Alto de cada sub-fila del pie. Se usa para calcular su `bottom` (el tfoot es
    /// sticky: sin offsets propios las cuatro filas se apilarían una encima de la otra).</summary>
    private const int SubTotAlto = 24;

    /// <summary>Barra de 3 colores con la proporción Empresa/Turismo/Nortur de una celda.
    /// Devuelve "" si no hay nada que pintar. Los porcentajes van en cultura INVARIANTE: con
    /// es-AR el separador decimal es la coma y el CSS descarta el gradiente entero.</summary>
    private static string MixGradiente(CatMix m)
    {
        var tot = m.Total;
        if (tot <= 0) return "";
        var p1 = 100.0 * m.Empresa / tot;
        var p2 = p1 + 100.0 * m.Turismo / tot;
        string P(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
        return $"linear-gradient(to right, {ColorCat("Empresa")} 0 {P(p1)}, " +
               $"{ColorCat("Turismo")} {P(p1)} {P(p2)}, {ColorCat("Nortur")} {P(p2)} 100%)";
    }

    /// <summary>Suma un conjunto de filas separando por tipo de servicio, en una sola pasada
    /// (la grilla puede tener decenas de miles de filas: tres Where anidados costaban tres).</summary>
    private static CatMix MixDe(IEnumerable<ViajesChoferRow> filas, Func<ViajesChoferRow, int> val)
    {
        int e = 0, t = 0, n = 0;
        foreach (var f in filas)
        {
            var v = val(f);
            switch (f.Categoria)
            {
                case "Empresa": e += v; break;
                case "Turismo": t += v; break;
                case "Nortur": n += v; break;
            }
        }
        return new CatMix(e, t, n);
    }

    /// <summary>`bottom` de una fila del pie sticky: cuántas filas tiene por debajo.</summary>
    private static string BottomPie(int filasDebajo) => $"bottom:{filasDebajo * SubTotAlto}px;";

    private int PivTotColCat(string cat, string colKey) => _pivTotColCat.GetValueOrDefault((cat, colKey));

    /// <summary>Como FmtMetrica, pero el cero se dibuja como el punto medio de la grilla (·) en
    /// vez de un "0" que ensucia la lectura de la fila.</summary>
    private string FmtCero(int valor) => valor == 0 ? "·" : FmtMetrica(valor);

    private string MixCelda(string chofer, string colKey) =>
        _pivMix.TryGetValue((chofer, colKey), out var m) ? MixGradiente(m) : "";
    private string MixFila(string chofer) =>
        _pivMixFila.TryGetValue(chofer, out var m) ? MixGradiente(m) : "";

    private static bool EsFinde(DateOnly d) => d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
    /// <summary>Clave de columna de una fecha según la agrupación vigente.</summary>
    private string ColKeyDe(DateOnly d) => _porMes ? d.ToString("yyyy-MM") : d.ToString("yyyy-MM-dd");
    private static string CapFirst(string s) => s.Length == 0 ? s : char.ToUpper(s[0]) + s[1..];

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthState.EstaAutenticadoAsync())
        {
            Nav.NavigateTo($"/login?destino={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: false);
            return;
        }
        if (!Permisos.Tiene('V'))   // módulo Vehículos y Choferes
        {
            Nav.NavigateTo("/", forceLoad: false);
            return;
        }
        _vehiculos = await Reports.GetVehiculosTipoAsync();
        _vehiculosSel = new HashSet<string>(_vehiculos.Select(v => v.Id));
        await Cargar();
    }

    // El período Desde–Hasta no puede superar este ancho: rangos más largos pegan contra
    // millones de filas de viaje y afectan la performance del servidor (pedido del usuario, 20/08/2026).
    private const int RangoMaximoDias = 95;   // 3 meses

    // Días elegidos hoy en los pickers (sin aplicar todavía). 0 si falta alguna fecha.
    private int RangoDiasElegidos =>
        _desde is null || _hasta is null ? 0 : (int)(_hasta.Value.Date - _desde.Value.Date).TotalDays;

    private async Task Cargar()
    {
        if (_desde is null || _hasta is null) return;

        if (RangoDiasElegidos > RangoMaximoDias)
        {
            // Cartel "Contorno" — estándar del proyecto para validaciones bloqueantes (ver app.css § nt-toast-contorno).
            Snackbar.Add(
                $"El rango Desde–Hasta no puede superar los {RangoMaximoDias} días (elegiste {RangoDiasElegidos}). Achicá el período e intentá de nuevo.",
                Severity.Error,
                config =>
                {
                    config.SnackbarVariant = Variant.Outlined;
                    config.SnackbarTypeClass = "nt-toast-contorno";
                });
            return;
        }

        _cargando = true;
        StateHasChanged();

        _fDesdeAp = DateOnly.FromDateTime(_desde.Value);
        _fHastaAp = DateOnly.FromDateTime(_hasta.Value);
        _catAp = _todasCategorias ? new List<string>() : _categoriasSel.ToList();
        _choAp = _todosTiposChofer ? new List<string>() : _tipoChoferSel.ToList();
        _vehAp = _todosVehiculos ? new List<string>() : _vehiculosSel.ToList();
        _aplicadoAlgunaVez = true;
        _detalle = null;
        _choferFocus = null;
        _categoriaFocus = null;
        _buscarChofer = "";

        // Rango largo → columnas por mes (salvo que el usuario ya haya elegido a mano).
        if (!_agrupacionManual)
            _porMes = _fHastaAp.DayNumber - _fDesdeAp.DayNumber + 1 > DiasParaAgruparPorMes;

        _filas = await Reports.GetViajesPorChoferAsync(_fDesdeAp, _fHastaAp, _catAp, _choAp, _vehAp);
        await CalcularInactivosYVencimientosAsync();
        Recalcular();
        _chartsKey = Guid.NewGuid();
        _barsKey = Guid.NewGuid();

        _cargando = false;
    }

    /// <summary>Choferes sin actividad (padrón activo vs quién viajó) y choferes en actividad
    /// con documentación por vencer (cruce con Agenda de Vencimientos). Ambos reusan métodos
    /// de <see cref="ReportService"/> ya cacheados — no agregan queries nuevas.</summary>
    private async Task CalcularInactivosYVencimientosAsync()
    {
        var padron = await Reports.GetChoferesAsync();
        var roster = padron.Where(c => c.FInhabilitacion is null).ToList();
        // El padrón se recorta al mismo Tipo de chofer aplicado (Propio/Contratado), para no
        // comparar contra choferes que el filtro ya excluyó del todo.
        if (_choAp.Count == 1)
        {
            roster = _choAp[0] == "Contratado"
                ? roster.Where(c => c.Fletero.Length > 0).ToList()
                : roster.Where(c => c.Fletero.Length == 0).ToList();
        }
        var idsPeriodo = _filas.Select(f => f.IdChofer).ToHashSet();
        _rosterActivo = roster;
        _choferesInactivos = roster.Where(c => !idsPeriodo.Contains(c.Codigo.Trim()))
            .OrderBy(c => c.Nombre).ToList();

        var (diasChofer, _, _) = await Reports.GetParametrosAvisoAsync();
        _diasAvisoChofer = diasChofer;
        _choferesConActividad = idsPeriodo.Count;

        // Viajes del período por chofer — alimenta el subtítulo de cada fila del modal
        // ("Nortur · 34 viajes en el período"): sin eso el modal no dice cuánto pesa el caso.
        var viajesPorChofer = _filas.GroupBy(f => f.IdChofer)
            .ToDictionary(g => g.Key, g => g.Sum(x => x.Viajes));

        var hoy = DateOnly.FromDateTime(DateTime.Today);
        var porVencer = await Reports.GetChoferesPorVencerAsync(diasChofer);
        // 🔴 La query trae a CASI TODO el padrón porque su ISNULL(registro_4,'1900-01-01')
        // toma el AEP en blanco como vencido, y 227 de 254 choferes activos lo tienen vacío
        // (el AEP es solo para los que entran al aeropuerto). Por eso el filtro fino se hace
        // acá con VencimientosChofer: entra al aviso solo el que tiene algo REAL para revisar.
        _choferesVencidos = porVencer
            .Where(v => idsPeriodo.Contains(v.IdChofer.Trim()))
            .Select(v => VencimientosChofer.Clasificar(
                v, viajesPorChofer.GetValueOrDefault(v.IdChofer.Trim()), hoy, diasChofer))
            .Where(v => v.Alerta)
            .ToList();

        _docVencidos = _choferesVencidos.Count(v => v.Peor == DocEstado.Vencido);
        _docPorVencer = _choferesVencidos.Count(v => v.Peor == DocEstado.PorVencer);
    }

    private void CambiarMetrica(string metrica)
    {
        _metrica = metrica;
        if (_filas.Count > 0) { Recalcular(); _chartsKey = Guid.NewGuid(); _barsKey = Guid.NewGuid(); }
    }

    private void CambiarTopN(int topN)
    {
        // Cambia la cantidad de barras (la FORMA del gráfico) → remonte, no update.
        _topN = topN;
        if (_filas.Count > 0) { Recalcular(); _barsKey = Guid.NewGuid(); }
    }

    /// <summary>Día ↔ mes: solo cambia la FORMA de la tabla (sus columnas). No toca los
    /// gráficos ni vuelve a la base.</summary>
    private void CambiarAgrupacion(bool porMes)
    {
        _porMes = porMes;
        _agrupacionManual = true;
        if (_filas.Count > 0) Recalcular();
    }

    private void Recalcular()
    {
        // Horas: `val` devuelve MINUTOS (el campo `Minutos` de la fila, ver ViajesChoferRow) —
        // se formatea a "Xh Ym" recién al mostrarlo (FmtMetrica). Mantiene el mismo tipo `int`
        // en todos los diccionarios/acumuladores del pivote, sin tocar su forma.
        Func<ViajesChoferRow, int> val = _metrica switch
        {
            "Km" => f => f.Km,
            "Pax" => f => f.Pax,
            "Horas" => f => f.Minutos,
            _ => f => f.Viajes
        };

        // Los tres subconjuntos del cross-filter de dos dimensiones:
        //  · datos     → ambos focos (KPIs y evolución)
        //  · datosCat  → solo el foco de tipo de servicio (barras y GRILLA: el foco de chofer
        //                en esos visuales es resaltado, no filtro)
        //  · datosCho  → solo el foco de chofer (torta de tipo de servicio)
        bool PasaCat(ViajesChoferRow f) => _categoriaFocus is null || f.Categoria == _categoriaFocus;
        bool PasaCho(ViajesChoferRow f) => _choferFocus is null || f.IdChofer == _choferFocus;
        var datos = _filas.Where(f => PasaCat(f) && PasaCho(f)).ToList();
        var datosCat = _categoriaFocus is null ? _filas : _filas.Where(PasaCat).ToList();
        var datosCho = _choferFocus is null ? _filas : _filas.Where(PasaCho).ToList();

        _nombrePorChofer = _filas.GroupBy(f => f.IdChofer).ToDictionary(g => g.Key, g => g.First().Chofer);
        _catsPresentes = ReportService.CategoriasServicio
            .Where(c => _filas.Any(f => f.Categoria == c)).ToList();

        // ── KPIs ──
        _totalMetrica = datos.Sum(val);
        var diasActivos = datos.Select(f => (f.IdChofer, f.Fecha)).Distinct().Count();
        _promedioDia = diasActivos > 0 ? (int)Math.Round((double)_totalMetrica / diasActivos) : 0;
        _choferesActivos = datos.Select(f => f.IdChofer).Distinct().Count();

        // Mezcla de categorías: SIN el foco de tipo de servicio (ver MixSub).
        _mixEmpresa = datosCho.Where(f => f.Categoria == "Empresa").Sum(f => f.Viajes);
        _mixTurismo = datosCho.Where(f => f.Categoria == "Turismo").Sum(f => f.Viajes);
        _mixNortur = datosCho.Where(f => f.Categoria == "Nortur").Sum(f => f.Viajes);
        var totalMix = _mixEmpresa + _mixTurismo + _mixNortur;
        _pctTurismo = totalMix > 0 ? (int)Math.Round(100.0 * _mixTurismo / totalMix) : 0;

        var porChofer = datos.GroupBy(f => f.IdChofer)
            .Select(g => (Id: g.Key, Total: g.Sum(val)))
            .OrderByDescending(x => x.Total).ToList();
        _choferLider = porChofer.Count > 0 ? NombreDe(porChofer[0].Id) : "—";
        _maxChofer = porChofer.Count > 0 ? porChofer[0].Total : 0;

        // ── Columnas del pivote (día o mes), recorriendo TODO el rango aplicado ──
        _pivCols = new();
        if (_porMes)
        {
            for (var d = new DateOnly(_fDesdeAp.Year, _fDesdeAp.Month, 1); d <= _fHastaAp; d = d.AddMonths(1))
                _pivCols.Add(new PivCol(d.ToString("yyyy-MM"),
                                        CapFirst(d.ToString("MMM yy", Cult)),
                                        CapFirst(d.ToString("MMMM yyyy", Cult)),
                                        Finde: false));
        }
        else
        {
            for (var d = _fDesdeAp; d <= _fHastaAp; d = d.AddDays(1))
                _pivCols.Add(new PivCol(d.ToString("yyyy-MM-dd"),
                                        d.ToString("dd/MM"),
                                        CapFirst(d.ToString("dddd dd/MM", Cult)),
                                        EsFinde(d)));
        }
        var idxCol = _pivCols.Select((c, i) => (c.Key, i)).ToDictionary(t => t.Key, t => t.i);

        // ── Celdas: valor con el foco de tipo de servicio aplicado ──
        //    Se agrupa UNA sola vez y de ahí salen las dos cosas: el número de la celda y su
        //    mezcla por tipo de servicio (la micro-barra de 3 colores).
        var celdas = datosCat.GroupBy(f => (f.IdChofer, Col: ColKeyDe(f.Fecha))).ToList();
        _pivMap = celdas.ToDictionary(g => g.Key, g => g.Sum(val));
        _pivMix = celdas.ToDictionary(g => g.Key, g => MixDe(g, val));

        // ── Francos: se calculan SIEMPRE sobre el dataset COMPLETO (todas las categorías).
        //    Un "franco" es un día que el chofer no trabajó NADA; si filtramos por Turismo, un
        //    día en que hizo Empresa NO es franco (trabajó) → ahí la celda queda en "·". ──
        _pivFrancos = new();
        _diasFranco = 0;
        foreach (var g in _filas.GroupBy(f => f.IdChofer))
        {
            // Franco por COLUMNA (para la grilla): huecos entre la primera y la última con
            // actividad del chofer. Mismo criterio que el FoxPro, generalizado a día/mes.
            var colsConDatos = g.Select(x => ColKeyDe(x.Fecha)).Distinct()
                                .Where(idxCol.ContainsKey).Select(k => idxCol[k]).ToList();
            if (colsConDatos.Count > 0)
            {
                var conDatos = colsConDatos.ToHashSet();
                for (var i = colsConDatos.Min(); i <= colsConDatos.Max(); i++)
                    if (!conDatos.Contains(i)) _pivFrancos.Add((g.Key, _pivCols[i].Key));
            }

            // Franco por DÍA (para el KPI): siempre en días, no cambia con la agrupación.
            var dias = g.Select(x => x.Fecha).Distinct().OrderBy(x => x).ToList();
            var conDatosDia = dias.ToHashSet();
            for (var d = dias.First(); d <= dias.Last(); d = d.AddDays(1))
                if (!conDatosDia.Contains(d)) _diasFranco++;
        }

        // Totales de la grilla: con el foco de tipo de servicio, SIN el de chofer (que en la
        // grilla resalta pero no filtra) → los totales cierran con las filas que se ven.
        _pivTotFila = datosCat.GroupBy(f => f.IdChofer).ToDictionary(g => g.Key, g => g.Sum(val));
        _pivChoferes = datosCat.GroupBy(f => f.IdChofer)
            .Select(g => (Id: g.Key, Total: g.Sum(val)))
            .OrderByDescending(x => x.Total).ThenBy(x => NombreDe(x.Id))
            .Select(x => x.Id).ToList();
        _pivTotCol = _pivCols.ToDictionary(
            c => c.Key,
            c => datosCat.Where(f => ColKeyDe(f.Fecha) == c.Key).Sum(val));
        _granTotal = datosCat.Sum(val);

        // ── Código de color de la grilla: mezcla de la columna TOTAL y totales por categoría
        //    (las sub-filas del pie). Todo sale de `datosCat` — el mismo dataset que los
        //    números de la grilla — así los colores siempre cierran con lo que se ve. ──
        _pivMixFila = datosCat.GroupBy(f => f.IdChofer).ToDictionary(g => g.Key, g => MixDe(g, val));
        _catsGrilla = ReportService.CategoriasServicio.Where(c => datosCat.Any(f => f.Categoria == c)).ToList();
        _pivTotColCat = new();
        _pivTotCat = new();
        foreach (var cat in _catsGrilla)
        {
            var deCat = datosCat.Where(f => f.Categoria == cat).ToList();
            _pivTotCat[cat] = deCat.Sum(val);
            foreach (var g in deCat.GroupBy(f => ColKeyDe(f.Fecha)))
                _pivTotColCat[(cat, g.Key)] = g.Sum(val);
        }

        RecalcularPivMostrados();

        // ── Evolución diaria (Empresa/Turismo/Nortur) — filtrada por el foco de chofer.
        //    Las 3 series van SIEMPRE (con 0 si el foco las vacía) para que el update en el
        //    lugar no tenga que reordenar series. Oculto en pantalla (MostrarEvolucionDiaria)
        //    pero se sigue calculando: reactivar el panel no necesita tocar esto. ──
        var evolPorDia = datosCho.GroupBy(f => f.Fecha)
            .ToDictionary(g => g.Key, g => g.ToList());
        _evolData = new();
        for (var d = _fDesdeAp; d <= _fHastaAp; d = d.AddDays(1))
        {
            evolPorDia.TryGetValue(d, out var delDia);
            int Cat(string c) => delDia?.Where(f => f.Categoria == c).Sum(f => f.Viajes) ?? 0;
            _evolData.Add(new EvolItem(d.ToString("dd/MM"), Cat("Empresa"), Cat("Turismo"), Cat("Nortur")));
        }

        // ── Ranking de choferes + desglose por categoría (para las barras apiladas) ──
        // El orden sale del dataset con el foco de tipo de servicio: enfocando "Turismo" el
        // gráfico tiene que contestar "quién hace más turismo", no repetir el ranking general
        // con quince barras en cero. Por eso el chart se remonta (_barsKey).
        var porChoferCat = datosCat.GroupBy(f => f.IdChofer)
            .Select(g => (
                Id: g.Key,
                Nombre: g.First().Chofer,
                Empresa: g.Where(f => f.Categoria == "Empresa").Sum(val),
                Turismo: g.Where(f => f.Categoria == "Turismo").Sum(val),
                Nortur: g.Where(f => f.Categoria == "Nortur").Sum(val),
                Total: g.Sum(val)))
            .OrderByDescending(x => x.Total).ThenBy(x => x.Nombre).ToList();
        _rankingChoferes = porChoferCat.Select(x => (x.Id, x.Nombre, x.Total)).ToList();

        var nombresRepetidos = porChoferCat.GroupBy(x => x.Nombre)
            .Where(g => g.Count() > 1).Select(g => g.Key).ToHashSet();
        // La selección COMPLETA del usuario (lo que pide el combo "Mostrar"). De acá salen las
        // filas de la tabla del PDF; `_barItems` (el gráfico) puede ser un recorte de esto —
        // ver AplicarTopeBarras.
        _pdfFilas = porChoferCat.Take(_topN)
            .Select(x => new BarStackItem(x.Id,
                nombresRepetidos.Contains(x.Nombre) ? $"{x.Nombre} ({x.Id})" : x.Nombre,
                x.Empresa, x.Turismo, x.Nortur))
            .ToList();
        AplicarTopeBarras();

        // ── Donut tipo de servicio — valores con el foco de CHOFER; las 3 porciones siempre
        //    presentes y en orden fijo (Empresa/Turismo/Nortur), como pide el update en el
        //    lugar. El foco de categoría acá RESALTA (por color), no filtra. ──
        _donutOrigen = ReportService.CategoriasServicio
            .Select(c => new DonutItem(c, datosCho.Where(f => f.Categoria == c).Sum(val)))
            .ToList();

        // Colores de las barras: ahora son por CATEGORÍA (fijos, con el highlight del foco de
        // tipo de servicio), no por chofer — mismo criterio que la torta.
        _optsBarCho.Colors = ReportService.CategoriasServicio.Select(ColorFocoCat).ToList();
        _optsPie.Colors = _donutOrigen.Select(d => ColorFocoCat(d.Label)).ToList();

        // Tooltip de barras/torta en Horas: minutos → "Xh Ym", igual que la pantalla.
        var formatterVal = _metrica == "Horas"
            ? "function(val){ var h=Math.floor(val/60), m=Math.round(val%60); return h+'h'+(m>0?' '+m+'m':''); }"
            : "function(val){ return val.toLocaleString('es-AR'); }";
        _optsBarCho.Tooltip = new() { Y = new() { Formatter = formatterVal } };
        _optsPie.Tooltip = new() { Y = new() { Formatter = formatterVal } };
    }

    private int? PivValor(string cho, string colKey) =>
        _pivMap.TryGetValue((cho, colKey), out var v) ? v : null;
    private bool EsFranco(string cho, string colKey) => _pivFrancos.Contains((cho, colKey));
    private int PivTotFila(string cho) => _pivTotFila.TryGetValue(cho, out var v) ? v : 0;
    private int PivTotCol(string colKey) => _pivTotCol.TryGetValue(colKey, out var v) ? v : 0;

    // ── Buscador de chofer (filtra la lista de la grilla en memoria) ──
    private void RecalcularPivMostrados()
    {
        _pivChoferesMostrados = string.IsNullOrWhiteSpace(_buscarChofer)
            ? _pivChoferes
            : _pivChoferes.Where(id => NombreDe(id).Contains(_buscarChofer.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void OnBuscarChoferChanged(string? valor)
    {
        _buscarChofer = valor ?? "";
        RecalcularPivMostrados();
    }

    // ── Cross-filter (2 dimensiones) ──
    private async Task ToggleFocoChofer(string id)
    {
        _choferFocus = _choferFocus == id ? null : id;
        Recalcular();
        // El foco de chofer ya no toca el gráfico de barras (su color es por categoría, no por
        // chofer): recalcula KPIs/torta/evolución. El chofer se resalta en la TABLA (fila
        // atenuada), que es de donde sale este foco.
        await ActualizarGraficos();
    }

    private Task ToggleFocoCategoria(string cat) =>
        AplicarCategoriaFoco(_categoriaFocus == cat ? null : cat);

    private Task LimpiarFocoChofer() => ToggleFocoChofer(_choferFocus ?? "");
    private Task LimpiarFocoCategoria() => AplicarCategoriaFoco(null);

    /// <summary>El combo de tipo de servicio de la grilla, el clic en la torta y el clic en un
    /// tramo/leyenda de las barras mueven el MISMO estado (`_categoriaFocus`): son accesos a la
    /// misma perilla.</summary>
    private Task CambiarCategoriaFoco(string valor) =>
        AplicarCategoriaFoco(string.IsNullOrEmpty(valor) ? null : valor);

    private async Task AplicarCategoriaFoco(string? cat)
    {
        _categoriaFocus = cat;
        Recalcular();
        // Las barras se RE-ORDENAN con este foco → van por remonte (@key), no por update:
        // actualizar en el lugar un chart cuyo eje cambió de categorías lo deja inconsistente.
        _barsKey = Guid.NewGuid();
        await ActualizarGraficos();
    }

    private async Task ActualizarGraficos()
    {
        // El foco cambia VALORES (no solo colores) en los charts de la otra dimensión →
        // hace falta UpdateOptions + UpdateSeries, no alcanza con uno solo. Las barras NO se
        // actualizan acá: el foco de categoría las remonta por @key y el de chofer no las toca.
        if (_evolChart is not null) { await _evolChart.UpdateSeriesAsync(true); }
        if (_pieChart is not null) { await _pieChart.UpdateOptionsAsync(true, true, false); await _pieChart.UpdateSeriesAsync(true); }
    }

    private async Task OnBarChoSelection(SelectedData<BarStackItem> e)
    {
        // El color del tramo clickeado ES la categoría (Empresa/Turismo/Nortur): clic enfoca
        // por tipo de servicio, igual que un clic en la torta. Enfocar por CHOFER se hace desde
        // el nombre en la tabla de abajo.
        var cat = e.Series?.Name;
        if (cat is not null) await ToggleFocoCategoria(cat);
    }

    private Task OnBarLegendClicked(LegendClicked<BarStackItem> e) =>
        e.Series?.Name is string cat ? ToggleFocoCategoria(cat) : Task.CompletedTask;

    private async Task OnPieCatSelection(SelectedData<DonutItem> e)
    {
        var cat = e.DataPoint?.Items?.FirstOrDefault()?.Label;
        if (cat is not null) await ToggleFocoCategoria(cat);
    }

    private async Task OnPieCatLegendClicked(LegendClicked<DonutItem> e)
    {
        var cat = e.Series?.Name ?? e.DataPoint?.Items?.FirstOrDefault()?.Label;
        if (cat is not null) await ToggleFocoCategoria(cat);
    }

    // ── Choferes sin actividad / documentación por vencer (listados) ──
    private async Task VerInactivos()
    {
        if (_choferesInactivos.Count == 0) return;
        var msg = string.Join("\n", _choferesInactivos.Select(c =>
            string.IsNullOrEmpty(c.Localidad) ? $"• {c.Nombre}" : $"• {c.Nombre} ({c.Localidad})"));
        await DialogService.ShowMessageBoxAsync(
            $"Choferes sin actividad en el período ({_choferesInactivos.Count})",
            msg, yesText: "Cerrar");
    }

    /// <summary>Abre la tabla semáforo de documentación. <paramref name="filtro"/> viene del
    /// chip que se clickeó ("vencidos" / "porvencer") o "todos" desde el botón Ver detalle.</summary>
    private async Task VerVencimientos(string filtro)
    {
        if (_choferesVencidos.Count == 0) return;
        var parametros = new DialogParameters
        {
            { "Filas", _choferesVencidos },
            { "DiasAviso", _diasAvisoChofer },
            { "ConActividad", _choferesConActividad },
            { "Periodo", $"{_fDesdeAp:dd/MM/yyyy} – {_fHastaAp:dd/MM/yyyy}" },
            { "FiltroInicial", filtro }
        };
        var opciones = new DialogOptions
        {
            MaxWidth = MaxWidth.Large, FullWidth = true,
            CloseButton = false, CloseOnEscapeKey = true, BackdropClick = true
        };
        await DialogService.ShowAsync<ChoferesVencimientosDialog>("Documentación de choferes", parametros, opciones);
    }

    // ── Drill-down ──
    private async Task<List<ViajesChoferDetalleRow>> GetDetalleAsync()
    {
        if (_detalle is null)
        {
            _cargandoDet = true;
            StateHasChanged();
            _detalle = await Reports.GetViajesPorChoferDetalleAsync(_fDesdeAp, _fHastaAp, _catAp, _choAp, _vehAp);
            _cargandoDet = false;
        }
        return _detalle;
    }

    // El número que se ve en la grilla ya está recortado por el foco de tipo de servicio →
    // el detalle tiene que filtrar igual, o el dialog mostraría más viajes que la celda.
    private bool PasaFocoCat(ViajesChoferDetalleRow d) => _categoriaFocus is null || d.Categoria == _categoriaFocus;
    private bool PasaFocoChofer(ViajesChoferDetalleRow d) => _choferFocus is null || d.IdChofer == _choferFocus;
    private string SufijoFoco => _categoriaFocus is null ? "" : $" · {_categoriaFocus}";

    private Task AbrirDetalleCelda(string id, PivCol col) =>
        AbrirDetalle(d => d.IdChofer == id && ColKeyDe(d.Fecha) == col.Key && PasaFocoCat(d),
                     $"{NombreDe(id)} — {col.Title}{SufijoFoco}");

    private Task AbrirDetalleChofer(string id) =>
        AbrirDetalle(d => d.IdChofer == id && PasaFocoCat(d),
                     $"{NombreDe(id)} — todo el período{SufijoFoco}");

    private Task AbrirDetalleCol(PivCol col) =>
        AbrirDetalle(d => ColKeyDe(d.Fecha) == col.Key && PasaFocoCat(d) && PasaFocoChofer(d),
                     $"{(_choferFocus is null ? "Todos los choferes" : NombreDe(_choferFocus))} — {col.Title}{SufijoFoco}");

    private async Task AbrirDetalle(Func<ViajesChoferDetalleRow, bool> filtro, string subtitulo)
    {
        var todas = await GetDetalleAsync();
        var items = todas.Where(filtro).Select(d => d.Reserva).ToList();
        if (items.Count == 0) return;

        var parametros = new DialogParameters<ReservasFsDetalleDialog>
        {
            { x => x.Items, items },
            { x => x.Subtitulo, subtitulo }
        };
        var opciones = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge, FullWidth = true,
            CloseButton = false, CloseOnEscapeKey = true, BackdropClick = true
        };
        await DialogService.ShowAsync<ReservasFsDetalleDialog>("Detalle de viajes", parametros, opciones);
    }

    private async Task DescargarExcel()
    {
        var viajes = await GetDetalleAsync();
        // El Excel sale con el mismo recorte que la pantalla (tipo de servicio y agrupación).
        var viajesFiltrados = viajes.Where(PasaFocoCat).ToList();
        var bytes = Excel.ViajesPorChofer(_filas, _metrica, _fDesdeAp, _fHastaAp,
                                          _porMes, _categoriaFocus, viajesFiltrados);
        var sufijo = _categoriaFocus is null ? "" : $"_{_categoriaFocus.ToLowerInvariant()}";
        var nombre = $"viajes_por_chofer_{_fDesdeAp:yyyyMMdd}_{_fHastaAp:yyyyMMdd}{sufijo}.xlsx";
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("descargarArchivo", nombre, streamRef);
    }

    /// <summary>Exporta el panel "… por chofer" a PDF (20/08/2026). Mismo patrón que el
    /// comprobante de Liquidación a Clientes (<c>imprimirElemento</c>, ver descarga.js): abre
    /// el bloque <c>#vpc-barras-print</c> en una ventana aislada y dispara la impresión — el
    /// usuario elige "Guardar como PDF" del navegador. Cero dependencias de servidor.
    /// Apaisado ("landscape"): el gráfico es más ancho que alto, a diferencia del comprobante
    /// de Liquidación (vertical, tipo factura) que usa el default "portrait" de la función.
    /// Margen 0: sin área de margen, Chrome no tiene dónde dibujar SU encabezado/pie
    /// (fecha · about:blank · nº de hoja) — el respiro de la hoja lo pone `.pdf-hoja`.</summary>
    private async Task ExportarBarrasPdf()
    {
        if (_exportando) return;
        _exportando = true;
        try
        {
            // Modo PDF: recorta el gráfico para que entre en una hoja (ver AplicarTopeBarras).
            // Hay que esperar a que ApexCharts redibuje el SVG antes de mandar a imprimir —
            // es un ida y vuelta por SignalR + el remonte que fuerza `_barsKey`.
            _modoPdf = true;
            AplicarTopeBarras();
            _barsKey = Guid.NewGuid();
            StateHasChanged();
            await Task.Delay(900);

            var titulo = $"{UnidadMetricaCap} por chofer - {_fDesdeAp:dd-MM-yyyy} a {_fHastaAp:dd-MM-yyyy}";
            await JS.InvokeVoidAsync("imprimirElemento", "vpc-barras-print", titulo, "landscape", 0);
            await Task.Delay(500);   // que la ventana termine de tomar el DOM antes de restaurar
        }
        finally
        {
            _modoPdf = false;
            AplicarTopeBarras();
            _barsKey = Guid.NewGuid();
            _exportando = false;
        }
    }

    /// <summary>Los filtros con los que se armó lo que se está viendo, en una línea, para el
    /// encabezado del PDF. Sale del snapshot APLICADO (`_catAp` y compañía), no de lo que esté
    /// en edición arriba: si no, el PDF diría un filtro y los números serían de otro.</summary>
    private string FiltrosAplicadosTexto()
    {
        string Lista(List<string> aplicados, string todos) =>
            aplicados.Count == 0 ? todos : string.Join(" + ", aplicados);

        var vehiculos = _vehAp.Count == 0
            ? "todos"
            : string.Join(" + ", _vehAp.Select(id => _vehiculos.FirstOrDefault(v => v.Id == id)?.Nombre ?? id));

        var partes = new List<string>
        {
            $"Período {_fDesdeAp:dd/MM/yyyy} – {_fHastaAp:dd/MM/yyyy}",
            $"Métrica: {UnidadMetricaCap}",
            $"Tipo de servicio: {Lista(_catAp, "todos")}",
            $"Tipo de chofer: {Lista(_choAp, "todos")}",
            $"Tipo de vehículo: {vehiculos}"
        };

        // El foco del cross-filter también recorta los números: si está puesto, va en el PDF.
        if (_categoriaFocus is not null) partes.Add($"Enfocado en: {_categoriaFocus}");
        if (_choferFocus is not null) partes.Add($"Chofer: {NombreDe(_choferFocus)}");

        return string.Join("  ·  ", partes);
    }

    private static string Fmt(int n) => n.ToString("#,0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));

    // Formatea un valor de la métrica ACTIVA: en Horas convierte minutos → "Xh Ym" (el dato
    // sigue siendo un int de minutos en todo el pivote/KPIs, ver el comentario en `val` de
    // Recalcular); en las demás métricas es el Fmt de siempre (miles con separador).
    private string FmtMetrica(int valor) => _metrica == "Horas" ? FmtHoras(valor) : Fmt(valor);
    private static string FmtHoras(int minutos)
    {
        var h = minutos / 60;
        var m = minutos % 60;
        return m == 0 ? $"{h}h" : $"{h}h {m:00}m";
    }
}
