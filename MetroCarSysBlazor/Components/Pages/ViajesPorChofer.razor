@page "/viajes-por-chofer"
@using ApexCharts
@using MudColor = MudBlazor.Color
@using MudSize = MudBlazor.Size
@inject ReportService Reports
@inject ExcelExportService Excel
@inject NorturAuthStateProvider AuthState
@inject IPermissionService Permisos
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<PageTitle>BusLink</PageTitle>

@* ── Encabezado de página ── *@
<div class="page-header mb-3">
    <MudText Typo="Typo.h5" Style="font-weight:800; color:#112F5B;">
        Viajes por chofer
    </MudText>
    <MudText Typo="Typo.body2" Style="color:#7A90AD; margin-top:2px;">
        Nortur · actividad diaria de los choferes: viajes, tipo de servicio y kilómetros
    </MudText>
</div>

@* ── Barra de filtros (horizontal, compacta) — mismo patrón que los otros informes ── *@
<MudPaper Elevation="1" Class="rfs-filtros mb-4">
    <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="MudSize.Small" Style="color:#003AA0; flex-shrink:0;" />

    <div class="rfs-fechas">
        <MudDatePicker Label="Desde" @bind-Date="_desde"
                       MinDate="_min" MaxDate="_max" DateFormat="dd/MM/yyyy"
                       PickerVariant="PickerVariant.Dialog" Editable="true"
                       Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:160px;" />
        <MudDatePicker Label="Hasta" @bind-Date="_hasta"
                       MinDate="_min" MaxDate="_max" DateFormat="dd/MM/yyyy"
                       PickerVariant="PickerVariant.Dialog" Editable="true"
                       Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:160px;" />
        @* Aviso en vivo: el rango tiene tope (ver RangoMaximoDias). Se muestra ANTES de apretar
           "Aplicar filtros" para que el usuario no crea que la pantalla se rompió. *@
        @if (RangoDiasElegidos > RangoMaximoDias)
        {
            <MudTooltip Text="@($"Elegiste {RangoDiasElegidos} días. El máximo es {RangoMaximoDias} (3 meses).")">
                <span class="rfs-rango-alerta">
                    <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="MudSize.Small" />
                    máx. @RangoMaximoDias días
                </span>
            </MudTooltip>
        }
    </div>

    @* Métrica: botonera segmentada dentro de un recuadro gris (20/08/2026). Antes eran cuatro
       radios sueltos que se perdían entre los combos. NO va a la base: cambia el tablero al
       instante, por eso no pinta el botón "Aplicar filtros" (ver HayCambiosSinAplicar).
       Sin rótulo visible (pedido del usuario): los cuatro nombres ya dicen qué es, y el rótulo
       arriba empujaba el bloque hacia abajo y lo desalineaba de los combos. El nombre queda en
       el `aria-label` para quien navegue con lector de pantalla. *@
    <div class="rfs-metrica">
        <div class="rfs-seg" role="group" aria-label="Métrica">
            @foreach (var m in Metricas)
            {
                var mm = m;
                <button type="button"
                        class="rfs-seg__btn @(_metrica == mm ? "rfs-seg__btn--on" : "")"
                        aria-pressed="@(_metrica == mm ? "true" : "false")"
                        @onclick="() => CambiarMetrica(mm)">@mm</button>
            }
        </div>
    </div>

    @* Tipo de servicio (18/08/2026): reemplaza el switch "Internos". Mismo esquema de 3
       categorías que Reservas por banda horaria — Empresa (antes "Cabecera", nombre engañoso
       que se confundía con el modo de facturación CABECERA_KM/SERV) / Turismo / Nortur (ex
       "Interno", renombrado 19/08/2026).
       Default (20/08/2026): las TRES tildadas — ver el comentario de `_categoriasSel`.
       OJO: este filtro va A LA BASE (define qué se trae). El selector de tipo de servicio que
       está sobre la grilla es otra cosa: enfoca en memoria lo ya traído. *@
    @* El ancho va en este contenedor y NO en el Style del MudSelect — ver app.css § .rfs-campo
       (ahí el estilo cae en un div interno y el ítem flex sigue midiéndose por contenido).
       182px era el mínimo medido para que entrara el peor texto real, "Empresa, Turismo";
       218px es ese mínimo +20%, que es el aire que pidió el usuario. *@
    <div class="rfs-campo" style="width:218px;">
        <MudSelect T="string" Label="Tipo de servicio" MultiSelection="true" @bind-SelectedValues="_categoriasSel"
                   SelectAll="true" SelectAllText="Todos" Dense="true"
                   Margin="Margin.Dense" Variant="Variant.Outlined"
                   MultiSelectionTextFunc="@(s => s.Count == ReportService.CategoriasServicio.Count ? "Todos" : string.Join(", ", s))">
            @foreach (var c in ReportService.CategoriasServicio)
            {
                <MudSelectItem T="string" Value="@c">
                    <span class="vpc-dot" style="@($"background:{ColorCat(c)};")" aria-hidden="true"></span>@c
                </MudSelectItem>
            }
        </MudSelect>
    </div>

    @* Tipo de chofer (18/08/2026): reemplaza el switch "Incluir contratados". Default: solo
       Propio tildado — igual que el switch anterior (el FoxPro fijaba tipo_chofe='PROPIO'). *@
    <div class="rfs-campo" style="width:170px;">
        <MudSelect T="string" Label="Tipo de chofer" MultiSelection="true" @bind-SelectedValues="_tipoChoferSel"
                   SelectAll="true" SelectAllText="Todos" Dense="true"
                   Margin="Margin.Dense" Variant="Variant.Outlined"
                   MultiSelectionTextFunc="@(s => s.Count == TiposChofer.Length ? "Todos" : string.Join(", ", s))">
            @foreach (var t in TiposChofer)
            {
                <MudSelectItem T="string" Value="@t">@t</MudSelectItem>
            }
        </MudSelect>
    </div>

    @* Tipo de vehículo (18/08/2026, nuevo): en qué unidades trabajó cada chofer. Default: todos. *@
    <div class="rfs-campo" style="width:180px;">
        <MudSelect T="string" Label="Tipo de vehículo" MultiSelection="true" @bind-SelectedValues="_vehiculosSel"
                   SelectAll="true" SelectAllText="Todos" Dense="true"
                   Margin="Margin.Dense" Variant="Variant.Outlined"
                   MultiSelectionTextFunc="@(s => s.Count == _vehiculos.Count ? "Todos" : $"{s.Count} de {_vehiculos.Count}")">
            @foreach (var v in _vehiculos)
            {
                <MudSelectItem T="string" Value="@v.Id">@v.Nombre</MudSelectItem>
            }
        </MudSelect>
    </div>

    @* Se pinta de naranja cuando hay filtros tocados sin aplicar: sin eso, el usuario cambia
       una fecha, no pasa nada en pantalla (la query no salió) y cree que el informe miente. *@
    <MudButton Variant="Variant.Filled" Color="MudColor.Primary"
               OnClick="Cargar" Disabled="_cargando" StartIcon="@Icons.Material.Filled.Search"
               Class="@(HayCambiosSinAplicar ? "rfs-aplicar--pend" : "")"
               title="@(HayCambiosSinAplicar ? "Hay filtros cambiados sin aplicar" : "")"
               Style="border-radius:8px; height:40px; text-transform:none; flex-shrink:0; margin-left:auto;">
        @(_cargando ? "Cargando..." : HayCambiosSinAplicar ? "Aplicar filtros •" : "Aplicar filtros")
    </MudButton>
</MudPaper>

@if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Color="MudColor.Primary" Class="mb-4" Style="border-radius:4px;" />
}
else if (_filas.Count == 0)
{
    <MudAlert Severity="Severity.Warning" Style="border-radius:12px;">No hay viajes para los filtros seleccionados.</MudAlert>
}
else
{
    @* ── Alerta: choferes en actividad con documentación por vencer ──
       Separada por GRAVEDAD (20/08/2026, elegido por el usuario): "ya está en infracción" y
       "hay que renovar" son dos problemas distintos y se atienden en momentos distintos. Cada
       contador es un botón que abre el detalle YA FILTRADO por esa gravedad. *@
    @if (_choferesVencidos.Count > 0)
    {
        <div class="vpc-doc-aviso mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Badge" Class="vpc-doc-aviso__ico" />
            <span class="vpc-doc-aviso__txt">
                <b>Documentación de choferes</b> — sobre @_choferesConActividad conductores en actividad en el período.
            </span>
            @if (_docVencidos > 0)
            {
                <button type="button" class="vpc-doc-chip vpc-doc-chip--rojo"
                        title="Ver solo los choferes con documentación vencida"
                        @onclick="@(() => VerVencimientos("vencidos"))">
                    <b>@_docVencidos</b> vencido@(_docVencidos == 1 ? "" : "s")
                </button>
            }
            @if (_docPorVencer > 0)
            {
                <button type="button" class="vpc-doc-chip vpc-doc-chip--ambar"
                        title="@($"Ver solo los que vencen dentro de {_diasAvisoChofer} días")"
                        @onclick="@(() => VerVencimientos("porvencer"))">
                    <b>@_docPorVencer</b> vence@(_docPorVencer == 1 ? "" : "n") en @_diasAvisoChofer días
                </button>
            }
            <MudButton Variant="Variant.Outlined" Color="MudColor.Primary" Size="MudSize.Small"
                       OnClick="@(() => VerVencimientos("todos"))"
                       Style="text-transform:none; border-radius:8px; flex-shrink:0;">
                Ver detalle
            </MudButton>
        </div>
    }

    @* ── KPIs ── con foco activo se recalculan al subconjunto enfocado (cross-filter) *@
    <div class="rfs-kpis mb-3">
        <KpiCard Label="@KpiTotalLabel" Value="@FmtMetrica(_totalMetrica)"
                 Sub="@($"prom. {FmtMetrica(_promedioDia)} {UnidadMetrica}/día activo")" Color="@NorturColors.Azul" />
        <KpiCard Label="Choferes con actividad" Value="@_choferesActivos.ToString()"
                 Sub="@($"{Fmt(_diasFranco)} días de franco")" Color="@NorturColors.Verde" />
        <KpiCard Label="Chofer líder" Value="@_choferLider"
                 Sub="@($"{FmtMetrica(_maxChofer)} {UnidadMetrica}")" Color="@NorturColors.Naranja" />
        <KpiCard Label="Empresa / Turismo / Nortur" Value="@($"{Fmt(_mixEmpresa)} / {Fmt(_mixTurismo)} / {Fmt(_mixNortur)}")"
                 Sub="@MixSub" Color="@NorturColors.Rojo"
                 Title="Mezcla de tipos de servicio (viajes) — no cambia con el foco de tipo de servicio, para poder compararlos" />
        <KpiCard Label="Choferes sin actividad" Value="@_choferesInactivos.Count.ToString()"
                 Sub="@($"de {_rosterActivo.Count} en el padrón")"
                 Color="@(_choferesInactivos.Count > 0 ? NorturColors.Rojo : NorturColors.Verde)"
                 OnClick="VerInactivos" Title="Clic para ver el listado" />
    </div>

    <div @key="_chartsKey">
        @* ── Evolución diaria (área): Empresa / Turismo / Nortur ──
           Oculta momentáneamente (19/08/2026, pedido del frente final) — se decide después si
           vuelve. El código y los datos (_evolData/_evolChart) quedan intactos: reactivar es
           volver MostrarEvolucionDiaria a true. *@
        @if (MostrarEvolucionDiaria)
        {
            <MudPaper Class="pa-4 mb-3" Elevation="1" Style="border-radius:14px;">
                @CabeceraFoco("Evolución diaria — tipo de servicio")
                <ApexChart TItem="EvolItem" Options="_optsEvol" Height="300" @ref="_evolChart">
                    <ApexPointSeries TItem="EvolItem" Items="_evolData" Name="Empresa"
                                     SeriesType="SeriesType.Area" XValue="@(x => x.Dia)" YValue="@(x => x.Empresa)" />
                    <ApexPointSeries TItem="EvolItem" Items="_evolData" Name="Turismo"
                                     SeriesType="SeriesType.Area" XValue="@(x => x.Dia)" YValue="@(x => x.Turismo)" />
                    <ApexPointSeries TItem="EvolItem" Items="_evolData" Name="Nortur"
                                     SeriesType="SeriesType.Area" XValue="@(x => x.Dia)" YValue="@(x => x.Nortur)" />
                </ApexChart>
            </MudPaper>
        }

        @* ── Ranking de choferes + donut tipo de servicio ── *@
        <MudGrid Spacing="3" Class="mb-3" Style="align-items:stretch;">
            <MudItem xs="12" md="7" Style="display:flex; flex-direction:column;">
                <MudPaper Class="pa-4" Elevation="1" Style="border-radius:14px; flex:1;">
                    @* Todo lo de adentro de este div va al PDF (mismo patrón que el comprobante
                       de Liquidación a Clientes — ver LiquidacionResumenDialog.razor). El
                       selector "Mostrar" y los chips de foco llevan `no-print`: son controles de
                       pantalla, no datos del reporte. La tabla de abajo del gráfico es la MISMA
                       información en texto — imprescindible porque un PDF no es interactivo (no
                       se puede pasar el mouse por una barra para leer el valor exacto). *@
                    <div id="vpc-barras-print" class="pdf-hoja">
                        @* ══════ ENCABEZADO DEL DOCUMENTO — solo aparece en el PDF ══════
                           Va con logos <img> (NO background-image): Chrome NO imprime fondos
                           salvo que el usuario tilde "Gráficos de fondo", pero las imágenes
                           y los bordes SÍ se imprimen siempre. Por eso la banda es blanca con
                           filete de color en vez de un bloque de color macizo. *@
                        <div class="pdf-doc">
                            <div class="pdf-doc__marca">
                                <img src="images/logo.png" alt="NORTUR" class="pdf-doc__logo-nortur" />
                                <span class="pdf-doc__div" aria-hidden="true"></span>
                                <img src="images/buslink_icon_e.png" alt="" class="pdf-doc__logo-buslink" />
                                <span class="pdf-doc__marca-txt">BUSLINK</span>
                                <span class="pdf-doc__spacer"></span>
                                <span class="pdf-doc__emitido">Emitido @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>

                            <div class="pdf-doc__titulo">@($"{UnidadMetricaCap} por chofer")</div>
                            <div class="pdf-doc__filtros">@FiltrosAplicadosTexto()</div>

                            @* Franja de KPIs — los mismos cuatro de la pantalla. Sin fondo de
                               color (ver arriba): filete lateral + valor en el color de marca. *@
                            <div class="pdf-doc__kpis">
                                <div class="pdf-kpi" style="border-left-color:@NorturColors.Azul;">
                                    <span class="pdf-kpi__lbl">@KpiTotalLabel</span>
                                    <span class="pdf-kpi__val">@FmtMetrica(_totalMetrica)</span>
                                    <span class="pdf-kpi__sub">@($"prom. {FmtMetrica(_promedioDia)} {UnidadMetrica}/día activo")</span>
                                </div>
                                <div class="pdf-kpi" style="border-left-color:@NorturColors.Verde;">
                                    <span class="pdf-kpi__lbl">Choferes con actividad</span>
                                    <span class="pdf-kpi__val">@_choferesActivos</span>
                                    <span class="pdf-kpi__sub">@($"{Fmt(_diasFranco)} días de franco")</span>
                                </div>
                                <div class="pdf-kpi" style="border-left-color:@NorturColors.Naranja;">
                                    <span class="pdf-kpi__lbl">Chofer líder</span>
                                    <span class="pdf-kpi__val pdf-kpi__val--txt">@_choferLider</span>
                                    <span class="pdf-kpi__sub">@($"{FmtMetrica(_maxChofer)} {UnidadMetrica}")</span>
                                </div>
                                <div class="pdf-kpi" style="border-left-color:@NorturColors.Rojo;">
                                    <span class="pdf-kpi__lbl">Empresa / Turismo / Nortur</span>
                                    <span class="pdf-kpi__val">@($"{Fmt(_mixEmpresa)} / {Fmt(_mixTurismo)} / {Fmt(_mixNortur)}")</span>
                                    <span class="pdf-kpi__sub">@MixSub</span>
                                </div>
                            </div>

                            @if (PdfGraficoRecortado)
                            {
                                <div class="pdf-doc__nota">
                                    Gráfico: top @TopMaxPdf de @_pdfFilas.Count · la tabla de abajo incluye los @_pdfFilas.Count
                                </div>
                            }
                        </div>

                        <div class="rfs-bar-head mb-2 no-print">
                            <div class="rfs-bar-title">
                                <MudText Typo="Typo.subtitle2" Style="font-weight:700; color:#112F5B;">@($"{UnidadMetricaCap} por chofer — {TituloTopN}")</MudText>
                                <MudSelect T="int" Value="_topN" ValueChanged="CambiarTopN"
                                           Label="Mostrar" Dense="true" Margin="Margin.Dense"
                                           Variant="Variant.Outlined" Class="rfs-topn-select no-print">
                                    <MudSelectItem T="int" Value="10">Top 10</MudSelectItem>
                                    <MudSelectItem T="int" Value="15">Top 15</MudSelectItem>
                                    <MudSelectItem T="int" Value="20">Top 20</MudSelectItem>
                                    <MudSelectItem T="int" Value="999">Todos (@_rankingChoferes.Count)</MudSelectItem>
                                </MudSelect>
                            </div>
                            <div class="rfs-bar-head__der no-print">
                                @ChipsFoco
                                @* Botón con TEXTO, no solo ícono (20/08/2026): como ícono suelto
                                   de 28px pasaba desapercibido. Mismo formato que el "Descargar
                                   Excel" de la grilla —convención de la app: la acción se
                                   nombra— pero Outlined y en rojo, para que no le compita al
                                   verde relleno del Excel. Muestra "Exportando…" mientras dura
                                   el remonte del gráfico en modo PDF (ver ExportarBarrasPdf). *@
                                <MudButton Variant="Variant.Outlined" Size="MudSize.Small"
                                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                           OnClick="ExportarBarrasPdf"
                                           Disabled="_barItems.Count == 0 || _exportando"
                                           Class="rfs-pdf-btn" title="Exportar este gráfico a PDF">
                                    @(_exportando ? "Exportando…" : "PDF")
                                </MudButton>
                            </div>
                        </div>
                        @* Barras APILADAS por tipo de servicio (19/08/2026, pedido del frente final):
                           el largo de cada barra sigue siendo el total del chofer (mismo ranking de
                           siempre), pero dividida en 3 tramos de color según cuánto hizo de cada
                           categoría — mismos colores fijos que la torta y el resto de la app. El
                           color ya NO identifica al chofer (antes 15 hues por chofer); identifica la
                           categoría, así que un clic en un tramo enfoca por tipo de servicio, igual
                           que un clic en la torta. Enfocar por CHOFER se hace desde la tabla de abajo
                           (clic en el nombre), no desde acá.
                           @key propio: al cambiar el foco de tipo de servicio el ranking se
                           RE-ORDENA (cambia la forma del gráfico), y eso pide remontar. *@
                        @* Width fijo SOLO en modo PDF: ApexCharts hornea el ancho en píxeles
                           dentro del <svg> al renderizar, así que el gráfico llegaba al PDF con
                           el ancho del panel de pantalla (~830px) y dejaba un cuarto de hoja
                           vacío a la derecha. 1040px ≈ A4 apaisada (1123px) menos el padding
                           de `.pdf-hoja`. En pantalla sigue siendo responsivo (null = auto). *@
                        <ApexChart @key="_barsKey" TItem="BarStackItem" Options="_optsBarCho" Height="@_altoBarras"
                                   Width="@(_modoPdf ? AnchoBarrasPdf : null)"
                                   OnDataPointSelection="OnBarChoSelection" OnLegendClicked="OnBarLegendClicked">
                            <ApexPointSeries TItem="BarStackItem" Items="_barItems" Name="Empresa"
                                             SeriesType="SeriesType.Bar" XValue="@(x => x.Chofer)" YValue="@(x => x.Empresa)" />
                            <ApexPointSeries TItem="BarStackItem" Items="_barItems" Name="Turismo"
                                             SeriesType="SeriesType.Bar" XValue="@(x => x.Chofer)" YValue="@(x => x.Turismo)" />
                            <ApexPointSeries TItem="BarStackItem" Items="_barItems" Name="Nortur"
                                             SeriesType="SeriesType.Bar" XValue="@(x => x.Chofer)" YValue="@(x => x.Nortur)" />
                        </ApexChart>

                        @* Tabla del detalle numérico — SOLO visible en el PDF (ver .vpc-print-tabla
                           en app.css, @media print). En pantalla el gráfico ya cumple ese rol; en
                           papel hace falta el número exacto de cada chofer.
                           Sale de `_pdfFilas` (la selección COMPLETA), no de `_barItems`: el
                           gráfico puede venir recortado al top que entra en una hoja, la tabla
                           nunca. El <thead> se repite solo en cada hoja (table-header-group). *@
                        <table class="vpc-print-tabla">
                            <caption>Detalle por chofer — @_pdfFilas.Count chofer@(_pdfFilas.Count == 1 ? "" : "es")</caption>
                            <thead>
                                <tr>
                                    <th style="text-align:left;">Chofer</th>
                                    <th>Empresa</th>
                                    <th>Turismo</th>
                                    <th>Nortur</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in _pdfFilas)
                                {
                                    <tr>
                                        <td style="text-align:left;">@b.Chofer</td>
                                        <td>@FmtMetrica((int)b.Empresa)</td>
                                        <td>@FmtMetrica((int)b.Turismo)</td>
                                        <td>@FmtMetrica((int)b.Nortur)</td>
                                        <td><b>@FmtMetrica((int)(b.Empresa + b.Turismo + b.Nortur))</b></td>
                                    </tr>
                                }
                                @* Fila de cierre: sin esto el informe tenía 101 filas y ningún
                                   total. Va como última fila del tbody (NO en <tfoot>: en
                                   impresión el tfoot se repite en TODAS las hojas). *@
                                <tr class="vpc-print-tot">
                                    <td style="text-align:left;">TOTAL</td>
                                    <td>@FmtMetrica((int)_pdfFilas.Sum(x => x.Empresa))</td>
                                    <td>@FmtMetrica((int)_pdfFilas.Sum(x => x.Turismo))</td>
                                    <td>@FmtMetrica((int)_pdfFilas.Sum(x => x.Nortur))</td>
                                    <td>@FmtMetrica((int)_pdfFilas.Sum(x => x.Empresa + x.Turismo + x.Nortur))</td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="vpc-print-pie">
                            @* Solo "Buslink": el nombre Metrocar es el del sistema viejo que se
                               está migrando y NO va en material de marca (regla del usuario,
                               20/08/2026). Sigue siendo válido nombrarlo cuando se habla del
                               FoxPro en sí ("esto se carga en el Metrocar"). *@
                            Buslink · emitido @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                            · @FiltrosAplicadosTexto()
                            · vista en pantalla, no reemplaza un comprobante oficial
                        </p>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="5" Style="display:flex; flex-direction:column;">
                <MudPaper Class="pa-4" Elevation="1" Style="border-radius:14px; flex:1;">
                    @CabeceraFoco("Tipo de servicio")
                    @* Clickeable: enfoca el tablero en un tipo de servicio (2ª dimensión del
                       cross-filter). El clic en la leyenda hace lo mismo. *@
                    <ApexChart TItem="DonutItem" Options="_optsPie" Height="300" @ref="_pieChart"
                               OnDataPointSelection="OnPieCatSelection" OnLegendClicked="OnPieCatLegendClicked">
                        <ApexPointSeries TItem="DonutItem" Items="_donutOrigen" Name="Viajes"
                                         SeriesType="SeriesType.Donut" XValue="@(x => x.Label)" YValue="@(x => x.Valor)" />
                    </ApexChart>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </div>

    @* ── Tabla pivote chofer × día/mes ── *@
    <MudPaper Class="pa-4" Elevation="1" Style="border-radius:14px;">
        @* Cabecera de la grilla (20/08/2026 — INVERTIDA a pedido del usuario): los CONTROLES
           van a la izquierda y la INFORMACIÓN a la derecha. Antes era al revés.
           Orden de los controles, de izquierda a derecha: BUSCAR · VISTA (Agrupar por · Tipo
           de servicio · Métrica), separados por un filete fino para que se lea la jerarquía.
           El Excel sigue al extremo derecho, junto a los títulos: es la única acción, y esa
           es la convención de la app (ver skill blazor-nortur § barra de filtros). *@
        <div class="vpc-head">
            <div class="vpc-toolbar">
                @* ── Grupo BUSCAR (1º) ── Filtra la grilla EN VIVO mientras se tipea (Immediate),
                   en memoria y sin re-query. Va SIN etiqueta flotante a propósito: con la lupa y
                   el placeholder ya se lee como buscador, y la etiqueta lo disfrazaba de campo de
                   formulario más (era el control más ancho de la barra y desbalanceaba todo). *@
                <div class="vpc-search @(BuscandoChofer ? "vpc-search--activo" : "")">
                    <MudTextField T="string" Value="_buscarChofer"
                                  ValueChanged="OnBuscarChoferChanged" Immediate="true"
                                  Clearable="true" Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Placeholder="Buscar chofer…"
                                  Adornment="MudBlazor.Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                    @if (BuscandoChofer)
                    {
                        <span class="vpc-search__count">
                            @_pivChoferesMostrados.Count de @_pivChoferes.Count choferes
                        </span>
                    }
                </div>

                <span class="vpc-toolbar__sep" aria-hidden="true"></span>

                @* ── Grupo VISTA: los tres combos que definen cómo se arma la grilla ── *@
                <div class="vpc-toolbar__group">
                    @* (2º) Métrica: QUÉ número muestra cada celda. Va primero del grupo porque es
                       la pregunta de más arriba de todas — define qué se está mirando; recién
                       después importa cómo se agrupa y qué se enfoca.
                       Es el MISMO `_metrica` que los radios de la barra de filtros de arriba: los
                       dos controles se sincronizan solos (mismo campo, mismo handler). *@
                    <MudSelect T="string" Label="Métrica" Value="_metrica" ValueChanged="CambiarMetrica"
                               Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:120px;">
                        <MudSelectItem T="string" Value="@("Viajes")">Viajes</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Km")">Km</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Pax")">Pax</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Horas")">Horas</MudSelectItem>
                    </MudSelect>

                    @* (3º) Agrupación de las columnas: día (grano fino) o mes (rangos largos). Es
                       un recálculo en MEMORIA — cambia al instante, sin volver a la base. *@
                    <MudSelect T="bool" Label="Agrupar por" Value="_porMes" ValueChanged="CambiarAgrupacion"
                               Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:130px;">
                        <MudSelectItem T="bool" Value="@false">Día</MudSelectItem>
                        <MudSelectItem T="bool" Value="@true">Mes</MudSelectItem>
                    </MudSelect>

                    @* (4º) Tipo de servicio EN MEMORIA: enfoca todo el tablero (es la misma perilla
                       que el clic en la torta). No re-consulta la base.
                       Cada opción lleva el punto de color de su categoría — el mismo azul/naranja/
                       verde que usan la torta, las barras y ahora la grilla ("Todos" es tricolor).
                       Alcanza con ponerlo en los ítems: MudSelect 9.5 dibuja el ChildContent del
                       ítem elegido también en el campo cerrado (verificado en captura). *@
                    <div class="vpc-catsel">
                        <MudSelect T="string" Label="Tipo de servicio" Value="@(_categoriaFocus ?? "")"
                                   ValueChanged="CambiarCategoriaFoco"
                                   Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:150px;">
                            <MudSelectItem T="string" Value="@("")">
                                <span class="vpc-dot vpc-dot--tri" aria-hidden="true"></span>Todos
                            </MudSelectItem>
                            @foreach (var c in _catsPresentes)
                            {
                                <MudSelectItem T="string" Value="@c">
                                    <span class="vpc-dot" style="@($"background:{ColorCat(c)};")" aria-hidden="true"></span>@c
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                </div>
            </div>

            @* ── Bloque de INFORMACIÓN (derecha): qué se está mirando + la única acción ── *@
            <div class="vpc-head__right">
                <div class="vpc-head__titles">
                    <MudText Typo="Typo.subtitle2" Style="font-weight:700; color:#112F5B;">
                        Detalle: @UnidadMetrica por chofer y @(_porMes ? "mes" : "día")
                        @if (_categoriaFocus is not null)
                        {
                            <span style="@($"color:{ColorCat(_categoriaFocus)};")"> · solo @_categoriaFocus</span>
                        }
                    </MudText>
                    @* El "mostrando X de Y" no vive acá: cuelga debajo del buscador, que es donde
                       el usuario está mirando cuando tipea. *@
                    <MudText Typo="Typo.caption" Style="color:#8FA3BC;">
                        Click en una celda para ver los viajes uno por uno · click en el nombre de un chofer para enfocar el tablero · <span style="color:#B08900;">F</span> = @(_porMes ? "mes" : "día") sin trabajar
                    </MudText>
                </div>

                <MudButton Variant="Variant.Filled" Color="MudColor.Success"
                           StartIcon="@Icons.Material.Filled.Download"
                           OnClick="DescargarExcel" Disabled="_cargandoDet"
                           Class="vpc-toolbar__excel"
                           Style="border-radius:8px; text-transform:none;">
                    Descargar Excel
                </MudButton>
            </div>
        </div>
        @if (_cargandoDet)
        {
            <MudProgressLinear Indeterminate="true" Color="MudColor.Primary" Class="mb-2" Style="border-radius:4px;" />
        }
        @* Con una categoría enfocada, TODA la grilla toma su color (borde, encabezados y pie):
           de un vistazo se ve que lo que hay abajo es un subconjunto, y cuál. *@
        <div class="rfs-tabla-wrap @(_categoriaFocus is not null ? "rfs-cat-foco" : "")"
             style="@(_categoriaFocus is not null ? $"--nt-cat:{ColorCat(_categoriaFocus)};" : "")">
            <table class="rfs-tabla">
                <thead>
                    <tr>
                        <th class="rfs-col-fecha" style="min-width:220px;">Chofer</th>
                        @foreach (var col in _pivCols)
                        {
                            <th class="rfs-th-serv @(col.Finde ? "rfs-finde" : "")" title="@col.Title">@col.Label</th>
                        }
                        <th class="rfs-th-total">TOTAL</th>
                    </tr>
                </thead>
                <tbody>
                    @* Virtualize: pueden ser cientos de choferes (regla de performance). *@
                    <Virtualize Items="_pivChoferesMostrados" Context="cho" ItemSize="30" OverscanCount="12" SpacerElement="tr">
                        <tr>
                            @{ var atenua = _choferFocus is not null && !EnFocoChofer(cho) ? "rfs-atenua" : ""; }
                            <td class="rfs-col-fecha rfs-click @(EnFocoChofer(cho) && _choferFocus is not null ? "rfs-col-foco" : "") @atenua"
                                style="max-width:280px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                title="Clic para enfocar el tablero en @NombreDe(cho)"
                                @onclick="() => ToggleFocoChofer(cho)">@NombreDe(cho)</td>
                            @foreach (var col in _pivCols)
                            {
                                var c = col;
                                var valor = PivValor(cho, c.Key);
                                if (valor is not null)
                                {
                                    <td class="rfs-num rfs-click rfs-mix-cel @atenua" title="Ver viajes de @NombreDe(cho) — @c.Title"
                                        @onclick="() => AbrirDetalleCelda(cho, c)">
                                        @FmtMetrica(valor.Value)
                                        <span class="rfs-mix" style="@($"background:{MixCelda(cho, c.Key)};")" aria-hidden="true"></span>
                                    </td>
                                }
                                else if (EsFranco(cho, c.Key))
                                {
                                    <td class="rfs-num rfs-finde-cell @atenua" title="@NombreDe(cho) — sin trabajar @c.Title"
                                        style="color:#B08900; font-style:italic;">F</td>
                                }
                                else
                                {
                                    <td class="rfs-num rfs-cero @atenua">·</td>
                                }
                            }
                            <td class="rfs-num rfs-tot rfs-click rfs-mix-cel @atenua" title="Ver todos los viajes de @NombreDe(cho)"
                                @onclick="() => AbrirDetalleChofer(cho)">
                                @FmtMetrica(PivTotFila(cho))
                                <span class="rfs-mix" style="@($"background:{MixFila(cho)};")" aria-hidden="true"></span>
                            </td>
                        </tr>
                    </Virtualize>
                </tbody>
                <tfoot>
                    @* El pie es sticky (queda pegado abajo mientras se scrollea). Con las
                       sub-filas por tipo de servicio son varias filas sticky, y sticky NO las
                       apila solo: cada una necesita su propio `bottom`. De ahí el cálculo. *@
                    @{ var subs = MostrarSubTotales ? _catsGrilla.Count : 0; }
                    <tr>
                        <td class="rfs-col-fecha rfs-tot" style="@BottomPie(subs)">TOTAL</td>
                        @foreach (var col in _pivCols)
                        {
                            var c = col;
                            <td class="rfs-num rfs-tot rfs-click" style="@BottomPie(subs)"
                                title="Ver todos los viajes de @c.Title"
                                @onclick="() => AbrirDetalleCol(c)">@FmtMetrica(PivTotCol(c.Key))</td>
                        }
                        <td class="rfs-num rfs-tot rfs-grantot" style="@BottomPie(subs)">@FmtMetrica(_granTotal)</td>
                    </tr>
                    @* Desglose del TOTAL por tipo de servicio, cada uno en su color. Solo cuando
                       hay más de una categoría a la vista: con un foco activo repetiría el TOTAL. *@
                    @if (MostrarSubTotales)
                    {
                        @for (var i = 0; i < _catsGrilla.Count; i++)
                        {
                            var cat = _catsGrilla[i];
                            var bottom = BottomPie(_catsGrilla.Count - 1 - i);
                            <tr class="rfs-subtot" style="@($"--nt-cat:{ColorCat(cat)};")">
                                <td class="rfs-col-fecha rfs-subtot-lbl" style="@bottom">
                                    <span class="vpc-dot" style="@($"background:{ColorCat(cat)};")" aria-hidden="true"></span>@cat
                                </td>
                                @foreach (var col in _pivCols)
                                {
                                    <td class="rfs-num" style="@bottom">@FmtCero(PivTotColCat(cat, col.Key))</td>
                                }
                                <td class="rfs-num rfs-subtot-tot" style="@bottom">@FmtCero(_pivTotCat.GetValueOrDefault(cat))</td>
                            </tr>
                        }
                    }
                </tfoot>
            </table>
        </div>
    </MudPaper>
}

@code {
    private readonly DateTime _min = ReportService.FechaMinValida.ToDateTime(TimeOnly.MinValue);
    private readonly DateTime _max = ReportService.FechaMaxValida.ToDateTime(TimeOnly.MinValue);
    private static readonly System.Globalization.CultureInfo Cult =
        System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    // Catálogo fijo del combo "Tipo de chofer" (no tiene tabla propia: es viaje.tipo_chofe).
    private static readonly string[] TiposChofer = { "Propio", "Contratado" };

    // A partir de este largo de rango, la grilla arranca agrupada por MES: con 3+ meses las
    // columnas por día no entran en pantalla y la tabla deja de ser legible.
    private const int DiasParaAgruparPorMes = 92;

    // Panel "Evolución diaria" oculto momentáneamente (19/08/2026, pedido del frente final).
    // El código y los datos del gráfico quedan intactos; para reactivarlo alcanza con volver
    // esto a true. `static readonly` (no `const`): con `const` el compilador marca el bloque
    // del @if como código inalcanzable (CS0162) porque pliega el valor en tiempo de compilación.
    private static readonly bool MostrarEvolucionDiaria = false;

    // ── Filtros en edición ── Default: el mes calendario ANTERIOR completo.
    private DateTime? _desde = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-1);
    private DateTime? _hasta = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddDays(-1);

    // Las TRES categorías tildadas de arranque (20/08/2026). Antes venía Empresa+Turismo y
    // Nortur destildado (herencia del switch viejo "Internos", que arrancaba apagado): como el
    // combo de tipo de servicio de la grilla solo lista las categorías PRESENTES en los datos
    // (_catsPresentes), Nortur no aparecía nunca ahí y el código de color de la grilla se
    // quedaba sin su verde. Trayendo las tres, el tablero arranca completo.
    private IReadOnlyCollection<string> _categoriasSel = new HashSet<string>(ReportService.CategoriasServicio);
    // Tipo de chofer: solo Propio tildado por defecto — mismo comportamiento que el switch
    // "Incluir contratados" que reemplaza (el FoxPro fijaba tipo_chofe='PROPIO').
    private IReadOnlyCollection<string> _tipoChoferSel = new HashSet<string> { "Propio" };
    // Tipo de vehículo: todos tildados por defecto (filtro nuevo, sin restricción histórica).
    private IReadOnlyCollection<string> _vehiculosSel = new HashSet<string>();
    private bool _todasCategorias => _categoriasSel.Count == ReportService.CategoriasServicio.Count;
    private bool _todosTiposChofer => _tipoChoferSel.Count == TiposChofer.Length;
    private bool _todosVehiculos => _vehiculos.Count > 0 && _vehiculosSel.Count == _vehiculos.Count;

    // Arranca en HORAS (20/08/2026, pedido de Claudio): la primera pregunta del informe es
    // cuánto trabajó cada chofer, no cuántos viajes hizo. Cambiar la métrica NO vuelve a la
    // base — se recalcula en memoria (ver CambiarMetrica).
    private string _metrica = "Horas";                  // "Viajes" | "Km" | "Pax" | "Horas"
    // Horas PRIMERO: es la métrica por defecto, y el primer lugar de la botonera es el que se
    // lee antes (20/08/2026).
    private static readonly string[] Metricas = { "Horas", "Viajes", "Km", "Pax" };

    // ── Foco / cross-filter (DOS dimensiones combinables con AND: chofer × tipo de servicio) ──
    // Cada dimensión RESALTA en sus propios visuales (para poder cambiar de foco) y FILTRA los
    // de la otra. Todo en memoria, sin re-query. null = sin foco.
    private string? _choferFocus;                        // IdChofer (clave estable)
    private string? _categoriaFocus;                     // Empresa | Turismo | Nortur
    private bool EnFocoChofer(string id) => _choferFocus is null || _choferFocus == id;

    // Agrupación de las columnas del pivote: false = día, true = mes. En memoria.
    private bool _porMes;
    // Se marca cuando el usuario elige la agrupación a mano: desde ahí manda su elección y el
    // auto-posicionamiento por largo de rango ya no la pisa.
    private bool _agrupacionManual;

    // ── Filtros APLICADOS (snapshot al Aplicar) ──
    private DateOnly _fDesdeAp, _fHastaAp;
    private List<string> _catAp = new();
    private List<string> _choAp = new();
    private List<string> _vehAp = new();
    private bool _aplicadoAlgunaVez;

    // ── "Hay filtros sin aplicar" ──
    // Solo cuentan los filtros que van A LA BASE (fechas + los tres combos). La métrica y los
    // controles de la grilla (agrupación, foco, buscador) trabajan en memoria y ya se aplicaron
    // solos: pintarlos acá diría "te falta hacer algo" cuando no falta nada.
    // La comparación va contra el snapshot NORMALIZADO (`_catAp` y compañía guardan lista vacía
    // cuando están todos tildados), así que el lado en edición se normaliza igual antes de
    // comparar — si no, "todos tildados" leería como distinto de "sin filtro".
    private List<string> CatEnEdicion => _todasCategorias ? new List<string>() : _categoriasSel.ToList();
    private List<string> ChoEnEdicion => _todosTiposChofer ? new List<string>() : _tipoChoferSel.ToList();
    private List<string> VehEnEdicion => _todosVehiculos ? new List<string>() : _vehiculosSel.ToList();

    private static bool MismoSet(List<string> a, List<string> b) =>
        a.Count == b.Count && !a.Except(b).Any();

    private bool HayCambiosSinAplicar =>
        _aplicadoAlgunaVez && !_cargando && (
            _desde is null || _hasta is null ||
            DateOnly.FromDateTime(_desde.Value) != _fDesdeAp ||
            DateOnly.FromDateTime(_hasta.Value) != _fHastaAp ||
            !MismoSet(CatEnEdicion, _catAp) ||
            !MismoSet(ChoEnEdicion, _choAp) ||
            !MismoSet(VehEnEdicion, _vehAp));

    private List<VehiculoTipoDto> _vehiculos = new();
    private List<ViajesChoferRow> _filas = new();
    private List<ViajesChoferDetalleRow>? _detalle;     // lazy: al primer drill-down/Excel
    private bool _cargando, _cargandoDet;
    private Guid _chartsKey = Guid.NewGuid();
    // Key propio del gráfico de barras: el foco de tipo de servicio RE-ORDENA su ranking
    // (cambia la forma), y un cambio de forma se resuelve remontando, no actualizando.
    private Guid _barsKey = Guid.NewGuid();

    // KPIs
    private int _totalMetrica, _promedioDia, _choferesActivos, _diasFranco;
    private string _choferLider = "—";
    private int _maxChofer, _mixEmpresa, _mixTurismo, _mixNortur, _pctTurismo;
    private string UnidadMetrica => _metrica switch { "Km" => "km", "Pax" => "pax", "Horas" => "horas", _ => "viajes" };
    private string UnidadMetricaCap => _metrica switch { "Km" => "Km", "Pax" => "Pax", "Horas" => "Horas", _ => "Viajes" };
    private string KpiTotalLabel => _metrica switch { "Km" => "Total km", "Pax" => "Total pax", "Horas" => "Total horas", _ => "Total viajes" };
    // Horas se guarda internamente en MINUTOS (mismo tipo `int` que las otras métricas, sin
    // tocar los Dictionary<..,int> del pivote) y se formatea recién al mostrarla — ver Fmt().
    // El KPI de mezcla NO se recorta con el foco de tipo de servicio (si no, mostraría una sola
    // categoría y dejaría de ser una mezcla). Cuando hay foco, el Sub lo dice.
    private string MixSub => _categoriaFocus is not null
        ? $"enfocado: {_categoriaFocus}"
        : $"{_pctTurismo}% turismo";

    // Choferes sin actividad: padrón activo de `chofer` vs quién viajó.
    private List<ChoferListaRow> _rosterActivo = new();
    private List<ChoferListaRow> _choferesInactivos = new();

    // Choferes en actividad con documentación por vencer (cruce con Agenda de Vencimientos).
    private List<ChoferDocVista> _choferesVencidos = new();
    private int _diasAvisoChofer = 30;
    private int _docVencidos, _docPorVencer;      // desglose del aviso por gravedad
    private int _choferesConActividad;            // choferes que viajaron (base del KPI "al día")

    // Buscador de chofer: filtra la grilla en memoria, en vivo.
    private string _buscarChofer = "";
    private List<string> _pivChoferesMostrados = new();
    // Hay búsqueda activa: marca el campo en naranja y muestra el contador debajo.
    private bool BuscandoChofer => !string.IsNullOrWhiteSpace(_buscarChofer);

    // ── Gráficos ApexCharts ──
    private record EvolItem(string Dia, decimal Empresa, decimal Turismo, decimal Nortur);
    // Una barra por chofer, con el desglose de las 3 categorías ya calculado — alimenta las
    // 3 series apiladas del gráfico de barras (una por categoría, mismo XValue=Chofer).
    private record BarStackItem(string IdChofer, string Chofer, decimal Empresa, decimal Turismo, decimal Nortur);

    // ── Modo PDF (20/08/2026) ──
    // Un <svg> es un elemento ATÓMICO: el navegador no lo puede partir entre dos hojas. Con
    // "Todos (101)" el gráfico mide 101 × 30 = 3.030px (más de 4 hojas A4), así que al no
    // entrar en lo que quedaba de la primera hoja se iba ENTERO a la segunda y la primera
    // quedaba con el título solo y el resto en blanco (bug reportado por el usuario).
    // Solución: al exportar, el GRÁFICO se recorta al top 25 y se dibuja más compacto para
    // que entre en una hoja junto al encabezado. La TABLA sigue trayendo la selección
    // completa, así que no se pierde ni un chofer.
    private const int TopMaxPdf = 25;
    private const int AltoBarrasPdf = 500;    // px: lo que queda de una A4 apaisada bajo el encabezado
    private const int AnchoBarrasPdf = 1040;  // px: A4 apaisada (1123px @96dpi) menos el padding de la hoja
    private bool _modoPdf;
    private bool _exportando;
    private List<BarStackItem> _pdfFilas = new();   // selección completa (tabla del PDF)

    /// <summary>Deja `_barItems` y `_altoBarras` según el modo: en pantalla, la selección
    /// entera; en PDF, recortada al top que entra en una hoja.</summary>
    private void AplicarTopeBarras()
    {
        _barItems = _modoPdf ? _pdfFilas.Take(TopMaxPdf).ToList() : _pdfFilas;
        _altoBarras = _modoPdf ? AltoBarrasPdf : Math.Max(360, _barItems.Count * 30);
    }

    private bool PdfGraficoRecortado => _modoPdf && _pdfFilas.Count > TopMaxPdf;
    private record DonutItem(string Label, decimal Valor);
    private List<EvolItem> _evolData = new();
    private List<BarStackItem> _barItems = new();
    private List<DonutItem> _donutOrigen = new();

    private ApexChart<EvolItem>? _evolChart;
    private ApexChart<DonutItem>? _pieChart;

    private const string _colorOtros = "#94A3B8";

    // Colores FIJOS por tipo de servicio (color por entidad, igual en todos los informes que
    // usan este esquema — ver ReservasBandaHoraria.razor). Nortur = ex "Interno" (renombrado
    // 19/08/2026); el gráfico de barras ahora colorea por ESTA categoría, no por chofer.
    private static readonly Dictionary<string, string> _colorCategoria = new()
    {
        ["Empresa"] = "#2058D0",
        ["Turismo"] = "#F99410",
        ["Nortur"] = "#16A34A",
    };
    private static string ColorCat(string cat) => _colorCategoria.TryGetValue(cat, out var c) ? c : _colorOtros;
    private string ColorFocoCat(string cat) =>
        (_categoriaFocus is null || cat == _categoriaFocus) ? ColorCat(cat) : "#D9E1EC";

    private List<string> _catsPresentes = new();

    private Dictionary<string, string> _nombrePorChofer = new();
    private string NombreDe(string id) => _nombrePorChofer.TryGetValue(id, out var n) ? n : id;

    // Selector "Mostrar Top N" del gráfico de barras.
    private int _topN = 15;
    private List<(string Id, string Nombre, int Total)> _rankingChoferes = new();
    private string TituloTopN => _topN >= 999 ? $"todos ({_barItems.Count})" : $"top {Math.Min(_topN, _barItems.Count)}";
    private int _altoBarras = 360;

    private RenderFragment ChipsFoco => __builder =>
    {
        @if (_choferFocus is not null || _categoriaFocus is not null)
        {
            <div class="rfs-focus">
                @if (_choferFocus is not null)
                {
                    <span class="rfs-focus__lbl">Chofer:</span>
                    <span class="rfs-focus__val" style="background:#112F5B;">@NombreDe(_choferFocus)</span>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="MudSize.Small"
                                   OnClick="LimpiarFocoChofer" title="Quitar filtro de chofer"
                                   Style="color:#64748B; padding:2px;" />
                }
