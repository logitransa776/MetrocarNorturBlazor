@page "/vehiculos"
@using MetroCarSysBlazor.Components.Shared
@inject ReportService Reports
@inject NorturAuthStateProvider AuthState
@inject IPermissionService Permisos
@inject NavigationManager Nav
@inject IDialogService DialogService
@rendermode InteractiveServer

<PageTitle>Vehículos - Flota — NORTUR</PageTitle>

@* ── Encabezado de página ── *@
<div class="page-header mb-4">
    <MudText Typo="Typo.h5" Style="font-weight:800; color:#112F5B;">
        Vehículos - Flota
    </MudText>
    <MudText Typo="Typo.body2" Style="color:#7A90AD; margin-top:2px;">
        Vehículos y Choferes · ABM de Vehículos — vista de solo lectura desde replicaVPF
    </MudText>
</div>

@* ── Filtros (réplica de la toolbar FoxPro) ── *@
<MudPaper Class="pa-3 mb-3" Elevation="1" Style="border-radius:14px; border-top:4px solid #003AA0;">
    <div class="d-flex flex-wrap align-center" style="gap:16px;">
        <MudSelect T="string" @bind-Value="_fletero" Label="Fletero" Clearable="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:180px;">
            <MudSelectItem T="string" Value="@("")">(Todos)</MudSelectItem>
            @foreach (var f in _fleteros)
            {
                <MudSelectItem T="string" Value="@f">@f</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="_busqueda" Label="Dominio o Interno"
                      Immediate="true" DebounceInterval="200"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Style="min-width:260px; flex:1;" />
        <MudCheckBox T="bool" @bind-Value="_verActivos" Label="Ver Activos" Color="Color.Primary" Size="Size.Small" />
        <MudCheckBox T="bool" @bind-Value="_verFlotaPropia" Label="Ver Flota Propia" Color="Color.Primary" Size="Size.Small" />
        <MudChip T="string" Variant="Variant.Text" Color="Color.Default" Size="Size.Small">
            Total de vehículos: @Filtrados.Count()
        </MudChip>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Refresh" OnClick="Refrescar" Disabled="_cargando">
            Actualizar
        </MudButton>
    </div>
</MudPaper>

@if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" Style="border-radius:4px;" />
}
else
{
    <MudPaper Elevation="1" Style="border-radius:14px; overflow:hidden;">
        <MudTable Items="Filtrados" Dense="true" Hover="true" Striped="true"
                  FixedHeader="true" Height="calc(100vh - 290px)"
                  Bordered="false" Class="cli-grid grid-compacta"
                  RowClass="cli-grid__row" RowClassFunc="@RowClass"
                  OnRowClick="@OnRowClick" T="VehiculoListaRow">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<VehiculoListaRow, object>(x => x.IdVehiculo)">Id_vehiculo</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<VehiculoListaRow, object>(x => x.Cronograma)">Cronograma</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<VehiculoListaRow, object>(x => x.Fletero)">Fletero</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<VehiculoListaRow, object>(x => x.Marca)">Marca_y_modelo</MudTableSortLabel></MudTh>
                <MudTh>Color</MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<VehiculoListaRow, object>(x => x.Dominio)">Dominio</MudTableSortLabel></MudTh>
                <MudTh>Poliza_nombre</MudTh>
                <MudTh>Poliza_nro</MudTh>
                <MudTh>Poliza_vto</MudTh>
                <MudTh>Estado_cnrt</MudTh>
                <MudTh>Radicacion</MudTh>
                <MudTh>Tacografo_marca</MudTh>
                <MudTh>Tacografo_nro</MudTh>
                <MudTh>Habilitacion_nro</MudTh>
                <MudTh>Habilitac</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Id_vehiculo" Style="font-weight:700; color:#003AA0;">@context.IdVehiculo</MudTd>
                <MudTd DataLabel="Cronograma">@context.Cronograma</MudTd>
                <MudTd DataLabel="Fletero">@context.Fletero</MudTd>
                <MudTd DataLabel="Marca_y_modelo">@context.Marca</MudTd>
                <MudTd DataLabel="Color">@context.Color</MudTd>
                <MudTd DataLabel="Dominio">@context.Dominio</MudTd>
                <MudTd DataLabel="Poliza_nombre">@context.PolizaNombre</MudTd>
                <MudTd DataLabel="Poliza_nro">@context.PolizaNro</MudTd>
                <MudTd DataLabel="Poliza_vto">@Vto(context.PolizaVto)</MudTd>
                <MudTd DataLabel="Estado_cnrt">@context.EstadoCnrt</MudTd>
                <MudTd DataLabel="Radicacion">@context.Radicacion</MudTd>
                <MudTd DataLabel="Tacografo_marca">@context.TacografoMarca</MudTd>
                <MudTd DataLabel="Tacografo_nro">@context.TacografoNro</MudTd>
                <MudTd DataLabel="Habilitacion_nro">@context.HabilitacionNro</MudTd>
                <MudTd DataLabel="Habilitac">@Vto(context.HabilitacionVto)</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Class="pa-4">No hay vehículos para el filtro aplicado.</MudText>
            </NoRecordsContent>
        </MudTable>

        @* ── Botonera réplica FoxPro (solo lectura) ── *@
        <div class="cli-toolbar">
            <MudButton Disabled="true" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small">Agregar</MudButton>
            <MudButton Disabled="true" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Delete" Size="Size.Small">Eliminar</MudButton>
            <MudButton Disabled="true" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Edit" Size="Size.Small">Modificar</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Visibility"
                       Size="Size.Small" OnClick="AbrirSeleccionado" Disabled="_sel is null">Ver ficha</MudButton>
            <span style="flex:1;"></span>
            <span class="cli-toolbar__hint">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" /> Solo lectura · doble clic para ver la ficha
            </span>
        </div>
    </MudPaper>
}

@code {
    private List<VehiculoListaRow> _vehiculos = new();
    private List<string> _fleteros = new();
    private bool _cargando = true;
    private string? _busqueda;
    private string _fletero = "";
    private bool _verActivos = true;       // FoxPro arranca con "Ver Activos" tildado
    private bool _verFlotaPropia;
    private VehiculoListaRow? _sel;
    private readonly System.Globalization.CultureInfo _ar =
        System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    private IEnumerable<VehiculoListaRow> Filtrados =>
        _vehiculos.Where(v =>
            (string.IsNullOrWhiteSpace(_fletero)
                || string.Equals(v.Fletero, _fletero, StringComparison.OrdinalIgnoreCase))
            && (string.IsNullOrWhiteSpace(_busqueda)
                || v.Dominio.Contains(_busqueda, StringComparison.OrdinalIgnoreCase)
                || v.IdVehiculo.Contains(_busqueda, StringComparison.OrdinalIgnoreCase)
                || v.Interno.ToString().Contains(_busqueda, StringComparison.OrdinalIgnoreCase))
            && (!_verActivos || !v.EsEgresado)
            && (!_verFlotaPropia || v.EsPropio));

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthState.EstaAutenticadoAsync())
        {
            Nav.NavigateTo($"/login?destino={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: false);
            return;
        }
        if (!Permisos.Tiene('V'))   // módulo Vehículos y Choferes
        {
            Nav.NavigateTo("/", forceLoad: false);
            return;
        }
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        StateHasChanged();
        _vehiculos = await Reports.GetVehiculosAsync();
        _fleteros = _vehiculos
            .Select(v => v.Fletero)
            .Where(f => !string.IsNullOrWhiteSpace(f))
            .Distinct()
            .OrderBy(f => f)
            .ToList();
        _cargando = false;
    }

    @* Botón "Actualizar": invalida el caché de la grilla y vuelve a pegarle a SQL en vivo. *@
    private async Task Refrescar()
    {
        Reports.InvalidarCacheAbm();
        await CargarAsync();
    }

    @* Egresado/baja = !activo O f_delete cargada → fila amarilla (igual que FoxPro) *@
    private string RowClass(VehiculoListaRow v, int _) =>
        v.EsEgresado ? "cli-grid__row--egresado" : "";

    @* Vto con color: rojo vencido, ámbar por vencer (30 días) *@
    private RenderFragment Vto(DateOnly? f) => b =>
    {
        if (f is null) { b.AddContent(0, ""); return; }
        var hoy = DateOnly.FromDateTime(DateTime.Today);
        var clase = f < hoy ? "chof-vto--vencido"
                  : f <= hoy.AddDays(30) ? "chof-vto--proximo" : "";
        b.OpenElement(0, "span");
        if (!string.IsNullOrEmpty(clase)) b.AddAttribute(1, "class", clase);
        b.AddContent(2, f.Value.ToString("dd/MM/yy", _ar));
        b.CloseElement();
    };

    private void OnRowClick(TableRowClickEventArgs<VehiculoListaRow> args)
    {
        _sel = args.Item;
        // doble clic abre la ficha (como FoxPro)
        if (args.MouseEventArgs.Detail >= 2 && _sel is not null)
            _ = AbrirFicha(_sel.IdVehiculo);
    }

    private async Task AbrirSeleccionado()
    {
        if (_sel is not null) await AbrirFicha(_sel.IdVehiculo);
    }

    private async Task AbrirFicha(string idVehiculo)
    {
        var parametros = new DialogParameters<VehiculoDetalleDialog>
        {
            { x => x.IdVehiculo, idVehiculo }
        };
        var opciones = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = false,
            CloseOnEscapeKey = true,
            BackdropClick = true
        };
        await DialogService.ShowAsync<VehiculoDetalleDialog>("ABM de Vehículos", parametros, opciones);
    }
}
