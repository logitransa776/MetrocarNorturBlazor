@page "/"
@inject NorturAuthStateProvider AuthState
@inject IPermissionService Permisos
@inject NavigationManager Nav

@if (_sinModulos)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-12">
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            Tu usuario no tiene habilitado ningún módulo con reportes disponibles.
            Pedile al supervisor que te asigne permisos desde Sistema → Accesos del Metrocar.
        </MudAlert>
    </MudContainer>
}

@code {
    private bool _sinModulos;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthState.EstaAutenticadoAsync())
        {
            Nav.NavigateTo("/login", forceLoad: false);
            return;
        }

        // Primer reporte que el usuario puede ver según su acceso; si no tiene
        // ninguno (ej. usuario de servicio BACKUP), se queda acá con el aviso.
        var destino = Permisos.DestinoInicial();
        if (destino is not null)
            Nav.NavigateTo(destino, forceLoad: false);
        else
            _sinModulos = true;
    }
}
