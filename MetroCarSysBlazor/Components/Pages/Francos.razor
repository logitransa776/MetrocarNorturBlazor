@page "/francos"
@using MetroCarSysBlazor.Components.Shared
@inject ReportService Reports
@inject NorturAuthStateProvider AuthState
@inject IPermissionService Permisos
@inject NavigationManager Nav
@inject ExcelExportService ExcelSvc
@inject AbmService Abm
@inject IDialogService DialogService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>BusLink</PageTitle>

<div class="page-header mb-4">
    <MudText Typo="Typo.h5" Style="font-weight:800; color:#112F5B;">Mantenimiento de Francos</MudText>
    <MudText Typo="Typo.body2" Style="color:#7A90AD; margin-top:2px;">
        Tráfico · Francos, licencias y permisos de los choferes — vista de solo lectura (lista para el ABM)
    </MudText>
</div>

@* ── Filtros (réplica de chofer_franco.scx) ── *@
<MudPaper Class="pa-2 mb-3" Elevation="1" Style="border-radius:14px; border-top:4px solid #003AA0;">
    <div class="d-flex flex-wrap align-center" style="gap:14px;">
        <div class="d-flex align-center" style="gap:6px;">
            <MudDatePicker Label="Desde" @bind-Date="_desde" DateFormat="dd/MM/yyyy"
                           PickerVariant="PickerVariant.Dialog" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Style="width:170px;" />
            <MudDatePicker Label="Hasta" @bind-Date="_hasta" DateFormat="dd/MM/yyyy"
                           PickerVariant="PickerVariant.Dialog" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Style="width:170px;" />
        </div>
        <MudSelect T="string" @bind-Value="_motivo" Label="Motivo" Dense="true" Clearable="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:220px;">
            <MudSelectItem T="string" Value="@("")">Todos</MudSelectItem>
            @foreach (var m in _motivos)
            {
                <MudSelectItem T="string" Value="@m.Codigo">@m.Texto</MudSelectItem>
            }
        </MudSelect>
        <MudChip T="string" Variant="Variant.Text" Color="Color.Default" Size="Size.Small">
            @_francos.Count francos
        </MudChip>

        <span style="flex:1 1 auto;"></span>
        <div class="d-flex align-center" style="gap:6px;">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.FilterAlt" OnClick="Aplicar" Disabled="_cargando">Filtro</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Refresh" OnClick="Refrescar" Disabled="_cargando">Actualizar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Download" OnClick="DescargarExcel"
                       Disabled="_cargando || _francos.Count == 0">Excel</MudButton>
        </div>
    </div>
</MudPaper>

@if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" Style="border-radius:4px;" />
}
else
{
    <MudPaper Elevation="1" Style="border-radius:14px; overflow:hidden;">
        <MudTable Items="_francos" Dense="true" Hover="true" Striped="true"
                  FixedHeader="true" Height="calc(100vh - 355px)"
                  Bordered="false" Class="cli-grid grid-compacta"
                  RowClass="cli-grid__row" RowClassFunc="@RowClass"
                  OnRowClick="@OnRowClick" T="FrancoRow" Virtualize="true">
            <HeaderContent>
                <MudTh><MudTableSortLabel InitialDirection="SortDirection.Ascending" SortBy="new Func<FrancoRow, object>(x => x.Nombre)">Chofer</MudTableSortLabel></MudTh>
                <MudTh>Cód.</MudTh>
                <MudTh>Motivo</MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<FrancoRow, object>(x => x.Fecha)">Fecha</MudTableSortLabel></MudTh>
                <MudTh>Trabajó</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Chofer" Style="font-weight:600;">@context.Nombre</MudTd>
                <MudTd DataLabel="Cód." Style="font-weight:700; color:#003AA0;">@context.Codigo</MudTd>
                <MudTd DataLabel="Motivo">@context.Motivo</MudTd>
                <MudTd DataLabel="Fecha">@context.Fecha.ToString("dd/MM/yyyy")</MudTd>
                <MudTd DataLabel="Trabajó">@(context.Trabajo ? "Sí" : "No")</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Class="pa-4">
                    No hay francos en ese rango de fechas. Probá ampliando el período o cambiando el motivo.
                </MudText>
            </NoRecordsContent>
        </MudTable>

        @* ── Botonera réplica FoxPro (Agregar masivo / Eliminar / Modificar) ── *@
        @* ANDAMIAJE: la escritura se habilita con AbmFeatureFlags.FrancosAbmActivo (hoy false). *@
        <div class="cli-toolbar usr-toolbar">
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.PlaylistAdd"
                       Size="Size.Medium" Class="usr-toolbar__btn" OnClick="Agregar" Disabled="!_abmActivo">Ingreso masivo</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                       Size="Size.Medium" Class="usr-toolbar__btn" OnClick="Eliminar" Disabled="!_abmActivo || _sel is null">Eliminar</MudButton>
            <span style="flex:1;"></span>
            <span class="cli-toolbar__hint">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                @(_abmActivo
                    ? "ABM habilitado"
                    : "Solo lectura · el ABM se activa el día del corte a Buslink")
            </span>
        </div>
    </MudPaper>
}

@code {
    private static bool _abmActivo => AbmFeatureFlags.FrancosAbmActivo;

    private List<FrancoRow> _francos = new();
    private List<(string Codigo, string Texto)> _motivos = new();
    private bool _cargando = true;
    private DateTime? _desde = DateTime.Today.AddDays(-30);
    private DateTime? _hasta = DateTime.Today;
    private string _motivo = "";
    private FrancoRow? _sel;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthState.EstaAutenticadoAsync())
        {
            Nav.NavigateTo($"/login?destino={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: false);
            return;
        }
        if (!Permisos.Tiene('T'))
        {
            Nav.NavigateTo("/", forceLoad: false);
            return;
        }
        _motivos = await Reports.GetFrancoMotivosAsync();
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        StateHasChanged();
        var desde = DateOnly.FromDateTime(_desde ?? DateTime.Today.AddDays(-30));
        var hasta = DateOnly.FromDateTime(_hasta ?? DateTime.Today);
        _francos = await Reports.GetFrancosAsync(desde, hasta, string.IsNullOrWhiteSpace(_motivo) ? null : _motivo);
        if (_sel is not null)
            _sel = _francos.FirstOrDefault(f => f.Id == _sel.Id);
        _cargando = false;
    }

    private async Task Aplicar() => await CargarAsync();

    private async Task Refrescar()
    {
        Reports.InvalidarCacheAbm();
        await CargarAsync();
    }

    private string RowClass(FrancoRow f, int _) =>
        _sel is not null && _sel.Id == f.Id ? "cli-grid__row--sel" : "";

    private void OnRowClick(TableRowClickEventArgs<FrancoRow> args) => _sel = args.Item;

    private async Task Agregar()
    {
        var opciones = new DialogOptions
        {
            MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = false,
            CloseOnEscapeKey = true, BackdropClick = false
        };
        var dlg = await DialogService.ShowAsync<FrancoAltaDialog>("Ingreso de Francos", opciones);
        var res = await dlg.Result;
        if (res is not null && !res.Canceled && res.Data is bool grabo && grabo)
            await Refrescar();
    }

    private async Task Eliminar()
    {
        if (_sel is null || !_abmActivo) return;   // doble candado: con el flag en false no toca la base
        var ok = await DialogService.ShowMessageBoxAsync(
            "Eliminar franco",
            $"¿Eliminar el franco de {_sel.Nombre} del {_sel.Fecha:dd/MM/yyyy}?",
            yesText: "Eliminar", cancelText: "Cancelar");
        if (ok != true) return;
        var r = await Abm.BajaFrancoAsync(_sel.Id);
        if (r.Ok) await Refrescar();
        else await DialogService.ShowMessageBoxAsync("No se pudo eliminar", r.Error ?? "Error desconocido.");
    }

    private async Task DescargarExcel()
    {
        var bytes = ExcelSvc.Francos(_francos);
        await JS.InvokeVoidAsync("downloadFile", "Francos.xlsx", Convert.ToBase64String(bytes));
    }
}
