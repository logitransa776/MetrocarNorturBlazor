@page "/contactos"
@using MetroCarSysBlazor.Components.Shared
@inject ReportService Reports
@inject NorturAuthStateProvider AuthState
@inject IPermissionService Permisos
@inject NavigationManager Nav
@inject ExcelExportService ExcelSvc
@inject IDialogService DialogService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>BusLink</PageTitle>

<div class="page-header mb-4">
    <MudText Typo="Typo.h5" Style="font-weight:800; color:#112F5B;">Contactos y Proveedores</MudText>
    <MudText Typo="Typo.body2" Style="color:#7A90AD; margin-top:2px;">
        Tráfico · Agenda de proveedores de la empresa — vista de solo lectura (lista para el ABM)
    </MudText>
</div>

@* ── Filtros (réplica de la toolbar FoxPro estacion.scx: rubro + campo + texto) ── *@
<MudPaper Class="pa-2 mb-3" Elevation="1" Style="border-radius:14px; border-top:4px solid #003AA0;">
    <div class="d-flex flex-wrap align-center" style="gap:14px;">
        <MudSelect T="long" Value="_rubroId" ValueChanged="OnRubroChanged" Label="Rubro" Dense="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:190px;">
            <MudSelectItem Value="0L">Todos los rubros</MudSelectItem>
            @foreach (var r in _rubros)
            {
                <MudSelectItem Value="@((long)r.Id)">@r.Rubro</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="string" @bind-Value="_campo" @bind-Value:after="CargarAsync" Label="Campo" Dense="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:150px;">
            <MudSelectItem Value="@("razon")">Razón social</MudSelectItem>
            <MudSelectItem Value="@("direccion")">Dirección</MudSelectItem>
            <MudSelectItem Value="@("localidad")">Localidad</MudSelectItem>
            <MudSelectItem Value="@("telefono")">Teléfono</MudSelectItem>
        </MudSelect>
        <MudTextField @bind-Value="_texto" Label="Buscar" Immediate="true" DebounceInterval="250"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Style="min-width:220px;" OnDebounceIntervalElapsed="CargarAsync" />
        <MudChip T="string" Variant="Variant.Text" Color="Color.Default" Size="Size.Small">@_items.Count proveedores</MudChip>

        <span style="flex:1 1 auto;"></span>
        <div class="d-flex align-center" style="gap:6px;">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Refresh" OnClick="Refrescar" Disabled="_cargando">Actualizar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Download" OnClick="DescargarExcel"
                       Disabled="_cargando || _items.Count == 0">Excel</MudButton>
        </div>
    </div>
</MudPaper>

@if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" Style="border-radius:4px;" />
}
else
{
    <MudPaper Elevation="1" Style="border-radius:14px; overflow:hidden;">
        <MudTable Items="_items" Dense="true" Hover="true" Striped="true"
                  FixedHeader="true" Height="calc(100vh - 320px)"
                  Bordered="false" Class="cli-grid grid-compacta"
                  RowClass="cli-grid__row" RowClassFunc="@RowClass"
                  OnRowClick="@OnRowClick" T="ContactoRow">
            <HeaderContent>
                <MudTh><MudTableSortLabel InitialDirection="SortDirection.Ascending" SortBy="new Func<ContactoRow, object>(x => x.Nombre)">Razón social</MudTableSortLabel></MudTh>
                <MudTh>Rubro</MudTh>
                <MudTh>Domicilio</MudTh>
                <MudTh>Localidad</MudTh>
                <MudTh>Provincia</MudTh>
                <MudTh>Teléfono</MudTh>
                <MudTh>Celular</MudTh>
                <MudTh>Contacto</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Razón social" Style="font-weight:700; color:#003AA0;">@context.Nombre</MudTd>
                <MudTd DataLabel="Rubro">@context.Rubro</MudTd>
                <MudTd DataLabel="Domicilio">@context.Domicilio</MudTd>
                <MudTd DataLabel="Localidad">@context.Localidad</MudTd>
                <MudTd DataLabel="Provincia">@context.Provincia</MudTd>
                <MudTd DataLabel="Teléfono">@context.Telefono</MudTd>
                <MudTd DataLabel="Celular">@context.Celular</MudTd>
                <MudTd DataLabel="Contacto">@context.Contacto1</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Class="pa-4">No hay proveedores para el filtro aplicado.</MudText>
            </NoRecordsContent>
        </MudTable>

        <div class="cli-toolbar usr-toolbar">
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add"
                       Size="Size.Medium" Class="usr-toolbar__btn" OnClick="Agregar" Disabled="!_abmActivo">Agregar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                       Size="Size.Medium" Class="usr-toolbar__btn" OnClick="Eliminar" Disabled="!_abmActivo || _sel is null">Eliminar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                       Size="Size.Medium" Class="usr-toolbar__btn" OnClick="Modificar" Disabled="!_abmActivo || _sel is null">Modificar</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Visibility"
                       Size="Size.Medium" Class="usr-toolbar__btn" OnClick="Ver" Disabled="_sel is null">Ver ficha</MudButton>
            <span style="flex:1;"></span>
            <span class="cli-toolbar__hint">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                @(_abmActivo
                    ? "ABM habilitado · doble clic para ver la ficha"
                    : "Solo lectura · catálogo compartido con Combustible · el ABM se activa el día del corte a Buslink")
            </span>
        </div>
    </MudPaper>
}

@code {
    private static bool _abmActivo => AbmFeatureFlags.ContactosAbmActivo;

    private List<ContactoRow> _items = new();
    private List<RubroContactoRow> _rubros = new();
    private long _rubroId;
    private string _campo = "razon";
    private string? _texto;
    private bool _cargando = true;
    private ContactoRow? _sel;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthState.EstaAutenticadoAsync())
        {
            Nav.NavigateTo($"/login?destino={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: false);
            return;
        }
        if (!Permisos.Tiene('T'))
        {
            Nav.NavigateTo("/", forceLoad: false);
            return;
        }
        _rubros = await Reports.GetRubrosContactoAsync();
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        StateHasChanged();
        _items = await Reports.GetContactosListaAsync(_rubroId, _campo, _texto ?? "");
        if (_sel is not null)
            _sel = _items.FirstOrDefault(i => i.Id == _sel.Id);
        _cargando = false;
    }

    private async Task OnRubroChanged(long id)
    {
        _rubroId = id;
        await CargarAsync();
    }

    private async Task Refrescar()
    {
        Reports.InvalidarCacheAbm();
        await CargarAsync();
    }

    private string RowClass(ContactoRow c, int _) =>
        _sel is not null && _sel.Id == c.Id ? "cli-grid__row--sel" : "";

    private void OnRowClick(TableRowClickEventArgs<ContactoRow> args)
    {
        _sel = args.Item;
        if (args.MouseEventArgs.Detail >= 2 && _sel is not null)
            _ = AbrirDialog("ver", _sel.Id);
    }

    private Task Agregar() => AbrirDialog("alta", 0);
    private Task Ver() => _sel is null ? Task.CompletedTask : AbrirDialog("ver", _sel.Id);
    private Task Modificar() => _sel is null ? Task.CompletedTask : AbrirDialog("modifica", _sel.Id);
    private Task Eliminar() => _sel is null ? Task.CompletedTask : AbrirDialog("baja", _sel.Id);

    private async Task AbrirDialog(string modo, int id)
    {
        var parametros = new DialogParameters<ContactoEditorDialog>
        {
            { x => x.Modo, modo },
            { x => x.Id, id }
        };
        var opciones = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = false,
            CloseOnEscapeKey = true, BackdropClick = false
        };
        var dlg = await DialogService.ShowAsync<ContactoEditorDialog>("Contacto", parametros, opciones);
        var res = await dlg.Result;
        if (res is not null && !res.Canceled && res.Data is bool grabo && grabo)
            await Refrescar();
    }

    private async Task DescargarExcel()
    {
        var bytes = ExcelSvc.Contactos(_items);
        await JS.InvokeVoidAsync("downloadFile", "Contactos.xlsx", Convert.ToBase64String(bytes));
    }
}
