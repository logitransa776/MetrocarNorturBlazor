        },
    };

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthState.EstaAutenticadoAsync())
        {
            Nav.NavigateTo($"/login?destino={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: false);
            return;
        }
        // La letra la decide el catálogo, no esta página: hoy pide 'S' porque el informe está
        // EN DESARROLLO, y volverá a pedir 'V' (Vehículos y Choferes) el día que se lo gradúe.
        if (!InformesCatalogo.PuedeVerRuta(Permisos, "panel-flota"))
        {
            Nav.NavigateTo("/", forceLoad: false);
            return;
        }
        await Cargar();
    }

    private async Task Cargar()
    {
        if (_desde is null || _hasta is null) return;

        _cargando = true;
        StateHasChanged();

        _desdeAp = DateOnly.FromDateTime(_desde.Value);
        _hastaAp = DateOnly.FromDateTime(_hasta.Value);
        _focus = null;   // datos nuevos → el foco anterior puede ya no existir

        var unidades = Reports.GetFlotaUnidadesAsync(_desdeAp, _hastaAp);
        var demanda = Reports.GetFlotaDemandaAsync(_desdeAp, _hastaAp);
        await Task.WhenAll(unidades, demanda);
        _unidades = unidades.Result;
        _demanda = demanda.Result;

        Recalcular();
        RemontarGraficos();
        _cargando = false;
    }

    // Universo y dimensión son cortes del MISMO dataset: se aplican al instante, sin re-query.
    private void CambiarUniverso(IEnumerable<string> sel)
    {
        _universoSel = sel.ToHashSet();
        _focus = null;
        Recalcular();
        RemontarGraficos();
    }

    private void CambiarDimension(string dim)
    {
        _dimension = dim;
        _focus = null;   // el foco era una categoría de la dimensión anterior
        Recalcular();
        RemontarGraficos();
    }

    /// <summary>
    /// Cambió la FORMA de los datos (otras categorías, otra cantidad de barras): los gráficos
    /// se remontan. Actualizarlos "en su lugar" acá los dejaría con las categorías viejas.
    /// </summary>
    private void RemontarGraficos()
    {
        _chartsKey = Guid.NewGuid();
        _pieKey = Guid.NewGuid();
    }

    /// <summary>Universo elegido: qué unidades entran en el conteo.</summary>
    private bool PasaUniverso(FlotaUnidadRow u)
    {
        if (u.EsBaja) return _uniBajas;
        if (u.EsContratada) return _uniContratadas;
        return _uniPropias;   // PROPIO, o sin dato de uso
    }

    private void Recalcular()
    {
        _base = _unidades.Where(PasaUniverso).ToList();
        if (_base.Count == 0)
        {
            _resumen = new(); _barItems = new(); _pieItems = new();
            _ofertaDemanda = new(); _sinAsignarItems = new();
            return;
        }

        // ── Resumen por categoría: SIEMPRE todas las categorías del universo ──
        // (no dependen del foco: el foco atenúa, así el usuario puede cambiar de categoría).
        _resumen = _base
            .GroupBy(u => u.Categoria(_dimension))
            .Select(g => new FlotaResumenCatRow(
                Cat: g.Key,
                Unidades: g.Count(),
                Propias: g.Count(u => !u.EsBaja && u.EsPropia),
                Contratadas: g.Count(u => !u.EsBaja && u.EsContratada),
                Bajas: g.Count(u => u.EsBaja),
                Butacas: g.Sum(u => u.Pax),
                AntiguedadProm: g.Any(u => u.Antiguedad is not null)
                    ? g.Where(u => u.Antiguedad is not null).Average(u => u.Antiguedad!.Value)
                    : null,
                Ociosas: g.Count(u => u.EsOciosa),
                Viajes: g.Sum(u => u.Viajes),
                Km: g.Where(u => u.TieneKm).Sum(u => u.Km),
                UnidadesConKm: g.Count(u => u.TieneKm)))
            .OrderByDescending(r => r.Unidades)
            .ThenBy(r => r.Cat)
            .ToList();

        // Los tramos de antigüedad y capacidad se leen mejor en su orden natural que por volumen.
        if (_esDimensionOrdinal)
            _resumen = _resumen.OrderBy(r => OrdenTramo(r.Cat)).ToList();

        // Color por entidad: el ranking por cantidad define el hue, y ese color acompaña a la
        // categoría en las barras, en la torta y en el punto de la tabla.
        _colorPorCat = _resumen
            .OrderByDescending(r => r.Unidades)
            .Select((r, i) => (r.Cat, i))
            .ToDictionary(t => t.Cat, t => t.i < _palette.Count ? _palette[t.i] : _colorOtros);

        // ── Gráficos de composición: valores completos, el foco solo cambia los colores ──
        // Las barras siguen el MISMO orden que la tabla: ranking por cantidad en las
        // dimensiones nominales (tipo, titular) y orden natural en las ordinales (antigüedad,
        // capacidad) — una escala de edad leída por volumen se entiende mal.
        var ordenGraf = _esDimensionOrdinal
            ? _resumen
            : _resumen.OrderByDescending(r => r.Unidades).ToList();
        _barItems = ordenGraf.Select(r => new BarItem(r.Cat, r.Unidades)).ToList();
        _altoBarras = Math.Max(280, _barItems.Count * 34);
        AplicarTotal(_optsBar, _barItems.Sum(b => (int)b.Valor), _barItems.Count > 0 ? (int)_barItems.Max(b => b.Valor) : 0);
        _optsBar.Colors = _barItems.Select(b => ColorFoco(b.Cat)).ToList();

        _pieItems = ordenGraf.Where(r => r.Butacas > 0)
            .OrderByDescending(r => r.Butacas)
            .Select(r => new PieItem(r.Cat, r.Butacas))
            .ToList();
        _optsPie.Colors = _pieItems.Select(p => ColorFoco(p.Cat)).ToList();
        var totalButacas = _pieItems.Sum(p => (int)p.Valor);
        if (_optsPie.Legend is not null)
            _optsPie.Legend.Formatter =
                $"function(name, opts){{ var v = opts.w.globals.series[opts.seriesIndex]; var p = {totalButacas} > 0 ? Math.round(v * 100 / {totalButacas}) : 0; return name + ': ' + v.toLocaleString('es-AR') + ' (' + p + '%)'; }}";

        // ── Oferta vs demanda por TIPO (siempre por tipo, sea cual sea la dimensión) ──
        // El universo se respeta en la oferta; la demanda es del período completo.
        var flotaActivaPorTipo = _base
            .Where(u => !u.EsBaja)
            .GroupBy(u => string.IsNullOrWhiteSpace(u.Tipo) ? "Sin tipo" : u.Tipo)
            .ToDictionary(g => g.Key, g => (Unidades: g.Count(), Trabajaron: g.Count(u => u.Viajes > 0)));
        var demandaPorTipo = _demanda.ToDictionary(d => d.Tipo, d => d);

        _ofertaDemanda = flotaActivaPorTipo.Keys.Union(demandaPorTipo.Keys)
            .Select(t => new FlotaOfertaDemandaRow(
                Tipo: t,
                Unidades: flotaActivaPorTipo.TryGetValue(t, out var f) ? f.Unidades : 0,
                Trabajaron: flotaActivaPorTipo.TryGetValue(t, out var f2) ? f2.Trabajaron : 0,
                Pedidos: demandaPorTipo.TryGetValue(t, out var d) ? d.Viajes : 0,
                SinAsignar: demandaPorTipo.TryGetValue(t, out var d2) ? d2.SinAsignar : 0))
            .OrderByDescending(x => x.Pedidos)
            .ThenByDescending(x => x.Unidades)
            .ToList();

        _sinAsignarItems = _ofertaDemanda.Where(x => x.SinAsignar > 0)
            .OrderByDescending(x => x.SinAsignar)
            .Select(x => new BarItem(x.Tipo, x.SinAsignar))
            .ToList();
        _altoFalta = Math.Max(240, _sinAsignarItems.Count * 40);
        AplicarTotal(_optsFalta, _sinAsignarItems.Sum(b => (int)b.Valor),
                     _sinAsignarItems.Count > 0 ? (int)_sinAsignarItems.Max(b => b.Valor) : 0);
        _optsFalta.Colors = _sinAsignarItems
            .Select(b => AtenuaTipo(b.Cat) ? "#D9E1EC" : "#DC2626")
            .ToList();

        // ── KPIs y totales: sobre el universo CON el foco aplicado ──
        var datos = _focus is null ? _base : _base.Where(u => u.Categoria(_dimension) == _focus).ToList();

        _kUnidades = datos.Count;
        _tUnidades = _kUnidades;
        _tPropias = _kPropias(datos);
        _tContratadas = datos.Count(u => !u.EsBaja && u.EsContratada);
        _tBajas = datos.Count(u => u.EsBaja);
        _kButacas = _tButacas = datos.Sum(u => u.Pax);
        _kCategorias = datos.Select(u => u.Categoria(_dimension)).Distinct().Count();
        _kOciosas = _tOciosas = datos.Count(u => u.EsOciosa);
        _tViajes = datos.Sum(u => u.Viajes);
        _tKm = datos.Where(u => u.TieneKm).Sum(u => u.Km);
        _kmDudosos = datos.Sum(u => u.MesesOdometroRaro);

        // Subtítulos cortos a propósito: son 6 KPIs en fila y el texto largo se corta con "…".
        _kUnidadesSub = _tBajas > 0
            ? $"{_tPropias} prop · {_tContratadas} contr · {_tBajas} baja"
            : $"{_tPropias} propias · {_tContratadas} contr.";

        var activas = datos.Count(u => !u.EsBaja);
        _kOciosasSub = activas > 0
            ? $"{(_kOciosas * 100.0 / activas):0} % de {activas} activas"
            : "sin unidades activas";

        // Los sin asignar del KPI siguen el foco solo cuando la dimensión es el tipo.
        var sinAsignarVisible = (_focus is not null && _dimension == ReportService.DimFlotaTipo)
            ? _ofertaDemanda.Where(x => x.Tipo == _focus)
            : _ofertaDemanda;
        _kSinAsignar = sinAsignarVisible.Sum(x => x.SinAsignar);
        var pedidos = sinAsignarVisible.Sum(x => x.Pedidos);
        _kSinAsignarSub = pedidos > 0
            ? $"{(_kSinAsignar * 100.0 / pedidos):0.0} % de {Fmt(pedidos)} pedidos"
            : "sin demanda en el período";

        var conEdad = datos.Where(u => u.Antiguedad is not null).ToList();
        _kAntiguedad = conEdad.Count > 0 ? $"{conEdad.Average(u => u.Antiguedad!.Value):0.0} años" : "·";
        _kAntiguedadSub = conEdad.Count == datos.Count
            ? "sobre el año de modelo"
            : $"{datos.Count - conEdad.Count} sin año de modelo cargado";
    }

    private static int _kPropias(List<FlotaUnidadRow> datos) => datos.Count(u => !u.EsBaja && u.EsPropia);

    /// <summary>
    /// Antigüedad y capacidad son escalas ORDINALES (los tramos tienen un orden propio);
    /// tipo y titular son nominales (se ordenan por volumen).
    /// </summary>
    private bool _esDimensionOrdinal =>
        _dimension is ReportService.DimFlotaAntiguedad or ReportService.DimFlotaCapacidad;

    /// <summary>Orden natural de los tramos (el texto de la categoría empieza por el número).</summary>
    private static int OrdenTramo(string cat) => cat switch
    {
        "Sin dato" => 99,
        "0 a 3 años" => 0,
        "4 a 7 años" => 1,
        "8 a 12 años" => 2,
        "13 años o más" => 3,
        "1 a 5 butacas" => 0,
        "6 a 19 butacas" => 1,
        "20 a 29 butacas" => 2,
        "30 a 45 butacas" => 3,
        "46 butacas o más" => 4,
        _ => 50,
    };

    // Inyecta el total (para el % del datalabel) y el margen del eje X, para que el número
    // del final de la barra más larga no se corte contra el borde.
    private static void AplicarTotal(ApexChartOptions<BarItem> opts, int total, int maxValor)
    {
        if (opts.DataLabels is not null)
            opts.DataLabels.Formatter =
                "function(val){ var p = " + total + " > 0 ? Math.round(val * 100 / " + total + ") : 0; return val.toLocaleString('es-AR') + ' (' + p + '%)'; }";
        if (opts.Xaxis is not null)
        {
            opts.Xaxis.Min = 0;
            opts.Xaxis.Max = maxValor > 0 ? maxValor * 1.30 : 1;
        }
    }

    // ── Cross-filter ──
    private async Task ToggleFoco(string cat)
    {
        _focus = _focus == cat ? null : cat;
        Recalcular();
        _pieKey = Guid.NewGuid();   // la torta se remonta (el update en el lugar le rompe la leyenda)
        // Los gráficos de barras cambian solo de color: update en el lugar, sin parpadeo.
        if (_barChart is not null) await _barChart.UpdateOptionsAsync(true, true, false);
        if (_faltaChart is not null) await _faltaChart.UpdateOptionsAsync(true, true, false);
    }

    private Task LimpiarFoco() => ToggleFoco(_focus ?? "");

    private async Task OnBarSelection(SelectedData<BarItem> e)
    {
        var cat = e.DataPoint?.Items?.FirstOrDefault()?.Cat;
        if (cat is not null) await ToggleFoco(cat);
    }

    private async Task OnPieSelection(SelectedData<PieItem> e)
    {
        var cat = e.DataPoint?.Items?.FirstOrDefault()?.Cat;
        if (cat is not null) await ToggleFoco(cat);
    }

    // ── Drill-down: las unidades de una categoría, una por una ──
    private async Task AbrirUnidades(string cat)
    {
        var items = _base.Where(u => u.Categoria(_dimension) == cat)
                         .OrderBy(u => u.Interno == 0 ? int.MaxValue : u.Interno)
                         .ThenBy(u => u.Dominio)
                         .ToList();
        if (items.Count == 0) return;

        var parametros = new DialogParameters<FlotaUnidadesDialog>
        {
            { x => x.Items, items },
            { x => x.Subtitulo, $"{EtiquetaDimSingularTit}: {cat} · actividad de {PeriodoTxt}" }
        };
        var opciones = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge, FullWidth = true,
            CloseButton = false, CloseOnEscapeKey = true, BackdropClick = true
        };
        await DialogService.ShowAsync<FlotaUnidadesDialog>("Unidades de la flota", parametros, opciones);
    }

    private async Task DescargarExcel()
    {
        var bytes = Excel.PanelFlota(
            _base, _resumen, _ofertaDemanda, EtiquetaDimSingularTit, _desdeAp, _hastaAp);
        var nombre = $"panel_flota_{_dimension.ToLower()}_{_desdeAp:yyyyMMdd}_{_hastaAp:yyyyMMdd}.xlsx";
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("descargarArchivo", nombre, streamRef);
    }

    private static string Fmt(int n) => n.ToString("#,0", _ar);
    private static string Fmt(long n) => n.ToString("#,0", _ar);
    private static string Cero(int n) => n > 0 ? Fmt(n) : "·";
    private static string Cero(long n) => n > 0 ? Fmt(n) : "·";
}
