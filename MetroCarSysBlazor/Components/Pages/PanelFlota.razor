    private ApexChartOptions<BarItem> _optsBar = OpcionesBarras("#2058D0");
    private ApexChartOptions<BarItem> _optsFalta = OpcionesBarras("#DC2626");

    // Barras horizontales con el número afuera al final (patrón del proyecto). Se usa igual
    // para "Unidades por categoría" y para "Viajes sin asignar por tipo".
