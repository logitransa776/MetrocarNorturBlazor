@page "/panel-flota"
@using ApexCharts
@using MudColor = MudBlazor.Color
@using MudSize = MudBlazor.Size
@inject ReportService Reports
@inject ExcelExportService Excel
@inject NorturAuthStateProvider AuthState
@inject IPermissionService Permisos
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDialogService DialogService
@rendermode InteractiveServer

@* ─────────────────────────────────────────────────────────────────────────────
   Panel de Flota — informe NUEVO (no existe en el Metrocar/FoxPro).

   Contesta las tres preguntas de la flota en un solo tablero:
     · QUÉ TENGO    → composición (unidades, butacas, antigüedad, titular)
     · QUÉ NO TENGO → demanda por tipo pedido vs unidades, medida en SIN ASIGNAR
     · QUÉ NO USO   → unidades activas sin un solo viaje en el período

   Dos consultas y todo lo demás en memoria (~412 unidades): los switches de
   universo, el cambio de dimensión y el cross-filter no vuelven a la base.
   ───────────────────────────────────────────────────────────────────────────── *@

<PageTitle>BusLink</PageTitle>

<div class="page-header mb-3">
    <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
        <MudText Typo="Typo.h5" Style="font-weight:800; color:#112F5B;">
            Panel de Flota
        </MudText>
        @* El informe está EN DESARROLLO en el catálogo: el badge lo dice también acá, para que
           quien lo abre sepa que está en evaluación y no publicado a la operación. *@
        <span class="nt-badge-dev" title="Informe en evaluación: se publica al módulo Flota cuando el cliente lo apruebe.">
            <MudIcon Icon="@Icons.Material.Filled.Science" Size="MudSize.Small" />
            En desarrollo
        </span>
        <AyudaReporte Ruta="panel-flota" />
    </div>
    <MudText Typo="Typo.body2" Style="color:#7A90AD; margin-top:2px;">
        Qué unidades hay, de qué tipo y qué capacidad · Nortur
    </MudText>
</div>

@* ── Barra de filtros (filtros a la izquierda, acciones juntas a la derecha) ── *@
<MudPaper Elevation="1" Class="rfs-filtros mb-3">
    <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="MudSize.Small" Style="color:#003AA0; flex-shrink:0;" />

    <div class="rfs-fechas">
        <MudDatePicker Label="Desde" Date="_desde" DateChanged="@(d => _desde = d)"
                       MinDate="_min" MaxDate="_max" DateFormat="dd/MM/yyyy"
                       PickerVariant="PickerVariant.Dialog" Editable="true"
                       Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:160px;" />
        <MudDatePicker Label="Hasta" Date="_hasta" DateChanged="@(d => _hasta = d)"
                       MinDate="_min" MaxDate="_max" DateFormat="dd/MM/yyyy"
                       PickerVariant="PickerVariant.Dialog" Editable="true"
                       Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:160px;" />
    </div>

    @* Universo: se aplica AL INSTANTE (es un filtro en memoria, no cuesta una query). *@
    <MudSelect T="string" Label="Universo" MultiSelection="true"
               SelectedValues="_universoSel" SelectedValuesChanged="CambiarUniverso"
               Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:210px;"
               title="Qué unidades entran en el conteo. Propias y contratadas son la flota que opera hoy; las dadas de baja (vendidas o desafectadas) están para ver el histórico. Se aplica al instante."
               MultiSelectionTextFunc="@(s => s.Count == 3 ? "Toda la flota" : string.Join(", ", s))">
        @foreach (var u in _universos)
        {
            <MudSelectItem T="string" Value="@u">@u</MudSelectItem>
        }
    </MudSelect>

    @* Dimensión: también al instante — es un corte del mismo dataset. *@
    <MudSelect T="string" Label="Desglosar por" Value="_dimension" ValueChanged="CambiarDimension"
               Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:175px;"
               title="Con qué criterio abrir la flota: por tipo de vehículo (BUS, VAN, MINI…), por titular (NORTUR y los fleteros), por antigüedad o por capacidad de butacas. Se aplica al instante.">
        @foreach (var d in ReportService.DimensionesFlota)
        {
            <MudSelectItem T="string" Value="@d">@EtiquetaDim(d)</MudSelectItem>
        }
    </MudSelect>

    <span style="flex:1 1 auto;"></span>

    <div style="display:flex; gap:6px; flex-shrink:0;">
        <MudButton Variant="Variant.Filled" Color="@(_pendientes > 0 ? MudColor.Warning : MudColor.Primary)"
                   OnClick="Cargar" Disabled="_cargando"
                   StartIcon="@(_pendientes > 0 ? Icons.Material.Filled.PriorityHigh : Icons.Material.Filled.Search)"
                   Style="border-radius:8px; height:40px; text-transform:none;">
            @(_cargando ? "Cargando..." : _pendientes > 0 ? $"Aplicar filtros ({_pendientes})" : "Aplicar filtros")
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="MudColor.Success"
                   StartIcon="@Icons.Material.Filled.Download" OnClick="DescargarExcel"
                   Disabled="@(_cargando || _unidades.Count == 0)"
                   Style="border-radius:8px; height:40px; text-transform:none;">
            Excel
        </MudButton>
    </div>
</MudPaper>

@if (_pendientes > 0 && !_cargando)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Style="border-radius:12px;"
              Icon="@Icons.Material.Filled.Update">
        Lo que se ve abajo <b>todavía no incluye</b> el cambio de fechas — apretá <b>Aplicar filtros</b> para actualizar.
    </MudAlert>
}

@if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Color="MudColor.Primary" Class="mb-4" Style="border-radius:4px;" />
}
else if (_unidades.Count == 0)
{
    <MudAlert Severity="Severity.Warning" Style="border-radius:12px;">No se pudo leer la flota.</MudAlert>
}
else if (_base.Count == 0)
{
    <MudAlert Severity="Severity.Warning" Style="border-radius:12px;">
        No hay unidades en el universo elegido. Tildá al menos una opción en <b>Universo</b>.
    </MudAlert>
}
else
{
    <div class="@(_pendientes > 0 ? "rfs-desactualizado" : "")">

    @* ── KPIs ── *@
    <div class="rfs-kpis mb-3">
        <KpiCard Label="Unidades" Value="@Fmt(_kUnidades)" Sub="@_kUnidadesSub" Color="@NorturColors.Azul" />
        <KpiCard Label="Butacas" Value="@Fmt(_kButacas)" Sub="capacidad instalada" Color="@NorturColors.Verde" />
        <KpiCard Label="@EtiquetaDimPlural" Value="@_kCategorias.ToString()" Sub="en la flota" Color="@NorturColors.Naranja" />
        <KpiCard Label="Sin uso" Value="@Fmt(_kOciosas)" Sub="@_kOciosasSub" Color="#B45309" />
        <KpiCard Label="Viajes sin asignar" Value="@Fmt(_kSinAsignar)" Sub="@_kSinAsignarSub" Color="@NorturColors.Rojo" />
        <KpiCard Label="Antigüedad promedio" Value="@_kAntiguedad" Sub="@_kAntiguedadSub" Color="#7C3AED" />
    </div>

    @* La aclaración es parte del informe, no un adorno: la tabla `vehiculo` no guarda historia,
       así que el plantel es siempre el de hoy y el período solo mide la actividad. *@
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Style="border-radius:12px;"
              Icon="@Icons.Material.Filled.Info">
        El <b>plantel es la foto de hoy</b> (el sistema no guarda cuántas unidades había en una fecha pasada).
        El período <b>@PeriodoTxt</b> mide la <b>actividad</b>: viajes, días trabajados, kilómetros y viajes sin asignar.
    </MudAlert>

    @* ── Composición: unidades por categoría + butacas por categoría ──
       El @key remonta los gráficos cuando cambia la FORMA de los datos (otro período, otro
       universo, otra dimensión): sin él, el de barras se quedaba con las categorías anteriores
       —al pasar a "Antigüedad" seguía mostrando BUS/VAN/MINI—. En el cambio de FOCO NO se
       regenera: ahí los gráficos se actualizan en su lugar, que es lo que evita el parpadeo. *@
    <MudGrid @key="_chartsKey" Spacing="3" Class="mb-3" Style="align-items:stretch;">
        <MudItem xs="12" md="7" Style="display:flex; flex-direction:column;">
            <MudPaper Class="pa-4" Elevation="1" Style="border-radius:14px; flex:1;">
                @CabeceraFoco($"Unidades por {EtiquetaDimSingular}")
                <ApexChart TItem="BarItem" Options="_optsBar" Height="@_altoBarras" @ref="_barChart"
                           OnDataPointSelection="OnBarSelection">
                    <ApexPointSeries TItem="BarItem" Items="_barItems" Name="Unidades"
                                     SeriesType="SeriesType.Bar"
                                     XValue="@(x => x.Cat)" YValue="@(x => x.Valor)"
                                     ShowDataLabels="true" />
                </ApexChart>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="5" Style="display:flex; flex-direction:column;">
            <MudPaper Class="pa-4" Elevation="1" Style="border-radius:14px; flex:1;">
                @CabeceraFoco("Butacas — capacidad instalada")
                @* Torta limpia + cantidad y % en la LEYENDA (ApexCharts no tiene leader lines).
                   @key propio: se remonta en cada foco para que la leyenda no quede con los
                   valores del render anterior (regla del cross-filter). *@
                <ApexChart @key="_pieKey" TItem="PieItem" Options="_optsPie" Height="360"
                           OnDataPointSelection="OnPieSelection">
                    <ApexPointSeries TItem="PieItem" Items="_pieItems" Name="Butacas"
                                     SeriesType="SeriesType.Pie"
                                     XValue="@(x => x.Cat)" YValue="@(x => x.Valor)" />
                </ApexChart>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* ── Oferta vs demanda por tipo — "de qué no hay" ── *@
    <MudPaper Class="pa-4 mb-3" Elevation="1" Style="border-radius:14px;">
        <div class="mb-2">
            <MudText Typo="Typo.subtitle2" Style="font-weight:700; color:#112F5B;">
                Oferta vs demanda por tipo de vehículo
                <AyudaReporte Ruta="panel-flota" Bloque="oferta" Chico="true" />
            </MudText>
            <MudText Typo="Typo.caption" Style="color:#8FA3BC;">
                Los <b>sin asignar</b> son los servicios que se pidieron de cada tipo y no encontraron unidad: es la medida
                del faltante. La demanda sale del tipo pedido en la reserva, que puede no existir en la flota (y al revés).
            </MudText>
        </div>

        <MudGrid Spacing="3" Style="align-items:stretch;">
            <MudItem xs="12" md="7">
                <div class="rfs-tabla-wrap" style="max-height:340px;">
                    <table class="rfs-tabla">
                        <thead>
                            <tr>
                                <th class="rfs-col-fecha">Tipo</th>
                                <th class="rfs-num" title="Unidades activas de ese tipo en la flota (propias + contratadas)">Unidades</th>
                                <th class="rfs-num" title="Unidades distintas que efectivamente hicieron algún viaje">Trabajaron</th>
                                <th class="rfs-num" title="Viajes pedidos de ese tipo en el período (todos los estados)">Pedidos</th>
                                <th class="rfs-num" title="Viajes que quedaron sin unidad asignada">Sin asignar</th>
                                <th class="rfs-num" title="Qué porcentaje de lo pedido quedó sin cubrir">% sin cubrir</th>
                                <th class="rfs-num" title="Carga media: viajes pedidos por cada unidad activa del tipo">Viajes/unidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in _ofertaDemanda)
                            {
                                var atenua = AtenuaTipo(f.Tipo) ? "rfs-atenua" : "";
                                <tr>
                                    <td class="rfs-col-fecha @atenua">@f.Tipo</td>
                                    <td class="rfs-num @atenua @(f.Unidades == 0 ? "pfl-alerta" : "")">@(f.Unidades > 0 ? Fmt(f.Unidades) : "sin flota")</td>
                                    <td class="rfs-num @atenua">@(f.Unidades > 0 ? Fmt(f.Trabajaron) : "·")</td>
                                    <td class="rfs-num @atenua">@(f.Pedidos > 0 ? Fmt(f.Pedidos) : "·")</td>
                                    <td class="rfs-num @atenua @(f.SinAsignar > 0 ? "pfl-alerta" : "")">@(f.SinAsignar > 0 ? Fmt(f.SinAsignar) : "·")</td>
                                    <td class="rfs-num @atenua">@(f.Pedidos > 0 ? $"{f.PctSinCubrir:0.0}%" : "·")</td>
                                    <td class="rfs-num @atenua">@(f.Unidades > 0 && f.Pedidos > 0 ? f.ViajesPorUnidad.ToString("#,0.0", _ar) : "·")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td class="rfs-col-fecha rfs-tot">TOTAL</td>
                                <td class="rfs-num rfs-tot">@Fmt(_ofertaDemanda.Sum(x => x.Unidades))</td>
                                <td class="rfs-num rfs-tot">@Fmt(_ofertaDemanda.Sum(x => x.Trabajaron))</td>
                                <td class="rfs-num rfs-tot">@Fmt(_ofertaDemanda.Sum(x => x.Pedidos))</td>
                                <td class="rfs-num rfs-tot rfs-grantot">@Fmt(_ofertaDemanda.Sum(x => x.SinAsignar))</td>
                                <td class="rfs-num rfs-tot">@PctSinCubrirTotal</td>
                                <td class="rfs-num rfs-tot">·</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </MudItem>
            <MudItem xs="12" md="5">
                @if (_sinAsignarItems.Count > 0)
                {
                    <ApexChart @key="_chartsKey" TItem="BarItem" Options="_optsFalta" Height="@_altoFalta" @ref="_faltaChart">
                        <ApexPointSeries TItem="BarItem" Items="_sinAsignarItems" Name="Sin asignar"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(x => x.Cat)" YValue="@(x => x.Valor)"
                                         ShowDataLabels="true" />
                    </ApexChart>
                }
                else
                {
                    <MudAlert Severity="Severity.Success" Dense="true" Style="border-radius:12px;">
                        En este período <b>no quedó ningún viaje sin asignar</b>: la flota cubrió toda la demanda.
                    </MudAlert>
                }
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* ── Tabla resumen por la dimensión elegida ── *@
    <MudPaper Class="pa-4" Elevation="1" Style="border-radius:14px;">
        <div class="mb-3">
            <MudText Typo="Typo.subtitle2" Style="font-weight:700; color:#112F5B;">
                Detalle por @EtiquetaDimSingular
                <AyudaReporte Ruta="panel-flota" Bloque="detalle" Chico="true" />
            </MudText>
            <MudText Typo="Typo.caption" Style="color:#8FA3BC;">
                Click en una fila para ver las unidades una por una · click en el nombre para enfocar el tablero
            </MudText>
        </div>
        <div class="rfs-tabla-wrap">
            <table class="rfs-tabla">
                <thead>
                    <tr>
                        <th class="rfs-col-fecha">@EtiquetaDimSingularTit</th>
                        <th class="rfs-num">Unidades</th>
                        <th class="rfs-num">Propias</th>
                        <th class="rfs-num">Contratadas</th>
                        @if (_uniBajas)
                        {
                            <th class="rfs-num">De baja</th>
                        }
                        <th class="rfs-num">Butacas</th>
                        <th class="rfs-num" title="Promedio de años de las unidades con año de modelo cargado">Antigüedad</th>
                        <th class="rfs-num" title="Unidades activas que no hicieron ni un viaje en el período">Sin uso</th>
                        <th class="rfs-num">Viajes</th>
                        <th class="rfs-num" title="Km del odómetro en el período, solo de las unidades con lecturas confiables">Km</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _resumen)
                    {
                        var atenua = !EnFoco(r.Cat) ? "rfs-atenua" : "";
                        <tr>
                            <td class="rfs-col-fecha rfs-click @atenua @(EnFocoDuro(r.Cat) ? "pfl-cat-foco" : "")"
                                title="Clic para enfocar el tablero en @r.Cat"
                                @onclick="() => ToggleFoco(r.Cat)">
                                <span class="pfl-punto" style="@($"background:{ColorDe(r.Cat)};")"></span>@r.Cat
                            </td>
                            <td class="rfs-num rfs-click @atenua" title="Ver las @r.Unidades unidades de @r.Cat"
                                @onclick="() => AbrirUnidades(r.Cat)">@Fmt(r.Unidades)</td>
                            <td class="rfs-num @atenua">@Cero(r.Propias)</td>
                            <td class="rfs-num @atenua">@Cero(r.Contratadas)</td>
                            @if (_uniBajas)
                            {
                                <td class="rfs-num @atenua">@Cero(r.Bajas)</td>
                            }
                            <td class="rfs-num @atenua">@Cero(r.Butacas)</td>
                            <td class="rfs-num @atenua">@(r.AntiguedadProm is null ? "·" : $"{r.AntiguedadProm:0.0} a")</td>
                            <td class="rfs-num @atenua @(r.Ociosas > 0 ? "pfl-alerta" : "")">@Cero(r.Ociosas)</td>
                            <td class="rfs-num @atenua">@Cero(r.Viajes)</td>
                            <td class="rfs-num @atenua" title="@r.KmTitulo">@(r.UnidadesConKm > 0 ? Fmt(r.Km) : "·")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td class="rfs-col-fecha rfs-tot">TOTAL@(_focus is null ? "" : $" ({_focus})")</td>
                        <td class="rfs-num rfs-tot rfs-grantot">@Fmt(_tUnidades)</td>
                        <td class="rfs-num rfs-tot">@Fmt(_tPropias)</td>
                        <td class="rfs-num rfs-tot">@Fmt(_tContratadas)</td>
                        @if (_uniBajas)
                        {
                            <td class="rfs-num rfs-tot">@Fmt(_tBajas)</td>
                        }
                        <td class="rfs-num rfs-tot">@Fmt(_tButacas)</td>
                        <td class="rfs-num rfs-tot">@_kAntiguedad</td>
                        <td class="rfs-num rfs-tot">@Fmt(_tOciosas)</td>
                        <td class="rfs-num rfs-tot">@Fmt(_tViajes)</td>
                        <td class="rfs-num rfs-tot">@Fmt(_tKm)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        @if (_kmDudosos > 0)
        {
            @* La calidad del dato se muestra, no se esconde: `vehiculo_km` se carga a mano y
               tiene errores de tipeo de varios órdenes de magnitud. *@
            <MudText Typo="Typo.caption" Class="mt-2" Style="color:#B45309; display:block;">
                ⚠ @_kmDudosos @(_kmDudosos == 1 ? "lectura de odómetro quedó" : "lecturas de odómetro quedaron") fuera del cálculo de km por
                superar los @Fmt(ReportService.KmMaximoPorMes) km en un mes (error de carga). Los km de arriba son solo los de las lecturas confiables.
            </MudText>
        }
    </MudPaper>

    </div>
}

@code {
    private readonly DateTime _min = ReportService.FechaMinValida.ToDateTime(TimeOnly.MinValue);
    private readonly DateTime _max = ReportService.FechaMaxValida.ToDateTime(TimeOnly.MinValue);
    private static readonly System.Globalization.CultureInfo _ar =
        System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    // ── Filtros ──
    private DateTime? _desde = new DateTime(DateTime.Today.Year, 1, 1);
    private DateTime? _hasta = DateTime.Today;

    private const string UniPropias = "Propias";
    private const string UniContratadas = "Contratadas";
    private const string UniBajas = "De baja";
    private static readonly string[] _universos = { UniPropias, UniContratadas, UniBajas };

    // Default: la flota que opera hoy. Las de baja se suman a pedido (sirven para el histórico).
    private IReadOnlyCollection<string> _universoSel = new HashSet<string> { UniPropias, UniContratadas };
    private bool _uniPropias => _universoSel.Contains(UniPropias);
    private bool _uniContratadas => _universoSel.Contains(UniContratadas);
    private bool _uniBajas => _universoSel.Contains(UniBajas);

    private string _dimension = ReportService.DimFlotaTipo;

    // Fechas ya aplicadas (snapshot): el Excel y el drill-down tienen que corresponder a lo
    // que se está viendo, no a lo que el usuario editó sin aplicar.
    private DateOnly _desdeAp, _hastaAp;

    private int _pendientes
    {
        get
        {
            if (_unidades.Count == 0 && !_cargando) return 0;
            var n = 0;
            if (_desde is not null && DateOnly.FromDateTime(_desde.Value) != _desdeAp) n++;
            if (_hasta is not null && DateOnly.FromDateTime(_hasta.Value) != _hastaAp) n++;
            return n;
        }
    }

    // ── Datos ──
    private List<FlotaUnidadRow> _unidades = new();      // todo lo que devolvió la base
    private List<FlotaDemandaRow> _demanda = new();
    private List<FlotaUnidadRow> _base = new();          // filtrado por universo (sin foco)
    private bool _cargando;

    // ── Cross-filter ──
    private string? _focus;
    private bool EnFoco(string cat) => _focus is null || _focus == cat;
    private bool EnFocoDuro(string cat) => _focus == cat;

    // El panel de demanda solo puede seguir el foco cuando la dimensión ES el tipo de vehículo:
    // la demanda vive en `viaje` y no sabe nada de titulares, antigüedad ni butacas.
    private bool AtenuaTipo(string tipo) =>
        _focus is not null && _dimension == ReportService.DimFlotaTipo && _focus != tipo;

    // ── KPIs ──
    private int _kUnidades, _kButacas, _kCategorias, _kOciosas, _kSinAsignar, _kmDudosos;
    private string _kUnidadesSub = "", _kOciosasSub = "", _kSinAsignarSub = "";
    private string _kAntiguedad = "·", _kAntiguedadSub = "";
    private string PeriodoTxt => $"{_desdeAp:dd/MM/yyyy} – {_hastaAp:dd/MM/yyyy}";

    // ── Tabla resumen ── (los records viven en el service: la pantalla y el Excel
    //    comparten la misma forma, así no hay dos versiones del mismo número)
    private List<FlotaResumenCatRow> _resumen = new();
    private int _tUnidades, _tPropias, _tContratadas, _tBajas, _tButacas, _tOciosas, _tViajes;
    private long _tKm;

    // ── Oferta vs demanda ──
    private List<FlotaOfertaDemandaRow> _ofertaDemanda = new();
    private string PctSinCubrirTotal
    {
        get
        {
            var ped = _ofertaDemanda.Sum(x => x.Pedidos);
            return ped > 0 ? $"{_ofertaDemanda.Sum(x => x.SinAsignar) * 100.0 / ped:0.0}%" : "·";
        }
    }

    // ── Gráficos ──
    private record BarItem(string Cat, decimal Valor);
    private record PieItem(string Cat, decimal Valor);
    private List<BarItem> _barItems = new();
    private List<PieItem> _pieItems = new();
    private List<BarItem> _sinAsignarItems = new();
    private int _altoBarras = 360, _altoFalta = 300;
    private ApexChart<BarItem>? _barChart;
    private ApexChart<BarItem>? _faltaChart;
    // _chartsKey remonta los gráficos cuando cambia la FORMA de los datos (período, universo,
    // dimensión). _pieKey además se regenera en cada foco: la torta necesita remontarse para
    // que su leyenda no quede con los valores del render anterior.
    private Guid _chartsKey = Guid.NewGuid();
    private Guid _pieKey = Guid.NewGuid();

    // Paleta categórica del proyecto (color por ENTIDAD, igual en todos los gráficos).
    private static readonly List<string> _palette = new()
    {
        "#2058D0", "#F99410", "#16A34A", "#DC2626", "#0EA5E9",
        "#7C3AED", "#B45309", "#DB2777", "#0D9488", "#65A30D",
        "#4F46E5", "#EA580C", "#059669", "#9333EA", "#0891B2"
    };
    private const string _colorOtros = "#94A3B8";
    private Dictionary<string, string> _colorPorCat = new();
    private string ColorDe(string cat) => _colorPorCat.TryGetValue(cat, out var c) ? c : _colorOtros;
    private string ColorFoco(string cat) =>
        (_focus is null || cat == _focus) ? ColorDe(cat) : "#D9E1EC";

    // ── Etiquetas de la dimensión ──
    private static string EtiquetaDim(string d) => d switch
    {
        ReportService.DimFlotaTitular => "Titular",
        ReportService.DimFlotaAntiguedad => "Antigüedad",
        ReportService.DimFlotaCapacidad => "Capacidad",
        _ => "Tipo de vehículo",
    };
    private string EtiquetaDimSingular => _dimension switch
    {
        ReportService.DimFlotaTitular => "titular",
        ReportService.DimFlotaAntiguedad => "tramo de antigüedad",
        ReportService.DimFlotaCapacidad => "tramo de capacidad",
        _ => "tipo",
    };
    private string EtiquetaDimSingularTit =>
        char.ToUpper(EtiquetaDimSingular[0]) + EtiquetaDimSingular[1..];
    private string EtiquetaDimPlural => _dimension switch
    {
        ReportService.DimFlotaTitular => "Titulares",
        ReportService.DimFlotaAntiguedad => "Tramos de edad",
        ReportService.DimFlotaCapacidad => "Tramos de capacidad",
        _ => "Tipos distintos",
    };

