@page "/auditoria-accesos"
@using MetroCarSysBlazor.Components.Shared
@inject ReportService Reports
@inject NorturAuthStateProvider AuthState
@inject IPermissionService Permisos
@inject NavigationManager Nav
@inject ExcelExportService ExcelSvc
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>BusLink</PageTitle>

@* ── Encabezado ── *@
<div class="page-header mb-4">
    <MudText Typo="Typo.h5" Style="font-weight:800; color:#112F5B;">
        Auditoría de accesos
    </MudText>
    <MudText Typo="Typo.body2" Style="color:#7A90AD; margin-top:2px;">
        Sistema · Accesos — bitácora de ingresos, egresos y vencimientos de todos los usuarios
    </MudText>
</div>

@* ── Filtros ── *@
<MudPaper Class="pa-2 mb-3 odo-filtros" Elevation="1" Style="border-radius:14px; border-top:4px solid #003AA0;">
    <div class="d-flex flex-wrap align-center" style="gap:14px;">
        @* Desde + Hasta, pegaditos *@
        <div class="odo-grupo">
            <MudDatePicker Label="Desde" @bind-Date="_desde" DateFormat="dd/MM/yyyy"
                           PickerVariant="PickerVariant.Dialog" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Style="width:170px;" />
            <MudDatePicker Label="Hasta" @bind-Date="_hasta" DateFormat="dd/MM/yyyy"
                           PickerVariant="PickerVariant.Dialog" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Style="width:170px;" />
        </div>

        @* Usuario + Eventos *@
        <div class="odo-grupo">
            <MudAutocomplete T="string" @bind-Value="_usuario" Label="Usuario" Dense="true"
                             SearchFunc="@BuscarUsuario" ResetValueOnEmptyText="true"
                             Clearable="true" CoerceValue="true"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:160px;" />
            <MudSelect T="string" Label="Eventos" MultiSelection="true"
                       @bind-SelectedValues="_eventos" Dense="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:200px;"
                       MultiSelectionTextFunc="@(v => v.Count == 0 ? "Todos" : string.Join(", ", v))">
                @foreach (var ev in _eventosPosibles)
                {
                    <MudSelectItem T="string" Value="@ev">@EventoTexto(ev)</MudSelectItem>
                }
            </MudSelect>
        </div>

        @* Botonera de acción, toda junta a la derecha *@
        <span style="flex:1 1 auto;"></span>
        <div class="odo-grupo">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.FilterAlt" OnClick="Aplicar" Disabled="_cargando">
                Filtro
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Refresh" OnClick="Refrescar" Disabled="_cargando">
                Actualizar
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Download" OnClick="DescargarExcel"
                       Disabled="_cargando || _datos.Count == 0">
                Excel
            </MudButton>
        </div>
    </div>
</MudPaper>

@* Leyenda de las letras de Acceso (desplegable). *@
<LeyendaAccesos />

@if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" Style="border-radius:4px;" />
}
else
{
    @* ── KPIs ── *@
    <div class="rfs-kpis mb-3">
        <KpiCard Label="EVENTOS" Value="@_datos.Count.ToString("N0", _ar)" Sub="@PeriodoTexto" />
        <KpiCard Label="INGRESOS" Value="@KpiLogins.ToString("N0", _ar)"
                 Sub="logins exitosos" Color="@NorturColors.Verde" />
        <KpiCard Label="USUARIOS" Value="@KpiUsuarios.ToString("N0", _ar)"
                 Sub="distintos en el período" Color="@NorturColors.Naranja" />
        <KpiCard Label="FALLIDOS" Value="@KpiFallidos.ToString("N0", _ar)"
                 Sub="intentos rechazados" Color="@NorturColors.Rojo" />
    </div>

    <MudPaper Elevation="1" Style="border-radius:14px; overflow:hidden;">
        <MudTable Items="_datos" Dense="true" Hover="true" Striped="true"
                  FixedHeader="true" Height="calc(100vh - 355px)"
                  Bordered="false" Class="cli-grid grid-compacta"
                  Virtualize="true" T="AccesoLogRow">
            <HeaderContent>
                <MudTh>Fecha y hora</MudTh>
                <MudTh>Evento</MudTh>
                <MudTh>Usuario</MudTh>
                <MudTh>Nivel</MudTh>
                <MudTh>Acceso</MudTh>
                <MudTh>IP</MudTh>
                <MudTh>Equipo</MudTh>
                <MudTh>Motivo / detalle</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Fecha y hora" Style="white-space:nowrap; font-weight:600;">@context.FEvento.ToString("dd/MM/yyyy HH:mm:ss", _ar)</MudTd>
                <MudTd DataLabel="Evento"><span class="acc-ev @ClaseEvento(context.Evento)">@EventoTexto(context.Evento)</span></MudTd>
                <MudTd DataLabel="Usuario" Style="font-weight:600;">@context.Usuario</MudTd>
                <MudTd DataLabel="Nivel">@context.Nivel</MudTd>
                <MudTd DataLabel="Acceso"><AccesoChips Acceso="@context.Acceso" /></MudTd>
                <MudTd DataLabel="IP" Style="font-family:monospace;">@(string.IsNullOrEmpty(context.Ip) ? "—" : context.Ip)</MudTd>
                <MudTd DataLabel="Equipo">@(string.IsNullOrEmpty(context.Hostname) ? "—" : context.Hostname)</MudTd>
                <MudTd DataLabel="Motivo / detalle" Style="color:#7A90AD;">@(string.IsNullOrEmpty(context.Motivo) ? "" : context.Motivo)</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Class="pa-4">
                    No hay accesos registrados para el filtro aplicado. Ampliá el rango de fechas.
                </MudText>
            </NoRecordsContent>
        </MudTable>

        <div class="cli-toolbar">
            <span class="cli-toolbar__hint">
                <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" /> Bitácora de solo lectura · un evento por fila
            </span>
            <span style="flex:1;"></span>
            <span class="cli-toolbar__hint">@_datos.Count.ToString("N0", _ar) eventos</span>
        </div>
    </MudPaper>
}

@code {
    private List<AccesoLogRow> _datos = new();
    private List<string> _usuarios = new();
    private bool _cargando = true;

    private DateTime? _desde = DateTime.Today.AddDays(-7);
    private DateTime? _hasta = DateTime.Today;
    private string? _usuario;
    private IReadOnlyCollection<string> _eventos = new HashSet<string>();   // vacío = todos
    private readonly string[] _eventosPosibles = { "LOGIN", "LOGOUT", "EXPIRADA", "VENCIDA", "LOGIN_FALLIDO" };

    private readonly System.Globalization.CultureInfo _ar =
        System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    private string PeriodoTexto =>
        $"{(_desde ?? DateTime.Today):dd/MM/yyyy} – {(_hasta ?? DateTime.Today):dd/MM/yyyy}";

    private int KpiLogins => _datos.Count(x => x.Evento == "LOGIN");
    private int KpiFallidos => _datos.Count(x => x.Evento == "LOGIN_FALLIDO");
    private int KpiUsuarios => _datos.Where(x => !string.IsNullOrWhiteSpace(x.Usuario))
                                     .Select(x => x.Usuario).Distinct().Count();

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthState.EstaAutenticadoAsync())
        {
            Nav.NavigateTo($"/login?destino={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: false);
            return;
        }
        if (!Permisos.Tiene('S'))   // Sistema · Accesos (solo supervisor)
        {
            Nav.NavigateTo("/", forceLoad: false);
            return;
        }
        _usuarios = await Reports.GetUsuariosDeLogsAsync();
        await CargarAsync();
    }

    private async Task<IEnumerable<string>> BuscarUsuario(string value, CancellationToken _)
    {
        if (string.IsNullOrWhiteSpace(value)) return _usuarios.Take(50);
        return _usuarios.Where(u => u.Contains(value, StringComparison.OrdinalIgnoreCase)).Take(50);
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        StateHasChanged();
        var desde = DateOnly.FromDateTime(_desde ?? DateTime.Today.AddDays(-7));
        var hasta = DateOnly.FromDateTime(_hasta ?? DateTime.Today);
        _datos = await Reports.GetAuditoriaAccesosAsync(desde, hasta, _usuario, _eventos);
        _cargando = false;
    }

    private async Task Aplicar() => await CargarAsync();

    private async Task Refrescar()
    {
        Reports.InvalidarCacheAbm();
        _usuarios = await Reports.GetUsuariosDeLogsAsync();
        await CargarAsync();
    }

    private async Task DescargarExcel()
    {
        var bytes = ExcelSvc.AuditoriaAccesos(_datos, _desde ?? DateTime.Today, _hasta ?? DateTime.Today);
        var nombre = $"Accesos_{(_desde ?? DateTime.Today):yyyyMMdd}_{(_hasta ?? DateTime.Today):yyyyMMdd}.xlsx";
        await JS.InvokeVoidAsync("downloadFile", nombre, Convert.ToBase64String(bytes));
    }

    // Texto legible del evento.
    private static string EventoTexto(string ev) => ev switch
    {
        "LOGIN" => "Ingreso",
        "LOGOUT" => "Egreso",
        "EXPIRADA" => "Expirada",
        "VENCIDA" => "Vencida (8hs)",
        "LOGIN_FALLIDO" => "Ingreso fallido",
        _ => ev
    };

    // Clase de color del pill según el evento.
    private static string ClaseEvento(string ev) => ev switch
    {
        "LOGIN" => "acc-ev--login",
        "LOGOUT" => "acc-ev--logout",
        "EXPIRADA" => "acc-ev--expirada",
        "VENCIDA" => "acc-ev--vencida",
        "LOGIN_FALLIDO" => "acc-ev--fallido",
        _ => ""
    };
}
