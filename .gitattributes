# Normalizar line endings a LF en el repo, CRLF en Windows al checkout
* text=auto
*.cs text eol=crlf
*.razor text eol=crlf
*.css text eol=crlf
*.js text eol=crlf
*.json text eol=crlf
*.md text eol=crlf

# Binarios — sin conversión
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.xlsx binary
*.woff binary
*.woff2 binary
*.ttf binary
