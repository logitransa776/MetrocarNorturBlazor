# Credenciales para los smoke tests E2E (Playwright).
# Copiá este archivo o exportá estas variables antes de correr `npm test`.
#
# PowerShell:
#   $env:NORTUR_USER="alejandra"
#   $env:NORTUR_PASS="tu_password"
#   npm test
#
# Opcional — apuntar a otra URL (default http://localhost:5287):
#   $env:NORTUR_BASEURL="https://localhost:7277"

NORTUR_USER=
NORTUR_PASS=
